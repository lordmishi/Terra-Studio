<style>
/* Design read: working studio tool for one documentary YouTuber, field-notebook / museum-specimen language, dials ENERGY 1 / RHYTHM 2 / MOTION 1.
   Layout: sticky strata tab bar, one tool panel at a time, form left / results right on wide screens.
   Why these choices (R-31):
   - Palette: limestone grey-green ground + peat ink + one amber "fossil resin" accent, taken from the channel's bog/Ice Age subject; moss and rust only as good/bad state.
   - Type: Alegreya SC (small caps like specimen labels and museum plaques) for headings, Alegreya Sans for reading, IBM Plex Mono only for numbers and specimen tags.
   - Identity motif: small uppercase mono "specimen tag" labels (.layer) above each block, like catalogue tags on fossil drawers.
   - Cards: only for separate results a user copies or compares; borders flat, no shadows, because nothing floats above anything else.
   - Spacing: 16px between sibling blocks, 24-28px between form and results, so a tool reads as one unit. */
:root{
  --bg:#F3F4F1; --surface:#FFFFFF; --line:#E0E3DC; --field:#9EA597; --ink:#1C1F1A; --muted:#5A6056;
  --accent:#975808; --accent-ink:#FFF8EE; --moss:#4E6B3A; --warn:#9A3B22; --chip:#ECEEE9;
  --f-display:"Familjen Grotesk", system-ui, sans-serif; --f-body:"Familjen Grotesk", system-ui, sans-serif; --f-mono:"IBM Plex Mono", ui-monospace, monospace;
}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]){
  --bg:#141613; --surface:#1C1F1B; --line:#2D312A; --field:#6C7366; --ink:#E9ECE5; --muted:#A2A99B;
  --accent:#E59A3C; --accent-ink:#1E1407; --moss:#9BC07E; --warn:#F08A6B; --chip:#262A23; color-scheme:dark}}
:root[data-theme="dark"]{
  --bg:#141613; --surface:#1C1F1B; --line:#2D312A; --field:#6C7366; --ink:#E9ECE5; --muted:#A2A99B;
  --accent:#E59A3C; --accent-ink:#1E1407; --moss:#9BC07E; --warn:#F08A6B; --chip:#262A23; color-scheme:dark}
*{box-sizing:border-box}
[hidden]{display:none!important}
body{background:var(--bg);color:var(--ink);font:17px/1.55 var(--f-body)}
.wrap{max-width:1180px;margin:0 auto;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px));padding-block:28px 64px}
header.top{display:flex;flex-wrap:wrap;gap:12px 24px;align-items:end;justify-content:space-between;margin-bottom:20px}
h1{font:700 clamp(28px,4vw,40px)/1.05 var(--f-display);margin:0;letter-spacing:.01em;text-wrap:balance}
.sub{color:var(--muted);margin:6px 0 0;max-width:60ch}
.meter{font:500 13px/1.3 var(--f-mono);color:var(--muted);text-align:right}
.meter b{color:var(--ink);font-size:18px}
.bar{height:8px;background:var(--chip);border-radius:4px;overflow:hidden;margin-top:6px;min-width:180px}
.bar i{display:block;height:100%;background:var(--accent)}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);z-index:10;background:var(--bg)}
nav.tabs{position:sticky;top:env(safe-area-inset-top,0px);z-index:5;background:var(--bg);display:flex;gap:4px;overflow-x:auto;border-bottom:2px solid var(--ink);margin-bottom:24px;scrollbar-width:thin}
nav.tabs button{flex:0 0 auto;border:0;background:none;color:var(--muted);font:500 15px var(--f-body);padding:12px 14px 10px;min-height:46px;cursor:pointer;border-bottom:4px solid transparent;margin-bottom:-2px}
nav.tabs button[aria-selected="true"]{color:var(--ink);border-bottom-color:var(--accent);font-weight:700}
nav.tabs button:focus-visible,button:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.layer{font:500 11px var(--f-mono);letter-spacing:.06em;color:var(--muted);display:block;text-transform:uppercase}
.panel{display:grid;grid-template-columns:minmax(0,340px) minmax(0,1fr);gap:28px;align-items:start}
@media (max-width:820px){.panel{grid-template-columns:minmax(0,1fr)}}
form.tool{display:grid;gap:14px;background:var(--surface);border:1px solid var(--line);border-radius:6px;padding:18px}
form.tool h2{font:700 22px/1.15 var(--f-display);margin:0}
form.tool p.hint{margin:0;color:var(--muted);font-size:15px}
label{display:grid;gap:4px;font-weight:500;font-size:15px}
input,select,textarea{font:16px var(--f-body);color:var(--ink);background:var(--bg);border:1px solid var(--field);border-radius:4px;padding:9px 10px;min-height:44px;width:100%}
textarea{min-height:84px;resize:vertical}
.row2{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.btn{font:700 16px var(--f-body);background:var(--accent);color:var(--accent-ink);border:0;border-radius:4px;padding:11px 16px;min-height:44px;cursor:pointer}
.btn[disabled]{opacity:.6;cursor:progress}
.btn.ghost{background:none;color:var(--ink);border:1px solid var(--field);font-weight:500;padding:6px 12px;font-size:14px;min-height:44px}
.status{font:13px var(--f-mono);color:var(--muted);min-height:1.2em}
.status.err{color:var(--warn)}
.out{display:grid;gap:16px;min-width:0}
.out-head{display:flex;flex-wrap:wrap;gap:8px;align-items:center;justify-content:space-between}
.tag-example{font:500 11px var(--f-mono);letter-spacing:.08em;text-transform:uppercase;background:var(--chip);color:var(--muted);padding:3px 8px;border-radius:3px}
.card{background:var(--surface);border:1px solid var(--line);border-radius:6px;padding:16px 18px;min-width:0}
.card h3{font:700 19px/1.25 var(--f-body);margin:0 0 6px;text-wrap:balance}
.card p{margin:6px 0}
.meta{font:12px var(--f-mono);color:var(--muted);display:flex;flex-wrap:wrap;gap:6px 14px}
.chips{display:flex;flex-wrap:wrap;gap:6px}
.chip{background:var(--chip);border-radius:3px;padding:2px 8px;font:13px var(--f-mono)}
.ideas{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:14px}
.date{font:500 13px var(--f-mono);color:var(--accent)}
.act{display:grid;grid-template-columns:72px minmax(0,1fr);gap:14px;border-top:1px solid var(--line);padding-top:14px}
.act:first-of-type{border-top:0;padding-top:0}
.act .num{font:700 30px/1 var(--f-display);color:var(--accent)}
.act .num small{display:block;font:12px var(--f-mono);color:var(--muted);margin-top:6px}
.act ul{margin:6px 0;padding-left:18px}
.strata{display:flex;height:14px;border-radius:3px;overflow:hidden;margin:4px 0 12px}
.strata span{display:block}
.copybox{position:relative}
.copybox pre{white-space:pre-wrap;word-break:break-word;font:14px/1.5 var(--f-mono);background:var(--bg);border:1px solid var(--line);border-radius:4px;padding:12px;margin:8px 0 0;max-height:420px;overflow:auto}
.copybox .btn.ghost{position:absolute;top:-48px;right:0}
.titles li{margin:6px 0}
.titles .len{font:12px var(--f-mono);color:var(--muted);margin-left:6px}
.thumbs{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:14px}
.thumb-text{font:900 26px/1 var(--f-body);text-transform:uppercase;background:var(--ink);color:var(--bg);padding:14px;border-radius:4px;aspect-ratio:16/9;max-width:100%;display:flex;align-items:flex-end;letter-spacing:.01em}
.check li{list-style:none;display:grid;grid-template-columns:22px minmax(0,1fr);gap:8px;padding:8px 0;border-top:1px solid var(--line)}
.check{padding:0;margin:0}
.check input{width:18px;height:18px;margin-top:3px}
.check small{color:var(--muted);display:block}
.grid2{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,320px),1fr));gap:16px}
.big{font:700 34px/1 var(--f-display);font-variant-numeric:tabular-nums}
.ok{color:var(--moss)} .no{color:var(--warn)}
.note{font-size:14px;color:var(--muted)}
.kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px;margin-top:10px}
.kpis div{padding-top:8px;border-top:1px solid var(--line)}
.kpis b{display:block;font:700 26px/1.1 var(--f-display);font-variant-numeric:tabular-nums}
.kpis span{font-size:13px;color:var(--muted)}
table{border-collapse:collapse;width:100%;font-size:14px;font-variant-numeric:tabular-nums}
th,td{text-align:right;padding:6px 8px;border-bottom:1px solid var(--line);white-space:nowrap}
th:first-child,td:first-child{text-align:left;white-space:normal}
.vt td:first-child{min-width:240px}
.vt th{cursor:pointer;user-select:none;font-weight:700}
.vt th:hover{color:var(--accent)}
.vt th:focus-visible{outline:2px solid var(--accent);outline-offset:-2px}
.chart-wrap{position:relative;overflow-x:auto;margin-top:14px}
.tip{position:absolute;pointer-events:none;background:var(--ink);color:var(--bg);font:13px/1.35 var(--f-mono);padding:6px 9px;border-radius:4px;white-space:nowrap;transform:translate(-50%,-110%)}
details.mtable{margin-top:10px}details.mtable summary{cursor:pointer;font-size:14px;color:var(--muted);min-height:44px;display:flex;align-items:center}
.grid3{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr));gap:16px}
.ages{display:grid;gap:6px;margin:10px 0}
.ab{display:grid;grid-template-columns:48px minmax(0,1fr) 48px;gap:8px;align-items:center;font:13px var(--f-mono)}
.ab b{text-align:right;font-weight:500}
.abar{height:10px;background:var(--chip);border-radius:3px;overflow:hidden}.abar i{display:block;height:100%;background:var(--accent)}
.diag{padding-left:18px;margin:12px 0 0}.diag li{margin:8px 0}
.flag{color:var(--warn);font-weight:700}.good{color:var(--moss);font-weight:700}
footer{margin-top:40px;color:var(--muted);font-size:14px;max-width:70ch}
.banner{display:flex;flex-wrap:wrap;gap:8px 12px;align-items:center;background:var(--chip);border:1px solid var(--field);border-radius:6px;padding:10px 14px;margin-bottom:16px}
.empty{border:1px dashed var(--field);border-radius:6px;padding:20px;color:var(--muted);max-width:60ch}
.steps{padding-left:20px;margin:8px 0 14px}.steps li{margin:6px 0}
.confirm{display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin-top:12px}
a{color:var(--accent)}a:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
code{font:13px var(--f-mono);background:var(--chip);padding:1px 5px;border-radius:3px;word-break:break-all}
/* App shell: fixed sidebar + top bar, like a desktop workspace */
body{margin:0}
.shell{display:grid;grid-template-columns:232px minmax(0,1fr);min-height:100vh}
.side{position:sticky;top:0;height:100vh;display:flex;flex-direction:column;gap:6px;background:var(--surface);border-right:1px solid var(--line);padding:18px 12px}
.brand{display:flex;gap:10px;align-items:center;padding:4px 8px 16px}
.brand .logo{width:34px;height:34px;flex:none}
.brand .logo rect{fill:var(--accent)}.brand .logo rect.layer-b{fill:var(--accent-ink)}.brand .logo path{stroke:var(--accent-ink);stroke-width:2.2;fill:none;stroke-linecap:round}.brand .logo circle{fill:none;stroke:var(--accent);stroke-width:1.6}
.brand b{display:block;font:700 19px/1.1 var(--f-display)}
.brand small{display:block;font-size:12.5px;color:var(--muted);line-height:1.3;margin-top:2px}
.side-label{padding:6px 10px}
.side nav.tabs{position:static;flex-direction:column;gap:2px;border:0;margin:0;overflow:visible;background:none}
.side nav.tabs button{display:flex;gap:10px;align-items:center;width:100%;text-align:left;border:0;border-radius:6px;margin:0;padding:10px 12px;min-height:44px;color:var(--ink);font-weight:500}
.side nav.tabs button svg{width:20px;height:20px;flex:none;fill:none;stroke:var(--muted);stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
.side nav.tabs button:hover{background:var(--chip)}
.side nav.tabs button[aria-selected="true"]{background:var(--chip);color:var(--accent);font-weight:700;box-shadow:inset 3px 0 0 var(--accent)}
.side nav.tabs button[aria-selected="true"] svg{stroke:var(--accent)}
.side-foot{margin-top:auto;font:12px var(--f-mono);color:var(--muted);padding:8px 10px}
.main{min-width:0}
.topbar{position:sticky;top:0;z-index:5;display:flex;flex-wrap:wrap;gap:10px 16px;align-items:center;justify-content:space-between;background:var(--bg);border-bottom:1px solid var(--line);padding:14px max(16px,2.5vw)}
.topbar h1{font-size:clamp(24px,2.6vw,30px)}
.topbar .meter{text-align:left;margin-top:2px}.topbar .meter b{font-size:14px}.topbar .meter .layer{display:inline;margin-right:6px}
.actions{display:flex;flex-wrap:wrap;gap:8px}.actions .btn.ghost{background:var(--surface)}
.main .wrap{padding-block:22px 48px}
/* dashboard */
.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px;margin-bottom:16px}
.stat{background:var(--surface);border:1px solid var(--line);border-radius:6px;padding:12px 14px}
.stat span{display:block;font-size:13.5px;color:var(--muted)}
.stat b{display:block;font:700 24px/1.2 var(--f-display);font-variant-numeric:tabular-nums;margin-top:2px;overflow-wrap:anywhere}
.stats-note{grid-column:1/-1;margin:0}
.cal-card{padding:0;overflow:hidden;margin-bottom:16px}
.cal-head{display:flex;flex-wrap:wrap;gap:10px 16px;align-items:center;justify-content:space-between;padding:14px 16px;border-bottom:1px solid var(--line)}
.cal-head h2{font:700 22px var(--f-display);margin:0;text-transform:capitalize}
.cal-nav{display:flex;gap:6px}.btn.icon{min-width:44px;font-size:20px;padding:4px 10px}
.cal-legend{display:flex;flex-wrap:wrap;gap:6px 12px;font-size:13px;color:var(--muted)}
.cl::before{content:"";display:inline-block;width:10px;height:10px;border-radius:2px;margin-right:5px;vertical-align:-1px;background:var(--chip);border:1px solid var(--field)}
.cl.video::before,.ev.video{--c:var(--accent)}.cl.short::before,.ev.short{--c:var(--moss)}.cl.post::before,.ev.post{--c:var(--muted)}
.cl.video::before,.cl.short::before,.cl.post::before{background:var(--c);border-color:var(--c)}
.cal{display:grid;grid-template-columns:repeat(7,minmax(0,1fr))}
.cal-dow{font:500 12px var(--f-mono);text-transform:uppercase;letter-spacing:.06em;color:var(--muted);text-align:center;padding:8px 4px;border-bottom:1px solid var(--line)}
.cal-day{min-height:104px;border-right:1px solid var(--line);border-bottom:1px solid var(--line);padding:4px;display:flex;flex-direction:column;gap:3px;min-width:0}
.cal-day:nth-child(7n){border-right:0}
.cal-day.off{background:var(--bg)}
.cal-num{align-self:flex-start;border:0;background:none;color:var(--ink);font:500 13px var(--f-mono);min-width:30px;min-height:30px;border-radius:15px;cursor:pointer}
.cal-num:hover{background:var(--chip)}
.cal-day.today .cal-num{background:var(--accent);color:var(--accent-ink);font-weight:700}
.ev{display:block;width:100%;text-align:left;font:12.5px/1.25 var(--f-body);color:var(--ink);background:var(--bg);border:1px solid var(--line);border-left:3px solid var(--c,var(--field));border-radius:3px;padding:3px 5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
button.ev{cursor:pointer}button.ev:hover{border-color:var(--c)}
.ev i{font:500 10px var(--f-mono);font-style:normal;text-transform:uppercase;letter-spacing:.04em;color:var(--muted);margin-right:5px}
.ev.pub{background:var(--chip);border-left-color:var(--ink)}
.ev.done{opacity:.7}
.up{list-style:none;padding:0;margin:8px 0 0}
.up li{display:grid;grid-template-columns:110px minmax(0,1fr) auto;gap:10px;align-items:center;padding:8px 0;border-top:1px solid var(--line)}
.linkish{border:0;background:none;color:var(--ink);font:500 16px var(--f-body);text-align:left;cursor:pointer;padding:6px 0;min-height:36px}.linkish:hover{color:var(--accent);text-decoration:underline}
dialog{border:1px solid var(--line);border-radius:8px;padding:0;background:var(--surface);color:var(--ink);width:min(520px,calc(100vw - 32px))}
dialog::backdrop{background:rgba(20,22,18,.45)}
dialog form.tool{border:0}
.btn.ghost.danger{color:var(--warn);border-color:var(--warn)}
@media (max-width:900px){
  .shell{grid-template-columns:minmax(0,1fr)}
  .side{position:sticky;top:0;z-index:6;height:auto;flex-direction:row;align-items:center;padding:6px 8px;border-right:0;border-bottom:1px solid var(--line);overflow-x:auto}
  .brand{padding:0 6px 0 2px}.brand small,.brand b,.side-label,.side-foot{display:none}
  .side nav.tabs{flex-direction:row}.side nav.tabs button{width:auto;white-space:nowrap}
  .topbar{position:static}
  .cal-day{min-height:72px}.ev i{display:none}
  .up li{grid-template-columns:minmax(0,1fr)}
}
@media (max-width:560px){.side nav.tabs button span{display:none}.side nav.tabs button{padding:10px}}
@media (prefers-reduced-motion:reduce){*{transition:none!important}}
.main .banner{font-size:15px;line-height:1.45;padding:8px 12px}
.grp{display:grid;gap:12px;padding:12px;border:1px solid var(--line);border-radius:6px;background:var(--bg)}
.qbar{height:8px;border-radius:4px;background:var(--line);overflow:hidden;margin:4px 0 6px}.qbar span{display:block;height:100%;background:var(--accent)}
a.btn{text-decoration:none;display:inline-flex;align-items:center}
/* Restyle 2026-11 (Craftwork rules): data-tool family. One sans for text, mono only for numbers,
   flat surfaces, hairlines instead of boxes in dense areas, one radius system (10 cards, 8 controls),
   one button scale (40 / 34), hover fades 180ms. */
:root{--r-card:10px;--r-ctl:8px;--ease:cubic-bezier(.22,1,.36,1)}
h1{font-weight:600;letter-spacing:-.02em}
form.tool{border-radius:var(--r-card);padding:20px;gap:16px}
form.tool h2,.cal-head h2{font:600 19px/1.2 var(--f-display);letter-spacing:-.01em}
.card{border-radius:var(--r-card);padding:18px 20px}
.card h3{font-weight:600;font-size:18px}
input,select,textarea{border-radius:var(--r-ctl);background:var(--surface);border-color:var(--line);box-shadow:inset 0 0 0 1px transparent;transition:background-color .18s var(--ease)}
.grp input,.grp select{background:var(--surface)}
.btn{font:600 15px var(--f-body);border-radius:var(--r-ctl);min-height:40px;padding:8px 16px;transition:background-color .18s var(--ease),color .18s var(--ease),transform .15s var(--ease)}
.btn.ghost{font:500 14px var(--f-body);min-height:40px;padding:8px 14px;background:var(--surface);border:1px solid var(--line);box-shadow:0 1px 0 rgba(28,31,26,.04)}
@media (hover:hover){.btn:hover{background:#7E4906}.btn.ghost:hover{background:var(--chip)}
  :root[data-theme="dark"] .btn:hover{background:#F0AE5A}}
@media (hover:hover) and (prefers-color-scheme:dark){:root:not([data-theme="light"]) .btn:not(.ghost):hover{background:#F0AE5A}}
.btn:active{transform:scale(.97)}
.btn.icon{min-width:40px;font-size:18px;padding:4px 10px}
.status{font:14px/1.45 var(--f-body)}
.layer{font:600 12.5px var(--f-body);letter-spacing:0;text-transform:none;color:var(--muted)}
.meta,.chip,.date,.titles .len,.ab,.act .num small{font-family:var(--f-body);font-variant-numeric:tabular-nums}
.chip{border-radius:6px;padding:3px 9px}
.date{font-weight:600}
.act .num{font:600 26px/1 var(--f-display)}
.copybox pre{font:15px/1.6 var(--f-body);border-radius:var(--r-ctl);background:var(--bg);padding:14px 16px}
.banner{border-radius:var(--r-card);border-color:var(--line)}
.grp{border-radius:var(--r-card)}
/* shell */
.side{padding:20px 12px}
.brand b{font:600 18px/1.1 var(--f-display);letter-spacing:-.01em}
.side-label{font:600 12px var(--f-body);color:var(--muted)}
.side nav.tabs button{border-radius:var(--r-ctl);font-size:15px;transition:background-color .18s var(--ease),color .18s var(--ease)}
.side nav.tabs button[aria-selected="true"]{box-shadow:none;background:var(--chip);font-weight:600}
.side-foot{font:13px var(--f-body)}
.topbar{padding:16px max(16px,2.5vw)}
.topbar .meter,.topbar .meter .layer{font:14px var(--f-body);letter-spacing:0;text-transform:none}
.topbar .meter b{font:600 15px var(--f-mono);font-variant-numeric:tabular-nums}
/* dashboard: one stat strip with hairlines, not six boxes */
.stats{gap:0;background:var(--surface);border:1px solid var(--line);border-radius:var(--r-card);margin-bottom:20px;overflow:hidden}
.stat{background:none;border:0;border-left:1px solid var(--line);border-radius:0;padding:16px 18px}
.stat:first-child{border-left:0}
.stat span{font-size:13.5px}
.stat b{font:600 22px/1.25 var(--f-mono);letter-spacing:-.02em;margin-top:4px}
.card.cal-card{border-radius:var(--r-card);padding:0}
@media (max-width:700px){.stats{grid-template-columns:repeat(2,minmax(0,1fr))}.stat{border-left:0;border-top:1px solid var(--line)}.stat:nth-child(even){border-left:1px solid var(--line)}.stat:nth-child(-n+2){border-top:0}.stat b{font-size:18px}}
.cal-card>.note{margin:0;padding:12px 20px}
.cal-head{padding:16px 20px}
.cal-dow{font:600 12px var(--f-body);letter-spacing:.04em}
.cal-day{min-height:84px;padding:6px}
.cal-day.off{background:color-mix(in srgb,var(--bg) 60%,var(--surface))}
.cal-num{font:500 13px var(--f-body);font-variant-numeric:tabular-nums;transition:background-color .18s var(--ease)}
.ev{border:0;border-radius:6px;background:var(--chip);padding:4px 7px 4px 18px;position:relative;font-size:12.5px}
.ev::before{content:"";position:absolute;left:7px;top:50%;width:6px;height:6px;margin-top:-3px;border-radius:3px;background:var(--c,var(--field))}
@media (hover:hover){button.ev:hover{background:var(--line)}}
.ev i{font:600 10.5px var(--f-body);letter-spacing:.02em}
.ev.pub{background:transparent;box-shadow:inset 0 0 0 1px var(--line)}
.ev.pub::before{background:var(--ink)}
.cl::before{border-radius:3px}
dialog{border-radius:12px}
.tip{font:13px/1.35 var(--f-body);border-radius:6px}
/* Nav icons: Streamline Core outline, Craftwork "Core Essential UI Icons" pack (free, Craftwork Commercial License) */
.side nav.tabs button svg{stroke-width:1.05}
</style>
