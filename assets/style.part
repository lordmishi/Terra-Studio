<style>
/* Terra Studio 1.8 design.
   Read: a production workspace for one prehistory documentary channel, in the language of Sigit's reference
   (dark shell, slim icon rail, cream-circle calendar, bright planning cards on a light board, striped highlight bar).
   Why these choices:
   - Two skins only: "batu" (dark rock, default) and "lumut" (moss), the same pair the reference shows.
   - Colour comes from the channel banner: amber accent, rust for long videos, moss for Shorts, bone cream for days.
   - Display type is Archivo extra-bold, slightly wide, close to the TERRA lettering on the banner; text is Familjen Grotesk.
   - Surfaces: dark panels (radius 20) for tools; one light "paper" board for planning so plans read as cards on a desk.
   - One radius scale (20 panels, 14 cards, 10 controls), one button height (40), hover fades 180ms.
   - Rust and moss are dark enough for white 12px text (5.0:1 and 5.3:1). */
/* Fonts ship inside the app (SIL Open Font License), so an offline PC looks the same. */
@font-face{font-family:"Archivo";src:url(/fonts/archivo.woff2) format("woff2");font-weight:600 800;font-stretch:100% 125%;font-display:swap}
@font-face{font-family:"Familjen Grotesk";src:url(/fonts/familjen.woff2) format("woff2");font-weight:400 700;font-display:swap}
:root{
  --bg:#0F0E0C; --pan:#1A1815; --pan2:#25221E; --line:rgba(255,240,220,.09); --field:rgba(255,240,220,.18);
  --ink:#F4ECDD; --muted:#A79E8F; --accent:#F2A230; --accent-ink:#1A1206; --accent-hi:#F6B655; --accent-lo:#D98A16;
  --rust:#BD4A20; --moss:#4D7647; --stone:#C9CFC9; --stone-dot:#737B74; --bone:#F1E6CF; --ok:#93C285; --warn:#F59E80; --chip:#25221E;
  --paper:#F5F0E6; --paper-ink:#1A1612; --pub:#2A2622;
  --surface:var(--pan);
  --f-display:"Archivo", "Familjen Grotesk", system-ui, sans-serif; --f-body:"Familjen Grotesk", system-ui, sans-serif; --f-mono:"Familjen Grotesk", system-ui, sans-serif;
  --r-pan:20px; --r-card:14px; --r-ctl:10px; --ease:cubic-bezier(.22,1,.36,1);
  color-scheme:dark;
}
:root[data-skin="lumut"]{--bg:#112217; --pan:#19301F; --pan2:#223D29; --line:rgba(230,255,230,.09); --field:rgba(230,255,230,.2); --muted:#A5BBA6; --chip:#223D29; --warn:#F7B098}
*{box-sizing:border-box}
[hidden]{display:none!important}
html,body{height:100%}
body{margin:0;background:var(--bg);color:var(--ink);font:500 15.5px/1.5 var(--f-body);-webkit-font-smoothing:antialiased}
svg{fill:none;stroke:currentColor;stroke-width:1.1;stroke-linecap:round;stroke-linejoin:round}
#g-chart{stroke:none}
a{color:var(--accent)}
code{font:13px var(--f-body);background:var(--pan2);padding:1px 6px;border-radius:6px;word-break:break-all}
:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
/* amber focus rings vanish on the light board and the amber card */
.paper :focus-visible,.next :focus-visible,.k:focus-visible{outline-color:var(--paper-ink)}
.disp,.page-title{font-family:var(--f-display);font-stretch:112%;font-weight:800;letter-spacing:-.01em}
.sr{position:absolute;width:1px;height:1px;margin:-1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
.skip{position:absolute;left:12px;top:-60px;z-index:50;background:var(--accent);color:var(--accent-ink);font-weight:700;padding:10px 14px;border-radius:var(--r-ctl);text-decoration:none}
.skip:focus{top:12px}

/* Shell: rail, calendar column, main */
.shell{display:grid;grid-template-columns:72px 292px minmax(0,1fr);gap:12px;padding:12px;height:100vh}
.rail{background:var(--pan);border-radius:var(--r-pan);display:flex;flex-direction:column;align-items:center;gap:4px;padding:16px 0 12px;min-height:0}
.rail .logo{display:block;width:40px;height:40px;margin-bottom:20px;flex:none}
nav.tabs{display:flex;flex-direction:column;gap:4px}
nav.tabs button,.rail-plus,.skin{position:relative;border:0;cursor:pointer}
nav.tabs button{width:44px;height:44px;border-radius:12px;background:none;color:var(--muted);display:grid;place-items:center;transition:background-color .18s var(--ease),color .18s var(--ease)}
nav.tabs button svg{width:20px;height:20px}
nav.tabs button[aria-selected="true"]{background:var(--pan2);color:var(--accent)}
@media (hover:hover){nav.tabs button:hover{color:var(--ink);background:var(--pan2)}}
/* labels show as a tooltip; they stay in the DOM as each tab's accessible name */
nav.tabs button span,[data-tip]::after{position:absolute;left:calc(100% + 10px);top:50%;transform:translateY(-50%);white-space:nowrap;background:var(--ink);color:var(--bg);font:600 13px var(--f-body);padding:5px 9px;border-radius:7px;pointer-events:none;opacity:0;transition:opacity .15s var(--ease);z-index:20}
[data-tip]::after{content:attr(data-tip)}
nav.tabs button:hover span,nav.tabs button:focus-visible span,[data-tip]:hover::after,[data-tip]:focus-visible::after{opacity:1}
.rail-sp{flex:1}
.rail-plus{width:44px;height:44px;border-radius:50%;background:var(--accent);color:var(--accent-ink);font:500 26px/1 var(--f-body);display:grid;place-items:center;margin-bottom:12px;transition:background-color .18s var(--ease),transform .15s var(--ease)}
@media (hover:hover){.rail-plus:hover{background:var(--accent-hi)}}
.rail-plus:active{transform:scale(.95)}
.skin{width:44px;height:24px;border-radius:12px;background:var(--pan2);box-shadow:inset 0 0 0 1px var(--field)}
.skin i{position:absolute;top:3px;left:3px;width:18px;height:18px;border-radius:50%;background:var(--bone);transition:left .2s var(--ease)}
:root[data-skin="lumut"] .skin i{left:23px;background:var(--ok)}
.ver{margin:10px 0 0;font-size:11.5px;color:var(--muted)}

.side{display:flex;flex-direction:column;gap:12px;min-height:0;overflow:auto;scrollbar-width:none}
.box{background:var(--pan);border-radius:var(--r-pan);padding:18px}
.box h2{font:700 15px/1.25 var(--f-body);margin:0}
.sub{color:var(--muted);font-size:13px;margin:2px 0 0}.sub b{color:var(--ink)}
.ic-btn{width:34px;height:34px;border-radius:10px;border:0;background:var(--pan2);color:var(--muted);display:grid;place-items:center;cursor:pointer;font-size:16px;flex:none;transition:color .18s var(--ease)}
.ic-btn svg{width:16px;height:16px}
@media (hover:hover){.ic-btn:hover{color:var(--ink)}}
.calw-hd{display:flex;align-items:center;gap:10px}
.calw-hd small{display:block;color:var(--muted);font-size:12.5px}
.calw-hd .ic-btn{margin-left:auto;background:none}
.calw-ic{width:38px;height:38px;border-radius:50%;background:var(--bone);color:var(--rust);display:grid;place-items:center;flex:none}
.calw-ic svg{width:17px;height:17px;stroke-width:1.3}
.pills{display:flex;gap:6px;margin:14px 0 12px}
.pills button{flex:1;padding:6px 0;border-radius:999px;border:1px solid var(--field);background:none;color:var(--muted);font:600 12.5px var(--f-body);cursor:pointer;transition:background-color .18s var(--ease),color .18s var(--ease)}
.pills button[aria-pressed="true"]{background:var(--bone);border-color:var(--bone);color:var(--paper-ink)}
.mc{display:grid;grid-template-columns:repeat(7,1fr);gap:5px;justify-items:center}
.mc .dow{font-size:11px;color:var(--muted);padding-bottom:2px}
.mc .d{width:32px;height:32px;border-radius:50%;border:0;padding:0;background:var(--bone);color:var(--paper-ink);font:700 12px/32px var(--f-body);text-align:center;cursor:pointer;font-variant-numeric:tabular-nums}
.mc .d.e{background:none;box-shadow:inset 0 0 0 1px rgba(241,230,207,.22);cursor:default}
.mc .d.video{background:var(--rust);color:#fff}.mc .d.short{background:var(--moss);color:#fff}.mc .d.post{background:var(--stone)}
.mc .d.pub{box-shadow:inset 0 0 0 2px var(--paper-ink)}
.mc .d.today{box-shadow:0 0 0 2px var(--pan),0 0 0 4px var(--accent)}
.mc .d:focus-visible{outline:2px solid var(--ink);outline-offset:3px}
.vc .loading,.topv .loading,.sum .loading{color:var(--muted);font-size:13.5px;margin:12px 0 0}
.topv li.loading{margin:0;padding-left:0}
.mc-ft{display:flex;align-items:center;justify-content:space-between;margin-top:12px;font-size:13.5px}
.mc-ft .ic-btn{background:none}
.mc-ft b{text-transform:capitalize}

.next{background:var(--accent);color:var(--accent-ink);border-radius:var(--r-pan);padding:16px 18px;position:relative;overflow:hidden;min-height:150px;flex:none}
.next .top{display:flex;justify-content:space-between;align-items:center;gap:8px;font-size:12.5px;font-weight:700}
.next .badge{background:var(--accent-ink);color:var(--accent);border-radius:999px;padding:3px 9px;font-size:11.5px;white-space:nowrap}
.next h3{font:800 19px/1.12 var(--f-display);font-stretch:112%;margin:10px 0 12px;max-width:62%;overflow-wrap:anywhere}
.next.noimg h3{max-width:none}
.next .row{display:flex;gap:6px;flex-wrap:wrap}
.next button{border:0;cursor:pointer;padding:0 12px;height:34px;border-radius:9px;font:700 13px var(--f-body)}
.next .p{background:var(--rust);color:#fff}.next .s{background:none;color:var(--accent-ink);box-shadow:inset 0 0 0 1.5px rgba(26,18,6,.35)}
.next .stk{position:absolute;right:-16px;bottom:16px;width:118px;aspect-ratio:16/9;object-fit:cover;border-radius:8px;border:3px solid var(--accent-ink);transform:rotate(-8deg);box-shadow:4px 4px 0 var(--accent-ink)}
.next p{margin:4px 0 12px;font-size:13.5px}
.stages{flex:1 0 auto}
.stages ul{list-style:none;margin:10px 0 0;padding:0}
.stages li{display:flex;align-items:center;gap:10px;padding:6px 0;font-size:13.5px;color:var(--ink)}
.stages li i{width:10px;height:10px;border-radius:3px;background:var(--c,var(--muted));flex:none}
.stages li b{margin-left:auto;font-variant-numeric:tabular-nums;color:var(--muted);font-weight:600}

.main{min-width:0;min-height:0;overflow:auto;border-radius:var(--r-pan);scrollbar-width:thin}
.topbar{position:sticky;top:0;z-index:5;display:flex;flex-wrap:wrap;gap:10px 16px;align-items:center;justify-content:space-between;background:var(--bg);padding:6px 4px 14px}
.topbar .page-title{font-size:28px;line-height:1.05;margin:0}
.meter{font-size:13.5px;color:var(--muted);margin-top:4px}.meter b{color:var(--ink);font-variant-numeric:tabular-nums}.meter .layer{display:inline;margin-right:6px}
.actions{display:flex;gap:12px;align-items:center}
.ch-name{font-size:13.5px;color:var(--muted)}
.wrap{padding:0 0 32px}
footer{margin-top:28px;color:var(--muted);font-size:13px}

/* Controls */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:40px;padding:0 16px;border:0;border-radius:var(--r-ctl);background:var(--accent);color:var(--accent-ink);font:700 14.5px var(--f-body);white-space:nowrap;cursor:pointer;align-self:start;text-decoration:none;transition:background-color .18s var(--ease),color .18s var(--ease),transform .15s var(--ease)}
@media (hover:hover){.btn:hover{background:var(--accent-hi)}}
.btn:active{transform:scale(.97)}
.btn[disabled]{opacity:.55;cursor:progress}
.btn.ghost{background:var(--pan2);color:var(--ink);font-weight:600;box-shadow:inset 0 0 0 1px var(--line)}
@media (hover:hover){.btn.ghost:hover{background:color-mix(in srgb,var(--pan2) 70%,var(--ink) 12%)}}
.btn.ghost.danger{color:var(--warn)}
.btn.icon{width:40px;padding:0;font-size:18px}
label{display:grid;gap:5px;font-weight:600;font-size:14px}
input,select,textarea{font:500 15px var(--f-body);color:var(--ink);background:var(--pan2);border:1px solid var(--line);border-radius:var(--r-ctl);padding:9px 12px;min-height:42px;width:100%;transition:border-color .18s var(--ease)}
input:focus,select:focus,textarea:focus{border-color:var(--field)}
textarea{min-height:84px;resize:vertical}
input[type="checkbox"]{width:18px;height:18px;min-height:0;accent-color:var(--accent)}
.row2{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.chips{display:flex;flex-wrap:wrap;gap:6px;align-items:center}
.chip{background:var(--pan2);border-radius:7px;padding:3px 9px;font-size:13px;font-variant-numeric:tabular-nums}
.status{font-size:14px;color:var(--muted);min-height:1.2em}
.status.err{color:var(--warn)}
.note{font-size:13.5px;color:var(--muted)}
.layer{display:block;font:600 12.5px var(--f-body);color:var(--muted)}
.ok,.good{color:var(--ok)}.no,.flag{color:var(--warn)}.good,.flag{font-weight:700}

/* Tool pages */
.panel{display:grid;grid-template-columns:minmax(0,340px) minmax(0,1fr);gap:12px;align-items:start}
.grid2{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,320px),1fr));gap:12px;align-items:start}
.grid3{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr));gap:12px;align-items:start}
form.tool{display:grid;gap:14px;align-content:start;background:var(--pan);border-radius:var(--r-pan);padding:20px}
form.tool h2{font:800 20px/1.15 var(--f-display);font-stretch:112%;margin:0}
form.tool p.hint{margin:0;color:var(--muted);font-size:14px}
.out{display:grid;gap:12px;min-width:0}
.out-head{display:flex;flex-wrap:wrap;gap:8px;align-items:center;justify-content:space-between}
.card{background:var(--pan);border-radius:var(--r-pan);padding:18px 20px;min-width:0}
.card .card{background:var(--pan2);border-radius:var(--r-card)}
.card h3{font:700 17px/1.25 var(--f-body);margin:0 0 6px}
.card p{margin:6px 0}
.empty{border:1.5px dashed var(--field);border-radius:var(--r-pan);padding:22px;color:var(--muted);max-width:60ch}
.grp{display:grid;gap:12px;padding:14px;border-radius:var(--r-card);background:var(--bg)}
.grp input,.grp select{background:var(--pan)}
.steps{padding-left:20px;margin:6px 0 10px}.steps li{margin:6px 0}
.confirm{display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin-top:12px}
.banner{display:flex;flex-wrap:wrap;gap:8px 12px;align-items:center;background:var(--pan);border-radius:var(--r-pan);padding:12px 16px;margin-bottom:12px;font-size:14.5px}
.meta{font-size:12.5px;color:var(--muted);display:flex;flex-wrap:wrap;gap:6px 14px}
.tag-example{font-size:11.5px;font-weight:700;background:var(--pan2);color:var(--muted);padding:3px 8px;border-radius:6px}
.ideas{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:12px}
.date{font-weight:700;font-size:13px;color:var(--accent)}
.act{display:grid;grid-template-columns:64px minmax(0,1fr);gap:14px;border-top:1px solid var(--line);padding-top:14px}
.act:first-of-type{border-top:0;padding-top:0}
.act .num{font:800 26px/1 var(--f-display);color:var(--accent)}
.act .num small{display:block;font:500 12px var(--f-body);color:var(--muted);margin-top:6px}
.act ul{margin:6px 0;padding-left:18px}
.strata{display:flex;height:12px;border-radius:6px;overflow:hidden;margin:4px 0 12px}.strata span{display:block}
.copybox{position:relative}
.copybox pre{white-space:pre-wrap;word-break:break-word;font:15px/1.6 var(--f-body);background:var(--bg);border-radius:var(--r-ctl);padding:14px 16px;margin:8px 0 0;max-height:420px;overflow:auto}
.copybox .btn.ghost{position:absolute;top:-48px;right:0}
.titles li{margin:6px 0}.titles .len{font-size:12px;color:var(--muted);margin-left:6px}
.thumbs{display:grid;grid-template-columns:repeat(auto-fill,minmax(270px,1fr));gap:12px}
.thumb-text{font:800 26px/1 var(--f-display);font-stretch:112%;text-transform:uppercase;background:var(--bone);color:var(--paper-ink);padding:14px;border-radius:var(--r-ctl);aspect-ratio:16/9;display:flex;align-items:flex-end}
.check{padding:0;margin:0}
.check li{list-style:none;display:grid;grid-template-columns:22px minmax(0,1fr);gap:8px;padding:9px 0;border-top:1px solid var(--line)}
.check input{margin-top:3px}
.check small{color:var(--muted);display:block}
.big{font:800 32px/1 var(--f-display);font-variant-numeric:tabular-nums}
.kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px;margin-top:10px}
.kpis div{padding-top:8px;border-top:1px solid var(--line)}
.kpis b{display:block;font:800 24px/1.15 var(--f-display);font-stretch:108%;font-variant-numeric:tabular-nums}
.kpis span{font-size:13px;color:var(--muted)}
table{border-collapse:collapse;width:100%;font-size:14px;font-variant-numeric:tabular-nums}
th,td{text-align:right;padding:7px 8px;border-bottom:1px solid var(--line);white-space:nowrap}
th:first-child,td:first-child{text-align:left;white-space:normal}
.vt td:first-child{min-width:240px}
.vt th{cursor:pointer;user-select:none;font-weight:700}
@media (hover:hover){.vt th:hover{color:var(--accent)}}
.chart-wrap{position:relative;overflow-x:auto;margin-top:14px}
.tip{position:absolute;pointer-events:none;background:var(--ink);color:var(--bg);font:13px/1.35 var(--f-body);padding:6px 9px;border-radius:7px;white-space:nowrap;transform:translate(-50%,-110%)}
details.mtable{margin-top:10px}details.mtable summary,#yt-setup summary{cursor:pointer;font-size:14px;color:var(--muted);min-height:40px;display:flex;align-items:center}
#yt-setup summary{font-weight:700;color:var(--ink)}
.ages{display:grid;gap:6px;margin:10px 0}
.ab{display:grid;grid-template-columns:48px minmax(0,1fr) 48px;gap:8px;align-items:center;font-size:13px;font-variant-numeric:tabular-nums}
.ab b{text-align:right;font-weight:600}
.abar{height:10px;background:var(--pan2);border-radius:5px;overflow:hidden}.abar i{display:block;height:100%;background:var(--accent)}
.qbar{height:8px;border-radius:4px;background:var(--pan2);overflow:hidden;margin:4px 0 6px}.qbar span{display:block;height:100%;background:var(--accent)}
.bar{height:8px;background:var(--pan2);border-radius:4px;overflow:hidden;margin-top:6px;min-width:180px}.bar i{display:block;height:100%;background:var(--accent)}
.diag{padding-left:18px;margin:12px 0 0}.diag li{margin:8px 0}
.up{list-style:none;padding:0;margin:8px 0 0}
.linkish{border:0;background:none;color:var(--ink);font:600 15px var(--f-body);text-align:left;cursor:pointer;padding:6px 0}
@media (hover:hover){.linkish:hover{color:var(--accent);text-decoration:underline}}

/* Dashboard: light planning board */
.paper{--ink:#1A1612;--muted:#6B6357;--line:#E2DACB;--field:#CBC1AF;--pan2:#EBE4D6;--chip:#EBE4D6;--bg:#EFE9DD;--surface:#F5F0E6;
  background:var(--paper);color:var(--ink);border-radius:var(--r-pan);padding:20px 22px 14px;color-scheme:light}
.paper .btn.ghost{background:#fff;box-shadow:inset 0 0 0 1px var(--line)}
@media (hover:hover){.paper .btn.ghost:hover{background:var(--pan2)}}
.pp-head{display:flex;flex-wrap:wrap;align-items:center;gap:12px 14px}
.pp-head h2{font-size:26px;margin:0}
.seg{display:flex;background:var(--pan2);border-radius:999px;padding:3px}
.seg button{border:0;background:none;padding:6px 14px;border-radius:999px;font:600 13px var(--f-body);color:var(--muted);cursor:pointer;transition:background-color .18s var(--ease),color .18s var(--ease)}
.seg button[aria-pressed="true"]{background:var(--paper-ink);color:var(--paper)}
.pp-nav{margin-left:auto;display:flex;gap:6px}
.pp-row{display:flex;align-items:center;gap:10px;margin:14px 0 4px}
.search{display:flex;align-items:center;gap:8px;flex:0 1 340px;background:var(--pan2);border-radius:var(--r-ctl);padding:0 12px;color:var(--muted)}
.search svg{width:15px;height:15px;flex:none}
.search input{border:0;background:none;padding:0;min-height:40px;color:var(--ink)}
.search input:focus{outline:none}.search:focus-within{box-shadow:0 0 0 2px var(--accent)}
.pp-row .btn{margin-left:auto}
.pp-note{margin:10px 0 0;font-size:12.5px;color:var(--muted)}
.wk{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:10px}
.wk .day{display:flex;flex-direction:column;gap:8px;min-width:0;padding-top:10px}
.wk .dh{display:flex;align-items:baseline;gap:5px;padding:4px 2px 10px;border-bottom:1px solid var(--line);font-size:12.5px;color:var(--muted)}
.wk .dh b{font-size:18px;color:var(--ink);font-variant-numeric:tabular-nums}
.wk .day.today .dh b{color:#fff;background:var(--rust);border-radius:8px;padding:0 6px}
.wk .add{border:1.5px dashed var(--field);background:none;border-radius:var(--r-card);height:56px;color:var(--muted);font:600 13px var(--f-body);cursor:pointer;transition:border-color .18s var(--ease),color .18s var(--ease)}
@media (hover:hover){.wk .add:hover{border-color:var(--moss);color:var(--moss)}}
.k{display:block;width:100%;text-align:left;border:0;padding:0;border-radius:var(--r-card);overflow:hidden;font:500 12px/1.35 var(--f-body);cursor:pointer;transition:transform .15s var(--ease)}
@media (hover:hover){button.k:hover{transform:translateY(-2px)}}
.k img{display:block;width:100%;aspect-ratio:16/9;object-fit:cover}
.k .in{display:block;padding:11px 12px 12px}
.k .lb{display:block;font-size:11px}
.k .tt{display:block;font-weight:700;font-size:14px;line-height:1.18;margin:3px 0 8px;overflow-wrap:anywhere}
.k .pg{display:block;height:5px;border-radius:3px;background:rgba(0,0,0,.18)}.k .pg i{display:block;height:100%;border-radius:3px;background:currentColor}
.k .ft{display:block;font-size:11px;margin-top:6px}
.k.video{background:var(--rust);color:#fff}
.k.short{background:var(--moss);color:#fff}
.k.post{background:var(--stone);color:var(--paper-ink)}
.k.ide{background:var(--accent);color:var(--accent-ink)}
.k.tayang{opacity:.6}
.k.pub{background:var(--pub);color:#F4ECDD;cursor:default}
.paper .cal-legend{display:flex;flex-wrap:wrap;gap:6px 14px;font-size:12.5px;color:var(--muted);margin:12px 0 8px}
.cl::before{content:"";display:inline-block;width:10px;height:10px;border-radius:3px;margin-right:6px;vertical-align:-1px;background:var(--c,var(--paper-ink))}
.cl.video,.ev.video{--c:var(--rust)}.cl.short,.ev.short{--c:var(--moss)}.cl.post,.ev.post{--c:var(--stone-dot)}
.cal{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));border-top:1px solid var(--line)}
.cal-dow{font:700 11.5px var(--f-body);letter-spacing:.04em;text-transform:uppercase;color:var(--muted);text-align:center;padding:8px 4px;border-bottom:1px solid var(--line)}
.cal-day{min-height:88px;border-right:1px solid var(--line);border-bottom:1px solid var(--line);padding:6px;display:flex;flex-direction:column;gap:3px;min-width:0}
.cal-day:nth-child(7n){border-right:0}
.cal-day.off{background:var(--bg)}
.cal-num{align-self:flex-start;border:0;background:none;color:var(--ink);font:600 13px var(--f-body);min-width:28px;min-height:28px;border-radius:14px;cursor:pointer;font-variant-numeric:tabular-nums}
@media (hover:hover){.cal-num:hover{background:var(--pan2)}}
.cal-day.today .cal-num{background:var(--rust);color:#fff}
.ev{display:block;width:100%;text-align:left;font:600 12px/1.25 var(--f-body);color:#fff;background:var(--c,var(--pub));border:0;border-radius:7px;padding:4px 7px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.ev.post{color:var(--paper-ink);background:var(--stone)}
button.ev{cursor:pointer}
.ev i{font-style:normal;font-weight:500;opacity:.8;margin-right:5px}
.ev.pub{background:var(--pub);color:#F4ECDD}
.ev.done{opacity:.6}

.bot{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,1fr) minmax(190px,.62fr);gap:12px;margin-top:12px}
.bot>.box{min-width:0}
.bx-hd{display:flex;justify-content:space-between;align-items:flex-start;gap:10px}
.vc{display:grid;grid-template-columns:30px 1fr;height:190px;margin-top:14px}
.vc .ax{display:flex;flex-direction:column;justify-content:space-between;font-size:10.5px;color:var(--muted);padding-bottom:24px;font-variant-numeric:tabular-nums}
.vc .bars{display:grid;grid-template-columns:repeat(7,1fr);gap:10px;padding-bottom:24px;position:relative;background:repeating-linear-gradient(to bottom,transparent 0 calc(25% - 1px),var(--line) calc(25% - 1px) 25%)}
.vc .b{position:relative;display:flex;align-items:flex-end;border:0;background:none;padding:0;cursor:default}
.vc .g,.vc .f{position:absolute;bottom:0;left:0;right:0;border-radius:8px 8px 3px 3px}
.vc .g{background:var(--pan2)}
.vc .f{background:color-mix(in srgb,var(--pan2) 55%,var(--ink) 18%)}
/* striped highlight bar is from Sigit's reference design (kept on his decision, audit item 10) */
.vc .b.on .f{background:repeating-linear-gradient(135deg,var(--accent) 0 7px,var(--accent-lo) 7px 14px)}
.vc .lbl{position:absolute;bottom:-22px;left:0;right:0;text-align:center;font-size:11.5px;color:var(--muted)}
.vc .b.on .lbl{color:var(--ink);font-weight:700}
.vc .tp{position:absolute;z-index:3;background:color-mix(in srgb,var(--pan2) 92%,#000);box-shadow:inset 0 0 0 1px var(--field);border-radius:10px;padding:8px 11px;width:172px;font-size:12px;pointer-events:none}
.vc .tp p{display:flex;align-items:center;gap:7px;margin:1px 0;color:var(--muted)}.vc .tp p b,.vc .tp p span{color:var(--ink)}.vc .tp p span{margin-left:auto;font-variant-numeric:tabular-nums}
.vc .sq{width:9px;height:9px;border-radius:2px;display:inline-block;flex:none}.vc .sq.a{background:var(--accent)}.vc .sq.c{background:var(--pan2);box-shadow:inset 0 0 0 1px var(--muted)}
.topv ul{list-style:none;margin:12px 0 0;padding:0}
.topv li{display:flex;align-items:center;gap:10px;padding:8px 10px;border-radius:10px;font-size:13.5px}
.topv li:first-child{background:var(--pan2)}
.topv .pl{width:24px;height:24px;border-radius:7px;background:var(--rust);display:grid;place-items:center;flex:none}
.topv .pl svg{width:10px;height:10px;fill:#fff;stroke:none}
.topv .t{flex:1;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.topv .v{color:var(--muted);font-size:12.5px;font-variant-numeric:tabular-nums}
.topv .c{font-size:11.5px;font-weight:700;background:color-mix(in srgb,var(--accent) 16%,transparent);color:var(--accent);border-radius:6px;padding:2px 6px;font-variant-numeric:tabular-nums}
.sum .st{padding:10px 0;border-bottom:1px solid var(--line)}.sum .st:last-child{border:0;padding-bottom:0}
.sum .st span{font-size:12.5px;color:var(--muted)}
.sum .st b{display:block;font:800 21px/1.2 var(--f-display);font-stretch:110%;margin-top:2px;font-variant-numeric:tabular-nums;white-space:nowrap}
.sum .st em{font:700 12px var(--f-body);font-style:normal;margin-left:6px}
.sum .st em.dn{color:var(--warn)}.sum .st em.upc{color:var(--ok)}
.empty-s{color:var(--muted);font-size:13.5px;margin:12px 0 0}

dialog{border:0;border-radius:var(--r-pan);padding:0;background:var(--pan);color:var(--ink);width:min(540px,calc(100vw - 32px))}
dialog::backdrop{background:rgba(8,7,6,.6)}
.pl-thumb{display:flex;gap:12px;align-items:center}
.pl-thumb #pl-thumb-box:empty{display:none}
.pl-thumb img{display:block;width:128px;aspect-ratio:16/9;object-fit:cover;border-radius:8px}
.pl-thumb .lbl{display:block;font-weight:600;font-size:14px;margin-bottom:6px}

/* 2.0 growth loop. The calendar column only belongs to the Kalender page; the other pages get the full width. */
.shell:not([data-tab="dash"]){grid-template-columns:72px minmax(0,1fr)}
.shell:not([data-tab="dash"]) .side{display:none}
.stack{display:grid;gap:12px;align-content:start}
.stack>*,#p-today>*,#p-learn>*,#p-ideas>*,#p-make>*{min-width:0}
#p-today,#p-learn,#p-ideas,#p-make{display:grid;gap:12px;align-content:start}
#p-today[hidden],#p-learn[hidden],#p-ideas[hidden],#p-make[hidden]{display:none}
.muted{color:var(--muted)}
.num{font-variant-numeric:tabular-nums}
.pill{display:inline-flex;align-items:center;border-radius:999px;padding:3px 10px;font:700 12px/1.4 var(--f-body);background:var(--pan2);color:var(--muted);white-space:nowrap}
.pill.bad{color:var(--warn);background:color-mix(in srgb,var(--warn) 14%,var(--pan))}
.pill.good{color:var(--ok);background:color-mix(in srgb,var(--ok) 14%,var(--pan))}

/* Today: diagnosis on paper, the one card that should be read first */
.dx{background:var(--paper);color:var(--paper-ink);border-radius:var(--r-pan);padding:26px 28px;display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,1fr);gap:22px 32px;color-scheme:light}
.dx :focus-visible{outline-color:var(--paper-ink)}
.dx .eyebrow{font:700 12.5px var(--f-body);letter-spacing:.06em;text-transform:uppercase;color:#9A3A17}
.dx h2{font-size:clamp(26px,3.2vw,38px);line-height:1.05;margin:8px 0 12px}
.dx p{margin:0 0 12px;max-width:62ch;color:#3A342C}
.dx p b{color:var(--paper-ink)}
.dx .btn{background:var(--paper-ink);color:var(--paper)}
@media (hover:hover){.dx .btn:hover{background:#3A342C}}
.dx .btn.ghost{background:#E8E0D0;color:var(--paper-ink);box-shadow:none}
@media (hover:hover){.dx .btn.ghost:hover{background:#DDD3C0}}
.cmpb{display:grid;gap:10px;align-content:center}
.cmpb .lbl{font-size:13px;color:#5E574B;display:flex;justify-content:space-between;gap:10px}
.cmpb .lbl b{color:var(--paper-ink);font-variant-numeric:tabular-nums}
.cmpb .track{height:30px;border-radius:8px;background:#E8E0D0;position:relative;overflow:hidden}
.cmpb .fill{position:absolute;inset:0 auto 0 0;border-radius:8px;display:flex;align-items:center;padding:0 10px;font-weight:700;font-size:13px;white-space:nowrap;color:#fff}
.cmpb .fill.win{background:var(--moss)}.cmpb .fill.now{background:var(--rust)}
.cmpb small{color:#5E574B;font-size:12.5px}
.vitals{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}
.vital{display:grid;gap:6px;align-content:start}
.vital .vhd{display:flex;justify-content:space-between;align-items:center;gap:8px}
.vital .k{font-size:13px;color:var(--muted)}
.vital .v{font:800 32px/1 var(--f-display);font-stretch:110%;font-variant-numeric:tabular-nums}
.vital .v em{font:600 13px var(--f-body);font-style:normal;color:var(--muted);margin-left:6px}
.vital .spk{width:100%;height:46px;display:block}
.vital .foot{display:flex;justify-content:space-between;gap:8px;font-size:12px;color:var(--muted)}
.td2{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(0,1fr);gap:12px;align-items:start}
.moves{list-style:none;margin:14px 0 0;padding:0;display:grid;gap:8px}
.moves li{display:grid;grid-template-columns:22px minmax(0,1fr) auto;gap:12px;align-items:start;background:var(--pan2);border-radius:var(--r-card);padding:12px 14px}
.moves input{margin:2px 0 0}
.moves .mv-t{display:block;font-weight:700;font-size:15px;cursor:pointer}
.moves span{color:var(--muted);font-size:13.5px}
.moves .linkish{font-size:13.5px;color:var(--accent);padding:4px 0 0;display:block}
.moves li.done .mv-t{text-decoration:line-through;color:var(--muted)}
.grade{display:grid;gap:8px;margin-top:12px}
.gr{display:flex;flex-wrap:wrap;gap:6px 10px;align-items:center;justify-content:space-between;background:var(--pan2);border-radius:12px;padding:10px 12px;font-size:14px}
.pipe{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:10px;margin-top:14px}
.pipe .st{display:grid;gap:6px;align-content:start;min-width:0}
.pipe h3{font:700 12px var(--f-body);letter-spacing:.05em;text-transform:uppercase;color:var(--muted);margin:0 0 2px;display:flex;justify-content:space-between}
.pipe h3 b{font-weight:600}
.pcard{border:0;text-align:left;cursor:pointer;border-radius:12px;padding:10px 11px;background:var(--pan2);color:var(--ink);font:500 13px/1.3 var(--f-body);display:grid;gap:4px;transition:transform .15s var(--ease)}
@media (hover:hover){.pcard:hover{transform:translateY(-2px)}}
.pcard b{font-weight:700;overflow-wrap:anywhere}.pcard small{color:var(--muted)}
.pcard.hot{background:var(--accent);color:var(--accent-ink)}.pcard.hot small{color:#5B3A06}
.pcard.hot:focus-visible{outline-color:var(--ink)}
.pempty{font-size:12.5px;color:var(--muted);border:1.5px dashed var(--field);border-radius:12px;padding:10px 11px}

/* Learn */
.rchart{position:relative;margin-top:12px}
.rchart svg{width:100%;height:auto;display:block;overflow:visible}
.rchart .hit:focus-visible{outline:none;stroke:var(--accent);stroke-width:2}
.ctip{position:absolute;top:-8px;pointer-events:none;background:var(--paper);color:var(--paper-ink);border-radius:10px;padding:8px 10px;font-size:12.5px;width:250px;max-width:100%;box-shadow:0 6px 20px rgba(0,0,0,.35)}
.ctip b{display:block}
.lgd{display:flex;flex-wrap:wrap;gap:6px 16px;font-size:12.5px;color:var(--muted);margin-top:10px}
.lgd i{display:inline-block;width:10px;height:10px;border-radius:3px;margin-right:6px;vertical-align:-1px}
.tblw{overflow-x:auto;margin-top:12px}
.rc{min-width:760px}
.rc th{font-size:12px;color:var(--muted);letter-spacing:.04em;text-transform:uppercase}
.rc th,.rc td{text-align:left;vertical-align:top;padding:10px}
.rc td:first-child{min-width:220px}
.rc td:last-child{white-space:normal;min-width:260px;color:var(--muted)}

/* Ideas */
.pattern{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;margin-top:14px}
.pattern div{background:var(--pan2);border-radius:var(--r-card);padding:12px 14px}
.pattern b{display:block;font:800 22px/1.1 var(--f-display);font-stretch:110%;font-variant-numeric:tabular-nums}
.pattern span{font-size:13px;color:var(--muted)}
.idea-list{display:grid;gap:10px}
.idea2{display:grid;grid-template-columns:56px minmax(0,1fr) auto;gap:14px;align-items:start;background:var(--pan);border-radius:var(--r-pan);padding:16px}
.idea2 h3{font:700 16px/1.25 var(--f-body);margin:0}
.idea-act{display:grid;gap:6px}
.fit{width:56px;height:56px;border-radius:50%;display:grid;place-items:center;font:800 18px var(--f-display);background:conic-gradient(var(--accent) calc(var(--p)*1%),var(--pan2) 0)}
.fit span{width:44px;height:44px;border-radius:50%;background:var(--pan);display:grid;place-items:center}
.tags{display:flex;flex-wrap:wrap;gap:6px;margin-top:8px}
.tag{font-size:12px;border-radius:6px;padding:2px 7px;background:var(--pan2);color:var(--muted)}
.tag.y{color:var(--ok)}
.tag.n{color:var(--muted);text-decoration:line-through}

/* Make */
.mk-head{display:grid;gap:14px}
.mk-auto{display:flex;flex-wrap:wrap;gap:12px 20px;align-items:center;justify-content:space-between;background:var(--pan2);border-radius:var(--r-card);padding:14px 16px;box-shadow:inset 3px 0 0 var(--accent)}
.mk-auto>div:first-child{min-width:0;flex:1 1 320px}
.mk-auto b{display:block;font-size:16px;overflow-wrap:anywhere}.mk-auto span{color:var(--muted);font-size:13.5px}
.mk-head>.status:empty{display:none}
.mk-pick{display:grid;grid-template-columns:minmax(0,1.4fr) minmax(0,1fr);gap:10px}
.mk-stages{display:flex;flex-wrap:wrap;gap:6px}
.mk-stages button{border:1px solid var(--field);background:none;border-radius:999px;padding:0 15px;height:38px;font:600 14px var(--f-body);cursor:pointer;color:var(--muted);transition:background-color .18s var(--ease),color .18s var(--ease)}
@media (hover:hover){.mk-stages button:hover{color:var(--ink)}}
.mk-stages button[aria-selected="true"]{background:var(--ink);border-color:var(--ink);color:var(--bg)}
.tlist{display:grid;gap:8px;margin-top:12px}
.trow{display:grid;grid-template-columns:18px minmax(0,1fr) auto;gap:10px;align-items:center;background:var(--pan2);border-radius:12px;padding:10px 12px;cursor:pointer;font-weight:500}
.trow input{width:16px;height:16px;min-height:0;margin:0;accent-color:var(--accent)}
.trow .t{font-weight:600;overflow-wrap:anywhere}.trow small{display:block;font-weight:500;font-size:12px;color:var(--muted)}
.checks{display:flex;flex-wrap:wrap;gap:4px;justify-content:flex-end}
.checks i{font-style:normal;font-size:11.5px;font-weight:700;border-radius:5px;padding:1px 6px;background:var(--pan);color:var(--muted)}
.checks i.y{color:var(--ok)}
.mk-thumb{aspect-ratio:16/9;max-width:100%;border-radius:12px;background:radial-gradient(120% 90% at 70% 60%,#5A4A36 0%,#2A231B 55%,#14110D 100%);position:relative;overflow:hidden;margin:12px 0 8px}
.mk-thumb span{position:absolute;left:6%;top:10%;right:30%;font:800 clamp(22px,3vw,38px)/.98 var(--f-display);font-stretch:118%;color:#fff;text-transform:uppercase;overflow-wrap:anywhere}
.mk-thumb.ph span{color:rgba(255,255,255,.4)}
.rules{list-style:none;padding:0;margin:12px 0 0;display:grid;gap:8px;font-size:14px}
.rules li{display:grid;grid-template-columns:22px minmax(0,1fr);gap:8px}
.rules .y{color:var(--ok);font-weight:800}.rules .n{color:var(--warn);font-weight:800}.rules .u{color:var(--muted);font-weight:800}
.check label{display:block;font-weight:600;cursor:pointer}

/* Narrow windows */
@media (max-width:1180px){
  .shell{grid-template-columns:72px minmax(0,1fr)}
  .side{display:none}
  .bot{grid-template-columns:1fr 1fr}.bot .sum{grid-column:1/-1}
}
@media (max-width:980px){
  .dx,.td2{grid-template-columns:minmax(0,1fr)}
  .pipe{grid-template-columns:repeat(3,minmax(0,1fr))}
  .pattern,.vitals{grid-template-columns:repeat(2,minmax(0,1fr))}
}
@media (max-width:820px){
  .panel{grid-template-columns:minmax(0,1fr)}
  .mk-pick{grid-template-columns:minmax(0,1fr)}
  .idea2{grid-template-columns:48px minmax(0,1fr)}.idea-act{grid-column:1/-1;grid-template-columns:repeat(auto-fit,minmax(160px,1fr))}
  .fit{width:48px;height:48px}.fit span{width:38px;height:38px}
  .wk{grid-template-columns:repeat(2,minmax(0,1fr))}
  .bot{grid-template-columns:1fr}
}
@media (max-width:560px){
  .shell,.shell:not([data-tab="dash"]){grid-template-columns:minmax(0,1fr);grid-template-rows:auto minmax(0,1fr);height:auto;min-height:100vh}
  .vitals,.pipe{grid-template-columns:minmax(0,1fr)}
  .dx{padding:20px}
  .rail{flex-direction:row;padding:8px;overflow-x:auto}.rail .logo{margin:0 8px 0 0}nav.tabs{flex-direction:row}
  .rail-sp,.ver,.skin{display:none}.rail-plus{margin:0 0 0 8px}
  nav.tabs button span,[data-tip]::after{display:none}
  .main{overflow:visible}
  .row2{grid-template-columns:1fr}
}
@media (prefers-reduced-motion:reduce){*{transition:none!important}}
</style>
