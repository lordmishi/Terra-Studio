<a class="skip" href="#main">Skip to content</a>
<div class="shell">
  <aside class="rail">
    <h1 class="sr">Terra Studio</h1>
    <div class="rail-hd">
      <img class="logo" src="/logo.png" width="36" height="36" alt="">
      <b class="rail-name" aria-hidden="true">Terra Studio</b>
      <button type="button" class="nav-tog" id="nav-tog" aria-label="Close menu" title="Close menu (Ctrl+B)"><svg viewBox="0 0 14 14" aria-hidden="true"><rect x=".75" y="1.5" width="12.5" height="11" rx="2"/><path d="M5 1.5v11"/><path id="nav-tog-arrow" d="m10 5.25-1.75 1.75L10 8.75"/></svg></button>
    </div>
    <nav class="tabs" role="tablist" aria-label="Menu" aria-orientation="vertical">
      <button role="tab" id="t-today" aria-selected="true" data-tab="today"><svg viewBox="0 0 14 14" aria-hidden="true"><path d="M12 9.5a1 1 0 0 1 1 1V12a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1v-1.5a1 1 0 0 1 1-1z"/><path d="M7 1a1 1 0 0 1 1 1v4.5a1 1 0 0 1-1 1H1.932a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1z"/><path d="M12.469 1a.5.5 0 0 1 .5.5v1.25a.5.5 0 0 1-.5.5H10.5a.5.5 0 0 1-.5-.5V1.5a.5.5 0 0 1 .5-.5z"/><path d="M12.469 5.25a.5.5 0 0 1 .5.5V7a.5.5 0 0 1-.5.5H10.5A.5.5 0 0 1 10 7V5.75a.5.5 0 0 1 .5-.5z"/></svg><span>Dashboard</span></button>
      <button role="tab" id="t-ideas" aria-selected="false" data-tab="ideas"><svg viewBox="0 0 14 14" aria-hidden="true"><path d="M11.5 5.031a4.5 4.5 0 1 0-6.5 4v1.5a.5.5 0 0 0 .5.5h3a.5.5 0 0 0 .5-.5v-1.5a4.48 4.48 0 0 0 2.5-4"/><path d="M5 13.5h4"/></svg><span>Ideas</span></button>
      <button role="tab" id="t-make" aria-selected="false" data-tab="make"><svg viewBox="0 0 14 14" aria-hidden="true"><path d="M10 3.5v8a2 2 0 0 1-2 2H.5a2 2 0 0 0 2-2v-9a2 2 0 0 1 2-2h7.25"/><path d="M11.75.5a1.75 1.75 0 0 1 1.75 1.75V3a.5.5 0 0 1-.5.5h-3V2.25A1.75 1.75 0 0 1 11.75.5"/><path d="M6 4h1.5"/><path d="M5 7h2.5"/><path d="M5 10h2.5"/></svg><span>Make video</span></button>
      <button role="tab" id="t-learn" aria-selected="false" data-tab="learn"><svg viewBox="0 0 14 14" aria-hidden="true"><path d="M.5 13.5h13"/><path d="m1.5 10 3.5-4 3 2.5 4.5-6.5"/><path d="M10.5 2h2v2"/></svg><span>Learn</span></button>
      <button role="tab" id="t-dash" aria-selected="false" data-tab="dash"><svg viewBox="0 0 14 14" aria-hidden="true"><path d="M1.5 2.5h11a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1h-11a1 1 0 0 1-1-1v-9a1 1 0 0 1 1-1zM.5 6h13M4 .5v3M10 .5v3"/></svg><span>Calendar</span></button>
      <button role="tab" id="t-growth" aria-selected="false" data-tab="growth"><svg viewBox="0 0 14 14" aria-hidden="true"><path d="m1.24 6.54 11.5-5.23"/><path d="m10.59.5 2.15.81-.8 2.15"/><path d="M13.25 13.5h-2.5v-7a.5.5 0 0 1 .5-.5h1.5a.5.5 0 0 1 .5.5z"/><path d="M8.25 13.5h-2.5V8a.5.5 0 0 1 .5-.5h1.5a.5.5 0 0 1 .5.5z"/><path d="M3.25 13.5H.75v-4a.5.5 0 0 1 .5-.5h1.5a.5.5 0 0 1 .5.5z"/></svg><span>Data &amp; money</span></button>
      <button role="tab" id="t-settings" aria-selected="false" data-tab="settings"><svg viewBox="0 0 14 14" aria-hidden="true"><path d="m5.23 2.25.43-1.11A1 1 0 0 1 6.59.5h.82a1 1 0 0 1 .93.64l.43 1.11 1.46.84 1.18-.18a1 1 0 0 1 1 .49l.4.7a1 1 0 0 1-.08 1.13l-.73.93v1.68l.75.93a1 1 0 0 1 .08 1.13l-.4.7a1 1 0 0 1-1 .49l-1.18-.18-1.46.84-.43 1.11a1 1 0 0 1-.93.64h-.84a1 1 0 0 1-.93-.64l-.43-1.11-1.46-.84-1.18.18a1 1 0 0 1-1-.49l-.4-.7a1 1 0 0 1 .08-1.13L2 7.84V6.16l-.75-.93a1 1 0 0 1-.08-1.13l.4-.7a1 1 0 0 1 1-.49l1.18.18zM5 7a2 2 0 1 0 4 0 2 2 0 0 0-4 0"/></svg><span>Settings</span></button>
    </nav>
    <div class="rail-sp"></div>
    <button type="button" class="rail-plus" id="rail-plus" aria-label="New content plan" data-tip="New plan"><i aria-hidden="true">+</i><span>New plan</span></button>
    <button type="button" class="skin" id="skin-tog" aria-label="Change theme" data-tip="Theme: stone / moss"><u><i></i></u><span id="skin-name">Stone theme</span></button>
    <p class="ver">v2.3.0</p>
  </aside>
  <aside class="side" aria-label="Calendar and schedule">
    <div class="box calw">
      <div class="calw-hd"><span class="calw-ic"><svg viewBox="0 0 14 14" aria-hidden="true"><path d="M1.5 2.5h11a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1h-11a1 1 0 0 1-1-1v-9a1 1 0 0 1 1-1zM.5 6h13M4 .5v3M10 .5v3"/></svg></span><div><h2>Upload calendar</h2><small id="mc-sub">Plans and published videos</small></div><button type="button" class="ic-btn" data-goto="dash" id="mc-open" aria-label="Open the month calendar"><svg viewBox="0 0 14 14" aria-hidden="true"><path d="M4 10 10 4M5 4h5v5"/></svg></button></div>
      <div class="pills" role="group" aria-label="Content type" id="mc-pills"><button type="button" aria-pressed="true" data-f="all">All</button><button type="button" aria-pressed="false" data-f="video">Video</button><button type="button" aria-pressed="false" data-f="short">Shorts</button><button type="button" aria-pressed="false" data-f="post">Post</button></div>
      <div class="mc" id="mc" role="group" aria-label="This month's calendar, use the arrow keys to move between dates"></div>
      <div class="mc-ft"><button type="button" class="ic-btn" id="mc-prev" aria-label="Previous month">&larr;</button><b id="mc-title"></b><button type="button" class="ic-btn" id="mc-next" aria-label="Next month">&rarr;</button></div>
    </div>
    <div class="next" id="next-up"></div>
    <div class="box stages"><h2>Production status</h2><ul id="stages"></ul></div>
  </aside>
  <main class="main" id="main">
    <header class="topbar">
      <div><h2 id="page-title" class="page-title">Dashboard</h2><div class="meter" id="meter"></div><div class="meter" id="today-sub"></div></div>
      <div class="actions"><span class="ch-name" id="hdr-channel"></span><button type="button" class="btn ghost" data-goto="growth">Update Studio data</button></div>
    </header>
<div class="wrap">
  <div class="banner" id="banner-key" hidden>
    <span><strong>Copy-paste mode to claude.ai.</strong> To get AI results straight in the app at no cost, choose Gemini in Settings and paste a free API key from Google.</span> <button type="button" class="btn ghost" data-goto="settings">Open Settings</button><button type="button" class="btn ghost" id="banner-close">Close</button>
  </div>

  <!-- DASHBOARD: the numbers, the next video and the one thing to fix -->
  <section id="p-today" role="tabpanel" aria-labelledby="t-today">
    <div id="td-empty" class="card" hidden>
      <span class="layer">No video data yet</span>
      <h3>The Dashboard needs your channel's numbers</h3>
      <p class="note">Connect YouTube or import the Content file from YouTube Studio. Then this page shows your channel's numbers, its biggest problem and three steps for this week.</p>
      <button type="button" class="btn" data-goto="growth">Open Data &amp; money</button>
    </div>
    <div class="kpis" id="td-kpis"></div>
    <div class="rowb">
      <div class="box vchart">
        <div class="bx-hd"><div><h2>Views</h2><p class="sub" id="vc-sub"></p></div><div class="seg" role="group" aria-label="Time range" id="vc-seg"><button type="button" aria-pressed="true" data-r="30">30 days</button><button type="button" aria-pressed="false" data-r="90">90 days</button><button type="button" aria-pressed="false" data-r="12">12 months</button></div></div>
        <div id="vc" class="vc" tabindex="0" role="group" aria-label="Views chart. Press the left or right arrow to read each bar."><svg id="vc-svg" aria-hidden="true"></svg><div class="tp" id="vc-tp" role="status" hidden></div></div>
      </div>
      <div class="colb">
        <div class="next noimg" id="td-next"></div>
        <div class="box"><h2>Production status</h2><ul class="stg5" id="td-stg"></ul></div>
      </div>
    </div>
    <div id="td-full" class="rowc">
      <div class="dx sm">
        <span class="eyebrow">Biggest problem right now</span>
        <h2 class="disp" id="dx-h"></h2>
        <div class="cmpb" id="dx-cmp"></div>
        <p id="dx-p"></p>
        <div class="chips"><button type="button" class="btn" id="dx-go"></button></div>
      </div>
      <div class="box">
        <h2>This week</h2>
        <p class="sub">Three steps from your numbers. Tick them when done.</p>
        <ul class="moves" id="td-moves"></ul>
      </div>
      <div class="box topv"><h2>Top videos</h2><p class="sub">Views and CTR, all time</p><ul id="topv"><li class="loading">Loading data…</li></ul></div>
    </div>
    <div class="rowd">
      <div class="box" id="td-gradebox">
        <h2>Last upload, graded</h2>
        <p class="sub" id="td-last-sub"></p>
        <div id="td-grade"></div>
      </div>
      <div class="box">
        <div class="bx-hd"><div><h2>Up next</h2><p class="sub">Every video in progress, closest to upload first. The status moves by itself when the package, script and voice over are done.</p></div><button type="button" class="btn ghost" id="td-new">+ New video</button></div>
        <ul class="nxt" id="td-pipe"></ul>
      </div>
    </div>
  </section>

  <!-- LEARN: every upload graded against the channel's own best -->
  <section id="p-learn" role="tabpanel" aria-labelledby="t-learn" hidden>
    <div id="ln-empty" class="card" hidden>
      <span class="layer">No video data yet</span>
      <h3>Report cards appear once video data is in</h3>
      <button type="button" class="btn" data-goto="growth">Open Data &amp; money</button>
    </div>
    <div id="ln-full" class="stack">
      <div class="box">
        <h2>How much of each video is watched</h2>
        <p class="sub" id="ln-sub"></p>
        <div class="rchart" id="ln-chart"></div>
        <div class="lgd"><span><i style="background:var(--accent)"></i>20% or more: close to your best videos</span><span><i style="background:var(--warn)"></i>Under 10%: viewers leave quickly</span><span><i style="background:var(--stone-dot)"></i>In between</span></div>
      </div>
      <div class="box">
        <h2>Report card for each upload</h2>
        <p class="sub">Each upload is compared with your 6 best videos, from the latest data pulled. One lesson per video for the next one.</p>
        <div class="tblw"><table class="rc" id="ln-cards"></table></div>
      </div>
    </div>
  </section>

  <!-- CALENDAR -->
  <section id="p-dash" role="tabpanel" aria-labelledby="t-dash" hidden>
    <div class="paper">
      <div class="pp-head">
        <h2 class="disp" id="wk-title">Next 7 days</h2>
        <div class="seg" role="group" aria-label="View"><button type="button" aria-pressed="true" data-view="week">7 days</button><button type="button" aria-pressed="false" data-view="month">Month</button></div>
        <div class="pp-nav"><button type="button" class="btn ghost" id="wk-today">Today</button><button type="button" class="btn ghost icon" id="wk-prev" aria-label="Previous">&lsaquo;</button><button type="button" class="btn ghost icon" id="wk-next" aria-label="Next">&rsaquo;</button></div>
      </div>
      <div class="pp-row">
        <label class="search"><svg viewBox="0 0 14 14" aria-hidden="true"><path d="M6 11a5 5 0 1 0 0-10 5 5 0 0 0 0 10M13.5 13.5 9.6 9.6"/></svg><input id="pp-q" type="search" placeholder="Search plans or videos" aria-label="Search plans or videos"></label>
        <button type="button" class="btn" id="plan-new">+ Schedule content</button>
      </div>
      <div id="wk" class="wk"></div>
      <div id="cal-wrap" hidden>
        <div class="cal-legend"><span class="cl pub">Published</span><span class="cl video">Video plan</span><span class="cl short">Shorts plan</span><span class="cl post">Post plan</span></div>
        <div class="cal" id="cal" role="group" aria-label="Month calendar"></div>
      </div>
      <p class="pp-note" id="pp-note">Click a + box to add a plan, click a card to change its status or add a thumbnail.</p>
    </div>
  </section>

  <dialog id="plan-dlg" aria-labelledby="plan-dlg-title">
    <form method="dialog" id="plan-form" class="tool">
      <h2 id="plan-dlg-title">Content plan</h2>
      <label for="pl-title">Title<input id="pl-title" required maxlength="140"></label>
      <div class="row2">
        <label for="pl-date">Publish date<input id="pl-date" type="date" required></label>
        <label for="pl-type">Type<select id="pl-type"><option value="video">Long video</option><option value="short">Shorts</option><option value="post">Community post</option></select></label>
      </div>
      <label for="pl-status">Status<select id="pl-status"><option value="ide">Idea</option><option value="naskah">Script</option><option value="rekam">Record / voice over</option><option value="edit">Edit</option><option value="siap">Ready to upload</option><option value="tayang">Published</option></select></label>
      <label for="pl-note">Notes<textarea id="pl-note" rows="3"></textarea></label>
      <div class="pl-thumb"><span id="pl-thumb-box"></span><div><span class="lbl">Thumbnail (optional)</span><div class="chips"><button type="button" class="btn ghost" id="pl-thumb-pick">Choose image</button><button type="button" class="btn ghost" id="pl-thumb-del" hidden>Remove image</button></div><input type="file" id="pl-thumb-file" accept="image/jpeg,image/png,image/webp" hidden></div></div>
      <div class="confirm"><button class="btn" value="save" id="pl-save">Save</button><button class="btn ghost" value="cancel" formnovalidate>Cancel</button><button class="btn ghost danger" type="button" id="pl-del">Delete</button><button class="btn ghost" type="button" id="pl-tools">Open in Make video</button></div>
    </form>
  </dialog>

  <!-- IDEAS -->
  <section id="p-ideas" role="tabpanel" aria-labelledby="t-ideas" hidden>
    <div class="box" id="id-pattern-box">
      <h2>How close to your best videos</h2>
      <p class="sub" id="id-pattern-sub"></p>
      <div class="pattern" id="id-pattern"></div>
      <p class="sub" id="id-pattern-note" style="margin-top:12px"></p>
    </div>
    <div class="panel">
    <form class="tool" id="f-ideas">
      <h2>Find the next topic</h2>
      <p class="hint">AI suggests topics, then the app scores each from 0 to 5 against the pattern of your best videos. Your old video titles are used so no idea repeats.</p>
      <label for="ideas-focus">Theme focus (optional)<input id="ideas-focus" placeholder="e.g. Ice Age mammal predators"></label>
      <div class="row2">
        <label for="ideas-n">Number of ideas<input id="ideas-n" type="number" min="3" max="12" value="6"></label>
        <label for="ideas-freq">Uploads / month
          <select id="ideas-freq"><option value="2">2 videos</option><option value="4" selected>4 videos</option><option value="8">8 videos</option></select>
        </label>
      </div>
      <label for="ideas-start">Start date<input id="ideas-start" type="date"></label>
      <label for="ideas-avoid">Topics already made<textarea id="ideas-avoid" placeholder="Filled in automatically after a Studio import"></textarea></label>
      <button class="btn" type="submit">Find ideas</button>
      <div class="status" id="s-ideas" role="status"></div>
    </form>
    <div class="out" id="o-ideas"><div class="empty">Ideas will appear here, each with a score for how well it matches your best videos. Fill in the form beside it, then press <strong>Find ideas</strong>.</div></div>
    </div>
  </section>

  <!-- MAKE: one video, from title to upload -->
  <section id="p-make" role="tabpanel" aria-labelledby="t-make" hidden>
    <div class="box mk-head">
      <div class="mk-auto">
        <div><b id="mk-auto-h">Not sure what to make?</b><span id="mk-auto-p">One click: AI picks a topic that matches your best videos, fills in the titles, thumbnail text and hook, then writes the full script and voice over.</span></div>
        <div class="chips"><button type="button" class="btn" id="mk-one">Make script in 1 click</button><button type="button" class="btn ghost" id="mk-auto">Just suggest a topic</button><button type="button" class="btn ghost" id="mk-auto-new" hidden>Another topic</button></div>
      </div>
      <div class="status" id="s-auto" role="status"></div>
      <div class="mk-pick">
        <label for="mk-pick">Video<select id="mk-pick"></select></label>
        <label for="mk-topic">Topic or animal name<input id="mk-topic" placeholder="e.g. Pachycrocuta" maxlength="140"></label>
      </div>
      <div class="mk-stages" role="tablist" aria-label="Video steps" id="mk-stages">
        <button type="button" role="tab" id="ms-pkg" aria-controls="mk-pkg" aria-selected="true" data-stage="pkg">1. Package</button>
        <button type="button" role="tab" id="ms-hook" aria-controls="mk-hook-st" aria-selected="false" data-stage="hook" tabindex="-1">2. Hook</button>
        <button type="button" role="tab" id="ms-script" aria-controls="mk-script" aria-selected="false" data-stage="script" tabindex="-1">3. Script &amp; voice</button>
        <button type="button" role="tab" id="ms-seo" aria-controls="mk-seo" aria-selected="false" data-stage="seo" tabindex="-1">4. Publish</button>
      </div>
    </div>

    <div id="mk-pkg" role="tabpanel" aria-labelledby="ms-pkg" class="stack">
      <div class="td2">
        <div class="box">
          <h2>Title first, before writing</h2>
          <p class="sub">If no title makes people curious, change the topic. Pick one title; it is used for the thumbnail, hook and SEO.</p>
          <label for="mk-titles" style="margin-top:12px">Title ideas, one per line<textarea id="mk-titles" rows="4" placeholder="The 250 lb Hyena That Ate Our Ancestors"></textarea></label>
          <div class="tlist" id="mk-tlist" role="radiogroup" aria-label="Title in use"></div>
          <p class="sub" style="margin-top:10px">Check: <b>≤60</b> fits a phone screen · <b>Size</b> a number people can picture · <b>Threat</b> a danger to humans or a rival · <b>Name</b> the animal's name, for search.</p>
          <div class="chips" style="margin-top:12px"><button type="button" class="btn ghost" id="mk-titles-ai">Ask AI for 5 titles</button></div>
          <div class="status" id="s-titles" role="status"></div>
        </div>
        <div class="box">
          <h2>Thumbnail text</h2>
          <p class="sub">At most 4 words. One animal, one threat, big contrast. This text adds to the title, it does not repeat it.</p>
          <label for="mk-thumbtext" style="margin-top:12px">Thumbnail text<input id="mk-thumbtext" maxlength="40" placeholder="ATE OUR ANCESTORS"></label>
          <div class="mk-thumb" id="mk-thumbprev" aria-hidden="true"><span></span></div>
          <p class="note" id="mk-thumbnote"></p>
        </div>
      </div>
      <div class="box" id="mk-gen">
        <h2>Finished thumbnails</h2>
        <p class="sub">One click: AI writes 3 concepts, Gemini draws them, the app puts the text on top. Pick one and save it.</p>
        <div class="mk-auto" style="margin-top:12px">
          <div><b id="gen-h">Make 3 thumbnails with Gemini</b><span id="gen-p"></span></div>
          <button type="button" class="btn" id="gen-go">Make 3 thumbnails</button>
        </div>
        <div class="status" id="s-gen" role="status"></div>
        <div class="gthumbs" id="gen-list" hidden></div>
        <div class="gpos" id="gen-posrow" hidden>
          <label for="gen-pos">Text position
            <select id="gen-pos"><option value="tl">Top left</option><option value="bl">Bottom left</option><option value="tr">Top right</option><option value="none">No text</option></select>
          </label>
          <p class="note">The app adds the text, not the AI, so the letters are always right and can be changed without a new image.</p>
        </div>
        <div class="gphone" id="gen-phone" hidden>
          <div>
            <h3>Check at phone size</h3>
            <div class="gfeed" aria-label="How it looks on the YouTube home page">
              <img id="gen-feed-img" alt="Chosen thumbnail as on the YouTube home page">
              <div class="meta"><span class="av"></span><div><b id="gen-feed-title"></b><small id="gen-feed-ch"></small></div></div>
            </div>
          </div>
          <div>
            <h3>Suggested-video size</h3>
            <div class="gside"><img id="gen-side-img" alt="Chosen thumbnail at small size"><span id="gen-side-title"></span></div>
            <p class="note">If the text is still readable this small, the thumbnail is fine. Save 2 or 3 versions for Test &amp; Compare in YouTube Studio.</p>
            <p class="note" id="gen-saved"></p>
            <div class="chips"><button type="button" class="btn ghost" id="gen-folder">Open Downloads folder</button></div>
          </div>
        </div>
      </div>
      <div class="panel" id="mk-thumbtool">
    <form class="tool" id="f-thumb">
      <h2>Thumbnail concepts for Google Flow</h2>
      <p class="hint">Free fallback: three concepts with image prompts you can copy into Google Flow, with the composition and why people would click.</p>
      <label for="thumb-topic">Video topic<input id="thumb-topic" required></label>
      <label for="thumb-title">Title in use (optional)<input id="thumb-title"></label>
      <label for="thumb-style">Visual style
        <select id="thumb-style"><option>Photoreal cinematic</option><option>Painted illustration</option><option>Dark documentary, high contrast</option><option>Bold minimal graphic</option></select>
      </label>
      <button class="btn" type="submit">Make concepts</button>
      <div class="status" id="s-thumb" role="status"></div>
    </form>
    <div class="out" id="o-thumb"><div class="empty">Three thumbnail concepts will appear here. The image prompts can be copied into Google Flow.</div></div>
      </div>
    </div>

    <div id="mk-hook-st" role="tabpanel" aria-labelledby="ms-hook" hidden>
      <div class="td2">
        <div class="box">
          <h2>Hook coach: the first 60 seconds</h2>
          <p class="sub">This is where your viewers leave. Your best videos open straight with the animal and the danger. Write the opening here; the checks beside it update as you type.</p>
          <label for="mk-hook" style="margin-top:12px">Opening, in the video's language<textarea id="mk-hook" rows="9" placeholder="Two million years ago, a hyena bigger than any alive today ruled the caves of what is now China…"></textarea></label>
          <p class="note" id="mk-hook-len"></p>
          <div class="chips"><button type="button" class="btn" id="mk-hook-ai">Fix with AI</button><button type="button" class="btn ghost" data-stage-go="script">Go to script</button></div>
          <div class="status" id="s-hook" role="status"></div>
          <div class="out" id="o-hook"></div>
        </div>
        <div class="box">
          <h2>Check the hook</h2>
          <p class="sub">Rules from your videos that viewers left in the first minute.</p>
          <ul class="rules" id="mk-rules"></ul>
        </div>
      </div>
    </div>

    <div id="mk-script" role="tabpanel" aria-labelledby="ms-script" hidden>
    <div class="panel">
    <form class="tool" id="f-script">
      <h2>Full script</h2>
      <p class="hint">One click: an outline act by act, the full narration with your hook as the opening, then the ElevenLabs voice over. The narration is written one act at a time so it reaches the target length. All fields are filled in; just press the button.</p>
      <label for="script-topic">Video topic<input id="script-topic" required></label>
      <label for="script-angle">Story angle (optional)<textarea id="script-angle" placeholder="Leave empty and AI picks the strongest"></textarea></label>
      <div class="row2">
        <label for="script-words">Target words<input id="script-words" type="number" min="500" max="8000" step="100" value="2000"></label>
        <label for="script-acts">Number of acts<input id="script-acts" type="number" min="3" max="7" value="5"></label>
      </div>
      <div class="chips" id="script-len" role="group" aria-label="Script length options"><button type="button" class="btn ghost" data-w="2000">2,000 words · 14 min</button><button type="button" class="btn ghost" data-w="3000">3,000 words · 21 min</button><button type="button" class="btn ghost" data-w="4500">4,500 words · 32 min</button></div>
      <p class="note" id="script-len-note"></p>
      <label for="script-tone">Tone
        <select id="script-tone"><option>Cinematic, awe and mystery</option><option>Investigative, evidence-led</option><option>Survival drama</option><option>Calm, sleep-friendly narration</option></select>
      </label>
      <label class="cbx" for="script-auto"><input type="checkbox" id="script-auto" checked> Write the full narration and make the voice over straight away</label>
      <button class="btn" type="submit">Make full script</button>
      <div class="status" id="s-script" role="status"></div>
    </form>
    <div class="out" id="o-script"><div class="empty">The script outline will appear here, with the word share for each act and a list of facts to double-check. The hook from step 2 is used as the cold open.</div></div>
    </div>
    </div>

    <div id="mk-seo" role="tabpanel" aria-labelledby="ms-seo" hidden class="stack">
    <div class="panel">
    <form class="tool" id="f-seo">
      <h2>SEO package</h2>
      <p class="hint">Keywords, 5 titles, a description with chapters, hashtags, tags, a pinned comment and a Community post for publish day.</p>
      <label for="seo-topic">Video topic<input id="seo-topic" required></label>
      <label for="seo-facts">Key facts / outline (optional)<textarea id="seo-facts"></textarea></label>
      <label for="seo-mins">Video length (minutes)<input id="seo-mins" type="number" min="1" max="180" value="12"></label>
      <button class="btn" type="submit">Make SEO package</button>
      <div class="status" id="s-seo" role="status"></div>
    </form>
    <div class="out" id="o-seo"><div class="empty">The SEO package will appear here. Each part has a Copy button for pasting into YouTube Studio.</div></div>
    </div>
      <div class="box">
        <h2>Checklist before upload</h2>
        <p class="sub">Saved per video. The app never uploads anything; you still upload yourself in YouTube Studio.</p>
        <ul class="check" id="mk-pub" style="margin-top:10px"></ul>
        <div class="chips" style="margin-top:12px"><button type="button" class="btn ghost" id="mk-done">Mark as published</button></div>
        <div class="status" id="s-done" role="status"></div>
      </div>
    </div>
  </section>

  <!-- GROWTH -->
  <section id="p-growth" role="tabpanel" aria-labelledby="t-growth" hidden>
    <div id="g-empty" class="card" hidden>
      <span class="layer">No data yet</span>
      <h3>Import your YouTube Studio data</h3>
      <ol class="steps">
        <li>Open YouTube Studio, then Analytics, then <strong>Advanced mode</strong> (Advanced mode).</li>
        <li>Pick a date range, for example Lifetime.</li>
        <li>Click the download icon at the top right, choose <strong>Comma-separated values (.csv)</strong>. You get a .zip file.</li>
        <li>Click the button below and choose that .zip file. You can repeat this for the Traffic source and Geography tabs.</li>
      </ol>
      <button type="button" class="btn" data-import>Import .zip file from Studio</button>
      <div class="status" id="s-import-empty" role="status"></div>
    </div>

    <div id="g-full" hidden>
      <div class="card">
        <div class="out-head"><span class="layer" id="g-range">YouTube Studio data</span><span class="chips"><button type="button" class="btn ghost" data-ytsync hidden>Pull from YouTube</button><button type="button" class="btn ghost" data-import>Import new data</button></span></div>
        <h3>Channel report</h3>
        <div class="kpis" id="g-kpis"></div>
        <p style="margin:14px 0 0;font-weight:700">Views per month: when did the channel rise, when did it fall?</p>
        <div class="chart-wrap" id="g-chart-wrap"><svg id="g-chart" role="img" aria-label="Bar chart of views per month" style="width:100%;min-width:560px;height:240px;display:block"></svg><div class="tip" id="g-tip" hidden></div></div>
        <p class="note" id="g-chart-note">Hover or focus a bar for the monthly number.</p>
        <details class="mtable"><summary>See the monthly numbers as a table</summary><div style="overflow-x:auto"><table id="g-mtable"></table></div></details>
        <div class="status" id="s-import" role="status"></div>
      </div>

      <div class="grid2" style="margin-top:16px">
        <div class="card">
          <span class="layer">Automatic diagnosis</span>
          <h3>Best videos compared with the newest</h3>
          <div style="overflow-x:auto"><table class="cmp" id="g-cmp"></table></div>
          <ul class="diag" id="g-diag"></ul>
          <button type="button" class="btn" id="g-ai-btn">Deeper analysis with AI</button>
          <div class="status" id="s-ai" role="status"></div>
          <div id="g-ai" class="out" style="margin-top:12px"></div>
        </div>
        <div class="card">
          <span class="layer">An estimate, not a promise</span>
          <h3>Ad revenue simulator</h3>
          <div class="row2" style="margin:10px 0">
            <label for="g-views">Views / month<input id="g-views" type="number" min="0" step="1000" value="10000"></label>
            <label for="g-rpm"><span>RPM (<span class="cur">Rp</span> per 1,000 views)</span><input id="g-rpm" type="number" min="0" step="100" value="0"></label>
          </div>
          <div class="row2">
            <label for="g-members">Active members<input id="g-members" type="number" min="0" value="0"></label>
            <label for="g-mprice"><span>Member price (<span class="cur">Rp</span>)</span><input id="g-mprice" type="number" min="0" step="100" value="0"></label>
          </div>
          <div id="g-income" style="margin-top:12px"></div>
          <div class="chips" style="margin-top:10px" id="g-presets"></div>
          <p class="note" id="g-rpm-note"></p>
        </div>
      </div>

      <div class="grid2" style="margin-top:16px" id="g-extra"></div>

      <div class="card" style="margin-top:16px">
        <span class="layer">All long videos, click a column header to sort</span>
        <h3>Performance per video</h3>
        <div style="overflow-x:auto"><table class="vt" id="g-table"></table></div>
      </div>
    </div>

    <div class="grid2" style="margin-top:16px">
      <div class="card">
        <span class="layer">Saved on this computer</span>
        <h3>Growth checklist</h3>
        <ul class="check" id="g-check"></ul>
      </div>
      <form class="tool" id="f-shorts">
        <h2>Shorts from long videos</h2>
        <p class="hint">Each long video can become 3 to 5 Shorts that send viewers back to the full video.</p>
        <label for="shorts-topic">Source video<input id="shorts-topic" required></label>
        <label for="shorts-facts">Most interesting moments / facts (optional)<textarea id="shorts-facts"></textarea></label>
        <button class="btn" type="submit">Make 5 Shorts ideas</button>
        <div class="status" id="s-shorts" role="status"></div>
        <div class="out" id="o-shorts"></div>
      </form>
    </div>
  </section>

  <!-- SETTINGS -->
  <section id="p-settings" role="tabpanel" aria-labelledby="t-settings" hidden>
    <div class="grid2">
      <form class="tool" id="f-key">
        <h2>AI connection</h2>
        <label for="cfg-provider">How to use AI
          <select id="cfg-provider">
            <option value="manual">Copy-paste to claude.ai (uses your subscription, no cost)</option>
            <option value="gemini">Gemini, automatic (free quota from Google)</option>
            <option value="claude">Claude, automatic (paid API, best results)</option>
          </select>
        </label>
        <p class="hint" id="prov-hint"></p>
        <div id="grp-gemini" class="grp">
          <ol class="steps"><li>Open <a href="https://aistudio.google.com/apikey" target="_blank" rel="noopener">aistudio.google.com/apikey</a> and sign in with your Google account.</li><li>Click <strong>Create API key</strong>, then copy the key.</li><li>Paste it below, click Save, then Test connection.</li></ol>
          <label for="cfg-gkey">Gemini API key<input id="cfg-gkey" type="password" autocomplete="off" placeholder="AIza..."></label>
          <p class="note" id="cfg-gkey-hint"></p>
          <label for="cfg-gmodel">Gemini model<select id="cfg-gmodel"><option value="">Automatic: latest Gemini Flash</option></select></label>
          <div class="chips"><button class="btn ghost" type="button" id="cfg-gmodels">Load model list</button><button class="btn ghost" type="button" id="cfg-gclear">Remove Gemini key</button></div>
          <p class="note">On the free quota, Google may use your requests to improve its models, and there are limits on requests per minute and per day.</p>
        </div>
        <div id="grp-claude" class="grp">
          <label for="cfg-key">Claude API key<input id="cfg-key" type="password" autocomplete="off" placeholder="sk-ant-..."></label>
          <p class="note" id="cfg-key-hint"></p>
          <label for="cfg-model">Model
            <select id="cfg-model">
              <option value="claude-sonnet-5-5">Claude Sonnet 5.5: recommended, balanced (about Rp500 to 1,500 per run)</option>
              <option value="claude-opus-5-5">Claude Opus 5.5: best results (about Rp1,000 to 3,000)</option>
              <option value="claude-haiku-5-5">Claude Haiku 5.5: cheapest (under Rp100)</option>
            </select>
          </label>
          <label for="cfg-effort">Thinking depth
            <select id="cfg-effort"><option value="low">Low (fast, cheap)</option><option value="medium" selected>Medium</option><option value="high">High (more careful, costs more)</option></select>
          </label>
          <p class="note">Create a key at <a href="https://platform.claude.com/settings/keys" target="_blank" rel="noopener">platform.claude.com</a> and add credit (separate from your claude.ai subscription). A cost estimate appears after each run.</p>
          <p class="note" id="cfg-spent"></p>
          <div class="chips"><button class="btn ghost" type="button" id="cfg-clear">Remove Claude key</button></div>
        </div>
        <div class="chips"><button class="btn" type="submit">Save</button><button class="btn ghost" type="button" id="cfg-test">Test connection</button></div>
        <div class="status" id="s-key" role="status"></div>
      </form>

      <form class="tool" id="f-image">
        <h2>Thumbnail images (Gemini)</h2>
        <p class="hint">Makes thumbnail images right in the Package step. Images only work on a Gemini key with billing turned on, so use a separate key and your scripts and ideas stay free on the old key.</p>
        <ol class="steps">
          <li>Open <a href="https://aistudio.google.com/apikey" target="_blank" rel="noopener">aistudio.google.com/apikey</a>. Click <strong>Create API key</strong> and choose a new project. On that project's row click <strong>Set up billing</strong>, then add a first credit of $5.</li>
          <li>Open <a href="https://developers.google.com/program/my-benefits" target="_blank" rel="noopener">Google Developer Program, My benefits</a>. Claim the Google Cloud credit to that billing account and tick <strong>Always use this billing account</strong>.</li>
          <li>Paste the new key below, click Save, then Test image.</li>
        </ol>
        <label for="cfg-ikey">Gemini key for images<input id="cfg-ikey" type="password" autocomplete="off" placeholder="AIza..."></label>
        <p class="note" id="cfg-ikey-hint"></p>
        <label for="cfg-imodel">Image model
          <select id="cfg-imodel">
            <option value="gemini-3.1-flash-image">Flash Image: better, about $0.067</option>
            <option value="gemini-3.1-flash-lite-image">Flash Lite Image: cheaper, about $0.034</option>
          </select>
        </label>
        <div class="chips"><button class="btn" type="submit">Save</button><button class="btn ghost" type="button" id="cfg-itest">Test image</button><button class="btn ghost" type="button" id="cfg-iclear">Remove image key</button></div>
        <p class="note" id="cfg-ispent"></p>
        <p class="note">Test image makes one real image, so it uses credit. Prices are estimates from Google's price list as of November 2026. Google Cloud credit is used first; the $5 balance is only charged once that month's credit runs out.</p>
        <div class="status" id="s-image" role="status"></div>
        <div id="cfg-itest-out"></div>
      </form>

      <form class="tool" id="f-yt">
        <h2>YouTube Studio</h2>
        <p class="hint" id="yt-state">Connect the channel so the numbers on the Dashboard and in Data &amp; money update by themselves, without manual exports.</p>
        <div id="yt-on" class="grp" hidden>
          <p style="margin:0"><strong id="yt-name"></strong></p>
          <p class="note" id="yt-last" style="margin:0"></p>
          <div class="chips"><button class="btn" type="button" id="yt-sync">Pull data now</button><button class="btn ghost" type="button" id="yt-off">Disconnect</button></div>
        </div>
        <details id="yt-setup">
          <summary>One-time steps in Google Cloud (about 15 minutes, free)</summary>
          <ol class="steps">
            <li>Open <a href="https://console.cloud.google.com/projectcreate" target="_blank" rel="noopener">console.cloud.google.com</a> with the Google account that owns the channel. Create a new project, for example <strong>Terra Studio</strong>.</li>
            <li>In the <a href="https://console.cloud.google.com/apis/library" target="_blank" rel="noopener">API Library</a>, search for and click <strong>Enable</strong> for <strong>YouTube Data API v3</strong> and <strong>YouTube Analytics API</strong>.</li>
            <li>Open <a href="https://console.cloud.google.com/auth/overview" target="_blank" rel="noopener">Google Auth Platform</a>, click Get started. App name: Terra Studio, choose <strong>External</strong>, fill in your email.</li>
            <li>In the menu <strong>Audience</strong>, click <strong>Publish app</strong> so the permission does not expire every 7 days.</li>
            <li>In the menu <strong>Clients</strong>, click Create client, choose type <strong>Desktop app</strong>. Copy the Client ID and Client secret below.</li>
          </ol>
        </details>
        <label for="yt-id">Client ID<input id="yt-id" autocomplete="off" placeholder="....apps.googleusercontent.com"></label>
        <label for="yt-secret">Client secret<input id="yt-secret" type="password" autocomplete="off" placeholder="GOCSPX-..."></label>
        <p class="note" id="yt-secret-hint"></p>
        <div class="chips"><button class="btn" type="submit" id="yt-connect">Save and connect YouTube</button></div>
        <p class="note">Google will show "Google hasn't verified this app". That is normal because the app is your own: click Continue. Impressions and CTR are not available through this connection, so those numbers still come from the last Studio export.</p>
        <div class="status" id="s-yt" role="status"></div>
      </form>

      <form class="tool" id="f-voice">
        <h2>Voice (ElevenLabs)</h2>
        <p class="hint">Turns the full narration into an MP3 voice over. Uses the character quota of your ElevenLabs subscription, no extra cost.</p>
        <ol class="steps"><li>Open <a href="https://elevenlabs.io/app/settings/api-keys" target="_blank" rel="noopener">elevenlabs.io/app/settings/api-keys</a>.</li><li>Click <strong>Create API key</strong>. Allow Text to Speech, Voices, Models and User (read).</li><li>Paste it below, then click Load voices.</li></ol>
        <label for="cfg-ekey">ElevenLabs API key<input id="cfg-ekey" type="password" autocomplete="off" placeholder="sk_..."></label>
        <p class="note" id="cfg-ekey-hint"></p>
        <div class="chips"><button class="btn ghost" type="button" id="cfg-eload">Load voices</button></div>
        <div id="eleven-quota" class="note"></div>
        <label for="cfg-evoice">Narrator voice<select id="cfg-evoice"><option value="">Click Load voices first</option></select></label>
        <div id="cfg-epreview"></div>
        <label for="cfg-emodel">Voice model<select id="cfg-emodel"><option value="">Automatic: Multilingual v2 (most natural)</option></select></label>
        <div class="chips"><button class="btn" type="submit">Save</button><button class="btn ghost" type="button" id="cfg-eclear">Remove ElevenLabs key</button></div>
        <p class="note" id="cfg-adir"></p>
        <div class="status" id="s-voice" role="status"></div>
      </form>

      <form class="tool" id="f-profile">
        <h2>Channel profile</h2>
        <p class="hint">Every generator reads this profile. The more specific it is, the better the results.</p>
        <label for="pf-name">Channel name<input id="pf-name"></label>
        <div class="row2">
          <label for="pf-lang">Content language<input id="pf-lang" value="English"></label>
          <label for="pf-length">Usual video length<input id="pf-length" placeholder="e.g. 8 to 14 minutes"></label>
        </div>
        <label for="pf-niche">Niche and topics<textarea id="pf-niche" placeholder="e.g. prehistory documentaries: Ice Age megafauna, dinosaurs, ancient seas"></textarea></label>
        <label for="pf-audience">Audience<textarea id="pf-audience" placeholder="e.g. 88% male, mostly 45 and over, 39% from the US"></textarea></label>
        <label for="pf-wins">What has worked<textarea id="pf-wins" placeholder="Best-performing video titles and their pattern. Filled in from Studio data when left empty."></textarea></label>
        <label for="pf-money">Membership, merch, sponsor<textarea id="pf-money" placeholder="e.g. Field Crew and Lead Explorers memberships, Bog Titan merch collection"></textarea></label>
        <label for="pf-style">Narration style<input id="pf-style" placeholder="e.g. cinematic, calm, authoritative"></label>
        <div class="chips"><button class="btn" type="submit">Save profile</button><button class="btn ghost" type="button" id="pf-export">Copy profile (JSON)</button><button class="btn ghost" type="button" id="pf-import">Paste profile (JSON)</button></div>
        <textarea id="pf-json" hidden aria-label="Profile as JSON"></textarea>
        <div class="status" id="s-profile" role="status"></div>
      </form>
    </div>
    <div class="card" style="margin-top:16px">
      <span class="layer">App</span>
      <h3>Data and app</h3>
      <p class="note">All settings, Studio data, calendar plans and AI results are stored only on this computer, in the folder <code id="cfg-dir"></code>. API keys are stored encrypted with Windows protection. Closing the Terra Studio window closes the app.</p>
      <h3 style="margin-top:14px">Backup</h3>
      <p class="note">Save a backup file (profile, Studio data, calendar, AI results) to the Downloads folder, then copy it to a flash drive or Google Drive. API keys and plan thumbnail images are not included. Restore it on a new computer or after reinstalling Windows.</p>
      <div class="chips"><button type="button" class="btn ghost" id="backup-save">Save backup</button><button type="button" class="btn ghost" id="backup-load">Restore from backup</button></div>
      <input type="file" id="backup-file" accept=".json,application/json" hidden>
      <div class="confirm" id="backup-confirm" hidden><span id="backup-confirm-text"></span> <button type="button" class="btn ghost" id="backup-yes">Yes, restore</button> <button type="button" class="btn ghost" id="backup-no">Cancel</button></div>
      <div class="chips"><button type="button" class="btn ghost" data-import>Import Studio data (.zip/.csv)</button><button type="button" class="btn ghost" id="data-clear">Delete Studio data</button><button type="button" class="btn ghost" id="app-quit">Close app</button></div>
      <div class="confirm" id="data-clear-confirm" hidden>Delete all imported Studio data? <button type="button" class="btn ghost" id="data-clear-yes">Yes, delete</button> <button type="button" class="btn ghost" id="data-clear-no">Cancel</button></div>
      <div class="status" id="s-app" role="status"></div>
    </div>
  </section>

  <input type="file" id="file-import" accept=".zip,.csv" multiple hidden>
  <footer>The generators use Claude from Anthropic, through your claude.ai subscription or API key.</footer>
</div>
  </main>
</div>

<script>
const $=s=>document.querySelector(s);
const esc=s=>String(s??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
const store={get(k,d){try{const v=localStorage.getItem("ts-"+k);return v?JSON.parse(v):d}catch{return d}},set(k,v){try{localStorage.setItem("ts-"+k,JSON.stringify(v))}catch{}}};
const api=async(path,opts={})=>{opts.headers={...(opts.headers||{}),"X-Terra":"1"};let r;try{r=await fetch(path,opts)}catch{return{error:"Terra Studio is not running. Open it again from its icon."}}let j={};try{j=await r.json()}catch{}if(!r.ok&&!j.error)j.error="The app is not responding ("+r.status+").";return j};
let CFG={profile:{}},YT=null;

/* heartbeat: the app exits a while after this window closes */
const beat=()=>fetch("/api/heartbeat",{method:"POST",headers:{"X-Terra":"1"}}).catch(()=>{});setInterval(beat,15000);beat();

/* tabs */
const tabs=[...document.querySelectorAll("nav.tabs button")];
// The first show() skips scrollIntoView: Chromium moves the Tab starting point there, past the skip link.
// 1.x had separate Script, SEO and Thumbnail pages; they now live as stages of Make.
const OLD_TAB={script:"script",seo:"seo",thumb:"pkg"};
function show(name,first){if(OLD_TAB[name]){mkStage(OLD_TAB[name]);name="make"}if(!tabs.some(b=>b.dataset.tab===name))name="today";tabs.forEach(b=>{const on=b.dataset.tab===name;b.setAttribute("aria-selected",on);if(on){if(!first)b.scrollIntoView({block:"nearest",inline:"nearest"});$("#page-title").textContent=b.textContent.trim()}$("#p-"+b.dataset.tab).hidden=!on});
  $(".shell").dataset.tab=name;store.set("tab",name);$("#main").scrollTop=0;
  if(name==="dash")renderDash();if(name==="today")renderToday();if(name==="learn")renderLearn();if(name==="ideas")renderPattern();if(name==="make")renderMake();if(name==="growth")requestAnimationFrame(()=>{if(YT)chart()})}
tabs.forEach(b=>b.addEventListener("click",()=>show(b.dataset.tab)));
function setNav(open){document.documentElement.dataset.nav=open?"open":"closed";store.set("nav",open?"open":"closed");
  const b=$("#nav-tog"),t=open?"Close menu":"Open menu";b.setAttribute("aria-label",t);b.title=t+" (Ctrl+B)";
  $("#nav-tog-arrow").setAttribute("d",open?"m10 5.25-1.75 1.75L10 8.75":"m8.5 5.25 1.75 1.75L8.5 8.75");
  // the charts are drawn in pixels, so they follow the page once it has its new width
  setTimeout(()=>{if(YT&&!$("#p-growth").hidden)chart();if(!$("#p-today").hidden)renderViews()},260)}
const navOpen=()=>document.documentElement.dataset.nav!=="closed";
$("#nav-tog").addEventListener("click",()=>setNav(!navOpen()));
document.addEventListener("keydown",e=>{if((e.ctrlKey||e.metaKey)&&!e.altKey&&!e.shiftKey&&e.key.toLowerCase()==="b"){e.preventDefault();setNav(!navOpen())}});
document.addEventListener("click",e=>{const g=e.target.closest("[data-goto]");if(g)show(g.dataset.goto)});

/* prompt context from the profile */
function channelContext(){
  const p=CFG.profile||{},lines=[];
  lines.push(`You are helping the YouTube channel "${p.name||"(unnamed channel)"}".`);
  if(p.niche)lines.push("Niche and topics: "+p.niche);
  lines.push("Content language: "+(p.lang||"English")+". Write all video-facing text (titles, scripts, descriptions, tags, prompts) in that language.");
  if(p.length)lines.push("Typical video length: "+p.length+".");
  if(p.audience)lines.push("Audience: "+p.audience);
  const wins=p.wins||autoWins();if(wins)lines.push("What has worked on this channel: "+wins);
  if(p.money)lines.push("Monetization: "+p.money);
  if(p.style)lines.push("Narration style: "+p.style);
  lines.push("Keep facts accurate; flag anything uncertain instead of inventing it.");
  lines.push("Writing rules: no em dashes or en dashes (use commas, periods, colons or parentheses); no hype words (unlock, delve, journey, testament, revolutionary, seamless, mind-blowing, game-changer); no \"it's not just X, it's Y\" constructions; no runs of short dramatic fragments; no forced lists of three; no emojis; no invented numbers, dates, names or quotes.");
  lines.push("Write every field in English.");
  return lines.join("\n");
}
function autoWins(){if(!YT||!YT.videos)return "";const top=longForm().sort((a,b)=>b.v-a.v).slice(0,6);if(!top.length)return "";return "Top videos by views: "+top.map(v=>`"${v.t}" (${v.v} views, CTR ${v.ctr}%)`).join("; ")+"."}

/* Claude via the local app */
/* rough cost: USD per million tokens (input, output), shown in rupiah at a fixed rate */
const PRICE={"claude-opus-5-5":[4,20],"claude-sonnet-5-5":[2,10],"claude-haiku-5-5":[0.1,0.5]},KURS=16500;
function costRp(model,u,provider){if(provider==="gemini")return 0;const k=Object.keys(PRICE).find(m=>(model||"").startsWith(m));if(!u)return 0;const [i,o]=k?PRICE[k]:[5,25];return (u.input_tokens*i+u.output_tokens*o)/1e6*KURS}
let LAST={};
async function remember(key,data){LAST[key]={at:Date.now(),data};await api("/api/last",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({key,value:LAST[key]})})}
function spentText(){const s=LAST._spent?.data;const m=new Date().toISOString().slice(0,7);return s&&s.month===m?`Estimated AI cost this month: Rp${nf(Math.round(s.rp))} of ${s.n} runs.`:"No AI cost this month yet."}
async function addSpent(rp){const m=new Date().toISOString().slice(0,7);let s=LAST._spent?.data;if(!s||s.month!==m)s={month:m,rp:0,n:0};s.rp+=rp;s.n+=1;await remember("_spent",s);const el=$("#cfg-spent");if(el)el.textContent=spentText()}
/* Without an API key, the prompt is copied to claude.ai (the user's own
   subscription) and the reply is pasted back. */
function manualAsk(statusEl,prompt){
  const old=statusEl.nextElementSibling;if(old&&old.classList.contains("manual"))old.remove();
  const box=document.createElement("div");box.className="card manual";const id="mp"+Math.random().toString(36).slice(2,8);
  box.innerHTML=`<span class="layer">Use your claude.ai subscription</span>\n  <ol class="steps"><li>Copy the prompt below.</li><li>Open <a href="https://claude.ai/new" target="_blank" rel="noopener">claude.ai</a>, start a new chat, paste it, then send.</li><li>Copy Claude's whole answer, paste it in the box at the bottom, then click <strong>Use answer</strong>.</li></ol>\n  <div class="copybox" style="margin-top:52px"><button type="button" class="btn ghost" data-copy="${id}" data-label="Copy prompt">Copy prompt</button><pre id="${id}" style="max-height:160px">${esc(prompt)}</pre></div>\n  <label style="margin-top:12px">Answer from claude.ai<textarea rows="5" placeholder="Paste the answer here"></textarea></label>\n  <div class="confirm"><button type="button" class="btn" data-act="use">Use answer</button><button type="button" class="btn ghost" data-act="cancel">Cancel</button></div>\n  <div class="status" role="status"></div>`;
  statusEl.after(box);statusEl.className="status";statusEl.textContent="Waiting for the answer from claude.ai.";
  return new Promise(res=>{
    box.querySelector('[data-act="cancel"]').onclick=()=>{box.remove();statusEl.textContent="";res(null)};
    box.querySelector('[data-act="use"]').onclick=()=>{const d=parseJSON(box.querySelector("textarea").value);const st=box.querySelector(".status");
      if(!d){st.className="status err";st.textContent="The answer could not be read. Make sure Claude's whole answer is copied, from the first { to the last }.";return}
      box.remove();res(d)};
  })}
async function ask(statusEl,btn,prompt,key,label){
  if(!CFG.provider){const full=channelContext()+"\n\n"+prompt+"\n\nReply directly in this chat (not as an artifact or file) with ONLY valid JSON, no markdown fences, no text before or after.";
    const data=await manualAsk(statusEl,full);
    if(data){statusEl.className="status";statusEl.textContent="Done, "+new Date().toLocaleTimeString("en-US",{hour:"2-digit",minute:"2-digit"})+", via claude.ai, result saved";if(key)remember(key,data).catch(()=>{})}
    return data}
  statusEl.className="status";statusEl.textContent=label||"AI is writing… (usually 20 to 90 seconds)";btn.disabled=true;
  try{
    const j=await api("/api/generate",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({prompt:channelContext()+"\n\n"+prompt+"\n\nReturn ONLY valid JSON, no markdown fences, no text before or after."})});
    const rp=costRp(j.model,j.usage,j.provider);if(rp)addSpent(rp).catch(()=>{});
    if(j.error)throw j;
    const data=parseJSON(j.text);
    if(!data)throw{error:"Claude's answer could not be read. Press the button once more."};
    statusEl.textContent="Done, "+new Date().toLocaleTimeString("en-US",{hour:"2-digit",minute:"2-digit"})+(j.provider==="gemini"?", via Gemini":rp?`, cost about Rp${nf(Math.max(1,Math.round(rp)))}`:"")+", result saved";
    if(key)remember(key,data).catch(()=>{});
    return data;
  }catch(e){statusEl.className="status err";statusEl.textContent=e.error||("Failed: "+(e.message||"try again."));return null}
  finally{btn.disabled=false}
}
function parseJSON(t){if(!t)return null;try{return JSON.parse(t)}catch{}const a=t.indexOf("{"),b=t.lastIndexOf("}");if(a>=0&&b>a){try{return JSON.parse(t.slice(a,b+1))}catch{}}return null}

function copyBox(label,text){const id="c"+Math.random().toString(36).slice(2,8);return `<div class="card"><span class="layer">${esc(label)}</span><div class="copybox" style="margin-top:52px"><button type="button" class="btn ghost" data-copy="${id}">Copy</button><pre id="${id}">${esc(text)}</pre></div></div>`}
document.addEventListener("click",e=>{const b=e.target.closest("[data-copy]");if(!b)return;const pre=document.getElementById(b.dataset.copy);const txt=pre.textContent;
  const done=()=>{b.textContent="Copied";setTimeout(()=>b.textContent=b.dataset.label||"Copy",1500)};
  const sel=()=>{const r=document.createRange();r.selectNodeContents(pre);const s=getSelection();s.removeAllRanges();s.addRange(r);try{document.execCommand("copy");done()}catch{b.textContent="Press Ctrl+C"}};
  if(navigator.clipboard)navigator.clipboard.writeText(txt).then(done).catch(sel);else sel()});
const head=t=>`<div class="out-head"><span class="layer">${esc(t)}</span></div>`;
const val=id=>$(id).value.trim();

/* Ideas */
$("#ideas-start").value=new Date().toISOString().slice(0,10);
function schedule(n,perMonth,startISO){const gap=Math.round(30/perMonth),d=new Date(startISO+"T12:00:00"),out=[];for(let i=0;i<n;i++){const x=new Date(d);x.setDate(d.getDate()+i*gap);out.push(x)}return out}
const fmtDate=d=>d.toLocaleDateString("en-US",{weekday:"short",day:"numeric",month:"short",year:"numeric"});
function renderIdeas(list){
  const dates=schedule(list.length,+$("#ideas-freq").value,$("#ideas-start").value||new Date().toISOString().slice(0,10));
  const plan=list.map((x,i)=>`${dates[i].toISOString().slice(0,10)}  ${x.title}`).join("\n");
  const scored=list.map((x,i)=>({...x,date:isoDay(dates[i]),...fitOf(x)})).sort((a,b)=>b.score-a.score);
  $("#o-ideas").innerHTML=head("Next topics, sorted by score")+`<div class="idea-list">${scored.map(x=>`<article class="idea2"><div class="fit" style="--p:${x.score*20}" role="img" aria-label="Score ${x.score} out of 5"><span>${x.score}</span></div><div style="min-width:0"><h3>${esc(x.title)}</h3><div class="tags">${x.tags.map(([ok,t])=>`<span class="tag ${ok?"y":"n"}">${ok?"✓ ":""}${esc(t)}</span>`).join("")}</div><p class="note" style="margin:8px 0 0"><strong>Hook:</strong> ${esc(x.hook)}</p><p class="note" style="margin:4px 0 0">${esc(x.why)}</p></div><div class="idea-act"><button type="button" class="btn${x.score<3?" ghost":""}" data-start="${esc(x.title)}" data-topic="${esc(x.subject||"")}" data-date="${x.date}">Start video</button><button type="button" class="btn ghost" data-plan="${esc(x.title)}" data-date="${x.date}">To calendar, ${esc(fmtShort(x.date))}</button></div></article>`).join("")}</div><div class="chips"><button type="button" class="btn ghost" id="plan-all">Add all to calendar</button></div>`+copyBox("Schedule (copy to your notes or calendar)",plan);
}
const fmtShort=iso=>new Date(iso+"T12:00:00").toLocaleDateString("en-US",{day:"numeric",month:"short"});
// Score an idea against the winners' pattern. The AI only says what the animal is; the app checks the channel history itself.
function fitOf(x){const subj=String(x.subject||"").trim(),key=subj.split(/[\s,(]+/).find(w=>w.length>=4)||"";
  const prev=key?longForm().filter(v=>(v.t||"").toLowerCase().includes(key.toLowerCase())).sort((a,b)=>(b.d||"").localeCompare(a.d||""))[0]:null;
  const tags=[[!!x.mammal,"Mamalia"],[!!x.predator,"Predator"],[!!x.threat,"Threat to humans"],[!!x.size,"Size claim"],[!prev,prev?`Already made ${fmtShort(prev.d)}, ${f1(share(prev))}% watched`:"Never made"]];
  return {tags,score:tags.filter(t=>t[0]).length}}
document.addEventListener("click",async e=>{const b=e.target.closest("[data-start]");if(!b)return;
  let p=plans().find(x=>x.title===b.dataset.start);
  if(!p){p={id:Date.now().toString(36)+Math.random().toString(36).slice(2,6),title:b.dataset.start,date:b.dataset.date||isoDay(new Date()),type:"video",status:"ide",note:""};await savePlans([...plans(),p])}
  if(b.dataset.topic){work(p.id).topic=b.dataset.topic;saveWork()}
  openMake(p.id,"pkg")});
$("#f-ideas").addEventListener("submit",async e=>{e.preventDefault();const n=Math.min(12,Math.max(3,+$("#ideas-n").value||6));
  const data=await ask($("#s-ideas"),e.submitter||$("#f-ideas .btn"),`Suggest ${n} new video ideas for this channel.${val("#ideas-focus")?" Focus: "+val("#ideas-focus")+".":""} Do not repeat or closely overlap these existing videos: ${val("#ideas-avoid")||"none listed"}.
Base the choices on what has worked for this channel: ${patternText()||"giant prehistoric mammals, predators, framed as a threat to humans or rivals"}. Titles under 60 characters, clickable but honest, naming the animal.
For each idea also answer honestly about the main animal: "subject" its usual name, "mammal" true if it is a mammal, "predator" true if it hunted or scavenged large prey, "threat" true if the video frames it as a danger to humans or our ancestors (only when the evidence supports it), "size" true if the title states a size, weight or record.
JSON shape: {"ideas":[{"title":"","subject":"","mammal":true,"predator":true,"threat":true,"size":true,"hook":"one-sentence cold-open hook","why":"why it can perform for this channel (English, one sentence)"}]}`,"ideas");
  if(data?.ideas?.length)renderIdeas(data.ideas)});

/* Script outline */
const ACT_COLORS=["var(--accent)","var(--moss)","var(--muted)","var(--warn)","var(--ink)","var(--field)","var(--accent)"];
const ROMAN=["I","II","III","IV","V","VI","VII"];
let lastOutline=null;
function renderScript(s){lastOutline=s;const acts=s.acts||[],total=acts.reduce((a,x)=>a+(+x.words||0),0)||1;
  $("#o-script").innerHTML=head("Kerangka: "+(s.title||""))+`<div class="card"><span class="layer">Cold open</span><p style="font-size:19px">${esc(s.cold_open)}</p>\n  <div class="strata" aria-label="Word share per act">${acts.map((a,i)=>`<span style="width:${((+a.words||0)/total*100).toFixed(1)}%;background:${ACT_COLORS[i%7]}" title="Act ${i+1}: ${esc(a.words)} words"></span>`).join("")}</div>
  ${acts.map((a,i)=>`<div class="act"><div class="num">${ROMAN[i]||i+1}<small>${esc(a.words)} words</small></div><div style="min-width:0"><h3>${esc(a.name)}</h3><ul>${(a.beats||[]).map(b=>`<li>${esc(b)}</li>`).join("")}</ul>${a.open_loop?`<p class="note"><strong>Open loop:</strong> ${esc(a.open_loop)}</p>`:""}${a.cta?`<p class="note"><strong>CTA:</strong> ${esc(a.cta)}</p>`:""}</div></div>`).join("")}</div>
  ${(s.visuals?.length)?`<div class="card"><span class="layer">Visuals / B-roll list</span><div class="chips" style="margin-top:8px">${s.visuals.map(v=>`<span class="chip">${esc(v)}</span>`).join("")}</div></div>`:""}
  ${acts.some(a=>a.flow_prompts?.length)?copyBox("Video prompts for Google Flow (one per 8-second clip)",acts.map((a,i)=>(a.flow_prompts||[]).map((f,j)=>`[Act ${i+1}.${j+1}] ${f}${s.flow_style?" Style: "+s.flow_style:""}`).join("\n\n")).filter(Boolean).join("\n\n"))+`<p class="note">Paste one prompt per clip in Flow. The visual style is already in each prompt so the clips stay consistent.</p>`:""}
  ${(s.fact_check?.length)?`<div class="card"><span class="layer">Double-check before recording</span><ul>${s.fact_check.map(v=>`<li>${esc(v)}</li>`).join("")}</ul></div>`:""}\n  <div class="card"><span class="layer">Next step</span><h3>Full narration script</h3><p class="note">Turn this outline into a script ready to read aloud (voice over), at the target word count. You can paste it into Bang Story or read it yourself.</p><button type="button" class="btn" id="script-full-btn">Write full narration script</button><div class="status" id="s-scriptfull" role="status"></div></div>\n  <div id="o-scriptfull" class="out"></div>`}
function renderScriptFull(f){const parts=f.narration||[],all=parts.map(p=>p.text).join("\n\n"),words=all.split(/\s+/).filter(Boolean).length,mins=(words/140).toLocaleString("en-US",{maximumFractionDigits:1});
  $("#o-scriptfull").innerHTML=copyBox(`Full narration script, ${nf(words)} words, about ${mins} minutes read aloud`,parts.map((p,i)=>`[${p.act||"Act "+(i+1)}]\n${p.text}`).join("\n\n"))+(f.title?`<p class="note">For outline: ${esc(f.title)}</p>`:"")+voCard(f);const v=LAST.vo?.data;if(v&&v.title===(f.title||"voice over"))renderVo(v)}
let lastNarr=null;
function voCard(f){lastNarr=f;const chars=(f.narration||[]).reduce((n,p)=>n+(p.text||"").length,0);
  if(!CFG.has_eleven)return `<div class="card"><span class="layer">Voice over</span><h3>Turn it into voice with ElevenLabs</h3><p class="note">Add your ElevenLabs API key in Settings, under Voice, so this script can become an MP3 right in the app.</p><button type="button" class="btn ghost" data-goto="settings">Open Settings</button></div>`;
  return `<div class="card"><span class="layer">Voice over</span><h3>Turn it into voice with ElevenLabs</h3>\n  <label for="vo-voice">Voice<select id="vo-voice">${CFG.eleven_voice?`<option value="${esc(CFG.eleven_voice)}">${esc(CFG.eleven_voice_name||CFG.eleven_voice)}</option>`:`<option value="">Choose a voice in Settings first</option>`}</select></label>\n  <p class="note">This script is about ${nf(chars)} characters, so it uses about ${nf(chars)} characters of your ElevenLabs quota. A long script is split into parts and joined into one file.</p>\n  <button type="button" class="btn" id="vo-btn">Make voice over (${nf(chars)} characters)</button><div class="status" id="s-vo" role="status"></div><div id="o-vo"></div></div>`}
function renderVo(j){$("#o-vo").innerHTML=`<audio controls preload="metadata" src="/api/audio/${encodeURIComponent(j.file)}" style="width:100%;margin-top:12px"></audio><p class="note">Saved in ${esc(j.path)}</p><div class="chips"><button type="button" class="btn ghost" id="vo-open">Open folder</button><a class="btn ghost" href="/api/audio/${encodeURIComponent(j.file)}" download="${esc(j.file)}">Download MP3</a></div>`}
document.addEventListener("click",async e=>{
  if(e.target.closest("#vo-open")){api("/api/open-folder",{method:"POST",headers:{"Content-Type":"application/json"},body:"{}"});return}
  const b=e.target.closest("#vo-btn");if(b&&lastNarr)makeVoice(b)});
async function makeVoice(b){const st=$("#s-vo"),voice=$("#vo-voice").value;
  if(!voice){st.className="status err";st.textContent="Choose a voice first in Settings, under Voice.";return null}
  b.disabled=true;st.className="status";st.textContent="Making the voice over… this takes 1 to 3 minutes for a 2,000-word script. The finished audio is about as long as the video. Do not close the app.";
  const j=await api("/api/eleven/tts",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({title:lastNarr.title||"voice over",parts:lastNarr.narration.map(p=>p.text),voice})});b.disabled=false;
  if(j.error){st.className="status err";st.textContent=j.error;return null}
  st.textContent=`Done: ${nf(j.chars)} characters, ${j.chunks} parts, ${(j.bytes/1048576).toLocaleString("en-US",{maximumFractionDigits:1})} MB.`;j.title=lastNarr.title||"voice over";renderVo(j);remember("vo",j).catch(()=>{});advance(mkId(),"edit");return j}
document.addEventListener("click",e=>{const b=e.target.closest("#script-full-btn");if(b&&lastOutline)writeFull(b)});
const wordsOf=t=>(t||"").split(/\s+/).filter(Boolean).length;
// Asked for a whole script in one reply, models stop well short of the target. One call per act keeps each act at its planned length.
let narrPart=null;
async function writeFull(b){
  const w=+$("#script-words").value||2000,st=$("#s-scriptfull"),acts=lastOutline.acts||[];
  if(!CFG.provider||acts.length<2){
    const data=await ask(st,b,`Write the complete voice-over narration for this documentary, following the outline below act by act. The total must be about ${w} words (not shorter than ${Math.round(w*.9)}); keep each act close to its planned word count, in paragraphs of 70 to 95 words. Spoken style: clear sentences, vivid but accurate, no stage directions, no headings inside the text, no bracketed notes. Open with the cold open. Keep open loops and the soft CTAs where the outline puts them. Mark anything uncertain by phrasing it carefully ("scientists think", "the fossils suggest") rather than inventing facts.
Outline JSON: ${JSON.stringify({title:lastOutline.title,cold_open:lastOutline.cold_open,acts:acts.map(a=>({name:a.name,words:a.words,beats:a.beats,open_loop:a.open_loop,cta:a.cta}))})}
JSON shape: {"title":"","narration":[{"act":"act name","text":"narration paragraphs for this act"}]}`,"scriptfull");
    if(data?.narration?.length){renderScriptFull(data);return data}return null}
  const sum=acts.reduce((a,x)=>a+(+x.words||0),0),n=acts.length,title=lastOutline.title||"";
  const plan=JSON.stringify({title,cold_open:lastOutline.cold_open,acts:acts.map(a=>({name:a.name,beats:a.beats}))});
  // A failed act (quota, connection) leaves the finished acts in place; the next click continues from there.
  const narration=narrPart&&narrPart.title===title&&narrPart.w===w&&narrPart.narration.length<n?narrPart.narration:[];
  narrPart={title,w,narration};
  for(let i=narration.length;i<n;i++){const a=acts[i],t=Math.max(150,Math.round(sum?w*(+a.words||0)/sum:w/n)),paras=Math.max(2,Math.round(t/82)),last=i===n-1;
    const prev=narration.length?narration[narration.length-1].text.split(/\s+/).slice(-70).join(" "):"";
    const base=`Write the voice-over narration for act ${i+1} of ${n} ("${a.name}") of this documentary. Length: ${paras} paragraphs of 70 to 95 words each, about ${t} words in total, and not fewer than ${Math.round(t*.9)}. Spoken style: clear sentences, vivid but accurate, concrete numbers and comparisons a viewer can picture, no stage directions, no headings, no bracketed notes. Mark anything uncertain by phrasing it carefully ("scientists think", "the fossils suggest") rather than inventing facts. Cover only this act's beats; other acts are written separately, so do not summarise or repeat them.
${i===0?hookForScript()+"Open with the cold open.":`The previous act ended with: """${prev}""" Continue straight on from there without repeating it and without re-introducing the animal.`}
${last?"This is the final act: pay off the opening question and end with a short closing line."+(a.cta?" Soft CTA to include: "+a.cta:""):`End on this open loop so the viewer keeps watching: ${a.open_loop||"a question the next act answers"}. Do not conclude the film.`}${!last&&a.cta?" Soft CTA to include: "+a.cta:""}
Whole film outline (for context only): ${plan}
This act's beats: ${JSON.stringify(a.beats||[])}`;
    let d=await ask(st,b,base+`\nJSON shape: {"text":"the narration, paragraphs separated by a blank line"}`,null,`Writing act ${i+1} of ${n}: ${a.name}…`);
    if(!d?.text){const why=st.textContent;st.className="status err";st.textContent=`Act ${i+1} not finished (${why}) ${narration.length?`Acts 1 to ${narration.length} is safe. Click the button again to continue.`:"Click the button again."}`;return null}
    if(wordsOf(d.text)<t*.8){const more=await ask(st,b,base+`\nThis draft is too short at ${wordsOf(d.text)} words. Rewrite it at about ${t} words by adding accurate, concrete detail from the beats, not filler or repetition. Draft: """${d.text}"""\nJSON shape: {"text":""}`,null,`Act ${i+1} is too short, adding to it…`);if(more?.text&&wordsOf(more.text)>wordsOf(d.text))d=more}
    narration.push({act:a.name,text:String(d.text).trim()});renderScriptFull({title,narration:[...narration]})}
  const data={title,narration};narrPart=null;await remember("scriptfull",data).catch(()=>{});renderScriptFull(data);advance(mkId(),"rekam");
  const total=wordsOf(narration.map(x=>x.text).join(" "));st.className="status";st.textContent=`Narration done: ${nf(total)} words (target ${nf(w)}), about ${Math.round(total/140)} minutes read aloud. Result saved.`;
  return data}
$("#f-script").addEventListener("submit",e=>{e.preventDefault();runScript(e.submitter||$("#f-script .btn"))});
async function runScript(btn){const w=+$("#script-words").value||2000,n=Math.min(7,Math.max(3,+$("#script-acts").value||5));
  const data=await ask($("#s-script"),btn,`Build a detailed ${n}-act outline for a documentary script. Topic: ${val("#script-topic")}. Central question: ${val("#script-angle")||"choose the strongest one"}. Tone: ${$("#script-tone").value}. Target length: about ${w} words total (act word counts must add up to about ${w}).
${hookForScript()}Include a vivid 2-3 sentence cold open that pays off within the first 30 seconds, 3-5 beats per act, open loops across act breaks for retention, at most two soft CTAs (membership or merch from the profile) placed where they don't break the story, a visual/B-roll list, and facts to double-check.
Also write a "flow_style" line (one sentence, English) fixing one consistent visual style, lighting and camera look for the whole video, and for every act 2-4 "flow_prompts": English text-to-video prompts for Google Flow (Veo), each describing one 8-second shot (subject, action, setting, camera movement, lighting), self-contained (repeat key subject details, no references like "same as before"), scientifically accurate anatomy, no on-screen text, 16:9.
JSON shape: {"title":"","cold_open":"","flow_style":"","acts":[{"name":"","words":0,"beats":[""],"open_loop":"","cta":"","flow_prompts":[""]}],"visuals":[""],"fact_check":[""]}. Exactly ${n} acts. Use "" for open_loop or cta when not needed.`,"script");
  if(!data?.acts?.length)return false;renderScript(data);
  // One click runs the whole chain: outline, full narration, then the ElevenLabs voice when a voice is set up.
  if(!$("#script-auto").checked)return true;const st=$("#s-script");
  st.textContent="Step 2 of 3: writing the full narration…";$("#s-scriptfull").scrollIntoView({block:"center"});
  const full=await writeFull($("#script-full-btn"));if(!full){st.textContent="Outline done. The full narration is not finished; press Write full narration script below to continue.";return false}
  if(!(CFG.has_eleven&&CFG.eleven_voice&&$("#vo-btn"))){st.textContent="Outline and full narration done. Voice over skipped: set up ElevenLabs in Settings first.";return true}
  st.textContent="Step 3 of 3: making the voice over…";$("#s-vo").scrollIntoView({block:"center"});
  const vo=await makeVoice($("#vo-btn"));st.textContent=vo?"Done: the outline, full narration and MP3 voice over are ready. The Flow clip prompts are under the outline.":"Outline and full narration done. The voice over failed, see the message below.";return true}
// Length presets; the last choice is remembered.
function scriptLen(){const w=+$("#script-words").value||2000;document.querySelectorAll("#script-len [data-w]").forEach(b=>b.setAttribute("aria-pressed",+b.dataset.w===w));
  $("#script-len-note").textContent=`${nf(w)} words is roughly ${Math.round(w/140)} minutes of video and ${nf(Math.round(w*6.1/1000)*1000)} characters of ElevenLabs voice over.`}
$("#script-len").addEventListener("click",e=>{const b=e.target.closest("[data-w]");if(!b)return;$("#script-words").value=b.dataset.w;store.set("sw",+b.dataset.w);scriptLen()});
$("#script-words").addEventListener("input",e=>{store.set("sw",+e.target.value||2000);scriptLen()});

/* SEO pack */
function renderSEO(s){const tags=(s.tags||[]).join(", ");
  $("#o-seo").innerHTML=head("SEO package")+(s.keywords?`<div class="card"><span class="layer">Keywords</span><p><strong>Main:</strong> ${esc(s.keywords.primary)}</p><p><strong>Supporting:</strong> ${esc((s.keywords.secondary||[]).join(", "))}</p><p class="note">Put the main keyword in the title, in the first sentence of the description, and say it in the first 30 seconds of narration (YouTube reads the transcript).</p></div>`:"")
  +`<div class="card"><span class="layer">Title options</span><ol class="titles">${(s.titles||[]).map(t=>`<li>${esc(t.text)}<span class="len">${String(t.text||"").length} chars, ${esc(t.angle||"")}</span></li>`).join("")}</ol><p class="note">Aim for under 60 characters so it is not cut off on phones. Test 2 or 3 titles with Test &amp; Compare in YouTube Studio.</p></div>`
  +copyBox("Description (with chapters)",s.description||"")+copyBox("Hashtag",(s.hashtags||[]).join(" "))+copyBox(`Tags (${tags.length}/500 characters)`,tags)+copyBox("Pinned comment",s.pinned_comment||"")+(s.community_post?copyBox("YouTube Community post (publish day)",s.community_post):"")}
$("#f-seo").addEventListener("submit",async e=>{e.preventDefault();
  const data=await ask($("#s-seo"),e.submitter||$("#f-seo .btn"),`Create a YouTube SEO pack. Topic: ${val("#seo-topic")}. Key facts or outline: ${val("#seo-facts")||"none given"}. Video length: ${$("#seo-mins").value} minutes.
First pick ONE primary search keyword (what a viewer would actually type) and 2-3 secondary keywords. Give 5 title options (each under 60 characters, honest, varied angles, at least 3 containing the primary keyword or the subject's common name; "angle" is a 1-2 word English label). A description: strong first 2 lines (shown in search) with the primary keyword in the first sentence, 1 short paragraph, a CHAPTERS list with plausible timestamps spread over the length starting at 00:00, placeholders [membership link] and [merch link], then 3 hashtags at the end. 3 hashtags. 10-15 tags, total under 450 characters, mixing broad and long-tail phrases. A pinned comment that asks a question to spark replies. A YouTube Community post for release day (under 600 characters, one surprising fact, then a 3-4 option poll written as a list).
JSON shape: {"keywords":{"primary":"","secondary":[""]},"titles":[{"text":"","angle":""}],"description":"","hashtags":[""],"tags":[""],"pinned_comment":"","community_post":""}`,"seo");
  if(data?.titles)renderSEO(data)});

/* Thumbnail */
function renderThumb(list){$("#o-thumb").innerHTML=head("Thumbnail concepts")+`<div class="thumbs">${list.map((c,i)=>{const id="tp"+i+Math.random().toString(36).slice(2,6);return `<article class="card"><div class="thumb-text">${esc(c.text)}</div><h3 style="margin-top:12px">${esc(c.name)}</h3><p><strong>Composition:</strong> ${esc(c.composition)}</p><p class="note"><strong>Why people click:</strong> ${esc(c.why)}</p><div class="copybox" style="margin-top:52px"><button type="button" class="btn ghost" data-copy="${id}" data-label="Copy for Flow">Copy for Flow</button><pre id="${id}">${esc(c.prompt)}</pre></div></article>`}).join("")}</div><p class="note">Quick rules: at most 4 words, one big subject, high contrast, still readable at small phone size. The thumbnail text adds to the title, it does not repeat it.</p>`}
$("#f-thumb").addEventListener("submit",async e=>{e.preventDefault();
  const data=await ask($("#s-thumb"),e.submitter||$("#f-thumb .btn"),`Create 3 distinct YouTube thumbnail concepts. Topic: ${val("#thumb-topic")}. Video title: ${val("#thumb-title")||"not decided"}. Visual style: ${$("#thumb-style").value}.
Each concept: "name" short English label, "text" overlay of max 4 words, uppercase, that complements (not repeats) the title, "composition" one sentence, "why" one sentence in English on why it gets clicks, "prompt" a detailed text-to-image prompt in English for Google Flow / Imagen (16:9, leave empty space for the overlay text, do not render any text in the image, accurate anatomy and details).
JSON shape: {"concepts":[{"name":"","text":"","composition":"","why":"","prompt":""}]}`,"thumb");
  if(data?.concepts?.length)renderThumb(data.concepts)});

/* Shorts */
function renderShorts(list){$("#o-shorts").innerHTML=head("Shorts ideas")+list.map(s=>`<div class="card"><h3>${esc(s.title)}</h3><p><strong>Seconds 0 to 2:</strong> ${esc(s.hook)}</p><p class="note">${esc(s.outline)}</p><div class="meta"><span>${esc(s.length)}</span><span>CTA: ${esc(s.cta)}</span></div></div>`).join("")}
$("#f-shorts").addEventListener("submit",async e=>{e.preventDefault();
  const data=await ask($("#s-shorts"),e.submitter||$("#f-shorts .btn"),`Turn this long video into 5 YouTube Shorts ideas (vertical, under 60 seconds) that send viewers to the full video. Source video: ${val("#shorts-topic")}. Best moments: ${val("#shorts-facts")||"pick the most surprising"}.
Each: "title" (under 50 characters), "hook" what happens in the first 2 seconds (visual + line), "outline" one sentence, "length" like "40 seconds", "cta" short.
JSON shape: {"shorts":[{"title":"","hook":"","outline":"","length":"","cta":""}]}`,"shorts");
  if(data?.shorts?.length)renderShorts(data.shorts)});

/* Data and growth */
const nf=n=>Math.round(n||0).toLocaleString("en-US");
const f1=n=>(n||0).toLocaleString("en-US",{maximumFractionDigits:1});
const cur=()=>(YT&&YT.currency)||"IDR";
const moneyShort=n=>cur()==="IDR"&&Math.abs(n)>=1e6?"Rp"+(n/1e6).toLocaleString("en-US",{maximumFractionDigits:1})+"M":money(n);
const money=n=>{const c=cur();return c==="IDR"?"Rp"+nf(n):c==="USD"?"$"+nf(n):nf(n)+" "+c};
const longForm=()=>(YT&&YT.videos||[]).filter(v=>v.dur>=120);
const BN=["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"];
function monthly(){const m=new Map();(YT.daily||[]).forEach(([d,v])=>{const k=d.slice(0,7);m.set(k,(m.get(k)||0)+v)});return [...m.entries()].sort()}
function lastDays(n,offset=0){const d=YT.daily||[];return d.slice(Math.max(0,d.length-n-offset),d.length-offset).reduce((a,x)=>a+x[1],0)}
let MONTHS=[];
const mLabel=(m,i)=>BN[+m.slice(5,7)-1]+" "+m.slice(0,4)+(i===MONTHS.length-1&&YT.partialLast?" (not complete)":"");

function renderGrowth(){
  const has=YT&&(YT.videos?.length||YT.daily?.length);
  $("#g-empty").hidden=!!has;$("#g-full").hidden=!has;
  if(!has){$("#meter").innerHTML="";return}
  MONTHS=monthly();
  const t=YT.totals||{};
  $("#g-range").textContent="YouTube Studio data"+(YT.range?", "+YT.range:"")+(YT.imported_at?", imported "+new Date(YT.imported_at).toLocaleDateString("en-US"):"");
  const k=[];if(t.views!=null)k.push([nf(t.views),"total views"]);if(t.hours!=null)k.push([nf(t.hours),"watch hours"]);if(t.subs!=null)k.push([(t.subs>=0?"+":"")+nf(t.subs),"net subscribers"]);if(t.revenue!=null)k.push([money(t.revenue),"estimated revenue"]);if(YT.daily?.length)k.push([nf(lastDays(30)),"views in the last 30 days"]);
  $("#g-kpis").innerHTML=k.map(([b,l])=>`<div><b>${b}</b><span>${l}</span></div>`).join("");
  if(YT.daily?.length>=60){const a=lastDays(30),b=lastDays(30,30),pct=b?Math.round((a/b-1)*100):0;$("#meter").innerHTML=`<span class="layer">Views in the last 30 days</span><b>${nf(a)}</b> <span class="${a<b?"no":"ok"}">${a<b?"down":"up"} ${Math.abs(pct)}%</span> compared with the 30 days before`}
  if(!(YT.daily?.length>=60))$("#meter").innerHTML="";
  if(MONTHS.length){chart();$("#g-mtable").innerHTML=`<tr><th>Month</th><th>Views</th></tr>`+MONTHS.map(([m,v],i)=>`<tr><td>${mLabel(m,i)}</td><td>${nf(v)}</td></tr>`).join("")}
  $("#g-chart-wrap").hidden=!MONTHS.length;
  diagnose();table();extras();incomeSetup();
  const titles=(YT.videos||[]).filter(v=>v.dur>=120).map(v=>v.t);if(titles.length&&!$("#ideas-avoid").value)$("#ideas-avoid").value=titles.join("; ");
}

function chart(){
  const svg=$("#g-chart");if(!svg||!MONTHS.length)return;const W=Math.max(560,svg.clientWidth||560),H=240,pl=48,pb=26,pt=26,data=MONTHS;
  const peak=Math.max(...data.map(d=>d[1]),1),step=niceStep(peak/4),max=step*4,bw=(W-pl-8)/data.length,y=v=>pt+(H-pt-pb)*(1-v/max),base=H-pb,mono='font-family="Familjen Grotesk,system-ui,sans-serif"';
  let g="";for(let t=0;t<=max;t+=step)g+=`<line x1="${pl}" x2="${W-4}" y1="${y(t)}" y2="${y(t)}" stroke="var(--line)"/><text x="${pl-6}" y="${y(t)+4}" text-anchor="end" font-size="11" fill="var(--muted)" ${mono}>${short(t)}</text>`;
  const peakI=data.reduce((b,d,i)=>d[1]>data[b][1]?i:b,0),lastFull=YT.partialLast?data.length-2:data.length-1;
  data.forEach(([m,v],i)=>{const w=Math.max(2,bw-2),x=pl+i*bw+1,top=y(v),r=Math.min(4,w/2,base-top);
    const d=base-top<1?"":`M${x},${base}V${top+r}Q${x},${top} ${x+r},${top}H${x+w-r}Q${x+w},${top} ${x+w},${top+r}V${base}Z`;
    g+=`<path d="${d}" fill="var(--accent)"/><rect class="hit" data-i="${i}" x="${pl+i*bw}" y="${pt}" width="${bw}" height="${base-pt}" fill="transparent" tabindex="0" aria-label="${mLabel(m,i)}: ${nf(v)} views"/>`;
    const mo=+m.slice(5,7);if(mo===1||i===0)g+=`<text x="${x}" y="${H-8}" font-size="11" fill="var(--muted)" ${mono}>${BN[mo-1]} ${m.slice(2,4)}</text>`;else if(data.length<=36&&mo%3===1&&i>2)g+=`<text x="${x}" y="${H-8}" font-size="11" fill="var(--muted)" ${mono}>${BN[mo-1]}</text>`;
    if(i===peakI)g+=`<text x="${Math.min(Math.max(x+w/2,pl+30),W-40)}" y="${top-8}" text-anchor="middle" font-size="12" font-weight="500" fill="var(--ink)" ${mono}>${nf(v)}</text>`;
    if(i===lastFull&&i!==peakI)g+=`<text x="${x+w}" y="${top-8}" text-anchor="end" font-size="12" font-weight="500" fill="var(--ink)" ${mono}>${BN[mo-1]}: ${nf(v)}</text>`});
  svg.setAttribute("viewBox",`0 0 ${W} ${H}`);svg.innerHTML=g;
}
function niceStep(x){const p=Math.pow(10,Math.floor(Math.log10(Math.max(x,1)))),n=x/p;return (n<=1?1:n<=2?2:n<=2.5?2.5:n<=5?5:10)*p}
function short(n){return n>=1e6?f1(n/1e6)+"M":n>=1e3?f1(n/1e3)+"K":String(n)}
addEventListener("resize",()=>{if(YT&&!$("#p-growth").hidden)chart()});
(function hover(){const wrap=$("#g-chart-wrap"),tip=$("#g-tip");
  const showTip=el=>{const i=+el.dataset.i,[m,v]=MONTHS[i],r=el.getBoundingClientRect(),wr=wrap.getBoundingClientRect();tip.textContent=`${mLabel(m,i)}: ${nf(v)} views`;tip.hidden=false;let left=r.left-wr.left+wrap.scrollLeft+r.width/2;left=Math.max(90,Math.min(left,wrap.scrollWidth-90));tip.style.left=left+"px";tip.style.top=(r.top-wr.top+60)+"px"};
  wrap.addEventListener("pointerover",e=>{const h=e.target.closest(".hit");if(h)showTip(h)});wrap.addEventListener("pointerleave",()=>tip.hidden=true);
  wrap.addEventListener("focusin",e=>{const h=e.target.closest(".hit");if(h)showTip(h)});wrap.addEventListener("focusout",()=>tip.hidden=true)})();

function stats(g){const v=g.reduce((a,x)=>a+x.v,0),h=g.reduce((a,x)=>a+x.h,0),imp=g.reduce((a,x)=>a+x.imp,0),cl=g.reduce((a,x)=>a+x.imp*x.ctr/100,0);return{n:g.length,avg:g.length?v/g.length:0,ctr:imp?cl/imp*100:0,avd:v?h*60/v:0}}
function diagnose(){
  const lf=longForm(),ul=$("#g-diag"),tb=$("#g-cmp");if(lf.length<4){tb.innerHTML="";ul.innerHTML="<li>A comparison needs data for at least 4 long videos. Import the Content file from Studio.</li>";return}
  const dates=lf.map(v=>v.d).filter(Boolean).sort(),latest=dates[dates.length-1]||"";
  const cut=latest?new Date(new Date(latest+"T12:00:00").getTime()-90*864e5).toISOString().slice(0,10):"";
  const top=[...lf].sort((a,b)=>b.v-a.v).slice(0,6),recent=lf.filter(v=>v.d&&v.d>cut&&!top.includes(v));
  const a=stats(top),b=stats(recent.length?recent:lf.slice(-6));
  tb.innerHTML=`<tr><th></th><th>6 best videos</th><th>${recent.length||6} videos from the last 90 days</th></tr>\n  <tr><td>Average views</td><td>${nf(a.avg)}</td><td class="${b.avg<a.avg/3?"flag":""}">${nf(b.avg)}</td></tr>
  <tr><td>CTR thumbnail</td><td>${f1(a.ctr)}%</td><td class="${b.ctr<a.ctr*0.75?"flag":""}">${f1(b.ctr)}%</td></tr>\n  <tr><td>Average view duration</td><td>${f1(a.avd)} min</td><td class="${b.avd<a.avd*0.75?"flag":""}">${f1(b.avd)} min</td></tr>`;
  const li=[];
  if(b.ctr<a.ctr*0.75)li.push(`<strong>CTR fell from ${f1(a.ctr)}% to ${f1(b.ctr)}%.</strong> Videos are shown but rarely clicked. Fix titles and thumbnails first, with the SEO package and Thumbnail tools.`);
  else li.push(`CTR of the newest videos (${f1(b.ctr)}%) is still in line with the best videos (${f1(a.ctr)}%).`);
  if(b.avd<a.avd*0.75)li.push(`<strong>View duration fell from ${f1(a.avd)} to ${f1(b.avd)} minutes.</strong> Viewers leave sooner. Check the retention graph in Studio and strengthen the cold open in the Script outline tool.`);
  li.push(`<strong>Best-performing videos:</strong> ${top.slice(0,3).map(v=>esc(v.t)).join("; ")}. Look for the same topic pattern and title angle for the next ideas.`);
  const totalRev=lf.reduce((s,v)=>s+(v.rev||0),0);if(totalRev>0){const top3=[...lf].sort((x,y)=>(y.rev||0)-(x.rev||0)).slice(0,3).reduce((s,v)=>s+(v.rev||0),0);li.push(`${Math.round(top3/totalRev*100)}% of long-video revenue comes from just 3 videos.`)}
  const sh=(YT.videos||[]).filter(v=>v.dur<120);if(sh.length){const sv=sh.reduce((s,v)=>s+v.v,0),ss=sh.reduce((s,v)=>s+v.s,0);li.push(`${sh.length} Shorts brought in ${nf(sv)} views and ${nf(ss)} subscriber.${sv/sh.length<1000?" Shorts are not working yet; make them from the strongest moments of long videos.":""}`)}
  ul.innerHTML=li.map(x=>`<li>${x}</li>`).join("");
}
$("#g-ai-btn").addEventListener("click",async e=>{
  const lf=longForm(),top=[...lf].sort((a,b)=>b.v-a.v).slice(0,12),rec=[...lf].sort((a,b)=>(b.d||"").localeCompare(a.d||"")).slice(0,12);
  const row=v=>`${v.d} | ${v.t} | ${Math.round(v.dur/60)} min | ${v.v} views | CTR ${v.ctr}% | avg view ${(v.v?v.h*60/v.v:0).toFixed(1)} min | ${v.s} subs | revenue ${Math.round(v.rev||0)} ${cur()}`;
  const extra=[YT.traffic?.length?"Traffic sources: "+YT.traffic.slice(0,8).map(r=>`${r.name} ${r.views} views CTR ${r.ctr??"n/a"}%`).join("; "):"",YT.geo?.length?"Geography: "+YT.geo.slice(0,8).map(r=>`${r.name} ${r.views} views revenue ${Math.round(r.rev||0)}`).join("; "):""].filter(Boolean).join("\n");
  const data=await ask($("#s-ai"),e.currentTarget,`Analyse this channel's YouTube Studio data like an experienced YouTube strategist. Explain what drove the best period, why recent videos underperform (if they do), and give a concrete plan for the next 4 uploads.
Monthly views: ${MONTHS.map(([m,v])=>m+" "+v).join(", ")}
Top videos (date | title | length | views | CTR | avg view duration | subs | revenue):
${top.map(row).join("\n")}
Most recent videos:
${rec.map(row).join("\n")}
${extra}
Write everything in English, plain and direct, citing the numbers above. JSON shape: {"summary":"2-3 sentences","findings":[{"title":"","detail":""}],"plan":[{"title":"","detail":""}]}`,"ai");
  if(data)renderAI(data)
});
function renderAI(data){$("#g-ai").innerHTML=`<div class="card"><p>${esc(data.summary)}</p>${(data.findings||[]).length?`<h3>Findings</h3><ul class="diag">${data.findings.map(f=>`<li><strong>${esc(f.title)}.</strong> ${esc(f.detail)}</li>`).join("")}</ul>`:""}${(data.plan||[]).length?`<h3>Plan for the next 4 uploads</h3><ol class="diag">${data.plan.map(f=>`<li><strong>${esc(f.title)}.</strong> ${esc(f.detail)}</li>`).join("")}</ol>`:""}</div>`}

let sortKey="v",sortDir=-1;
const COLS=[["t","Title"],["d","Publish"],["v","Views"],["ctr","CTR %"],["avd","Watched (min)"],["s","Subs"],["rev","Revenue"]];
function table(){const rows=longForm().map(x=>({...x,avd:x.v?x.h*60/x.v:0})).sort((a,b)=>(a[sortKey]>b[sortKey]?1:a[sortKey]<b[sortKey]?-1:0)*sortDir);
  const lf=longForm(),ctrs=lf.map(v=>v.ctr).sort((a,b)=>a-b),med=ctrs[Math.floor(ctrs.length/2)]||0;
  $("#g-table").innerHTML=`<tr>${COLS.map(([k,l])=>`<th data-k="${k}" tabindex="0" aria-sort="${k===sortKey?(sortDir>0?"ascending":"descending"):"none"}">${l}${k===sortKey?(sortDir>0?" ▲":" ▼"):""}</th>`).join("")}</tr>`+
  rows.map(x=>`<tr><td>${esc(x.t)}</td><td>${x.d?new Date(x.d+"T12:00:00").toLocaleDateString("en-US",{day:"numeric",month:"short",year:"2-digit"}):""}</td><td>${nf(x.v)}</td><td class="${x.ctr>=med*1.25?"good":x.ctr<med*0.75?"flag":""}">${f1(x.ctr)}</td><td>${f1(x.avd)}</td><td>${nf(x.s)}</td><td>${money(x.rev)}</td></tr>`).join("")}
$("#g-table").addEventListener("click",e=>{const th=e.target.closest("th");if(!th)return;const k=th.dataset.k;if(k===sortKey)sortDir*=-1;else{sortKey=k;sortDir=k==="t"?1:-1}table();$(`#g-table th[data-k="${k}"]`)?.focus()});
$("#g-table").addEventListener("keydown",e=>{if((e.key==="Enter"||e.key===" ")&&e.target.matches("th")){e.preventDefault();e.target.click()}});

function extras(){const out=[];
  if(YT.traffic?.length){const tot=YT.traffic.reduce((s,r)=>s+r.views,0)||1;out.push(`<div class="card"><span class="layer">Traffic sources</span><h3>Where viewers come from</h3><div style="overflow-x:auto"><table><tr><th>Source</th><th>Views</th><th>CTR</th></tr>${YT.traffic.slice(0,8).map(r=>`<tr><td>${esc(r.name)}</td><td>${f1(r.views/tot*100)}%</td><td>${r.ctr!=null?f1(r.ctr)+"%":"none"}</td></tr>`).join("")}</table></div><p class="note">Browse features = the YouTube home page. Home only places videos with good CTR and view duration.</p></div>`)}
  if(YT.geo?.length){out.push(`<div class="card"><span class="layer">Revenue per 1,000 views by country</span><h3>Which viewers are worth most</h3><div style="overflow-x:auto"><table><tr><th>Country</th><th>Views</th><th>${cur()} / 1.000</th></tr>${YT.geo.slice(0,10).map(r=>{const rpm=r.views?(r.rev||0)/r.views*1000:0;return `<tr><td>${esc(r.name)}</td><td>${nf(r.views)}</td><td>${money(rpm)}</td></tr>`}).join("")}</table></div></div>`)}
  if(YT.age?.rows?.length){out.push(`<div class="card"><span class="layer">Age and gender</span><h3>Who the viewers are</h3><div style="overflow-x:auto"><table><tr>${YT.age.headers.map(h=>`<th>${esc(h)}</th>`).join("")}</tr>${YT.age.rows.slice(0,20).map(r=>`<tr>${r.map(c=>`<td>${esc(c)}</td>`).join("")}</tr>`).join("")}</table></div></div>`)}
  $("#g-extra").innerHTML=out.join("");$("#g-extra").hidden=!out.length}

function incomeSetup(){
  document.querySelectorAll(".cur").forEach(s=>s.textContent=cur()==="IDR"?"Rp":cur());
  const paid=longForm().filter(v=>v.rev>0&&v.v>500),rpms=paid.map(v=>v.rev/v.v*1000).sort((a,b)=>a-b);
  const saved=store.get("sim",null);
  if(saved){$("#g-views").value=saved.views;$("#g-rpm").value=saved.rpm;$("#g-members").value=saved.m;$("#g-mprice").value=saved.mp}
  else if(rpms.length){$("#g-rpm").value=Math.round(rpms[Math.floor(rpms.length/2)]);$("#g-views").value=Math.round(lastDays(30)/1000)*1000||1000}
  $("#g-rpm-note").textContent=rpms.length?`The RPM of your earning videos ranges from ${money(rpms[0])} to ${money(rpms[rpms.length-1])} per 1,000 views (median ${money(rpms[Math.floor(rpms.length/2)])}). Fill in the real member count from Studio.`:"Fill in the RPM from the Revenue tab in YouTube Studio.";
  const ms=MONTHS.map(m=>m[1]),best=ms.length?Math.max(...ms):0;
  $("#g-presets").innerHTML=[["Now (30 days)",Math.round(lastDays(30))],["Best month",best]].filter(p=>p[1]>0).map(([l,v])=>`<button type="button" class="btn ghost" data-views="${v}">${l}: ${nf(v)}</button>`).join("");
  income();
}
function income(){const n=id=>Math.max(0,+$(id).value||0);const ads=n("#g-views")/1000*n("#g-rpm"),mem=n("#g-members")*n("#g-mprice")*0.7;
  $("#g-income").innerHTML=`<div class="big">${money(ads+mem)}<span style="font-size:16px;font-family:var(--f-body)"> / month</span></div><div class="meta" style="margin-top:6px"><span>Ads: ${money(ads)}</span><span>Memberships after YouTube's 30% cut: ${money(mem)}</span><span>Not counting merch and sponsors</span></div>`;
  store.set("sim",{views:n("#g-views"),rpm:n("#g-rpm"),m:n("#g-members"),mp:n("#g-mprice")})}
$("#g-presets").addEventListener("click",e=>{const b=e.target.closest("[data-views]");if(b){$("#g-views").value=b.dataset.views;income()}});
["#g-views","#g-rpm","#g-members","#g-mprice"].forEach(id=>$(id).addEventListener("input",income));

const CHECK=[["Check the retention graph of the last 3 videos","Note the second where most viewers leave, then fix the opening of the next video."],["Upload on the same day and time","Use the calendar in the Ideas tool. Match it with the graph of when your viewers are active in Studio."],["Make 3 to 5 Shorts from each long video","Link them to the full video with the Related video feature."],["Test a title or thumbnail with Test & Compare","Replace a thumbnail with a low CTR after 48 hours."],["Make a series playlist","Adds watch time per session."],["Add an end screen to the next video in the series","Nudges viewers to keep watching."],["Mention the membership once, at the right moment","Explain what members get."],["Prepare a simple media kit for sponsors","Start contacting sponsors once average views are stable."],["Reply to and pin comments in the first 24 hours","Early comments signal engagement."],["Check the source of every big fact","Viewer trust is a long-term asset."]];
const done=store.get("check",{});
$("#g-check").innerHTML=CHECK.map(([t,s],i)=>`<li><input type="checkbox" id="ck${i}" ${done[i]?"checked":""}><label for="ck${i}" style="display:block;font-weight:500">${esc(t)}<small>${esc(s)}</small></label></li>`).join("");
$("#g-check").addEventListener("change",e=>{done[e.target.id.slice(2)]=e.target.checked;store.set("check",done)});

/* import */
let importStatus=null;
document.addEventListener("click",e=>{const b=e.target.closest("[data-import]");if(!b)return;importStatus=b.closest("#g-empty")?$("#s-import-empty"):b.closest("#p-settings")?$("#s-app"):$("#s-import");$("#file-import").click()});
$("#file-import").addEventListener("change",async e=>{const files=[...e.target.files];e.target.value="";if(!files.length)return;const st=importStatus||$("#s-import");st.className="status";st.textContent="Importing…";
  const msgs=[];for(const f of files){const j=await api("/api/import",{method:"POST",headers:{"X-Filename":encodeURIComponent(f.name)},body:await f.arrayBuffer()});if(j.error){st.className="status err";st.textContent=f.name+": "+j.error;return}msgs.push(...(j.found||[]))}
  st.textContent=msgs.length?"Imported: "+msgs.join(", ")+".":"No table was recognised in that file. Make sure the file comes from Studio's advanced mode export.";await loadData()});

/* settings */
const PROFILE_FIELDS=[["name","#pf-name"],["lang","#pf-lang"],["length","#pf-length"],["niche","#pf-niche"],["audience","#pf-audience"],["wins","#pf-wins"],["money","#pf-money"],["style","#pf-style"]];
async function loadConfig(){CFG=await api("/api/config");if(CFG.error){CFG={profile:{}};return}
  $("#cfg-model").value=CFG.model||"claude-sonnet-5-5";$("#cfg-effort").value=CFG.effort||"medium";
  $("#cfg-key-hint").textContent=CFG.has_key?"Saved: key ending in "+CFG.key_hint+". Leave the field empty to keep using this key.":"No Claude key saved yet.";
  $("#banner-key").hidden=!!CFG.provider||store.get("banner-off",false);
  $("#cfg-provider").value=CFG.provider_choice&&CFG.provider_choice!==""?CFG.provider_choice:(CFG.provider||"manual");showProv();
  $("#cfg-gkey-hint").textContent=CFG.has_gemini?"Saved: key ending in "+CFG.gemini_hint+". Leave the field empty to keep using this key.":"No Gemini key saved yet.";
  if(CFG.gemini_model&&![...$("#cfg-gmodel").options].some(o=>o.value===CFG.gemini_model))$("#cfg-gmodel").insertAdjacentHTML("beforeend",`<option value="${esc(CFG.gemini_model)}">${esc(CFG.gemini_model)}</option>`);$("#cfg-gmodel").value=CFG.gemini_model||"";$("#cfg-dir").textContent=CFG.dir||"";voiceFields();imgFields();ytFields();if(lastNarr&&$("#o-scriptfull"))renderScriptFull(lastNarr);
  const p=CFG.profile||{};PROFILE_FIELDS.forEach(([k,id])=>{if(p[k]!=null)$(id).value=p[k]});
  $("#hdr-channel").textContent=p.name||""}
function readProfile(){const p={};PROFILE_FIELDS.forEach(([k,id])=>p[k]=$(id).value.trim());return p}
async function saveConfig(extra,st){const body={model:$("#cfg-model").value,effort:$("#cfg-effort").value,profile:readProfile(),...extra};const j=await api("/api/config",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(body)});
  if(j.error){st.className="status err";st.textContent=j.error;return false}st.className="status";st.textContent="Saved.";await loadConfig();return true}
const PROV_HINT={manual:"Each AI button prepares a prompt to copy into claude.ai. Free because it uses your subscription, but it needs copy and paste.",gemini:"Results appear straight in the app. Uses a free API key from Google AI Studio.",claude:"Results appear straight in the app at the best quality. Billed by Anthropic per use, separate from your claude.ai subscription."};
function showProv(){const v=$("#cfg-provider").value;$("#prov-hint").textContent=PROV_HINT[v]||"";$("#grp-gemini").hidden=v!=="gemini";$("#grp-claude").hidden=v!=="claude"}
$("#cfg-provider").addEventListener("change",showProv);
function keyFields(st){const k=$("#cfg-key").value.trim(),g=$("#cfg-gkey").value.trim(),x={provider:$("#cfg-provider").value,gemini_model:$("#cfg-gmodel").value};
  if(k){if(!k.startsWith("sk-ant-")){st.className="status err";st.textContent="A Claude API key starts with sk-ant-. Check the key you pasted.";return null}x.api_key=k}
  if(g){if(!/^[A-Za-z0-9_\-]{20,}$/.test(g)){st.className="status err";st.textContent="The Gemini API key does not look right. Copy it again from AI Studio.";return null}x.gemini_key=g}
  return x}
$("#f-key").addEventListener("submit",async e=>{e.preventDefault();const st=$("#s-key"),x=keyFields(st);if(!x)return;
  if(x.provider==="gemini"&&!x.gemini_key&&!CFG.has_gemini){st.className="status err";st.textContent="Paste the Gemini API key first.";return}
  if(x.provider==="claude"&&!x.api_key&&!CFG.has_key){st.className="status err";st.textContent="Paste the Claude API key first.";return}
  if(await saveConfig(x,st)){$("#cfg-key").value="";$("#cfg-gkey").value=""}});
$("#cfg-test").addEventListener("click",async e=>{const st=$("#s-key"),btn=e.currentTarget,x=keyFields(st);if(!x)return;if(!await saveConfig(x,st))return;$("#cfg-key").value="";$("#cfg-gkey").value="";
  if(!CFG.provider){st.className="status";st.textContent="Copy-paste mode is on. There is no connection to test.";return}
  st.className="status";st.textContent="Testing…";btn.disabled=true;
  const j=await api("/api/generate",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({prompt:"Reply with exactly: OK",test:true})});btn.disabled=false;
  const rp=costRp(j.model,j.usage,j.provider);if(rp)addSpent(rp).catch(()=>{});
  if(j.error){st.className="status err";st.textContent=j.error}else{st.className="status";st.textContent="Connected to "+(j.model||"AI")+"."}});
$("#cfg-gmodels").addEventListener("click",async e=>{const st=$("#s-key"),g=$("#cfg-gkey").value.trim();st.className="status";st.textContent="Loading model list…";
  const j=await api("/api/gemini-models",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({key:g})});
  if(j.error){st.className="status err";st.textContent=j.error;return}fillGModels(j.models||[],j.default);st.textContent=`${(j.models||[]).length} models available. Automatic choice: ${j.default||"-"}.`});
function fillGModels(list,def){const sel=$("#cfg-gmodel"),cur=sel.value||CFG.gemini_model||"";sel.innerHTML=`<option value="">Automatic: ${esc(def||"latest Gemini Flash")}</option>`+list.map(m=>`<option value="${esc(m)}">${esc(m)}</option>`).join("");sel.value=list.includes(cur)?cur:""}
$("#cfg-gclear").addEventListener("click",async()=>{if(await saveConfig({clear_gemini:true,provider:$("#cfg-provider").value==="gemini"?"manual":$("#cfg-provider").value},$("#s-key")))$("#s-key").textContent="Gemini key removed."});
$("#cfg-clear").addEventListener("click",async()=>{if(await saveConfig({clear_key:true,provider:$("#cfg-provider").value==="claude"?"manual":$("#cfg-provider").value},$("#s-key")))$("#s-key").textContent="Claude key removed."});
/* ElevenLabs */
let EVOICES=[];
function voiceFields(){$("#cfg-ekey-hint").textContent=CFG.has_eleven?"Saved: key ending in "+CFG.eleven_hint+". Leave the field empty to keep using this key.":"No ElevenLabs key saved yet.";
  const vs=$("#cfg-evoice");if(CFG.eleven_voice&&![...vs.options].some(o=>o.value===CFG.eleven_voice))vs.innerHTML=`<option value="${esc(CFG.eleven_voice)}">${esc(CFG.eleven_voice_name||CFG.eleven_voice)}</option>`;vs.value=CFG.eleven_voice||"";
  const ms=$("#cfg-emodel");if(CFG.eleven_model&&![...ms.options].some(o=>o.value===CFG.eleven_model))ms.insertAdjacentHTML("beforeend",`<option value="${esc(CFG.eleven_model)}">${esc(CFG.eleven_model)}</option>`);ms.value=CFG.eleven_model||"";
  $("#cfg-adir").textContent=CFG.audio_dir?"MP3 files are saved in "+CFG.audio_dir:"";showPreview()}
function showPreview(){const v=EVOICES.find(x=>x.id===$("#cfg-evoice").value);$("#cfg-epreview").innerHTML=v?.preview?`<p class="note">${esc(v.desc||"")}</p><audio controls preload="none" src="${esc(v.preview)}" style="width:100%"></audio>`:""}
$("#cfg-evoice").addEventListener("change",showPreview);
$("#cfg-eload").addEventListener("click",async e=>{const st=$("#s-voice"),k=$("#cfg-ekey").value.trim(),b=e.currentTarget;
  if(!k&&!CFG.has_eleven){st.className="status err";st.textContent="Paste the ElevenLabs API key first.";return}
  st.className="status";st.textContent="Loading voices and quota…";b.disabled=true;
  const j=await api("/api/eleven/info",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({key:k})});b.disabled=false;
  if(j.error){st.className="status err";st.textContent=j.error;return}
  EVOICES=j.voices||[];const cur=$("#cfg-evoice").value||CFG.eleven_voice;
  $("#cfg-evoice").innerHTML=`<option value="">Choose a voice</option>`+EVOICES.map(v=>`<option value="${esc(v.id)}">${esc(v.name)}${v.desc?", "+esc(v.desc):""}</option>`).join("");$("#cfg-evoice").value=EVOICES.some(v=>v.id===cur)?cur:"";
  const mc=$("#cfg-emodel").value||CFG.eleven_model;$("#cfg-emodel").innerHTML=`<option value="">Automatic: Multilingual v2 (most natural)</option>`+(j.models||[]).map(m=>`<option value="${esc(m.id)}">${esc(m.name)}</option>`).join("");$("#cfg-emodel").value=(j.models||[]).some(m=>m.id===mc)?mc:"";
  const reset=j.reset?new Date(j.reset*1000).toLocaleDateString("en-US",{day:"numeric",month:"long"}):"";
  $("#eleven-quota").innerHTML=`<div class="qbar" role="img" aria-label="Quota used ${nf(j.used)} of ${nf(j.limit)} characters"><span style="width:${j.limit?Math.min(100,j.used/j.limit*100).toFixed(1):0}%"></span></div>Plan ${esc(j.tier||"-")}: <strong>${nf(j.left)}</strong> of ${nf(j.limit)} characters${reset?", refills "+reset:""}. One 2,000-word video is about 12,000 characters.`;
  st.textContent=`${EVOICES.length} voices loaded. Pick one, listen to the sample, then Save.`;showPreview()});
$("#f-voice").addEventListener("submit",async e=>{e.preventDefault();const st=$("#s-voice"),k=$("#cfg-ekey").value.trim(),sel=$("#cfg-evoice");
  if(!k&&!CFG.has_eleven){st.className="status err";st.textContent="Paste the ElevenLabs API key first.";return}
  const x={eleven_model:$("#cfg-emodel").value};if(k)x.eleven_key=k;if(sel.value){x.eleven_voice=sel.value;x.eleven_voice_name=EVOICES.find(v=>v.id===sel.value)?.name||sel.selectedOptions[0]?.textContent||""}
  if(await saveConfig(x,st)){$("#cfg-ekey").value="";st.textContent=CFG.eleven_voice?"Saved. The voice over button appears under the full narration script.":"Key saved. Click Load voices, then pick a narrator."}});
$("#cfg-eclear").addEventListener("click",async()=>{if(await saveConfig({clear_eleven:true},$("#s-voice")))$("#s-voice").textContent="ElevenLabs key removed."});
/* Image key: a second Gemini key on a billed project, so text generation can stay on the free key. */
const IMG_PRICE={"gemini-3.1-flash-image":.067,"gemini-3.1-flash-lite-image":.0336,"gemini-nano-banana-2.1":.0336};
const usd=x=>"$"+x.toFixed(2);
const imgMonth=()=>{const s=LAST._img?.data,m=new Date().toISOString().slice(0,7);return s&&s.month===m?s:{month:m,n:0,usd:0}};
const imgSpentText=()=>{const s=imgMonth();return s.n?`This month: ${s.n} images, about ${usd(s.usd)}.`:"No images made this month yet."};
async function addImg(n,model){const s={...imgMonth()};s.n+=n;s.usd+=n*(IMG_PRICE[model]||0);await remember("_img",s);$("#cfg-ispent").textContent=imgSpentText();genBar()}
function imgFields(){$("#cfg-ikey-hint").textContent=CFG.has_image?"Saved: key ending in "+CFG.image_hint+". Leave the field empty to keep using this key.":"No image key saved yet.";
  const s=$("#cfg-imodel");if(CFG.image_model&&![...s.options].some(o=>o.value===CFG.image_model))s.insertAdjacentHTML("beforeend",`<option value="${esc(CFG.image_model)}">${esc(CFG.image_model)}</option>`);s.value=CFG.image_model||"gemini-3.1-flash-image";
  $("#cfg-ispent").textContent=imgSpentText();if(!$("#p-make").hidden)genBar()}
async function saveImageCfg(st){const k=$("#cfg-ikey").value.trim(),x={image_model:$("#cfg-imodel").value};if(k)x.image_key=k;const ok=await saveConfig(x,st);if(ok)$("#cfg-ikey").value="";return ok}
$("#f-image").addEventListener("submit",async e=>{e.preventDefault();const st=$("#s-image");
  if(await saveImageCfg(st))st.textContent=CFG.has_image?"Saved. Click Test image to make sure billing is active.":"Model saved. Paste the key first, then Save."});
$("#cfg-itest").addEventListener("click",async e=>{const st=$("#s-image"),b=e.currentTarget,out=$("#cfg-itest-out");
  if(!await saveImageCfg(st))return;
  if(!CFG.has_image){st.className="status err";st.textContent="Paste the Gemini key for images first.";return}
  b.disabled=true;out.innerHTML="";st.className="status";st.textContent="Gemini is drawing… usually 10 to 40 seconds.";
  const j=await api("/api/image",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({id:"test",slot:0,prompt:"A giant prehistoric cave hyena standing at the mouth of a dark cave at dusk, warm orange light from inside the cave, photorealistic, cinematic, wide 16:9 frame. No text, letters, logos or watermarks."})});
  b.disabled=false;
  if(j.error){st.className="status err";st.textContent=j.error;
    if(/tidak tersedia/.test(j.error)){const m=await api("/api/image-models",{method:"POST"});const s=$("#cfg-imodel");
      (m.models||[]).forEach(n=>{if(![...s.options].some(o=>o.value===n))s.insertAdjacentHTML("beforeend",`<option value="${esc(n)}">${esc(n)}</option>`)});
      if(m.models?.length)st.textContent+=" The models available for this key have been added to the list above.";}
    return}
  addImg(1,j.model).catch(()=>{});
  st.textContent="It works. The key and billing are active, and the Make 3 thumbnails button in the Package step is ready.";
  out.innerHTML=`<img class="gtest" src="/api/gen/${encodeURIComponent(j.file)}?v=${j.v}" alt="Test image from Gemini: a giant hyena at a cave mouth">`});
$("#cfg-iclear").addEventListener("click",async()=>{if(await saveConfig({clear_image:true},$("#s-image")))$("#s-image").textContent="Image key removed."});
/* YouTube Studio */
function ytFields(){const on=!!CFG.yt_connected;$("#yt-on").hidden=!on;$("#yt-setup").open=!CFG.yt_client_id;
  $("#yt-name").textContent=on?(CFG.yt_channel?"Connected: "+CFG.yt_channel:"Connected"):"";
  $("#yt-last").textContent=CFG.yt_synced?"Last pulled "+new Date(CFG.yt_synced*1000).toLocaleString("en-US",{day:"numeric",month:"short",hour:"2-digit",minute:"2-digit"})+". Data is pulled each time the app opens.":"Never pulled yet.";
  $("#yt-connect").textContent=on?"Reconnect":"Save and connect YouTube";
  if(!$("#yt-id").value)$("#yt-id").value=CFG.yt_client_id||"";
  $("#yt-secret-hint").textContent=CFG.has_yt_secret?"Client secret saved. Leave the field empty to keep using it.":"";
  document.querySelectorAll("[data-ytsync]").forEach(b=>b.hidden=!on)}
async function ytSync(st,btn){if(btn)btn.disabled=true;if(st){st.className="status";st.textContent="Pulling data from YouTube…"}
  const j=await api("/api/yt/sync",{method:"POST",headers:{"Content-Type":"application/json"},body:"{}"});if(btn)btn.disabled=false;
  if(j.error){if(st){st.className="status err";st.textContent=j.error}return false}
  if(st)st.textContent=`Done: ${nf(j.videos)} video, ${nf(j.days)} days of data (${j.range}).${j.revenue?"":" Revenue is not included because this account does not give access to revenue data."}`;
  await loadConfig();await loadData();return true}
$("#f-yt").addEventListener("submit",async e=>{e.preventDefault();const st=$("#s-yt"),id=$("#yt-id").value.trim(),sec=$("#yt-secret").value.trim();
  if(!/\.apps\.googleusercontent\.com$/.test(id)){st.className="status err";st.textContent="A Client ID ends with .apps.googleusercontent.com. Copy it again from Google Cloud.";return}
  if(!sec&&!CFG.has_yt_secret){st.className="status err";st.textContent="Paste the Client secret too.";return}
  const x={yt_client_id:id};if(sec)x.yt_secret=sec;if(!await saveConfig(x,st))return;$("#yt-secret").value="";
  const j=await api("/api/yt/connect",{method:"POST",headers:{"Content-Type":"application/json"},body:"{}"});
  if(j.error){st.className="status err";st.textContent=j.error;return}
  st.className="status";st.innerHTML=`The Google sign-in page opened in your browser. Choose the account that owns the channel and allow access, then come back here. If it did not open, <a href="${esc(j.url)}" target="_blank" rel="noopener">click here</a>.`;
  const t0=Date.now(),iv=setInterval(async()=>{await loadConfig();if(CFG.yt_connected){clearInterval(iv);st.textContent="YouTube connected. Pulling data…";ytSync(st)}else if(Date.now()-t0>300000)clearInterval(iv)},3000)});
$("#yt-sync").addEventListener("click",e=>ytSync($("#s-yt"),e.currentTarget));
$("#yt-off").addEventListener("click",async()=>{if(await saveConfig({clear_yt:true},$("#s-yt")))$("#s-yt").textContent="YouTube disconnected. The data already pulled is kept."});
document.addEventListener("click",e=>{const b=e.target.closest("[data-ytsync]");if(b)ytSync($("#s-import")||null,b)});
$("#f-profile").addEventListener("submit",async e=>{e.preventDefault();await saveConfig({},$("#s-profile"))});
$("#pf-export").addEventListener("click",async e=>{const t=JSON.stringify(readProfile(),null,2),b=e.currentTarget;$("#pf-json").hidden=false;$("#pf-json").value=t;try{await navigator.clipboard.writeText(t);b.textContent="Copied"}catch{$("#pf-json").select();b.textContent="Press Ctrl+C"}});
$("#pf-import").addEventListener("click",()=>{const ta=$("#pf-json");if(ta.hidden){ta.hidden=false;ta.value="";ta.placeholder="Paste the profile JSON here, then click Paste profile again";ta.focus();return}
  let p;try{p=JSON.parse(ta.value)}catch{$("#s-profile").className="status err";$("#s-profile").textContent="That text is not a valid profile JSON.";return}
  PROFILE_FIELDS.forEach(([k,id])=>{if(p[k]!=null)$(id).value=p[k]});ta.hidden=true;saveConfig({},$("#s-profile"))});
$("#backup-save").addEventListener("click",async()=>{const st=$("#s-app");const j=await api("/api/backup");if(j.error){st.className="status err";st.textContent=j.error;return}
  const name=`terra-studio-backup-${isoDay(new Date())}.json`,url=URL.createObjectURL(new Blob([JSON.stringify(j)],{type:"application/json"})),a=document.createElement("a");a.href=url;a.download=name;document.body.append(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(url),2000);
  st.className="status";st.textContent=`Backup saved as ${name} in the Downloads folder.`});
let pendingBackup=null;
$("#backup-load").addEventListener("click",()=>$("#backup-file").click());
$("#backup-file").addEventListener("change",async e=>{const f=e.target.files[0];e.target.value="";if(!f)return;const st=$("#s-app");let j;try{j=JSON.parse(await f.text())}catch{st.className="status err";st.textContent="That file is not a Terra Studio backup.";return}
  if(j.app!=="terra-studio"){st.className="status err";st.textContent="That file is not a Terra Studio backup.";return}
  pendingBackup=j;$("#backup-confirm-text").textContent=`Replace the current data with the backup from ${new Date(j.created*1000).toLocaleDateString("en-US",{day:"numeric",month:"long",year:"numeric"})}?`;$("#backup-confirm").hidden=false});
$("#backup-no").addEventListener("click",()=>{pendingBackup=null;$("#backup-confirm").hidden=true});
$("#backup-yes").addEventListener("click",async()=>{if(!pendingBackup)return;const st=$("#s-app");const j=await api("/api/restore",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(pendingBackup)});pendingBackup=null;$("#backup-confirm").hidden=true;
  if(j.error){st.className="status err";st.textContent=j.error;return}st.className="status";st.textContent="Backup restored.";await loadConfig();await loadData();await loadLast();renderDash()});
$("#data-clear").addEventListener("click",()=>$("#data-clear-confirm").hidden=false);
$("#data-clear-no").addEventListener("click",()=>$("#data-clear-confirm").hidden=true);
$("#data-clear-yes").addEventListener("click",async()=>{await api("/api/data",{method:"DELETE"});$("#data-clear-confirm").hidden=true;$("#s-app").className="status";$("#s-app").textContent="Studio data deleted.";await loadData()});
$("#app-quit").addEventListener("click",async()=>{await fetch("/api/quit",{method:"POST",headers:{"X-Terra":"1"}}).catch(()=>{});document.body.innerHTML='<div class="wrap"><h1>Terra Studio is closed.</h1><p class="sub">You can close this window.</p></div>'});

async function loadData(){const j=await api("/api/data");YT=(j&&!j.error&&(j.videos||j.daily))?j:null;
  if(YT&&YT.daily?.length){const ld=new Date(YT.daily[YT.daily.length-1][0]+"T12:00:00"),dim=new Date(ld.getFullYear(),ld.getMonth()+1,0).getDate();YT.partialLast=ld.getDate()<dim}
  renderGrowth();renderDash();renderToday();renderLearn();renderPattern()}
/* Dashboard and calendar */
const TYPE_LABEL={video:"Video",short:"Shorts",post:"Post"},STATUS_LABEL={ide:"Idea",naskah:"Script",rekam:"Voice",edit:"Edit",siap:"Ready to upload",tayang:"Published"};
const plans=()=>LAST.plans?.data||[];
async function savePlans(list){list.sort((a,b)=>a.date.localeCompare(b.date));await remember("plans",list);renderDash();renderPipe();if(!$("#p-make").hidden)renderMake()}
const isoDay=d=>`${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,"0")}-${String(d.getDate()).padStart(2,"0")}`;
let calMonth=(()=>{const d=new Date();return new Date(d.getFullYear(),d.getMonth(),1)})();
let mcMonth=new Date(calMonth),weekStart=(()=>{const d=new Date();d.setHours(12,0,0,0);return d})();
let view="week",typeF="all",query="",mcFocus=null;
const STAGES=["ide","naskah","rekam","edit","siap","tayang"];
const DOW=["Sun","Mon","Tue","Wed","Thu","Fri","Sat"];
const addDays=(d,n)=>{const x=new Date(d);x.setDate(x.getDate()+n);return x};
const match=p=>(typeF==="all"||p.type===typeF)&&(!query||(p.title||"").toLowerCase().includes(query));
const pubs=()=>(YT?.videos||[]).filter(v=>v.d&&(typeF==="all"||(typeF==="short"?v.dur<120:typeF==="video"&&v.dur>=120))&&(!query||(v.t||"").toLowerCase().includes(query)));
const thumbUrl=p=>p.thumb?`/api/thumb/${encodeURIComponent(p.id)}?v=${encodeURIComponent(p.thumb)}`:"";
function cardHTML(p){const st=STAGES.indexOf(p.status),pct=Math.round((Math.max(st,0)+1)/STAGES.length*100),cls=p.status==="ide"?"ide":p.type;
  return `<button type="button" class="k ${esc(cls)}${p.status==="tayang"?" published":""}" data-plan-id="${esc(p.id)}">${p.thumb?`<img src="${thumbUrl(p)}" alt="">`:""}<span class="in"><span class="lb">${p.status==="ide"?"Idea, ":""}${TYPE_LABEL[p.type]||""}</span><span class="tt">${esc(p.title)}</span><span class="pg" role="img" aria-label="Status ${esc(STATUS_LABEL[p.status]||"")}"><i style="width:${pct}%"></i></span><span class="ft">${esc(STATUS_LABEL[p.status]||"")}</span></span></button>`}
function renderWeek(){const today=isoDay(new Date()),end=addDays(weekStart,6);
  $("#wk-title").textContent=weekStart.getMonth()===end.getMonth()?`${weekStart.getDate()} to ${end.getDate()} ${BN[end.getMonth()]} ${end.getFullYear()}`:`${weekStart.getDate()} ${BN[weekStart.getMonth()]} to ${end.getDate()} ${BN[end.getMonth()]}`;
  let h="";for(let i=0;i<7;i++){const d=addDays(weekStart,i),iso=isoDay(d);
    const items=plans().filter(p=>p.date===iso&&match(p)).map(cardHTML).join("")+pubs().filter(v=>v.d===iso).map(v=>`<div class="k pub"><span class="in"><span class="lb">Published, ${v.dur<120?"Shorts":"long video"}</span><span class="tt">${esc(v.t)}</span><span class="ft">${nf(v.v)} views</span></span></div>`).join("");
    h+=`<div class="day${iso===today?" today":""}"><div class="dh"><b>${d.getDate()}</b>${DOW[d.getDay()]}</div>${items}<button type="button" class="add" data-new="${iso}" aria-label="Add a plan for ${d.getDate()} ${BN[d.getMonth()]}">+ Add</button></div>`}
  $("#wk").innerHTML=h}
function renderCal(){const y=calMonth.getFullYear(),m=calMonth.getMonth(),first=new Date(y,m,1),days=new Date(y,m+1,0).getDate(),lead=(first.getDay()+6)%7,today=isoDay(new Date());
  const title=first.toLocaleDateString("en-US",{month:"long",year:"numeric"});if(view==="month")$("#wk-title").textContent=title;
  const byDay={};const add=(d,html)=>{(byDay[d]=byDay[d]||[]).push(html)};const pre=`${y}-${String(m+1).padStart(2,"0")}`;
  pubs().forEach(v=>{if(v.d.startsWith(pre))add(v.d,`<span class="ev pub" title="${esc(v.t)}, ${nf(v.v)} views"><i>${v.dur<120?"Shorts":"Published"}</i>${esc(v.t)}</span>`)});
  plans().filter(match).forEach(p=>add(p.date,`<button type="button" class="ev ${esc(p.type)}${p.status==="tayang"?" done":""}" data-plan-id="${esc(p.id)}" title="${esc(p.title)}, ${STATUS_LABEL[p.status]||""}"><i>${STATUS_LABEL[p.status]||""}</i>${esc(p.title)}</button>`));
  const head=["Mon","Tue","Wed","Thu","Fri","Sat","Sun"].map(d=>`<div class="cal-dow" aria-hidden="true">${d}</div>`).join("");
  let cells="";for(let i=0;i<lead;i++)cells+=`<div class="cal-day off" aria-hidden="true"></div>`;
  for(let d=1;d<=days;d++){const iso=`${pre}-${String(d).padStart(2,"0")}`;
    cells+=`<div class="cal-day${iso===today?" today":""}"><button type="button" class="cal-num" data-new="${iso}" aria-label="Add a plan for ${d} ${title}">${d}</button>${(byDay[iso]||[]).join("")}</div>`}
  const tail=(7-(lead+days)%7)%7;for(let i=0;i<tail;i++)cells+=`<div class="cal-day off" aria-hidden="true"></div>`;
  $("#cal").innerHTML=head+cells}
function renderMini(){const y=mcMonth.getFullYear(),m=mcMonth.getMonth(),days=new Date(y,m+1,0).getDate(),lead=(new Date(y,m,1).getDay()+6)%7,today=isoDay(new Date()),pre=`${y}-${String(m+1).padStart(2,"0")}`;
  $("#mc-title").textContent=new Date(y,m,1).toLocaleDateString("en-US",{month:"long",year:"numeric"});
  const kind={},pub={};plans().filter(match).forEach(p=>{if(p.date.startsWith(pre)&&!kind[p.date])kind[p.date]=p.type});pubs().forEach(v=>{if(v.d.startsWith(pre))pub[v.d]=1});
  // One tab stop for the whole month; arrow keys move between days.
  const stop=mcFocus&&mcFocus.startsWith(pre)?mcFocus:today.startsWith(pre)?today:pre+"-01";
  let h=["S","S","R","K","J","S","M"].map(d=>`<span class="dow" aria-hidden="true">${d}</span>`).join("");for(let i=0;i<lead;i++)h+=`<span class="d e" aria-hidden="true"></span>`;
  for(let d=1;d<=days;d++){const iso=`${pre}-${String(d).padStart(2,"0")}`,k=kind[iso];
    h+=`<button type="button" tabindex="${iso===stop?0:-1}" class="d${k?" "+k:""}${pub[iso]?" pub":""}${iso===today?" today":""}" data-day="${iso}" aria-label="${d} ${$("#mc-title").textContent}${k?", has a plan: "+(TYPE_LABEL[k]||""):""}${pub[iso]?", has a published video":""}">${d}</button>`}
  $("#mc").innerHTML=h;
  const n=plans().filter(p=>p.date.startsWith(pre)&&p.status!=="tayang").length;$("#mc-sub").textContent=n?`${n} plans this month`:"No plans this month yet"}
function renderNext(){const today=isoDay(new Date()),p=plans().filter(x=>x.date>=today&&x.status!=="tayang")[0],el=$("#next-up");
  if(!p){el.className="next noimg";el.innerHTML=`<div class="top"><span>Next upload</span></div><h3>Nothing scheduled</h3><p>Make a video plan so the upload schedule shows here.</p><div class="row"><button type="button" class="p" data-act="new">Make a plan</button></div>`;return}
  const d=new Date(p.date+"T12:00:00"),days=Math.round((d-new Date(today+"T12:00:00"))/864e5),when=days===0?"Today":days===1?"Tomorrow":`${days} days left`;
  el.className="next"+(p.thumb?"":" noimg");
  el.innerHTML=`<div class="top"><span>${d.toLocaleDateString("en-US",{weekday:"long",day:"numeric",month:"short"})}</span><span class="badge">${when}</span></div><h3>${esc(p.title)}</h3><div class="row"><button type="button" class="p" data-act="tools" data-id="${esc(p.id)}">Work on it</button><button type="button" class="s" data-plan-id="${esc(p.id)}">Edit</button></div>${p.thumb?`<img class="stk" src="${thumbUrl(p)}" alt="">`:""}`}
function renderStages(){const today=isoDay(new Date()),list=plans().filter(p=>p.date>=today&&p.status!=="tayang");const C={ide:"var(--accent)",naskah:"var(--bone)",rekam:"var(--stone)",edit:"var(--rust)",siap:"var(--ok)"};
  $("#stages").innerHTML=STAGES.slice(0,5).map(s=>`<li style="--c:${C[s]}"><i></i>${STATUS_LABEL[s]}<b>${list.filter(p=>p.status===s).length}</b></li>`).join("")}
const vcRange=()=>{const r=store.get("vr","30");return ["30","90","12"].includes(r)?r:"30"};
function viewSeries(){const d=YT?.daily||[],r=vcRange();
  if(r==="12"){const end=dataEnd(),part=YT.partialLast;return monthly().slice(-12).map(([m,v],i,a)=>{const mo=BN[+m.slice(5,7)-1];return {v,short:mo,long:mo+" "+m.slice(0,4)+(part&&i===a.length-1?` (to day ${+end.slice(8)})`:"")}})}
  return d.slice(-(+r)).map(([k,v])=>{const lbl=+k.slice(8)+" "+BN[+k.slice(5,7)-1];return {v,short:lbl,long:lbl+" "+k.slice(0,4)}})}
let VC=null;
function renderViews(){const box=$("#vc"),svg=$("#vc-svg"),d=YT?.daily||[],r=vcRange();if(!box)return;
  $("#vc-seg").querySelectorAll("button").forEach(b=>b.setAttribute("aria-pressed",b.dataset.r===r));
  $("#vc-tp").hidden=true;VC=null;
  if(d.length<14){$("#vc-sub").textContent="The chart appears once Studio data is imported or YouTube is connected.";svg.innerHTML="";return}
  const W=box.clientWidth,H=box.clientHeight;if(!W)return;
  const s=viewSeries(),n=s.length,pl=44,pr=4,pt=8,pb=24,pw=W-pl-pr,ph=H-pt-pb,top=Math.max(...s.map(x=>x.v),1);
  const ts=niceStep(top/5);
  const nt=Math.ceil(top/ts),max=ts*nt,step=pw/n,bw=Math.max(2,step-(n>40?1.5:n>20?3:8)),rx=Math.min(4,bw/2),y=v=>pt+ph-v/max*ph;
  const every=(n<=12?[1,2,3,6]:[5,10,15,30]).find(k=>k*step>=50)||n;
  let h="";
  for(let i=0;i<=nt;i++){const v=ts*i,yy=y(v);h+=`<line x1="${pl}" x2="${W-pr}" y1="${yy}" y2="${yy}"/><text x="${pl-8}" y="${yy+4}" text-anchor="end">${v>=1000?f1(v/1000)+"K":nf(v)}</text>`}
  s.forEach((x,i)=>{const bx=pl+i*step+(step-bw)/2,t=Math.min(y(x.v),pt+ph-1);
    h+=`<path class="b" data-i="${i}" d="M${bx},${pt+ph}V${t+rx}a${rx},${rx} 0 0 1 ${rx},-${rx}h${bw-2*rx}a${rx},${rx} 0 0 1 ${rx},${rx}V${pt+ph}z"/>`;
    if((n-1-i)%every===0)h+=`<text x="${i===n-1?bx+bw:bx+bw/2}" y="${H-6}" text-anchor="${i===n-1?"end":"middle"}">${x.short}</text>`});
  svg.setAttribute("viewBox",`0 0 ${W} ${H}`);svg.innerHTML=h;
  const sum=s.reduce((a,x)=>a+x.v,0),peak=s.reduce((b,x)=>x.v>b.v?x:b,s[0]);
  $("#vc-sub").innerHTML=r==="12"?`${n} months: <b>${nf(sum)}</b> views. Peak ${peak.long}, ${nf(peak.v)}.`:`${n} days: <b>${nf(sum)}</b> views, an average of ${nf(sum/n)} per day.`;
  VC={s,pl,step,W,y,i:-1}}
function vcShow(i){const tp=$("#vc-tp");if(!VC)return;
  $("#vc-svg").querySelectorAll(".b").forEach(b=>b.classList.toggle("on",+b.dataset.i===i));
  const x=VC.s[i];VC.i=x?i:-1;if(!x){tp.hidden=true;return}
  tp.hidden=false;tp.innerHTML=`${x.long}<b>${nf(x.v)} views</b>`;
  const cx=VC.pl+(i+.5)*VC.step,tw=tp.offsetWidth;
  tp.style.transform=`translate(${Math.max(0,Math.min(VC.W-tw,cx-tw/2))}px,${Math.max(0,VC.y(x.v)-tp.offsetHeight-8)}px)`}
(function(){const box=$("#vc");if(!box)return;
  const at=e=>{if(VC)vcShow(Math.floor((e.clientX-box.getBoundingClientRect().left-VC.pl)/VC.step))};
  box.addEventListener("pointermove",at);box.addEventListener("pointerdown",at);
  box.addEventListener("pointerleave",()=>vcShow(-1));box.addEventListener("blur",()=>vcShow(-1));
  box.addEventListener("keydown",e=>{const d={ArrowLeft:-1,ArrowRight:1}[e.key];if(!d||!VC)return;e.preventDefault();const n=VC.s.length;vcShow(VC.i<0?(d>0?0:n-1):Math.min(n-1,Math.max(0,VC.i+d)))});
  $("#vc-seg").addEventListener("click",e=>{const b=e.target.closest("button");if(!b)return;store.set("vr",b.dataset.r);renderViews()});
  let w=0;new ResizeObserver(()=>{const n=box.clientWidth;if(n&&n!==w){w=n;if(!$("#p-today").hidden)renderViews()}}).observe(box)})();

function renderTop(){const list=longForm().sort((a,b)=>b.v-a.v).slice(0,5);
  $("#topv").innerHTML=list.length?list.map(v=>`<li><span class="pl" aria-hidden="true"><svg viewBox="0 0 14 14"><path d="M4 2.5v9l7.5-4.5z"/></svg></span><span class="t" title="${esc(v.t)}">${esc(v.t)}</span><span class="v">${nf(v.v)}</span>${v.ctr?`<span class="c">${(+v.ctr).toLocaleString("en-US",{maximumFractionDigits:1})}%</span>`:""}</li>`).join(""):`<li class="empty-s">No video data yet.</li>`}
function renderKpis(){const el=$("#td-kpis");if(!el)return;const t=YT?.totals||{},d=YT?.daily||[],since=d.length?`since ${BN[+d[0][0].slice(5,7)-1]} ${d[0][0].slice(0,4)}`:"";
  let note="";if(d.length>=60){const a=lastDays(30),b=lastDays(30,30);if(b){const p=Math.round((a/b-1)*100);note=`<em class="${p<0?"dn":"upc"}">${p<0?"down":"up"} ${Math.abs(p)}%</em> from the 30 days before`}}
  const k=[["Views, 30 days",d.length?nf(lastDays(30)):"-",note],["Net subscribers",t.subs!=null?(t.subs>=0?"+":"")+nf(t.subs):"-",since],["Watch hours",t.hours!=null?nf(t.hours):"-",since],["Estimated revenue",t.revenue!=null?moneyShort(t.revenue):"-",since]];
  el.innerHTML=k.map(([l,v,n])=>`<div class="box kpi"><span>${l}</span><b>${v}</b><small>${n}</small></div>`).join("")}

function renderBoard(){$("#wk").hidden=view!=="week";$("#cal-wrap").hidden=view!=="month";if(view==="week")renderWeek();else renderCal()}
function renderDash(){if(!$("#wk"))return;renderBoard();renderMini();renderNext();renderStages()}
let editing=null,pendingThumb=undefined;
function openPlan(p){editing=p.id?p:null;pendingThumb=undefined;$("#plan-dlg-title").textContent=editing?"Edit plan":"New plan";$("#pl-title").value=p.title||"";$("#pl-date").value=p.date||isoDay(new Date());$("#pl-type").value=p.type||"video";$("#pl-status").value=p.status||"ide";$("#pl-note").value=p.note||"";$("#pl-del").hidden=!editing;$("#pl-tools").hidden=!editing;
  setThumbPreview(p.thumb?thumbUrl(p):"");$("#plan-dlg").showModal();$("#pl-title").focus()}
function setThumbPreview(src){$("#pl-thumb-box").innerHTML=src?`<img src="${esc(src)}" alt="">`:"";$("#pl-thumb-del").hidden=!src}
$("#pl-thumb-pick").addEventListener("click",()=>$("#pl-thumb-file").click());
$("#pl-thumb-file").addEventListener("change",e=>{const f=e.target.files[0];e.target.value="";if(!f)return;if(f.size>8*1024*1024){alert("The image is too large, 8 MB at most.");return}pendingThumb=f;setThumbPreview(URL.createObjectURL(f))});
$("#pl-thumb-del").addEventListener("click",()=>{pendingThumb=null;setThumbPreview("")});
$("#plan-form").addEventListener("submit",async e=>{if(e.submitter?.value!=="save")return;const list=plans().filter(x=>!editing||x.id!==editing.id);
  const id=editing?.id||Date.now().toString(36)+Math.random().toString(36).slice(2,6);let thumb=editing?.thumb||"";
  if(pendingThumb){const r=await api("/api/thumb?id="+encodeURIComponent(id),{method:"POST",headers:{"Content-Type":pendingThumb.type||"application/octet-stream"},body:pendingThumb});if(r.ok)thumb=String(Date.now());else alert(r.error||"The thumbnail could not be saved.")}
  else if(pendingThumb===null&&thumb){await api("/api/thumb?id="+encodeURIComponent(id),{method:"DELETE"});thumb=""}
  list.push({id,title:$("#pl-title").value.trim(),date:$("#pl-date").value,type:$("#pl-type").value,status:$("#pl-status").value,note:$("#pl-note").value.trim(),...(thumb?{thumb}:{})});
  const d=new Date($("#pl-date").value+"T12:00:00");calMonth=new Date(d.getFullYear(),d.getMonth(),1);mcMonth=new Date(calMonth);await savePlans(list)});
$("#pl-del").addEventListener("click",async()=>{if(!editing)return;$("#plan-dlg").close();if(editing.thumb)await api("/api/thumb?id="+encodeURIComponent(editing.id),{method:"DELETE"});await savePlans(plans().filter(x=>x.id!==editing.id))});
$("#pl-tools").addEventListener("click",()=>{$("#plan-dlg").close();if(editing)openMake(editing.id)});
$("#banner-close").addEventListener("click",()=>{store.set("banner-off",true);$("#banner-key").hidden=true});
const skinName=()=>{$("#skin-name").textContent=document.documentElement.dataset.skin==="lumut"?"Moss theme":"Stone theme"};
$("#plan-new").addEventListener("click",()=>openPlan({}));$("#rail-plus").addEventListener("click",()=>openPlan({}));
$("#skin-tog").addEventListener("click",()=>{const k=document.documentElement.dataset.skin==="lumut"?"batu":"lumut";document.documentElement.dataset.skin=k;store.set("skin",k);skinName();api("/api/skin?skin="+k,{method:"POST"});if(YT&&!$("#p-growth").hidden)chart()});
document.querySelectorAll(".seg button").forEach(b=>b.addEventListener("click",()=>{view=b.dataset.view;document.querySelectorAll(".seg button").forEach(x=>x.setAttribute("aria-pressed",x===b));renderBoard()}));
const shift=n=>{if(view==="week")weekStart=addDays(weekStart,7*n);else calMonth=new Date(calMonth.getFullYear(),calMonth.getMonth()+n,1);renderBoard()};
$("#wk-prev").addEventListener("click",()=>shift(-1));$("#wk-next").addEventListener("click",()=>shift(1));
$("#wk-today").addEventListener("click",()=>{const d=new Date();d.setHours(12,0,0,0);weekStart=d;calMonth=new Date(d.getFullYear(),d.getMonth(),1);renderBoard()});
$("#pp-q").addEventListener("input",e=>{query=e.target.value.trim().toLowerCase();renderBoard();renderMini()});
document.querySelectorAll("#mc-pills button").forEach(b=>b.addEventListener("click",()=>{typeF=b.dataset.f;document.querySelectorAll("#mc-pills button").forEach(x=>x.setAttribute("aria-pressed",x===b));renderMini();renderBoard()}));
$("#mc-prev").addEventListener("click",()=>{mcMonth=new Date(mcMonth.getFullYear(),mcMonth.getMonth()-1,1);renderMini()});
$("#mc-next").addEventListener("click",()=>{mcMonth=new Date(mcMonth.getFullYear(),mcMonth.getMonth()+1,1);renderMini()});
$("#mc").addEventListener("keydown",e=>{const b=e.target.closest("[data-day]"),step={ArrowLeft:-1,ArrowRight:1,ArrowUp:-7,ArrowDown:7}[e.key];if(!b||step==null)return;e.preventDefault();
  const d=addDays(new Date(b.dataset.day+"T12:00:00"),step);mcFocus=isoDay(d);mcMonth=new Date(d.getFullYear(),d.getMonth(),1);renderMini();$(`#mc [data-day="${mcFocus}"]`).focus()});
document.addEventListener("click",async e=>{
  const day=e.target.closest("[data-day]");if(day){const d=new Date(day.dataset.day+"T12:00:00");weekStart=d;mcFocus=day.dataset.day;calMonth=new Date(d.getFullYear(),d.getMonth(),1);view="week";document.querySelectorAll(".seg button").forEach(x=>x.setAttribute("aria-pressed",x.dataset.view==="week"));show("dash");return}
  const act=e.target.closest("[data-act]");if(act){if(act.dataset.act==="new")return openPlan({});const p=plans().find(x=>x.id===act.dataset.id);if(p)openMake(p.id);return}
  const n=e.target.closest("[data-new]");if(n)return openPlan({date:n.dataset.new});
  const pi=e.target.closest("[data-plan-id]");if(pi){const p=plans().find(x=>x.id===pi.dataset.planId);if(p)openPlan(p);return}
  const pl=e.target.closest("[data-plan]");if(pl){await savePlans([...plans(),{id:Date.now().toString(36)+Math.random().toString(36).slice(2,6),title:pl.dataset.plan,date:pl.dataset.date,type:"video",status:"ide",note:""}]);pl.textContent="Added to calendar";pl.disabled=true;return}
  if(e.target.closest("#plan-all")){const btns=[...document.querySelectorAll("#o-ideas [data-plan]:not([disabled])")];const add=btns.map((b,i)=>({id:Date.now().toString(36)+i+Math.random().toString(36).slice(2,5),title:b.dataset.plan,date:b.dataset.date,type:"video",status:"ide",note:""}));btns.forEach(b=>{b.textContent="Added to calendar";b.disabled=true});if(add.length)await savePlans([...plans(),...add]);e.target.textContent=add.length?`${add.length} ideas added to the calendar`:"All already in the calendar"}
});

/* 2.0 growth loop: Today, Learn, Ideas pattern and the Make workspace.
   Everything here is plain rules on the channel's own numbers; only the buttons that say "AI" call a model. */
const med=a=>{const b=a.filter(x=>x!=null&&!isNaN(x)).sort((x,y)=>x-y),m=b.length>>1;return b.length?(b.length%2?b[m]:(b[m-1]+b[m])/2):null};
const share=v=>v&&v.v&&v.dur?Math.min(100,v.h*3600/v.v/v.dur*100):null;
const avdMin=v=>v&&v.v?v.h*60/v.v:null;
const ctrOf=v=>v&&v.ctr>0?+v.ctr:null,impOf=v=>v&&v.imp>0?+v.imp:null;
const uploads=()=>longForm().filter(v=>v.d&&v.v>0).sort((a,b)=>a.d.localeCompare(b.d));
const winners=()=>[...longForm()].sort((a,b)=>b.v-a.v).slice(0,6);
const range=(a,fmt)=>{const b=a.filter(x=>x!=null);if(!b.length)return "-";const lo=Math.min(...b),hi=Math.max(...b);return fmt(lo)===fmt(hi)?fmt(lo):fmt(lo)+" to "+fmt(hi)};
const THREAT=/hunt|killer|kill|butcher|predator|\bate\b|eats?\b|eating|devour|terror|deadl|monster|crush|apex|nightmare|fear|slaughter|ripper|stalk|prey|bite|jaw|savage|beast|menace|danger|attack|blood/i;
// In spoken openings, putting people in the scene also counts as the danger.
const HOOK_DANGER=new RegExp(THREAT.source+"|ancestors|humans|our species|people",'i');
const SIZE=/\d|giant|biggest|largest|huge|colossal|massive|\bton|\blbs?\b|pound|feet|foot|meter|metre|tall|titan|mega|heaviest|strongest/i;
const dataEnd=()=>YT?.daily?.length?YT.daily[YT.daily.length-1][0]:isoDay(new Date());
const daysBetween=(a,b)=>Math.round((new Date(b+"T12:00:00")-new Date(a+"T12:00:00"))/864e5);
const pctTxt=x=>x==null?"-":f1(x)+"%";
function usShare(){const g=YT?.geo||[];const tv=g.reduce((s,r)=>s+(+r.views||0),0),tr=g.reduce((s,r)=>s+(+r.rev||0),0),us=g.find(r=>/united states|amerika serikat|^us$/i.test(r.name||""));
  return us&&tv?{views:Math.round(us.views/tv*100),rev:tr?Math.round((us.rev||0)/tr*100):null}:null}
function channelNumbers(){const up=uploads(),W=winners(),R=up.slice(-5);
  const n={up,W,R,wS:med(W.map(share)),rS:med(R.map(share)),wC:med(W.map(ctrOf)),rC:med(R.map(ctrOf)),wI:med(W.map(impOf)),rI:med(R.map(impOf))};
  n.ret=n.wS&&n.rS!=null&&n.rS<n.wS*0.6;n.ctr=n.wC&&n.rC!=null&&n.rC<n.wC*0.75;n.reach=n.wI&&n.rI!=null&&n.rI<n.wI*0.2;
  n.lever=n.ret?"ret":n.ctr?"ctr":n.reach?"reach":"ok";return n}
function lessonFor(v,n){const s=share(v),c=ctrOf(v),i=impOf(v);
  const best=[...n.W].sort((a,b)=>(share(b)||0)-(share(a)||0))[0];
  if(s!=null&&s<10)return `Only ${f1(s)}% watched, viewers leave early. Compare its first minute with "${best?best.t:"best videos"}".`;
  if(c&&n.wC&&c<n.wC*0.6)return `CTR ${f1(c)}%, far below your best videos (${f1(n.wC)}%). The title or thumbnail does not pull clicks.`;
  if(i&&n.wI&&i<n.wI*0.05&&s>=20)return `Viewers stay (${f1(s)}%), but YouTube only showed it ${nf(i)} times. A stronger topic and package opens up reach.`;
  if(s>=20)return `Close to your best videos (${f1(s)}% watched). Repeat how this video opens.`;
  return s==null?"Video length is not in the data yet.":`${f1(s)}% watched, below your best videos (${f1(n.wS)}%). Get to the heart of the story sooner.`}

function spark(vals,lo,hi,color){const v=vals.filter(x=>x!=null);if(v.length<2)return "";const w=300,h=46,n=v.length,x=i=>4+i*(w-8)/(n-1),y=t=>h-4-(Math.min(hi,Math.max(lo,t))-lo)/((hi-lo)||1)*(h-8);
  const d=v.map((t,i)=>`${i?"L":"M"}${x(i).toFixed(1)} ${y(t).toFixed(1)}`).join("");
  return `<svg class="spk" viewBox="0 0 ${w} ${h}" preserveAspectRatio="none" aria-hidden="true"><path d="${d}L${x(n-1)} ${h}L${x(0)} ${h}Z" fill="${color}" fill-opacity=".14" stroke="none"/><path d="${d}" fill="none" stroke="${color}" stroke-width="2" vector-effect="non-scaling-stroke"/></svg>`}

function renderNextVideo(){const el=$("#td-next");if(!el)return;const today=isoDay(new Date()),list=plans().filter(x=>x.type==="video"&&x.status!=="tayang"),p=list.filter(x=>x.date>=today)[0]||list[list.length-1];
  if(!p){el.className="next noimg";el.innerHTML=`<div class="top"><span>Next video</span></div><h3>No video scheduled</h3><p>The app picks a topic, title and hook from the pattern of your best videos, then writes the script.</p><div class="row"><button type="button" class="p" data-act="one">Make script in 1 click</button></div>`;return}
  const d=new Date(p.date+"T12:00:00"),days=daysBetween(today,p.date),when=days<0?"past due":days===0?"Today":days===1?"Tomorrow":`${days} days left`,early=p.status==="ide"||p.status==="naskah";
  el.className="next"+(p.thumb?"":" noimg");
  el.innerHTML=`<div class="top"><span>Next video · ${d.toLocaleDateString("en-US",{weekday:"long",day:"numeric",month:"short"})}</span><span class="badge">${when}</span></div><h3>${esc(p.title)}</h3><p>Current step: ${STATUS_LABEL[p.status]||p.status}.</p><div class="row">${early?`<button type="button" class="p" data-act="one" data-id="${esc(p.id)}">Make script in 1 click</button><button type="button" class="s" data-act="open" data-id="${esc(p.id)}">Open</button>`:`<button type="button" class="p" data-act="open" data-id="${esc(p.id)}">Continue</button>`}</div>${p.thumb?`<img class="stk" src="${thumbUrl(p)}" alt="">`:""}`}
$("#td-next").addEventListener("click",e=>{const b=e.target.closest("[data-act]");if(!b)return;
  if(b.dataset.act==="open")return openMake(b.dataset.id);
  if(b.dataset.id)openMake(b.dataset.id,"script");else $("#td-new").click();
  oneClick($("#mk-one"))});
function renderStg(){const el=$("#td-stg");if(!el)return;const list=plans().filter(p=>p.type!=="post"&&p.status!=="tayang");
  el.innerHTML=PIPE.map(([s,l])=>{const n=list.filter(p=>p.status===s).length;return `<li class="${n?"":"z"}" title="${l}"><b>${n}</b>${l==="Ready to upload"?"Ready":l}</li>`}).join("")}

function renderToday(){if(!$("#td-kpis"))return;const has=uploads().length>=6,dl=YT?.daily||[];
  $("#today-sub").textContent=new Date().toLocaleDateString("en-US",{weekday:"long",day:"numeric",month:"long",year:"numeric"})+(dl.length?` · data up to ${fmtShort(dataEnd())}`:"");
  $("#td-empty").hidden=has;$("#td-full").hidden=!has;$("#td-gradebox").hidden=!has;
  renderKpis();renderViews();renderTop();renderNextVideo();renderStg();renderPipe();if(!has)return;
  const n=channelNumbers(),{W,R}=n;
  const set=(h,p,label,fn)=>{$("#dx-h").textContent=h;$("#dx-p").textContent=p;const b=$("#dx-go");b.textContent=label;b.onclick=fn};
  if(n.lever==="ret")set("Viewers leave in the first minute.","Fix the first 60 seconds of every script first.","Open hook coach",()=>openMake(null,"hook"));
  else if(n.lever==="ctr")set("Videos are shown, but rarely clicked.","Fix the title and thumbnail first, before writing the script.","Open video package",()=>openMake(null,"pkg"));
  else if(n.lever==="reach")set("YouTube rarely shows your new videos.","Pick topics close to your best videos.","Find the next topic",()=>show("ideas"));
  else set("Recent uploads are in line with your best videos.","Keep the schedule and keep picking topics that match the pattern.","Find the next topic",()=>show("ideas"));
  const bar=(lbl,val,txt,w,cls)=>`<div><div class="lbl"><span>${lbl}</span><b>${val}</b></div><div class="track"><div class="fill ${cls}" style="width:${Math.max(w,3)}%">${txt}</div></div></div>`;
  let cmp;
  if(n.lever==="ctr"&&n.wC&&n.rC)cmp=bar("CTR, 6 best videos",pctTxt(n.wC),"",n.wC/8*100,"win")+bar("CTR, last 5 uploads",pctTxt(n.rC),"",n.rC/8*100,"now");
  else if(n.lever==="reach"&&n.wI&&n.rI)cmp=bar("Thumbnail impressions per best video",nf(n.wI),"",100,"win")+bar("Thumbnail impressions per recent upload",nf(n.rI),"",n.rI/n.wI*100,"now");
  else{const sc=Math.max(40,Math.max(n.wS||0,n.rS||0)*1.2);
    cmp=bar("Share watched, 6 best videos",pctTxt(n.wS),n.wS/sc*100>30?`average ${f1(med(W.map(avdMin)))} min`:"",n.wS/sc*100,"win")+bar("Share watched, last 5 uploads",pctTxt(n.rS),n.rS/sc*100>30?`${f1(med(R.map(avdMin)))} min`:"",n.rS/sc*100,"now")}
  $("#dx-cmp").innerHTML=cmp+`<small>Median values; both bars use the same scale.</small>`;
  renderMoves(n);renderGrade(n)}

const weekKey=()=>{const d=new Date();d.setDate(d.getDate()-((d.getDay()+6)%7));return isoDay(d)};
function renderMoves(n){const us=usShare(),soon=plans().some(p=>p.status!=="tayang"&&p.date>=isoDay(new Date())&&daysBetween(isoDay(new Date()),p.date)<=7);
  const M={ret:{t:"Rewrite the first 60 seconds of the next video",d:"Open straight with the animal and the danger, no channel intro.",tag:"retensi",bad:1,go:()=>openMake(null,"hook")},
    ctr:{t:"Prepare 3 titles and 2 thumbnails before upload",d:`CTR of the last 5 uploads ${pctTxt(n.rC)}, best videos ${pctTxt(n.wC)}.`,tag:"clicks",bad:1,go:()=>openMake(null,"pkg")},
    topic:{t:"Pick the next topic from Ideas",d:"Pick a topic that scores 4 or 5 and matches the pattern of your best videos.",tag:"topic",go:()=>show("ideas")},
    time:us?{t:"Publish at 07:00 WIB",d:`That is evening in America. US viewers bring ${us.views}% views${us.rev!=null?` and ${us.rev}% of revenue`:""} of yours.`,tag:"time"}:null,
    plan:soon?null:{t:"Schedule the next upload",d:"No video in the calendar for the next 7 days.",tag:"schedule",go:()=>openPlan({})}};
  const order=[n.ret&&"ret",n.ctr&&"ctr","topic","time","plan","ctr"].filter((k,i,a)=>k&&M[k]&&a.indexOf(k)===i).slice(0,3);
  const st=LAST.week?.data?.wk===weekKey()?LAST.week.data.done:[];
  $("#td-moves").innerHTML=order.map((k,i)=>{const m=M[k],on=st.includes(k);return `<li class="${on?"done":""}"><input type="checkbox" id="mv-${k}" data-move="${k}" ${on?"checked":""}><div><label for="mv-${k}" class="mv-t">${esc(m.t)}</label><span>${esc(m.d)}</span>${m.go?`<button type="button" class="linkish" data-move-go="${k}">Do it</button>`:""}</div></li>`}).join("");
  $("#td-moves").onclick=e=>{const g=e.target.closest("[data-move-go]");if(g)M[g.dataset.moveGo].go()};
  $("#td-moves").onchange=e=>{const c=e.target.closest("[data-move]");if(!c)return;let done=LAST.week?.data?.wk===weekKey()?[...LAST.week.data.done]:[];done=c.checked?[...new Set([...done,c.dataset.move])]:done.filter(x=>x!==c.dataset.move);c.closest("li").classList.toggle("done",c.checked);remember("week",{wk:weekKey(),done}).catch(()=>{})}}
function renderGrade(n){const up=n.up,L=up[up.length-1],prev=up.slice(-11,-1),age=daysBetween(L.d,dataEnd());
  $("#td-last-sub").textContent=`${L.t} · ${fmtShort(L.d)}${age<7?`, only ${Math.max(age,0)} days old: numbers still moving`:""}`;
  const rows=[["Share watched",share(L),med(prev.map(share)),pctTxt],["CTR",ctrOf(L),med(prev.map(ctrOf)),pctTxt],["Thumbnail impressions",impOf(L),med(prev.map(impOf)),nf],["Views",L.v,med(prev.map(v=>v.v)),nf]].filter(r=>r[1]!=null&&r[2]!=null);
  $("#td-grade").innerHTML=`<div class="grade">${rows.map(([k,v,m,f])=>{const ok=v>=m;return `<div class="gr"><span>${k}</span><span class="num"><b>${f(v)}</b> <span class="muted">vs ${f(m)} usual</span></span><span class="pill ${ok?"good":"bad"}">${ok?"above usual":"below usual"}</span></div>`}).join("")}</div><p class="sub" style="margin-top:12px"><b>Lesson:</b> ${esc(lessonFor(L,n))}</p>`}

const PIPE=[["ide","Idea"],["naskah","Script"],["rekam","Voice"],["edit","Edit"],["siap","Ready to upload"]];
// Status only moves forward, so a manual "Edit" is never pulled back by re-running an earlier step.
async function advance(id,status){const p=plans().find(x=>x.id===id);if(!p||STAGES.indexOf(status)<=STAGES.indexOf(p.status))return;
  await remember("plans",plans().map(x=>x.id===id?{...x,status}:x)).catch(()=>{});renderDash();renderPipe();renderStg();renderNextVideo()}
const NEXT={ide:["Package and script","Make it in 1 click","one"],naskah:["Write the full script","Write script in 1 click","one"],rekam:["Make the voice over","Open voice over","vo"],edit:["Edit in Premiere","Mark as edited","siap"],siap:["Upload to YouTube","Mark as published","tayang"]};
function renderPipe(){const el=$("#td-pipe");if(!el)return;const today=isoDay(new Date()),rank=s=>-STAGES.indexOf(s);
  const list=plans().filter(p=>p.type!=="post"&&p.status!=="tayang").sort((a,b)=>rank(a.status)-rank(b.status)||a.date.localeCompare(b.date));
  if(!list.length){el.innerHTML=`<li class="nx-empty">Nothing in progress. Press "New video" and the app suggests a topic.</li>`;return}
  el.innerHTML=list.map(p=>{const [step,label,act]=NEXT[p.status]||NEXT.ide,late=p.date<today;
    return `<li><button type="button" class="nx-t" data-make="${esc(p.id)}"><b>${esc(p.title)}</b><small>${p.type==="short"?"Short · ":""}${fmtShort(p.date)}${late?" · past due":""}</small></button><span class="pill st-${p.status}">${STATUS_LABEL[p.status]||p.status}</span><span class="nx-s">Next: ${step}</span><button type="button" class="btn ${act==="one"?"":"ghost"} sm" data-nx="${act}" data-id="${esc(p.id)}">${label}</button></li>`}).join("")}
document.addEventListener("click",e=>{const b=e.target.closest("[data-make]");if(b)openMake(b.dataset.make)});
$("#td-pipe").addEventListener("click",async e=>{const b=e.target.closest("[data-nx]");if(!b)return;const id=b.dataset.id,a=b.dataset.nx;
  if(a==="one"){openMake(id,"script");return oneClick($("#mk-one"))}
  if(a==="vo"){openMake(id,"script");return requestAnimationFrame(()=>$("#vo-btn")?.scrollIntoView({block:"center"}))}
  b.disabled=true;await advance(id,a)});

$("#td-new").addEventListener("click",()=>{store.set("mk","");const w=work("");w.topic="";w.titles=[];w.thumb="";w.hook="";w.pick="";saveWork();store.set("mkst","pkg");show("make")});

function renderLearn(){if(!$("#ln-full"))return;const up=uploads(),has=up.length>=6;$("#ln-empty").hidden=has;$("#ln-full").hidden=!has;if(!has)return;
  const n=channelNumbers(),V=up.slice(-48).filter(v=>share(v)!=null),W=900,H=260,pl=34,pr=8,pt=12,pb=28,bw=(W-pl-pr)/V.length,top=Math.max(40,Math.ceil(Math.max(...V.map(share))/10)*10),y=t=>pt+(1-t/top)*(H-pt-pb);
  $("#ln-sub").textContent=`Average share of each video watched, per upload since ${fmtShort(V[0].d)} ${V[0].d.slice(0,4)}. The dashed line is your 6 best videos (${pctTxt(n.wS)}). Hover or focus a bar for its title.`;
  let s=`<svg viewBox="0 0 ${W} ${H}" role="img" aria-label="Share of each video watched, ${V.length} upload">`;
  for(let t=0;t<=top;t+=10)s+=`<line x1="${pl}" x2="${W-pr}" y1="${y(t)}" y2="${y(t)}" stroke="var(--line)"/><text x="${pl-6}" y="${y(t)+4}" text-anchor="end" font-size="11" fill="var(--muted)" stroke="none">${t}%</text>`;
  let lastLbl=-9;V.forEach((v,i)=>{const p=share(v),c=p>=20?"var(--accent)":p<10?"var(--warn)":"var(--stone-dot)";
    s+=`<rect x="${pl+i*bw+1}" y="${y(p)}" width="${Math.max(bw-2,2)}" height="${y(0)-y(p)}" rx="3" fill="${c}" stroke="none"/><rect class="hit" data-i="${i}" x="${pl+i*bw}" y="${pt}" width="${bw}" height="${H-pt-pb}" fill="transparent" stroke="none" tabindex="0" aria-label="${esc(v.t)}: ${f1(p)}% watched"/>`;
    if(i-lastLbl>=7&&(i===0||v.d.slice(0,7)!==V[i-1].d.slice(0,7))){lastLbl=i;s+=`<text x="${pl+i*bw}" y="${H-8}" font-size="11" fill="var(--muted)" stroke="none">${BN[+v.d.slice(5,7)-1]} ${v.d.slice(2,4)}</text>`}});
  if(n.wS)s+=`<line x1="${pl}" x2="${W-pr}" y1="${y(n.wS)}" y2="${y(n.wS)}" stroke="var(--ink)" stroke-dasharray="4 4" stroke-width="1.2"/><text x="${W-pr}" y="${y(n.wS)-6}" text-anchor="end" font-size="11.5" fill="var(--ink)" stroke="none">best ${f1(n.wS)}%</text>`;
  const ch=$("#ln-chart");ch.innerHTML=s+`</svg><div class="ctip" hidden></div>`;const tip=ch.querySelector(".ctip");
  const showTip=el=>{const v=V[+el.dataset.i],box=ch.getBoundingClientRect(),b=el.getBoundingClientRect();tip.innerHTML=`<b>${esc(v.t)}</b>${fmtShort(v.d)} ${v.d.slice(0,4)} · ${f1(share(v))}% watched (${f1(avdMin(v))} min) · ${nf(v.v)} views`;tip.hidden=false;tip.style.left=Math.min(Math.max(b.left-box.left-110,0),Math.max(box.width-250,0))+"px"};
  ch.onmouseover=e=>{if(e.target.classList?.contains("hit"))showTip(e.target)};ch.onfocusin=e=>{if(e.target.classList?.contains("hit"))showTip(e.target)};ch.onmouseleave=()=>tip.hidden=true;ch.onfocusout=()=>tip.hidden=true;
  $("#ln-cards").innerHTML=`<tr><th>Upload</th><th>Watched</th><th>CTR</th><th>Impressions</th><th>Views</th><th>Grade</th><th>Lesson</th></tr>`+up.slice(-8).reverse().map(v=>{const p=share(v),cls=p>=20?"good":p<10?"bad":"";return `<tr><td><b>${esc(v.t)}</b><br><span class="muted">${fmtShort(v.d)} ${v.d.slice(0,4)}</span></td><td>${pctTxt(p)}</td><td>${pctTxt(ctrOf(v))}</td><td>${impOf(v)?nf(v.imp):"-"}</td><td>${nf(v.v)}</td><td><span class="pill ${cls}">${p>=20?"near best":p<10?"left early":"below best"}</span></td><td>${esc(lessonFor(v,n))}</td></tr>`}).join("")}

function renderPattern(){const box=$("#id-pattern-box");if(!box)return;const W=winners(),up=uploads();box.hidden=up.length<6;if(box.hidden)return;
  const thr=W.filter(v=>THREAT.test(v.t)).length,n=channelNumbers();
  $("#id-pattern-sub").textContent=`Of the 6 videos with the most views (${nf(Math.min(...W.map(v=>v.v)))} views and up): ${W.map(v=>`"${v.t}"`).join("; ")}.`;
  $("#id-pattern").innerHTML=[[`${thr} of 6`,"the title names a predator or a threat"],[range(W.map(ctrOf),x=>f1(x))+"%","CTR thumbnail"],[range(W.map(v=>v.dur/60),x=>Math.round(x))+" min","video length"],[range(W.map(share),x=>Math.round(x))+"%","share watched"]].map(([b,s])=>`<div><b>${b}</b><span>${s}</span></div>`).join("");
  const miss=up.filter(v=>!W.includes(v)&&THREAT.test(v.t)&&share(v)!=null&&share(v)<10).pop();
  $("#id-pattern-note").textContent=miss?`Topic alone is not enough: "${miss.t}" (${fmtShort(miss.d)}) matches the pattern but only ${f1(share(miss))}% is watched. That is why every idea still goes through the hook coach.`:"The idea scores below use this pattern. Topics scoring 4 or 5 are closest to your best videos."}
function patternText(){const W=winners();if(W.length<6)return "";const thr=W.filter(v=>THREAT.test(v.t)).length;
  return `${thr} of the 6 most-viewed videos frame the animal as a predator or a threat in the title (${W.map(v=>`"${v.t}"`).join("; ")}); they run ${range(W.map(v=>v.dur/60),x=>Math.round(x))} minutes`}

/* Make: one video from package to upload. Per-video work is saved under LAST.work, keyed by plan id. */
let WORK=null,workTimer=0;
const work=id=>{WORK=WORK||LAST.work?.data||{};const k=id||"free";return WORK[k]=WORK[k]||{}};
const saveWork=()=>{clearTimeout(workTimer);workTimer=setTimeout(()=>remember("work",WORK).catch(()=>{}),600)};
const mkId=()=>{const id=store.get("mk","");return plans().some(p=>p.id===id)?id:""};
const mkPlan=()=>plans().find(p=>p.id===mkId());
const mkW=()=>work(mkId());
const topicKey=()=>{const t=(mkW().topic||"").trim();return (t.split(/[\s,:(]+/).find(w=>w.length>=4)||t).toLowerCase()};
function openMake(id,stage){if(id)store.set("mk",id);else if(!mkId()){const next=plans().filter(p=>p.type!=="post"&&p.status!=="tayang")[0];if(next)store.set("mk",next.id)}if(stage)mkStage(stage);show("make")}
function mkStage(s){const tabsEl=[...document.querySelectorAll("#mk-stages [role=tab]")];tabsEl.forEach(b=>{const on=b.dataset.stage===s;b.setAttribute("aria-selected",on);b.tabIndex=on?0:-1;document.getElementById(b.getAttribute("aria-controls")).hidden=!on});store.set("mkst",s)}
$("#mk-stages").addEventListener("click",e=>{const b=e.target.closest("[data-stage]");if(b)mkStage(b.dataset.stage)});
$("#mk-stages").addEventListener("keydown",e=>{const t=[...e.currentTarget.querySelectorAll("[role=tab]")],i=t.indexOf(e.target),d={ArrowRight:1,ArrowLeft:-1}[e.key];if(i<0||!d)return;e.preventDefault();const n=t[(i+d+t.length)%t.length];mkStage(n.dataset.stage);n.focus()});
document.addEventListener("click",e=>{const b=e.target.closest("[data-stage-go]");if(b){mkStage(b.dataset.stageGo);$("#main").scrollTop=0}});
function renderMake(){const list=plans().filter(p=>p.type!=="post"&&(p.status!=="tayang"||p.id===mkId())),id=mkId(),p=mkPlan(),w=mkW();
  $("#mk-pick").innerHTML=list.map(x=>`<option value="${esc(x.id)}">${esc(x.title)} · ${fmtShort(x.date)}</option>`).join("")+`<option value="">No plan, free topic</option>`;$("#mk-pick").value=id;
  if(!w.topic&&p)w.topic=p.title.split(/[:,]/)[0].trim();
  $("#mk-topic").value=w.topic||"";$("#mk-titles").value=(w.titles||(p?[p.title]:[])).join("\n");$("#mk-thumbtext").value=w.thumb||"";$("#mk-hook").value=w.hook||"";
  const t=w.pick||p?.title||w.topic||"";["#script-topic","#seo-topic","#thumb-topic","#shorts-topic"].forEach(s=>{if(t)$(s).value=t});if(w.pick)$("#thumb-title").value=w.pick;
  $("#mk-done").hidden=!p;$("#s-done").textContent=p?.status==="tayang"?"This video is already marked as published.":"";
  renderAuto();mkStage(store.get("mkst","pkg"));renderTitles();renderThumbPrev();renderGen();renderRules();renderPub()}
function renderAuto(){const w=mkW(),has=!!(w.topic||"").trim(),full=has&&w.titles?.length>1&&w.thumb&&w.hook;
  $("#mk-auto-h").textContent=!has?"Not sure what to make?":full?"Filled in. Check it, then go on to the script.":`Topic: ${w.topic}`;
  $("#mk-auto-p").textContent=!has?"One click: AI picks a topic that matches your best videos, fills in the titles, thumbnail text and hook, then writes the full script and voice over.":full?"Title, thumbnail and hook are ready. One more click for the full script and voice over.":"One click: AI fills in the title, thumbnail text and hook for this topic, then writes the full script and voice over.";
  $("#mk-auto").textContent=!has?"Just suggest a topic":full?"Refill package":"Fill title, thumbnail & hook";$("#mk-auto-new").hidden=!has}
// One AI call fills the whole package, so Sigit can start from a suggestion instead of a blank page.
async function autoFill(btn,newTopic){const w=mkW(),topic=newTopic?"":(w.topic||"").trim(),st=$("#s-auto");
  const done=[...longForm().map(v=>v.t),...plans().map(p=>p.title)].slice(-80).join("; ");
  const d=await ask(st,btn,`${topic?`Plan the package for a documentary about: ${topic}.`:`Pick the single best next documentary topic for this channel and plan its package. Do not repeat or closely overlap: ${done||"none"}.`}
What works on this channel: ${patternText()||"giant prehistoric mammal predators framed as a threat to humans"}. Viewers of recent videos left in the first minute, so the opening matters most.
Return: "subject" the animal's usual name; "mammal","predator","threat","size" honest true/false about the animal and the angle; "why" one English sentence on why this topic fits the channel; "titles" 5 title options, best first, each under 60 characters, naming the animal, with a size or number people can picture and a threat or rivalry angle where the evidence supports it; "thumb" thumbnail text of at most 4 words, uppercase, adding information the best title does not repeat; "hook" the first 60 seconds of narration (120-160 words, English): name the animal in the first sentence, state the danger before 15 seconds, say the thumbnail words before 15 seconds, promise a specific payoff at the end, no channel intro, no "subscribe", accurate facts with uncertain claims phrased carefully.
JSON shape: {"subject":"","mammal":true,"predator":true,"threat":true,"size":true,"why":"","titles":[""],"thumb":"","hook":""}`,null);
  if(!d?.titles?.length)return false;
  let id=mkId();
  if(!id||newTopic){const last=plans().map(p=>p.date).sort().pop(),base=last&&last>isoDay(new Date())?last:isoDay(new Date()),date=isoDay(addDays(new Date(base+"T12:00:00"),7));
    id=Date.now().toString(36)+Math.random().toString(36).slice(2,6);await savePlans([...plans(),{id,title:d.titles[0],date,type:"video",status:"ide",note:d.why||""}]);store.set("mk",id)}
  const x=work(id);Object.assign(x,{topic:d.subject||topic,titles:d.titles,pick:d.titles[0],thumb:d.thumb||"",hook:d.hook||""});saveWork();advance(id,"naskah");
  const f=fitOf(d);store.set("mkst","pkg");renderMake();
  st.className="status";st.textContent=`${d.subject||topic}: score ${f.score} out of 5. ${d.why||""} The first title is selected; change it if you like another better.`;return true}
// The whole video in one click: package first when it is missing, then outline, narration and voice.
async function oneClick(btn){const w=mkW(),st=$("#s-auto"),full=(w.topic||"").trim()&&w.titles?.length>1&&w.hook;
  btn.disabled=true;
  try{if(!full&&!await autoFill($("#mk-auto"),false))return;
    const note=st.textContent;mkStage("script");st.className="status";st.textContent=(full?"":note+" ")+"Now writing the script; progress shows in step 3.";
    const ok=await runScript($("#f-script .btn[type=submit]"));
    st.className=ok?"status":"status err";st.textContent=ok?"Script done. Check it in step 3, then go to the thumbnail in step 1.":"Script not finished. See the message in step 3."}
  finally{btn.disabled=false}}
$("#mk-one").addEventListener("click",e=>oneClick(e.currentTarget));
$("#mk-auto").addEventListener("click",e=>autoFill(e.currentTarget,false));
$("#mk-auto-new").addEventListener("click",e=>autoFill(e.currentTarget,true));
$("#mk-pick").addEventListener("change",e=>{store.set("mk",e.target.value);renderMake()});
$("#mk-topic").addEventListener("input",e=>{mkW().topic=e.target.value;saveWork();renderTitles();renderRules();renderAuto()});
$("#mk-titles").addEventListener("input",e=>{mkW().titles=e.target.value.split("\n");saveWork();renderTitles()});
$("#mk-thumbtext").addEventListener("input",e=>{mkW().thumb=e.target.value;saveWork();renderThumbPrev();renderRules()});
$("#mk-hook").addEventListener("input",e=>{mkW().hook=e.target.value;saveWork();renderRules()});
function titleChecks(t){const k=topicKey();return [[t.length<=60,"≤60"],[SIZE.test(t),"Size"],[THREAT.test(t),"Threat"],[!!k&&t.toLowerCase().includes(k),"Name"]]}
function renderTitles(){const w=mkW(),list=(w.titles||[]).map(s=>s.trim()).filter(Boolean);
  $("#mk-tlist").innerHTML=list.map((t,i)=>{const c=titleChecks(t);return `<label class="trow"><input type="radio" name="mk-pick-title" value="${i}" ${w.pick===t?"checked":""}><span class="t">${esc(t)}<small>${t.length} characters</small></span><span class="checks">${c.map(([ok,k])=>`<i class="${ok?"y":""}">${k}<span class="sr">${ok?" passed":" not yet"}</span></i>`).join("")}</span></label>`}).join("");
  $("#mk-tlist").onchange=e=>{w.pick=list[+e.target.value];saveWork();$("#thumb-title").value=w.pick;["#script-topic","#seo-topic","#thumb-topic","#shorts-topic"].forEach(s=>$(s).value=w.pick);renderThumbPrev()}}
function renderThumbPrev(){const w=mkW(),t=(w.thumb||"").trim(),words=t.split(/\s+/).filter(Boolean),pick=(w.pick||"").toLowerCase();
  $("#mk-thumbprev span").textContent=t||"Thumbnail text";$("#mk-thumbprev").classList.toggle("ph",!t);
  const rep=words.filter(x=>x.length>3&&pick.includes(x.toLowerCase()));
  $("#mk-thumbnote").textContent=!t?"Type text to see a preview.":words.length>4?`${words.length} words, too many for a phone screen. Cut it to 4 words or fewer.`:rep.length?`The word "${rep.join(", ")}" is already in the title. A thumbnail is stronger when it adds new information.`:`${words.length} words, good.`}
/* Thumbnail images: Gemini draws the background, the app adds the text so the letters are always right. */
const genW=()=>{const w=mkW();return w.gen=w.gen||{concepts:[],imgs:[],pick:null,pos:"tl"}};
const GENBUSY=new Set(),GIMG={};
const loadImg=u=>GIMG[u]=GIMG[u]||new Promise((res,rej)=>{const i=new Image();i.onload=()=>res(i);i.onerror=()=>{delete GIMG[u];rej()};i.src=u});
const genUrl=x=>`/api/gen/${encodeURIComponent(x.file)}?v=${x.v}`;
function genBar(){const g=genW(),has=g.imgs?.some(x=>x?.file),price=IMG_PRICE[CFG.image_model],b=$("#gen-go");if(b.dataset.arm)return;
  if(!CFG.has_image){$("#gen-h").textContent="Add the image key first";$("#gen-p").textContent="Images are made by Gemini using the Google Cloud credit from your subscription. The key is set once in Settings.";b.textContent="Open Settings";return}
  $("#gen-h").textContent=has?"Want 3 new images?":"Make 3 thumbnails with Gemini";
  $("#gen-p").textContent=`3 images${price?", about "+usd(price*3)+",":""} is taken from your Google Cloud credit. ${imgSpentText()}`;
  b.textContent=has?"Make 3 new":"Make 3 thumbnails"}
// At most 3 lines; short lines keep the letters large on a phone.
function thumbLines(t){const words=(t||"").trim().toUpperCase().split(/\s+/).filter(Boolean);if(!words.length)return [];
  for(let lim=10;lim<40;lim+=2){const lines=[];let cur="";for(const w of words){if(cur&&(cur+" "+w).length>lim){lines.push(cur);cur=w}else cur=cur?cur+" "+w:w}lines.push(cur);if(lines.length<=3)return lines}
  return [words.join(" ")]}
function drawThumb(cv,img,text,pos){const c=cv.getContext("2d"),W=cv.width,H=cv.height;c.shadowColor="transparent";c.fillStyle="#14110D";c.fillRect(0,0,W,H);
  if(img){const s=Math.max(W/img.naturalWidth,H/img.naturalHeight),w=img.naturalWidth*s,h=img.naturalHeight*s;c.drawImage(img,(W-w)/2,(H-h)/2,w,h)}
  const lines=pos==="none"?[]:thumbLines(text);if(!lines.length)return;
  const right=pos==="tr",bottom=pos==="bl",u=W/1280;
  const g=c.createLinearGradient(right?W:0,0,right?W*.3:W*.7,0);g.addColorStop(0,"rgba(8,6,4,.78)");g.addColorStop(1,"rgba(8,6,4,0)");c.fillStyle=g;c.fillRect(0,0,W,H);
  if("fontStretch" in c)c.fontStretch="expanded";
  const font=s=>`800 ${s}px Archivo, "Arial Black", Arial, sans-serif`;let size=168*u;
  for(;size>56*u;size-=4*u){c.font=font(size);if(Math.max(...lines.map(l=>c.measureText(l).width))<=W*.6&&lines.length*size*.96<=H*.66)break}
  c.font=font(size);c.textBaseline="top";c.textAlign=right?"right":"left";c.lineJoin="round";
  const lh=size*.96,x=right?W-64*u:64*u,y0=bottom?H-56*u-lines.length*lh:56*u;
  lines.forEach((l,i)=>{const y=y0+i*lh;c.shadowColor="rgba(0,0,0,.55)";c.shadowBlur=size*.12;c.shadowOffsetY=size*.04;c.lineWidth=size*.07;c.strokeStyle="rgba(8,6,4,.6)";c.strokeText(l,x,y);
    c.shadowColor="transparent";c.fillStyle=i===lines.length-1&&lines.length>1?"#F2A230":"#fff";c.fillText(l,x,y)})}
function renderGen(){const g=genW(),id=mkId(),cs=(g.concepts||[]).slice(0,3);genBar();$("#gen-pos").value=g.pos||"tl";
  $("#gen-list").hidden=$("#gen-posrow").hidden=!cs.length;
  $("#gen-list").innerHTML=cs.map((c,i)=>{const x=g.imgs?.[i]||{},busy=GENBUSY.has(id+":"+i);
    return `<article class="gth${g.pick===i?" pick":""}" data-slot="${i}"><div class="gimg">${x.file?`<canvas width="1280" height="720" role="img" aria-label="Thumbnail ${i+1}: ${esc(c.name)}"></canvas>`:""}${busy||!x.file?`<div class="gph${busy?" busy":""}">${busy?"Gemini is drawing… usually 10 to 40 seconds":esc(x.err||"No image yet")}</div>`:""}</div>
    <h3>${i+1}. ${esc(c.name)}</h3><p>${esc(c.composition)}</p>\n    <label>Text on image<input maxlength="40" data-g="text" value="${esc(c.text)}"></label>
    <div class="chips"><button type="button" class="btn${g.pick===i?"":" ghost"}" data-g="pick"${x.file?"":" disabled"}>${g.pick===i?"Selected":"Pick this"}</button><button type="button" class="btn ghost" data-g="save"${x.file?"":" disabled"}>Save JPG</button><button type="button" class="btn ghost" data-g="redo"${busy?" disabled":""}>${x.file?"Redo":"Try again"}</button></div>
    <p class="note" data-g="msg" role="status">${x.file&&x.err?esc(x.err):""}</p></article>`}).join("");
  paintGen().then(renderPhone)}
async function paintGen(only){const g=genW();try{await document.fonts.load("800 100px Archivo")}catch{}
  for(const art of document.querySelectorAll("#gen-list .gth")){const i=+art.dataset.slot,cv=art.querySelector("canvas"),x=g.imgs?.[i];if(!cv||!x?.file||(only!=null&&only!==i))continue;
    try{drawThumb(cv,await loadImg(genUrl(x)),g.concepts[i]?.text,g.pos||"tl")}catch{drawThumb(cv,null,g.concepts[i]?.text,g.pos||"tl")}}}
function renderPhone(){const g=genW(),w=mkW(),cv=g.pick!=null&&$(`#gen-list [data-slot="${g.pick}"] canvas`);$("#gen-phone").hidden=!cv;if(!cv)return;
  const src=cv.toDataURL("image/jpeg",.8),t=w.pick||mkPlan()?.title||w.topic||"";$("#gen-feed-img").src=$("#gen-side-img").src=src;
  $("#gen-feed-title").textContent=$("#gen-side-title").textContent=t;$("#gen-feed-ch").textContent=(CFG.profile?.name||"Your channel")+" · new"}
const imgPrompt=(c,pos)=>{const side=pos==="tr"?"right":"left",other=pos==="tr"?"left":"right";
  return `${c.prompt}\n\nFormat: wide 16:9 YouTube thumbnail background, cinematic, high contrast, one large clear subject on the ${other} side of the frame. Keep the ${side} third of the frame darker and uncluttered because a headline is added there later. Scientifically plausible anatomy. Do not render any text, letters, numbers, captions, logos, watermarks or borders anywhere in the image.`};
async function genImage(i){const g=genW(),id=mkId(),c=g.concepts[i],k=id+":"+i;if(!c||GENBUSY.has(k))return false;
  GENBUSY.add(k);renderGen();
  const j=await api("/api/image",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({...(id?{id}:{}),slot:i,prompt:imgPrompt(c,g.pos)})});
  GENBUSY.delete(k);g.imgs=g.imgs||[];
  if(j.error)g.imgs[i]={...(g.imgs[i]||{}),err:j.error};else{g.imgs[i]={file:j.file,v:j.v};addImg(1,j.model).catch(()=>{})}
  saveWork();
  // Still on the same video: redraw, and refresh the saved thumbnail if this slot is the chosen one.
  if(mkId()===id){renderGen();if(!j.error&&g.pick===i){await paintGen(i);await applyPick(i)}}
  return !j.error}
async function genAll(btn){const w=mkW(),g=genW(),st=$("#s-gen");
  if(!CFG.has_image){show("settings");$("#f-image").scrollIntoView({block:"start"});$("#cfg-ikey").focus();return}
  const topic=(w.pick||w.topic||"").trim();
  if(!topic){st.className="status err";st.textContent='No topic yet. Click "Just suggest a topic" above first.';return}
  if(g.imgs?.some(x=>x?.file)&&!btn.dataset.arm){btn.dataset.arm="1";btn.textContent="Click again to replace";setTimeout(()=>{if(btn.dataset.arm){delete btn.dataset.arm;genBar()}},5000);return}
  delete btn.dataset.arm;genBar();
  const main=(w.thumb||"").trim();
  const d=await ask(st,btn,`Create 3 distinct YouTube thumbnail concepts. Topic: ${w.topic||topic}. Video title: ${w.pick||"not decided"}. Visual style: ${$("#thumb-style").value}.
${main?`The overlay text "${main}" is already chosen: concept 1 uses exactly that text; concepts 2 and 3 each use a different text so they can be A/B tested.`:"Each concept has its own overlay text."}
Each concept: "name" short English label, "text" overlay of max 4 words, uppercase, that complements (not repeats) the title, "composition" one sentence in English, "why" one sentence in English on why it gets clicks, "prompt" a detailed text-to-image prompt in English (16:9, one large subject on the right two thirds, the left third dark and empty for the overlay text, do not render any text in the image, accurate anatomy and details).
JSON shape: {"concepts":[{"name":"","text":"","composition":"","why":"","prompt":""}]}`,"thumb");
  if(!d?.concepts?.length)return;
  renderThumb(d.concepts);
  g.concepts=d.concepts.slice(0,3).map(c=>({name:String(c.name||"Concept"),text:String(c.text||main).slice(0,40),composition:String(c.composition||""),prompt:String(c.prompt||c.composition||topic)}));
  g.imgs=[];g.pick=null;saveWork();renderGen();
  st.className="status";st.textContent="Concepts ready. Gemini is drawing 3 thumbnails…";btn.disabled=true;
  const ok=(await Promise.all(g.concepts.map((_,i)=>genImage(i)))).filter(Boolean).length;btn.disabled=false;
  st.className=ok?"status":"status err";
  st.textContent=ok===g.concepts.length?`${ok} thumbnails done. Pick one; the text can be changed under each image.`:ok?`${ok} of ${g.concepts.length} images done. Click Try again on the one that failed.`:(g.imgs.find(x=>x?.err)?.err||"The image could not be made. Try again.")}
const thumbBlob=cv=>new Promise(r=>cv.toBlob(r,"image/jpeg",.92));
async function saveJpg(i,blob){const w=mkW(),name=`${w.pick||mkPlan()?.title||w.topic||"terra"} thumbnail ${i+1}`;
  return api("/api/save-jpg?name="+encodeURIComponent(name),{method:"POST",headers:{"Content-Type":"image/jpeg"},body:blob})}
function markPick(){const g=genW();document.querySelectorAll("#gen-list .gth").forEach(a=>{const on=+a.dataset.slot===g.pick,b=a.querySelector('[data-g="pick"]');a.classList.toggle("pick",on);b.classList.toggle("ghost",!on);b.textContent=on?"Selected":"Pick this"})}
// Choosing a thumbnail makes it the plan image on the calendar and writes the JPG to Downloads.
async function applyPick(i){const g=genW(),id=mkId(),art=$(`#gen-list [data-slot="${i}"]`),cv=art?.querySelector("canvas"),msg=art?.querySelector('[data-g="msg"]');if(!cv)return;
  g.pick=i;saveWork();markPick();renderPhone();
  const blob=await thumbBlob(cv),done=[],bad=[];
  if(id){const r=await api("/api/thumb?id="+encodeURIComponent(id),{method:"POST",headers:{"Content-Type":"image/jpeg"},body:blob});
    if(r.ok){await remember("plans",plans().map(x=>x.id===id?{...x,thumb:String(Date.now())}:x));renderDash();renderPipe();done.push("set as the plan image in the Calendar")}else bad.push(r.error||"The plan image could not be saved.")}
  const s=await saveJpg(i,blob);if(s.path){done.push("saved in "+s.path);$("#gen-saved").textContent="Last file: "+s.path}else bad.push(s.error||"The JPG could not be saved.");
  if(msg){msg.className=bad.length?"note err":"note";msg.textContent=(done.length?"Selected: "+done.join(", ")+". ":"")+bad.join(" ")}}
let genTextTimer=0;
$("#gen-go").addEventListener("click",e=>genAll(e.currentTarget));
$("#gen-folder").addEventListener("click",()=>api("/api/open-folder",{method:"POST"}));
$("#gen-pos").addEventListener("change",async e=>{const g=genW();g.pos=e.target.value;saveWork();await paintGen();if(g.pick!=null)applyPick(g.pick)});
$("#gen-list").addEventListener("input",e=>{if(e.target.dataset.g!=="text")return;const g=genW(),i=+e.target.closest(".gth").dataset.slot;g.concepts[i].text=e.target.value;saveWork();
  paintGen(i).then(()=>{if(g.pick===i){renderPhone();clearTimeout(genTextTimer);genTextTimer=setTimeout(()=>applyPick(i),900)}})});
$("#gen-list").addEventListener("click",async e=>{const b=e.target.closest("button[data-g]");if(!b)return;const art=b.closest(".gth"),i=+art.dataset.slot,msg=art.querySelector('[data-g="msg"]');
  if(b.dataset.g==="pick")return applyPick(i);
  if(b.dataset.g==="redo"){const ok=await genImage(i);const m=$(`#gen-list [data-slot="${i}"] [data-g="msg"]`);if(m&&!ok){m.className="note err";m.textContent=genW().imgs[i]?.err||"The image could not be made."}return}
  if(b.dataset.g==="save"){const cv=art.querySelector("canvas");if(!cv)return;b.disabled=true;const s=await saveJpg(i,await thumbBlob(cv));b.disabled=false;
    msg.className=s.path?"note":"note err";msg.textContent=s.path?"Saved in "+s.path:(s.error||"The JPG could not be saved.");if(s.path)$("#gen-saved").textContent="Last file: "+s.path}});
function renderRules(){const w=mkW(),txt=(w.hook||"").trim(),words=txt.split(/\s+/).filter(Boolean),f25=words.slice(0,25).join(" ").toLowerCase(),f35=words.slice(0,35).join(" "),k=topicKey();
  const thumbW=(w.thumb||"").toLowerCase().split(/\s+/).filter(x=>x.length>=3&&!["the","and","our","for","with","that","this","from","was"].includes(x));
  const R=!txt?[[null,"Write the opening in the box beside this. The checks appear as you type."]]:[
    [k?f25.includes(k):null,k?"Animal named in the first 10 seconds":"Animal named in the first 10 seconds: fill in the topic above first"],
    [HOOK_DANGER.test(f35),"Danger or threat named before 0:15"],
    [/by the end|at the end|you'll see|you will see|stay with|before this video ends|the answer|what (really )?happened|di akhir/i.test(txt),"A promise at the end, so viewers stay"],
    [!/subscribe|welcome (back )?to|this channel|hello everyone|hi everyone|hey guys|hey everyone/i.test(txt),"No channel intro or subscribe request"],
    [thumbW.length?thumbW.some(x=>f35.toLowerCase().includes(x)):null,thumbW.length?`Thumbnail words ("${w.thumb.trim()}") spoken before 0:15`:"Thumbnail words spoken before 0:15: fill in the thumbnail text in the Package step first"],
    [words.length>=110&&words.length<=170,`Right length for 60 seconds (110 to 170 words, now ${words.length})`]];
  $("#mk-rules").innerHTML=R.map(([ok,t])=>`<li><span class="${ok===true?"y":ok===false?"n":"u"}" aria-hidden="true">${ok===true?"✓":ok===false?"✗":"–"}</span><span>${esc(t)}<span class="sr">${ok===true?", passed":ok===false?", not yet":""}</span></span></li>`).join("");
  $("#mk-hook-len").textContent=words.length?`${words.length} words, about ${Math.round(words.length/140*60)} seconds read aloud (140 words per minute).`:""}
function hookForScript(){const w=mkW(),h=(w.hook||"").trim();let s="";if(w.pick)s+=`Video title: ${w.pick}. `;if(w.thumb)s+=`Thumbnail text: ${w.thumb}. `;if(h.split(/\s+/).length>=20)s+=`Use this exact opening, word for word, as the cold open and first part of act 1: """${h}"""\n`;return s}
$("#mk-titles-ai").addEventListener("click",async e=>{const w=mkW(),topic=w.topic||mkPlan()?.title||"";const st=$("#s-titles");if(!topic){st.className="status err";st.textContent="Fill in the topic first.";return}
  const d=await ask(st,e.currentTarget,`Write 5 YouTube title options for a documentary about: ${topic}. What works on this channel: ${patternText()||"giant prehistoric predators framed as a threat to humans"}. Each under 60 characters, honest, naming the animal, ideally with a size or number people can picture and a threat or rivalry angle. Vary the angle.
JSON shape: {"titles":[""]}`,null);
  if(d?.titles?.length){const cur=(w.titles||[]).map(s=>s.trim()).filter(Boolean);w.titles=[...cur,...d.titles.filter(t=>!cur.includes(t))];saveWork();$("#mk-titles").value=w.titles.join("\n");renderTitles()}});
$("#mk-hook-ai").addEventListener("click",async e=>{const w=mkW(),topic=w.topic||mkPlan()?.title||"",st=$("#s-hook");if(!topic){st.className="status err";st.textContent="Fill in the topic first.";return}
  const d=await ask(st,e.currentTarget,`Write 2 alternative openings (the first 60 seconds, 120-160 words each, spoken narration) for a documentary about ${topic}.${w.pick?" Title: "+w.pick+".":""}${w.thumb?" Thumbnail text: "+w.thumb+".":""}
Rules from where this channel's viewers dropped off: name and show the animal in the first sentence; state the danger or threat before 15 seconds; say the thumbnail words before 15 seconds; promise a specific payoff at the end; no channel intro, no "subscribe", no "millions of years ago" warm-up. Keep every fact accurate; phrase uncertain claims carefully.
${(w.hook||"").trim()?"Current draft to improve:\n"+w.hook.trim():""}
JSON shape: {"hooks":[{"text":"","why":"one sentence in English on what changed"}]}`,"hook");
  if(d?.hooks?.length)renderHooks(d.hooks)});
function renderHooks(list){$("#o-hook").innerHTML=list.map((h,i)=>`<div class="card"><span class="layer">Version ${i+1}</span><p>${esc(h.text)}</p><p class="note">${esc(h.why||"")}</p><button type="button" class="btn ghost" data-hook="${i}">Use this version</button></div>`).join("");
  $("#o-hook").onclick=e=>{const b=e.target.closest("[data-hook]");if(!b)return;mkW().hook=list[+b.dataset.hook].text;saveWork();$("#mk-hook").value=mkW().hook;renderRules();$("#mk-hook").focus()}}
function renderPub(){const w=mkW(),us=usShare(),best=winners()[0],done=w.pub||{};
  const items=[["t60","Title chosen, under 60 characters",w.pick?`"${w.pick}"`:"Pick a title in the Package step"],["thumb","Thumbnail done, text of at most 4 words, readable at phone size",""],["tc","Test & Compare: 2 or 3 thumbnails tested in YouTube Studio",""],["desc","Description with chapters, keyword in the first sentence","Copy it from the SEO package above"],["end","End screen points to your best video",best?`"${best.t}"`:""],["pin","Pinned comment with a question",""],["time",us?"Scheduled for 07:00 WIB, evening in America":"The publish time is set in YouTube Studio",us?`US viewers: ${us.views}% views`:""],["comm","Community post on publish day",""]];
  $("#mk-pub").innerHTML=items.map(([k,t,s])=>`<li><input type="checkbox" id="pub-${k}" data-pub="${k}" ${done[k]?"checked":""}><label for="pub-${k}">${esc(t)}${s?`<small>${esc(s)}</small>`:""}</label></li>`).join("");
  $("#mk-pub").onchange=e=>{const c=e.target.closest("[data-pub]");if(!c)return;w.pub={...(w.pub||{}),[c.dataset.pub]:c.checked};saveWork()}}
$("#mk-done").addEventListener("click",async()=>{const p=mkPlan();if(!p)return;await savePlans(plans().map(x=>x.id===p.id?{...x,status:"tayang"}:x));$("#s-done").className="status";$("#s-done").textContent="Marked as published. Its report card appears in Learn after the next data pull."});

// Ideas saved by 1.x have no animal facts, so they can't be scored; leave the empty state instead.
const RENDER={ideas:d=>d?.ideas?.length&&"subject" in d.ideas[0]&&(renderIdeas(d.ideas),true),script:d=>d?.acts?.length&&(renderScript(d),true),scriptfull:d=>d?.narration?.length&&$("#o-scriptfull")&&(renderScriptFull(d),true),seo:d=>d?.titles&&(renderSEO(d),true),thumb:d=>d?.concepts?.length&&(renderThumb(d.concepts),true),shorts:d=>d?.shorts?.length&&(renderShorts(d.shorts),true),ai:d=>d&&(renderAI(d),true)};
async function loadLast(){const j=await api("/api/last");if(!j||j.error)return;LAST=j;
  for(const [k,f] of Object.entries(RENDER)){const r=LAST[k];if(!r)continue;try{if(f(r.data)){const st=$("#s-"+k);if(st){st.className="status";st.textContent="Last result, made "+new Date(r.at).toLocaleString("en-US",{day:"numeric",month:"short",hour:"2-digit",minute:"2-digit"})+". No credit is used again."}}}catch{}}
  $("#cfg-spent").textContent=spentText();$("#cfg-ispent").textContent=imgSpentText()}
api("/api/skin?skin="+(document.documentElement.dataset.skin||"batu"),{method:"POST"});
