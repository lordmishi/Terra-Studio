<a class="skip" href="#main">Skip to content</a>
<svg class="sr" width="0" height="0" aria-hidden="true" focusable="false"><defs><pattern id="hx" width="8" height="8" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><rect width="8" height="8" fill="var(--hx-b)" stroke="none"/><rect width="4" height="8" fill="var(--hx-a)" stroke="none"/></pattern></defs></svg>
<div class="shell">
  <aside class="rail">
    <h1 class="sr">Terra Studio</h1>
    <div class="rail-hd">
      <img class="logo" src="/logo.png" width="36" height="36" alt="">
      <b class="rail-name" aria-hidden="true">Terra Studio</b>
      <button type="button" class="nav-tog" id="nav-tog" aria-label="Close menu" title="Close menu (Ctrl+B)"><svg viewBox="0 0 14 14" aria-hidden="true"><rect x=".75" y="1.5" width="12.5" height="11" rx="2"/><path d="M5 1.5v11"/><path id="nav-tog-arrow" d="m10 5.25-1.75 1.75L10 8.75"/></svg></button>
    </div>
    <nav class="tabs" role="tablist" aria-label="Menu" aria-orientation="vertical">
      <button role="tab" id="t-today" aria-selected="true" data-tab="today"><svg viewBox="0 0 14 14" aria-hidden="true"><path d="M12 9.5a1 1 0 0 1 1 1V12a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1v-1.5a1 1 0 0 1 1-1z"/><path d="M7 1a1 1 0 0 1 1 1v4.5a1 1 0 0 1-1 1H1.932a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1z"/><path d="M12.469 1a.5.5 0 0 1 .5.5v1.25a.5.5 0 0 1-.5.5H10.5a.5.5 0 0 1-.5-.5V1.5a.5.5 0 0 1 .5-.5z"/><path d="M12.469 5.25a.5.5 0 0 1 .5.5V7a.5.5 0 0 1-.5.5H10.5A.5.5 0 0 1 10 7V5.75a.5.5 0 0 1 .5-.5z"/></svg><span>Dashboard</span></button>
      <button role="tab" id="t-ideas" aria-selected="false" data-tab="ideas"><svg viewBox="0 0 14 14" aria-hidden="true"><path d="M11.5 5.031a4.5 4.5 0 1 0-6.5 4v1.5a.5.5 0 0 0 .5.5h3a.5.5 0 0 0 .5-.5v-1.5a4.48 4.48 0 0 0 2.5-4"/><path d="M5 13.5h4"/></svg><span>Ideas</span></button>
      <button role="tab" id="t-make" aria-selected="false" data-tab="make"><svg viewBox="0 0 14 14" aria-hidden="true"><path d="M10 3.5v8a2 2 0 0 1-2 2H.5a2 2 0 0 0 2-2v-9a2 2 0 0 1 2-2h7.25"/><path d="M11.75.5a1.75 1.75 0 0 1 1.75 1.75V3a.5.5 0 0 1-.5.5h-3V2.25A1.75 1.75 0 0 1 11.75.5"/><path d="M6 4h1.5"/><path d="M5 7h2.5"/><path d="M5 10h2.5"/></svg><span>Make video</span></button>
      <button role="tab" id="t-edit" aria-selected="false" data-tab="edit"><svg viewBox="0 0 14 14" aria-hidden="true"><rect x="1" y="2" width="12" height="10" rx="1.5"/><path d="M1 5h12M1 9h12M4.5 2v3M9.5 2v3M4.5 9v3M9.5 9v3"/></svg><span>Editing</span></button>
      <button role="tab" id="t-learn" aria-selected="false" data-tab="learn"><svg viewBox="0 0 14 14" aria-hidden="true"><path d="M.5 13.5h13"/><path d="m1.5 10 3.5-4 3 2.5 4.5-6.5"/><path d="M10.5 2h2v2"/></svg><span>Learn</span></button>
      <button role="tab" id="t-dash" aria-selected="false" data-tab="dash"><svg viewBox="0 0 14 14" aria-hidden="true"><path d="M1.5 2.5h11a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1h-11a1 1 0 0 1-1-1v-9a1 1 0 0 1 1-1zM.5 6h13M4 .5v3M10 .5v3"/></svg><span>Calendar</span></button>
      <button role="tab" id="t-growth" aria-selected="false" data-tab="growth"><svg viewBox="0 0 14 14" aria-hidden="true"><path d="m1.24 6.54 11.5-5.23"/><path d="m10.59.5 2.15.81-.8 2.15"/><path d="M13.25 13.5h-2.5v-7a.5.5 0 0 1 .5-.5h1.5a.5.5 0 0 1 .5.5z"/><path d="M8.25 13.5h-2.5V8a.5.5 0 0 1 .5-.5h1.5a.5.5 0 0 1 .5.5z"/><path d="M3.25 13.5H.75v-4a.5.5 0 0 1 .5-.5h1.5a.5.5 0 0 1 .5.5z"/></svg><span>Data &amp; money</span></button>
      <button role="tab" id="t-settings" aria-selected="false" data-tab="settings"><svg viewBox="0 0 14 14" aria-hidden="true"><path d="m5.23 2.25.43-1.11A1 1 0 0 1 6.59.5h.82a1 1 0 0 1 .93.64l.43 1.11 1.46.84 1.18-.18a1 1 0 0 1 1 .49l.4.7a1 1 0 0 1-.08 1.13l-.73.93v1.68l.75.93a1 1 0 0 1 .08 1.13l-.4.7a1 1 0 0 1-1 .49l-1.18-.18-1.46.84-.43 1.11a1 1 0 0 1-.93.64h-.84a1 1 0 0 1-.93-.64l-.43-1.11-1.46-.84-1.18.18a1 1 0 0 1-1-.49l-.4-.7a1 1 0 0 1 .08-1.13L2 7.84V6.16l-.75-.93a1 1 0 0 1-.08-1.13l.4-.7a1 1 0 0 1 1-.49l1.18.18zM5 7a2 2 0 1 0 4 0 2 2 0 0 0-4 0"/></svg><span>Settings</span></button>
    </nav>
    <div class="rail-sp"></div>
    <button type="button" class="rail-plus" id="rail-plus" aria-label="New content plan" data-tip="New plan"><i aria-hidden="true">+</i><span>New plan</span></button>
    <button type="button" class="skin" id="skin-tog" role="switch" aria-checked="false" aria-label="Dark look" data-tip="Switch light / dark"><u aria-hidden="true"><i class="sun"><svg viewBox="0 0 14 14"><circle cx="7" cy="7" r="2.5"/><path d="M7 .75v1.5M7 11.75v1.5M.75 7h1.5M11.75 7h1.5M2.6 2.6l1.05 1.05M10.35 10.35l1.05 1.05M2.6 11.4l1.05-1.05M10.35 3.65l1.05-1.05"/></svg></i><i class="moon"><svg viewBox="0 0 14 14"><path d="M12.25 8.4A5.6 5.6 0 0 1 5.6 1.75a5.6 5.6 0 1 0 6.65 6.65"/></svg></i></u><span id="skin-name">Light look</span></button>
    <p class="ver">v2.6.0</p>
  </aside>
  <aside class="side" aria-label="Calendar and schedule">
    <div class="box calw">
      <div class="calw-hd"><span class="calw-ic"><svg viewBox="0 0 14 14" aria-hidden="true"><path d="M1.5 2.5h11a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1h-11a1 1 0 0 1-1-1v-9a1 1 0 0 1 1-1zM.5 6h13M4 .5v3M10 .5v3"/></svg></span><div><h2>Upload calendar</h2><small id="mc-sub">Plans and published videos</small></div><button type="button" class="ic-btn" data-goto="dash" id="mc-open" aria-label="Open the month calendar"><svg viewBox="0 0 14 14" aria-hidden="true"><path d="M4 10 10 4M5 4h5v5"/></svg></button></div>
      <div class="pills" role="group" aria-label="Content type" id="mc-pills"><button type="button" aria-pressed="true" data-f="all">All</button><button type="button" aria-pressed="false" data-f="video">Video</button><button type="button" aria-pressed="false" data-f="short">Shorts</button><button type="button" aria-pressed="false" data-f="post">Post</button></div>
      <div class="mc" id="mc" role="group" aria-label="This month's calendar, use the arrow keys to move between dates"></div>
      <div class="mc-ft"><button type="button" class="ic-btn" id="mc-prev" aria-label="Previous month">&larr;</button><b id="mc-title"></b><button type="button" class="ic-btn" id="mc-next" aria-label="Next month">&rarr;</button></div>
    </div>
    <div class="next" id="next-up"></div>
    <div class="box stages"><h2>Production status</h2><ul id="stages"></ul></div>
  </aside>
  <main class="main" id="main">
    <header class="topbar">
      <div><h2 id="page-title" class="page-title">Dashboard</h2><div class="meter" id="meter"></div><div class="meter" id="today-sub"></div></div>
      <div class="actions"><span class="ch-name" id="hdr-channel"></span><button type="button" class="btn ghost" data-goto="growth">Update Studio data</button></div>
    </header>
<div class="wrap">
  <div class="banner" id="banner-save" role="alert" hidden><span id="banner-save-t"></span></div>
  <div class="banner" id="banner-key" hidden>
    <span><strong>Copy-paste mode to claude.ai.</strong> To get AI results straight in the app at no cost, choose Gemini in Settings and paste a free API key from Google. Or use one paid KIE.ai key for scripts and thumbnails.</span> <button type="button" class="btn ghost" data-goto="settings">Open Settings</button><button type="button" class="btn ghost" id="banner-close">Close</button>
  </div>

  <!-- DASHBOARD: the numbers, the next video and the one thing to fix -->
  <section id="p-today" role="tabpanel" aria-labelledby="t-today">
    <div id="td-empty" class="card" hidden>
      <span class="layer">No video data yet</span>
      <h3>The Dashboard needs your channel's numbers</h3>
      <p class="note">Connect YouTube or import the Content file from YouTube Studio. Then this page shows your channel's numbers, its biggest problem and a ranked list of steps to get more views.</p>
      <button type="button" class="btn" data-goto="growth">Open Data &amp; money</button>
    </div>
    <div class="kpis" id="td-kpis"></div>
    <div class="rowb">
      <div class="box vchart">
        <div class="bx-hd"><div><h2>Views</h2><p class="sub" id="vc-sub"></p></div><div class="seg" role="group" aria-label="Time range" id="vc-seg"><button type="button" aria-pressed="true" data-r="30">30 days</button><button type="button" aria-pressed="false" data-r="90">90 days</button><button type="button" aria-pressed="false" data-r="12">12 months</button></div></div>
        <div id="vc" class="vc" tabindex="0" role="group" aria-label="Views chart. Press the left or right arrow to read each bar."><svg id="vc-svg" aria-hidden="true"></svg><div class="tp" id="vc-tp" role="status" hidden></div></div>
      </div>
      <div class="colb">
        <div class="next noimg" id="td-next"></div>
        <div class="box"><h2>Production status</h2><ul class="stg5" id="td-stg"></ul></div>
      </div>
    </div>
    <div class="box gw" id="td-grow" hidden>
      <div class="bx-hd"><div><h2>How to get more views</h2><p class="sub">Ranked by how much it should help, from your own numbers. Do them top to bottom.</p></div><span class="sub gw-upd" id="gw-upd"></span></div>
      <div id="gw-list"></div>
      <p class="note gw-note">These are rules from your own data, not a promise of views. Tick a step when it is done. After your next Update Studio data, the step shows how CTR and share watched moved since you ticked it.</p>
    </div>
    <div id="td-full" class="rowc">
      <div class="dx sm">
        <span class="eyebrow">Biggest problem right now</span>
        <h2 class="disp" id="dx-h"></h2>
        <div class="cmpb" id="dx-cmp"></div>
        <p id="dx-p"></p>
        <div class="chips"><button type="button" class="btn" id="dx-go"></button></div>
      </div>
      <div class="box topv"><h2>Top videos</h2><p class="sub">Views and CTR, all time</p><ul id="topv"><li class="loading">Loading data…</li></ul></div>
    </div>
    <div class="rowd">
      <div class="box" id="td-gradebox">
        <h2>Last upload, graded</h2>
        <p class="sub" id="td-last-sub"></p>
        <div id="td-grade"></div>
      </div>
      <div class="box">
        <div class="bx-hd"><div><h2>Up next</h2><p class="sub">Every video in progress, closest to upload first. The status moves by itself when the package, script and voice over are done.</p></div><button type="button" class="btn ghost" id="td-new">+ New video</button></div>
        <ul class="nxt" id="td-pipe"></ul>
      </div>
    </div>
  </section>

  <!-- LEARN: every upload graded against the channel's own best -->
  <section id="p-edit" role="tabpanel" aria-labelledby="t-edit" hidden>
    <div id="el" class="vd-view">
      <div class="vd-intro"><p class="sub">Every long video, and what to do with it in Premiere. Closest upload first.</p><label class="ed-sw"><input type="checkbox" role="switch" id="el-pub"><span>Show published</span></label></div>
      <div id="el-hero"></div>
      <section class="card vd-list" aria-labelledby="el-h">
        <div class="vd-tbar"><h2 class="vd-h2" id="el-h">Long videos</h2></div>
        <div class="vd-tblw"><table class="vd-table ed-table"><thead><tr><th scope="col">Video</th><th scope="col">Upload</th><th scope="col">State</th><th scope="col">Length</th><th scope="col">Infographics</th><th scope="col">Clips</th><th scope="col">Next step</th></tr></thead><tbody id="el-rows"></tbody></table></div>
        <div class="status" id="s-el" role="status"></div>
        <p class="sub">Shorts are left out, because the edit guide is 16:9. States come from your saved work: a video is <b>Ready to edit</b> when its edit pack matches the script. "Mark as edited" moves it to Edited, the same button as on the Dashboard.</p>
      </section>
    </div>
    <div id="ed" class="vd-view" hidden>
      <div><button type="button" class="vd-back" id="ed-back"><span aria-hidden="true">&larr;</span> All videos</button></div>
      <div class="vd-hd"><div><h2 class="vd-title" id="ed-h" tabindex="-1"></h2><p class="sub" id="ed-sub"></p></div><span id="ed-pill"></span></div>
      <div class="vd-view" id="ed-body"></div>
    </div>
  </section>

  <section id="p-learn" role="tabpanel" aria-labelledby="t-learn" hidden>
    <div id="ln-empty" class="card" hidden>
      <span class="layer">No video data yet</span>
      <h3>Report cards appear once video data is in</h3>
      <button type="button" class="btn" data-goto="growth">Open Data &amp; money</button>
    </div>
    <div id="ln-full" class="stack">
      <div class="box">
        <h2>How much of each video is watched</h2>
        <p class="sub" id="ln-sub"></p>
        <div class="rchart" id="ln-chart"></div>
        <div class="lgd"><span><i class="l-top"></i>Solid: 20% or more, close to your best videos</span><span><i class="l-low"></i>Striped: under 10%, viewers leave quickly</span><span><i></i>Grey: in between</span></div>
      </div>
      <div class="box">
        <h2>Report card for each upload</h2>
        <p class="sub">Each upload is compared with your 6 best videos, from the latest data pulled. One lesson per video for the next one.</p>
        <div class="tblw"><table class="rc" id="ln-cards"></table></div>
      </div>
    </div>
  </section>

  <!-- CALENDAR -->
  <section id="p-dash" role="tabpanel" aria-labelledby="t-dash" hidden>
    <div class="paper">
      <div class="pp-head">
        <h2 class="disp" id="wk-title">Next 7 days</h2>
        <div class="seg" role="group" aria-label="View"><button type="button" aria-pressed="true" data-view="week">7 days</button><button type="button" aria-pressed="false" data-view="month">Month</button></div>
        <div class="pp-nav"><button type="button" class="btn ghost" id="wk-today">Today</button><button type="button" class="btn ghost icon" id="wk-prev" aria-label="Previous">&lsaquo;</button><button type="button" class="btn ghost icon" id="wk-next" aria-label="Next">&rsaquo;</button></div>
      </div>
      <div class="pp-row">
        <label class="search"><svg viewBox="0 0 14 14" aria-hidden="true"><path d="M6 11a5 5 0 1 0 0-10 5 5 0 0 0 0 10M13.5 13.5 9.6 9.6"/></svg><input id="pp-q" type="search" placeholder="Search plans or videos" aria-label="Search plans or videos"></label>
        <button type="button" class="btn" id="plan-new">+ Schedule content</button>
      </div>
      <div id="wk" class="wk"></div>
      <div id="cal-wrap" hidden>
        <div class="cal-legend"><span class="cl pub">Published</span><span class="cl video">Video plan</span><span class="cl short">Shorts plan</span><span class="cl post">Post plan</span></div>
        <div class="cal" id="cal" role="group" aria-label="Month calendar"></div>
      </div>
      <p class="pp-note" id="pp-note">Click a + box to add a plan, click a card to change its status or add a thumbnail.</p>
    </div>
  </section>

  <dialog id="plan-dlg" aria-labelledby="plan-dlg-title">
    <form method="dialog" id="plan-form" class="tool">
      <h2 id="plan-dlg-title">Content plan</h2>
      <label for="pl-title">Title<input id="pl-title" required maxlength="140"></label>
      <div class="row2">
        <label for="pl-date">Publish date<input id="pl-date" type="date" required></label>
        <label for="pl-type">Type<select id="pl-type"><option value="video">Long video</option><option value="short">Shorts</option><option value="post">Community post</option></select></label>
      </div>
      <label for="pl-status">Status<select id="pl-status"><option value="ide">Idea</option><option value="naskah">Script</option><option value="rekam">Record / voice over</option><option value="edit">Edit</option><option value="siap">Ready to upload</option><option value="tayang">Published</option></select></label>
      <label for="pl-note">Notes<textarea id="pl-note" rows="3"></textarea></label>
      <div class="pl-thumbs"><span class="lbl" id="pl-thumbs-h">Thumbnail <span class="sub" id="pl-thumbs-n">(optional)</span></span>
        <div class="pl-tgrid" id="pl-tgrid" role="group" aria-labelledby="pl-thumbs-h" hidden></div>
        <div class="chips"><button type="button" class="btn ghost" id="pl-thumb-pick">Choose image</button><button type="button" class="btn ghost" id="pl-thumb-del" hidden>Remove image</button></div>
        <p class="note" id="pl-thumbs-note" hidden></p><input type="file" id="pl-thumb-file" accept="image/jpeg,image/png,image/webp" hidden></div>
      <div class="confirm"><button class="btn" value="save" id="pl-save">Save</button><button class="btn ghost" value="cancel" formnovalidate>Cancel</button><button class="btn ghost danger" type="button" id="pl-del">Delete</button><button class="btn ghost" type="button" id="pl-tools">Open in Make video</button></div>
    </form>
  </dialog>

  <!-- IDEAS -->
  <section id="p-ideas" role="tabpanel" aria-labelledby="t-ideas" hidden>
    <div class="box" id="id-pattern-box">
      <h2>How close to your best videos</h2>
      <p class="sub" id="id-pattern-sub"></p>
      <div class="pattern" id="id-pattern"></div>
      <p class="sub" id="id-pattern-note" style="margin-top:12px"></p>
    </div>
    <div class="panel">
    <form class="tool" id="f-ideas">
      <h2>Find the next topic</h2>
      <p class="hint">AI suggests topics, then the app scores each from 0 to 5 against the pattern of your best videos. Your old video titles are used so no idea repeats.</p>
      <label for="ideas-focus">Theme focus (optional)<input id="ideas-focus" placeholder="e.g. Ice Age mammal predators"></label>
      <div class="row2">
        <label for="ideas-n">Number of ideas<input id="ideas-n" type="number" min="3" max="12" value="6"></label>
        <label for="ideas-freq">Uploads / month
          <select id="ideas-freq"><option value="2">2 videos</option><option value="4" selected>4 videos</option><option value="8">8 videos</option></select>
        </label>
      </div>
      <label for="ideas-start">Start date<input id="ideas-start" type="date"></label>
      <label for="ideas-avoid">Topics already made<textarea id="ideas-avoid" placeholder="Filled in automatically after a Studio import"></textarea></label>
      <div data-runw="ideas" data-cards></div>
      <button class="btn" type="submit" data-run="ideas">Find ideas</button>
      <div class="status" id="s-ideas" role="status"></div>
    </form>
    <div class="out" id="o-ideas"><div class="empty">Ideas will appear here, each with a score for how well it matches your best videos. Fill in the form beside it, then press <strong>Find ideas</strong>.</div></div>
    </div>
  </section>

  <!-- MAKE: every video in progress, then one video at a time in 12 steps -->
  <section id="p-make" role="tabpanel" aria-labelledby="t-make" hidden>
    <div id="vl" class="vd-view">
      <div class="vd-intro"><p class="sub">Videos you are working on. Closest to upload first.</p><div class="vd-new"><button type="button" class="btn" id="vl-new" data-run="auto" data-runcopy="+ New video (copy prompt to claude.ai)">+ New video (AI picks the topic)</button><div data-runw="auto"></div></div></div>
      <div class="status" id="s-vl" role="status"></div>
      <div class="vd-tiles" id="vl-tiles"></div>
      <section class="card vd-mig" id="vl-mig" aria-labelledby="vl-mig-h" hidden></section>
      <section class="card vd-list" id="vl-card" aria-labelledby="vl-h">
        <div class="vd-tbar"><h2 class="vd-h2" id="vl-h">Videos in progress</h2>
          <div class="vd-tools"><label class="search" for="vl-q"><svg viewBox="0 0 14 14" aria-hidden="true"><path d="M6 11a5 5 0 1 0 0-10 5 5 0 0 0 0 10M13.5 13.5 9.6 9.6"/></svg><span class="sr">Search videos</span><input id="vl-q" type="search" placeholder="Search videos" autocomplete="off"></label>
          <div class="seg" role="group" aria-label="Show" id="vl-seg"><button type="button" aria-pressed="true" data-vf="all">All</button><button type="button" aria-pressed="false" data-vf="week">This week</button><button type="button" aria-pressed="false" data-vf="done">Published</button></div></div>
        </div>
        <div class="vd-tblw"><table class="vd-table"><thead><tr><th scope="col">Upload</th><th scope="col">Video</th><th scope="col">Progress</th><th scope="col">Status</th><th scope="col">Next step</th><th scope="col"><span class="sr">Actions</span></th></tr></thead><tbody id="vl-rows"></tbody></table></div>
      </section>
      <section class="card vd-empty" id="vl-empty" aria-labelledby="vl-empty-h" hidden>
        <h2 class="vd-h2" id="vl-empty-h">No videos yet</h2>
        <p class="sub">Press <b>New video</b> and AI picks a topic that matches your best videos, then fills in the title, thumbnail text and hook. Each video then gets its own folder in Downloads\Terra Studio. You can also add a plan in the Calendar.</p>
        <div class="chips"><button type="button" class="btn" id="vl-new2" data-run="auto" data-runcopy="+ New video (copy prompt to claude.ai)">+ New video (AI picks the topic)</button><button type="button" class="btn ghost" data-goto="dash">Open Calendar</button></div>
      </section>
    </div>

    <div id="vd" class="vd-view" hidden>
      <div><button type="button" class="vd-back" id="vd-back"><span aria-hidden="true">&larr;</span> All videos</button></div>
      <div class="vd-hd"><div><h2 class="vd-title" id="vd-h" tabindex="-1"></h2><p class="sub" id="vd-sub"></p></div><span id="vd-pill"></span></div>
      <div class="vd-tiles" id="vd-tiles"></div>
      <div class="card vd-limit"><div class="vd-lh"><span><b id="vd-n"></b> steps done</span><span class="sub" id="vd-left"></span></div><div class="vd-track" role="img" id="vd-bar-l"><i id="vd-bar"></i></div><div class="status" id="vd-job" role="status"></div></div>
      <div class="vd-det">
        <ol class="vd-steps" id="vd-steps" aria-label="Steps for this video"></ol>
        <div class="card vd-pane" id="vd-pane">
          <div class="vd-head" id="vd-head"></div><p class="sr" id="vd-say" aria-live="polite"></p>
          <div class="vd-tool" data-tool="topic" hidden>
      <div class="mk-auto">
        <div><b id="mk-auto-h">Not sure what to make?</b><span id="mk-auto-p">One click: AI picks a topic that matches your best videos, fills in the titles, thumbnail text and hook, then writes the full script and voice over.</span></div>
        <div class="chips"><button type="button" class="btn" id="mk-one" data-run="auto" data-runcopy="Copy prompts and make the script">Make script in 1 click</button><button type="button" class="btn ghost" id="mk-auto" data-run="auto">Just suggest a topic</button><button type="button" class="btn ghost" id="mk-auto-new" data-run="auto" data-runcopy="Copy prompt for another topic" hidden>Another topic</button></div>
      </div>
      <div data-runw="auto"></div>
      <div class="status" id="s-auto" role="status"></div>
      <label for="mk-topic">Topic or animal name<input id="mk-topic" placeholder="e.g. Pachycrocuta" maxlength="140"></label>
          </div>
          <div class="vd-tool" data-tool="titles" hidden>
      <div class="td2">
        <div class="box">
          <h4>Title first, before writing</h4>
          <p class="sub">If no title makes people curious, change the topic. Pick one title; it is used for the thumbnail, hook and SEO.</p>
          <label for="mk-titles" style="margin-top:12px">Title ideas, one per line<textarea id="mk-titles" rows="4" placeholder="The 250 lb Hyena That Ate Our Ancestors"></textarea></label>
          <div class="tlist" id="mk-tlist" role="radiogroup" aria-label="Title in use"></div>
          <p class="sub" style="margin-top:10px">Check: <b>≤60</b> fits a phone screen · <b>Size</b> a number people can picture · <b>Threat</b> a danger to humans or a rival · <b>Name</b> the animal's name, for search.</p>
          <div data-runw="titles" style="margin-top:12px"></div>
          <div class="chips" style="margin-top:8px"><button type="button" class="btn ghost" id="mk-titles-ai" data-run="titles" data-runcopy="Copy prompt for 5 titles">Ask AI for 5 titles</button></div>
          <div class="status" id="s-titles" role="status"></div>
        </div>
        <div class="box">
          <h4>Thumbnail text</h4>
          <p class="sub">At most 4 words. One animal, one threat, big contrast. This text adds to the title, it does not repeat it.</p>
          <label for="mk-thumbtext" style="margin-top:12px">Thumbnail text<input id="mk-thumbtext" maxlength="40" placeholder="ATE OUR ANCESTORS"></label>
          <div class="mk-thumb" id="mk-thumbprev" aria-hidden="true"><span></span></div>
          <p class="note" id="mk-thumbnote"></p>
        </div>
      </div>
          </div>
          <div class="vd-tool" data-tool="hook" hidden>
      <div class="td2">
        <div class="box">
          <h4>Hook coach: the first 60 seconds</h4>
          <p class="sub">This is where your viewers leave. Your best videos open straight with the animal and the danger. Write the opening here; the checks beside it update as you type.</p>
          <label for="mk-hook" style="margin-top:12px">Opening, in the video's language<textarea id="mk-hook" rows="9" placeholder="Two million years ago, a hyena bigger than any alive today ruled the caves of what is now China…"></textarea></label>
          <p class="note" id="mk-hook-len"></p>
          <div data-runw="hook"></div>
          <div class="chips"><button type="button" class="btn" id="mk-hook-ai" data-run="hook" data-runcopy="Copy prompt and fix the hook">Fix with AI</button><button type="button" class="btn ghost" data-vd-go="outline">Go to outline</button></div>
          <div class="status" id="s-hook" role="status"></div>
          <div class="out" id="o-hook"></div>
        </div>
        <div class="box">
          <h4>Check the hook</h4>
          <p class="sub">Rules from your videos that viewers left in the first minute.</p>
          <ul class="rules" id="mk-rules"></ul>
        </div>
      </div>
          </div>
          <div class="vd-tool" data-tool="outline" hidden>
    <div class="panel">
    <form class="tool" id="f-script">
      <h4>Outline and full script</h4>
      <p class="hint">One click: an outline act by act, the full narration with your hook as the opening, then the ElevenLabs voice over (skipped when this video already has one). The narration is written one act at a time so it reaches the target length. All fields are filled in; just press the button.</p>
      <label for="script-topic">Video topic<input id="script-topic" required></label>
      <label for="script-angle">Story angle (optional)<textarea id="script-angle" placeholder="Leave empty and AI picks the strongest"></textarea></label>
      <div class="row2">
        <label for="script-words">Target words<input id="script-words" type="number" min="500" max="8000" step="100" value="2000"></label>
        <label for="script-acts">Number of acts<input id="script-acts" type="number" min="3" max="7" value="5"></label>
      </div>
      <div class="chips" id="script-len" role="group" aria-label="Script length options"><button type="button" class="btn ghost" data-w="2000">2,000 words · 14 min</button><button type="button" class="btn ghost" data-w="3000">3,000 words · 21 min</button><button type="button" class="btn ghost" data-w="4500">4,500 words · 32 min</button></div>
      <p class="note" id="script-len-note"></p>
      <label for="script-tone">Tone
        <select id="script-tone"><option>Cinematic, awe and mystery</option><option>Investigative, evidence-led</option><option>Survival drama</option><option>Calm, sleep-friendly narration</option></select>
      </label>
      <label class="cbx" for="script-auto"><input type="checkbox" id="script-auto" checked> Write the full narration and make the voice over straight away</label>
      <label class="cbx" for="script-fix"><input type="checkbox" id="script-fix" aria-describedby="script-fix-note" checked> Fix weak parts before voice over</label>
      <p class="note" id="script-fix-note">The script check runs on your PC for free. Every place it flags is then rewritten by AI and checked again, at most 2 tries per place and 10 short rewrites in all, before the voice over is made. With a Claude or KIE.ai key each one costs about Rp100 to 250. With Gemini it is free. In copy-paste mode nothing is rewritten for you; Fix all in the Script check step walks you through it.</p>
      <div data-runw="script"></div>
      <button class="btn" type="submit" data-run="script" data-runcopy="Copy prompts and make full script">Make full script</button>
      <div class="status" id="s-script" role="status"></div>
    </form>
    <div class="out" id="o-script"><div class="empty">The script outline will appear here, with the word share for each act and a list of facts to double-check. The hook is used as the cold open.</div></div>
    </div>
          </div>
          <div class="vd-tool" data-tool="script" hidden>
      <div data-runw="full"></div>
      <div class="chips"><button type="button" class="btn" id="script-full-btn" data-run="full">Write full narration script</button></div>
      <div class="status" id="s-scriptfull" role="status"></div>
      <div id="o-scriptfull" class="out"></div>
          </div>
          <div class="vd-tool" data-tool="check" hidden>
      <section class="card sc" id="sc-box" aria-labelledby="sc-h"></section>
          </div>
          <div class="vd-tool" data-tool="voice" hidden>
      <div class="vd-warn" id="vo-again" hidden><p><b>You already have this voice over.</b> <span id="vo-again-t"></span></p><div class="chips"><button type="button" class="btn" id="vo-again-yes">Yes, make it again</button><button type="button" class="btn ghost" id="vo-again-no">Keep the one I have</button></div></div>
      <div class="card" id="vo-box"></div>
      <div class="status" id="s-vo" role="status"></div>
          </div>
          <div class="vd-tool" data-tool="pack" hidden>
      <section class="card" id="pk-box" aria-labelledby="pk-h"></section>
          </div>
          <div class="vd-tool" data-tool="info" hidden>
      <section class="card" id="ig-box" aria-labelledby="ig-h"></section>
          </div>
          <div class="vd-tool" data-tool="thumb" hidden>
      <div class="box" id="mk-gen">
        <h4>Finished thumbnails</h4>
        <p class="sub">One click: AI writes 3 concepts, Gemini or KIE.ai draws them, the app puts the text on top. Pick one and save it.</p>
        <div class="mk-auto" style="margin-top:12px">
          <div><b id="gen-h">Make 3 thumbnails with Gemini</b><span id="gen-p"></span></div>
          <button type="button" class="btn" id="gen-go" data-run="gen">Make 3 thumbnails</button>
        </div>
        <div data-runw="gen"></div>
        <div class="status" id="s-gen" role="status"></div>
        <div class="gthumbs" id="gen-list" hidden></div>
        <div class="gpos" id="gen-posrow" hidden>
          <label for="gen-pos">Text position
            <select id="gen-pos"><option value="tl">Top left</option><option value="bl">Bottom left</option><option value="tr">Top right</option><option value="none">No text</option></select>
          </label>
          <p class="note">The app adds the text, not the AI, so the letters are always right and can be changed without a new image.</p>
        </div>
        <div class="gphone" id="gen-phone" hidden>
          <div>
            <h3>Check at phone size</h3>
            <div class="gfeed" aria-label="How it looks on the YouTube home page">
              <img id="gen-feed-img" alt="Chosen thumbnail as on the YouTube home page">
              <div class="meta"><span class="av"></span><div><b id="gen-feed-title"></b><small id="gen-feed-ch"></small></div></div>
            </div>
          </div>
          <div>
            <h3>Suggested-video size</h3>
            <div class="gside"><img id="gen-side-img" alt="Chosen thumbnail at small size"><span id="gen-side-title"></span></div>
            <p class="note">If the text is still readable this small, the thumbnail is fine. Save 2 or 3 versions for Test &amp; Compare in YouTube Studio.</p>
            <p class="note" id="gen-saved"></p>
            <div class="chips"><button type="button" class="btn ghost" id="gen-folder">Open thumbnail folder</button></div>
          </div>
        </div>
      </div>
      <div class="panel" id="mk-thumbtool">
    <form class="tool" id="f-thumb">
      <h4>Thumbnail concepts for Google Flow</h4>
      <p class="hint">Free fallback: three concepts with image prompts you can copy into Google Flow, with the composition and why people would click.</p>
      <label for="thumb-topic">Video topic<input id="thumb-topic" required></label>
      <label for="thumb-title">Title in use (optional)<input id="thumb-title"></label>
      <label for="thumb-style">Visual style
        <select id="thumb-style"><option>Photoreal cinematic</option><option>Painted illustration</option><option>Dark documentary, high contrast</option><option>Bold minimal graphic</option></select>
      </label>
      <div data-runw="thumb"></div>
      <button class="btn" type="submit" data-run="thumb">Make concepts</button>
      <div class="status" id="s-thumb" role="status"></div>
    </form>
    <div class="out" id="o-thumb"><div class="empty">Three thumbnail concepts will appear here. The image prompts can be copied into Google Flow.</div></div>
      </div>
          </div>
          <div class="vd-tool" data-tool="seo" hidden>
    <div class="panel">
    <form class="tool" id="f-seo">
      <h4>SEO package</h4>
      <p class="hint">Keywords, 5 titles, a description with chapters, hashtags, tags, a pinned comment and a Community post for publish day.</p>
      <label for="seo-topic">Video topic<input id="seo-topic" required></label>
      <label for="seo-facts">Key facts / outline (optional)<textarea id="seo-facts"></textarea></label>
      <label for="seo-mins">Video length (minutes)<input id="seo-mins" type="number" min="1" max="180" value="12"></label>
      <div data-runw="seo"></div>
      <button class="btn" type="submit" data-run="seo">Make SEO package</button>
      <div class="status" id="s-seo" role="status"></div>
    </form>
    <div class="out" id="o-seo"><div class="empty">The SEO package will appear here. Each part has a Copy button for pasting into YouTube Studio.</div></div>
    </div>
          </div>
          <div class="vd-tool" data-tool="upload" hidden>
      <div class="box">
        <h4>Checklist before upload</h4>
        <p class="sub">Saved per video. The app never uploads anything; you still upload yourself in YouTube Studio.</p>
        <ul class="check" id="mk-pub" style="margin-top:10px"></ul>
        <div class="chips" style="margin-top:12px"><button type="button" class="btn ghost" id="mk-done">Mark as published</button></div>
        <div class="status" id="s-done" role="status"></div>
      </div>
          </div>
          <p class="sub" id="vd-where"></p>
        </div>
      </div>
      <section class="card vd-folder" id="vd-folder" aria-labelledby="vd-f-h">
        <div class="vd-tbar"><div><h2 class="vd-h2" id="vd-f-h">Video folder</h2><p class="vd-path" id="vd-path"></p></div><button type="button" class="btn sm" id="vd-fopen">Open video folder</button></div>
        <div class="vd-wallet"><div class="vd-wh"><span><b>Folders</b> · 8 total</span><span id="vd-fsum"></span></div><ul class="vd-folders" id="vd-folders"></ul></div>
        <p class="sub">Files the app makes land in the right folder by themselves. Google Flow clips and Remotion renders: drop them in a folder marked <b class="vd-drop">Drop here</b>. Save your Premiere project and exports in 08 Premiere. Nothing in these folders is ever deleted by the app.</p>
        <div class="status" id="s-folder" role="status"></div>
      </section>
    </div>
  </section>

  <!-- GROWTH -->
  <section id="p-growth" role="tabpanel" aria-labelledby="t-growth" hidden>
    <div id="g-empty" class="card" hidden>
      <span class="layer">No data yet</span>
      <h3>Import your YouTube Studio data</h3>
      <ol class="steps">
        <li>Open YouTube Studio, then Analytics, then <strong>Advanced mode</strong> (Advanced mode).</li>
        <li>Pick a date range, for example Lifetime.</li>
        <li>Click the download icon at the top right, choose <strong>Comma-separated values (.csv)</strong>. You get a .zip file.</li>
        <li>Click the button below and choose that .zip file. You can repeat this for the Traffic source and Geography tabs.</li>
      </ol>
      <button type="button" class="btn" data-import>Import .zip file from Studio</button>
      <div class="status" id="s-import-empty" role="status"></div>
    </div>

    <div id="g-full" hidden>
      <div class="card">
        <div class="out-head"><span class="layer" id="g-range">YouTube Studio data</span><span class="chips"><button type="button" class="btn ghost" data-ytsync hidden>Pull from YouTube</button><button type="button" class="btn ghost" data-import>Import new data</button></span></div>
        <h3>Channel report</h3>
        <div class="kpis" id="g-kpis"></div>
        <p style="margin:14px 0 0;font-weight:700">Views per month: when did the channel rise, when did it fall?</p>
        <div class="chart-wrap" id="g-chart-wrap"><svg id="g-chart" role="img" aria-label="Bar chart of views per month" style="width:100%;min-width:560px;height:240px;display:block"></svg><div class="tip" id="g-tip" hidden></div></div>
        <p class="note" id="g-chart-note">Hover or focus a bar for the monthly number. A striped bar is a month that is not complete yet.</p>
        <details class="mtable"><summary>See the monthly numbers as a table</summary><div style="overflow-x:auto"><table id="g-mtable"></table></div></details>
        <div class="status" id="s-import" role="status"></div>
      </div>

      <div class="grid2" style="margin-top:16px">
        <div class="card">
          <span class="layer">Automatic diagnosis</span>
          <h3>Best videos compared with the newest</h3>
          <div style="overflow-x:auto"><table class="cmp" id="g-cmp"></table></div>
          <ul class="diag" id="g-diag"></ul>
          <div data-runw="ai"></div>
          <button type="button" class="btn" id="g-ai-btn" data-run="ai" data-runcopy="Copy prompt for a deeper analysis">Deeper analysis with AI</button>
          <div class="status" id="s-ai" role="status"></div>
          <div id="g-ai" class="out" style="margin-top:12px"></div>
        </div>
        <div class="card">
          <span class="layer">An estimate, not a promise</span>
          <h3>Ad revenue simulator</h3>
          <div class="row2" style="margin:10px 0">
            <label for="g-views">Views / month<input id="g-views" type="number" min="0" step="1000" value="10000"></label>
            <label for="g-rpm"><span>RPM (<span class="cur">Rp</span> per 1,000 views)</span><input id="g-rpm" type="number" min="0" step="100" value="0"></label>
          </div>
          <div class="row2">
            <label for="g-members">Active members<input id="g-members" type="number" min="0" value="0"></label>
            <label for="g-mprice"><span>Member price (<span class="cur">Rp</span>)</span><input id="g-mprice" type="number" min="0" step="100" value="0"></label>
          </div>
          <div id="g-income" style="margin-top:12px"></div>
          <div class="chips" style="margin-top:10px" id="g-presets"></div>
          <p class="note" id="g-rpm-note"></p>
        </div>
      </div>

      <div class="grid2" style="margin-top:16px" id="g-extra"></div>

      <div class="card" style="margin-top:16px">
        <span class="layer">All long videos, click a column header to sort</span>
        <h3>Performance per video</h3>
        <div style="overflow-x:auto"><table class="vt" id="g-table"></table></div>
      </div>
    </div>

    <div class="grid2" style="margin-top:16px">
      <div class="card">
        <span class="layer">Saved on this computer</span>
        <h3>Growth checklist</h3>
        <ul class="check" id="g-check"></ul>
      </div>
      <form class="tool" id="f-shorts">
        <h2>Shorts from long videos</h2>
        <p class="hint">Each long video can become 3 to 5 Shorts that send viewers back to the full video.</p>
        <label for="shorts-topic">Source video<input id="shorts-topic" required></label>
        <label for="shorts-facts">Most interesting moments / facts (optional)<textarea id="shorts-facts"></textarea></label>
        <div data-runw="shorts"></div>
        <button class="btn" type="submit" data-run="shorts">Make 5 Shorts ideas</button>
        <div class="status" id="s-shorts" role="status"></div>
        <div class="out" id="o-shorts"></div>
      </form>
    </div>
  </section>

  <!-- SETTINGS -->
  <section id="p-settings" role="tabpanel" aria-labelledby="t-settings" hidden>
    <div class="grid2">
      <form class="tool" id="f-key">
        <h2>AI connection</h2>
        <label for="cfg-provider">How to use AI
          <select id="cfg-provider">
            <option value="manual">Copy-paste to claude.ai (uses your subscription, no cost)</option>
            <option value="gemini">Gemini, automatic (free quota from Google)</option>
            <option value="claude">Claude, automatic (paid API, best results)</option>
            <option value="kie">KIE.ai (one key, pay as you go)</option>
          </select>
        </label>
        <p class="hint" id="prov-hint"></p>
        <div id="grp-gemini" class="grp">
          <ol class="steps"><li>Open <a href="https://aistudio.google.com/apikey" target="_blank" rel="noopener">aistudio.google.com/apikey</a> and sign in with your Google account.</li><li>Click <strong>Create API key</strong>, then copy the key.</li><li>Paste it below, click Save, then Test connection.</li></ol>
          <label for="cfg-gkey">Gemini API key<input id="cfg-gkey" type="password" autocomplete="off" placeholder="AIza..."></label>
          <p class="note" id="cfg-gkey-hint"></p>
          <label for="cfg-gmodel">Gemini model<select id="cfg-gmodel"><option value="">Automatic: latest Gemini Flash</option></select></label>
          <div class="chips"><button class="btn ghost" type="button" id="cfg-gmodels">Load model list</button><button class="btn ghost" type="button" id="cfg-gclear">Remove Gemini key</button></div>
          <p class="note">On the free quota, Google may use your requests to improve its models, and there are limits on requests per minute and per day.</p>
        </div>
        <div id="grp-claude" class="grp">
          <label for="cfg-key">Claude API key<input id="cfg-key" type="password" autocomplete="off" placeholder="sk-ant-..."></label>
          <p class="note" id="cfg-key-hint"></p>
          <label for="cfg-model">Model
            <select id="cfg-model">
              <option value="claude-sonnet-5-5">Claude Sonnet 5.5: recommended, balanced (about Rp500 to 1,500 per run)</option>
              <option value="claude-opus-5-5">Claude Opus 5.5: best results (about Rp1,000 to 3,000)</option>
              <option value="claude-haiku-5-5">Claude Haiku 5.5: cheapest (under Rp100)</option>
            </select>
          </label>
          <label for="cfg-effort">Thinking depth
            <select id="cfg-effort"><option value="low">Low (fast, cheap)</option><option value="medium" selected>Medium</option><option value="high">High (more careful, costs more)</option></select>
          </label>
          <p class="note">Create a key at <a href="https://platform.claude.com/settings/keys" target="_blank" rel="noopener">platform.claude.com</a> and add credit (separate from your claude.ai subscription). A cost estimate appears after each run.</p>
          <p class="note" id="cfg-spent"></p>
          <div class="chips"><button class="btn ghost" type="button" id="cfg-clear">Remove Claude key</button></div>
        </div>
        <div id="grp-kie" class="grp">
          <ol class="steps"><li>Open <a href="https://kie.ai" target="_blank" rel="noopener">kie.ai</a>, sign in and top up credit. A few dollars is enough to start.</li><li>Open <a href="https://kie.ai/api-key" target="_blank" rel="noopener">kie.ai/api-key</a>, create a key, then copy it.</li><li>Paste it below, click Save, then Test connection.</li></ol>
          <label for="cfg-kkey">KIE.ai API key<input id="cfg-kkey" type="password" autocomplete="off" placeholder="Paste the key from kie.ai/api-key"></label>
          <p class="note" id="cfg-kkey-hint"></p>
          <label for="cfg-kmodel">Model
            <select id="cfg-kmodel">
              <option value="claude-sonnet-5-5">Claude Sonnet 5.5: suggested</option>
              <option value="claude-haiku-5-5">Claude Haiku 5.5: cheaper</option>
              <option value="claude-opus-5-5">Claude Opus 5.5: best results, costs more</option>
            </select>
          </label>
          <p class="note" id="cfg-kbal" role="status"></p>
          <p class="note" id="cfg-kspent"></p>
          <div class="chips"><button class="btn ghost" type="button" id="cfg-kcheck">Check balance (free)</button><button class="btn ghost" type="button" id="cfg-kclear">Remove KIE.ai key</button></div>
          <p class="note">Test connection reads your balance, then sends one short message. That costs less than 1 credit. One credit is about $0.005.</p>
          <p class="note">Voice over stays on your own ElevenLabs key. KIE.ai only lists stock voices, not the voice your channel uses.</p>
          <p class="note">KIE.ai is a reseller. Its prices and models can change. These details come from its documentation, so run Test connection once after you paste the key.</p>
        </div>
        <div class="chips"><button class="btn" type="submit">Save</button><button class="btn ghost" type="button" id="cfg-test">Test connection</button></div>
        <div class="status" id="s-key" role="status"></div>
      </form>

      <form class="tool" id="f-image">
        <h2>Thumbnail images</h2>
        <p class="hint">Makes thumbnail images right in the Thumbnail step of Make video. Choose who draws them.</p>
        <label for="cfg-iprov">Make images with
          <select id="cfg-iprov">
            <option value="gemini">Gemini (uses your Google Cloud credit)</option>
            <option value="kie">KIE.ai, Nano Banana 2 (about $0.04 per image)</option>
          </select>
        </label>
        <div id="grp-igem" class="grp">
          <p class="note">Images only work on a Gemini key with billing turned on, so use a separate key and your scripts and ideas stay free on the old key.</p>
          <ol class="steps">
            <li>Open <a href="https://aistudio.google.com/apikey" target="_blank" rel="noopener">aistudio.google.com/apikey</a>. Click <strong>Create API key</strong> and choose a new project. On that project's row click <strong>Set up billing</strong>, then add a first credit of $5.</li>
            <li>Open <a href="https://developers.google.com/program/my-benefits" target="_blank" rel="noopener">Google Developer Program, My benefits</a>. Claim the Google Cloud credit to that billing account and tick <strong>Always use this billing account</strong>.</li>
            <li>Paste the new key below, click Save, then Test image.</li>
          </ol>
          <label for="cfg-ikey">Gemini key for images<input id="cfg-ikey" type="password" autocomplete="off" placeholder="AIza..."></label>
          <p class="note" id="cfg-ikey-hint"></p>
          <label for="cfg-imodel">Image model
            <select id="cfg-imodel">
              <option value="gemini-3.1-flash-image">Flash Image: better, about $0.067</option>
              <option value="gemini-3.1-flash-lite-image">Flash Lite Image: cheaper, about $0.034</option>
            </select>
          </label>
          <div class="chips"><button class="btn ghost" type="button" id="cfg-iclear">Remove image key</button></div>
          <p class="note">Prices are estimates from Google's price list as of November 2026. Google Cloud credit is used first; the $5 balance is only charged once that month's credit runs out.</p>
        </div>
        <div id="grp-ikie" class="grp">
          <p class="note">No Google billing setup is needed. Each image is about 8 KIE.ai credits ($0.04) at 1K size, from KIE.ai's price list. The app downloads each image at once, because KIE.ai deletes its copy after 14 days.</p>
          <label for="cfg-ikkey">KIE.ai API key<input id="cfg-ikkey" type="password" autocomplete="off" placeholder="Paste the key from kie.ai/api-key"></label>
          <p class="note" id="cfg-ikkey-hint"></p>
        </div>
        <div class="chips"><button class="btn" type="submit">Save</button><button class="btn ghost" type="button" id="cfg-itest">Test image</button></div>
        <p class="note" id="cfg-ispent"></p>
        <p class="note">Test image makes one real image, so it uses credit.</p>
        <div class="status" id="s-image" role="status"></div>
        <div id="cfg-itest-out"></div>
      </form>

      <form class="tool" id="f-yt">
        <h2>YouTube Studio</h2>
        <p class="hint" id="yt-state">Connect the channel so the numbers on the Dashboard and in Data &amp; money update by themselves, without manual exports.</p>
        <div id="yt-on" class="grp" hidden>
          <p style="margin:0"><strong id="yt-name"></strong></p>
          <p class="note" id="yt-last" style="margin:0"></p>
          <div class="chips"><button class="btn" type="button" id="yt-sync">Pull data now</button><button class="btn ghost" type="button" id="yt-off">Disconnect</button></div>
        </div>
        <details id="yt-setup">
          <summary>One-time steps in Google Cloud (about 15 minutes, free)</summary>
          <ol class="steps">
            <li>Open <a href="https://console.cloud.google.com/projectcreate" target="_blank" rel="noopener">console.cloud.google.com</a> with the Google account that owns the channel. Create a new project, for example <strong>Terra Studio</strong>.</li>
            <li>In the <a href="https://console.cloud.google.com/apis/library" target="_blank" rel="noopener">API Library</a>, search for and click <strong>Enable</strong> for <strong>YouTube Data API v3</strong> and <strong>YouTube Analytics API</strong>.</li>
            <li>Open <a href="https://console.cloud.google.com/auth/overview" target="_blank" rel="noopener">Google Auth Platform</a>, click Get started. App name: Terra Studio, choose <strong>External</strong>, fill in your email.</li>
            <li>In the menu <strong>Audience</strong>, click <strong>Publish app</strong> so the permission does not expire every 7 days.</li>
            <li>In the menu <strong>Clients</strong>, click Create client, choose type <strong>Desktop app</strong>. Copy the Client ID and Client secret below.</li>
          </ol>
        </details>
        <label for="yt-id">Client ID<input id="yt-id" autocomplete="off" placeholder="....apps.googleusercontent.com"></label>
        <label for="yt-secret">Client secret<input id="yt-secret" type="password" autocomplete="off" placeholder="GOCSPX-..."></label>
        <p class="note" id="yt-secret-hint"></p>
        <div class="chips"><button class="btn" type="submit" id="yt-connect">Save and connect YouTube</button></div>
        <p class="note">Google will show "Google hasn't verified this app". That is normal because the app is your own: click Continue. Impressions and CTR are not available through this connection, so those numbers still come from the last Studio export.</p>
        <div class="status" id="s-yt" role="status"></div>
      </form>

      <form class="tool" id="f-voice">
        <h2>Voice (ElevenLabs)</h2>
        <p class="hint">Turns the full narration into an MP3 voice over. Uses the character quota of your ElevenLabs subscription, no extra cost.</p>
        <ol class="steps"><li>Open <a href="https://elevenlabs.io/app/settings/api-keys" target="_blank" rel="noopener">elevenlabs.io/app/settings/api-keys</a>.</li><li>Click <strong>Create API key</strong>. Allow Text to Speech, Voices, Models and User (read).</li><li>Paste it below, then click Load voices.</li></ol>
        <label for="cfg-ekey">ElevenLabs API key<input id="cfg-ekey" type="password" autocomplete="off" placeholder="sk_..."></label>
        <p class="note" id="cfg-ekey-hint"></p>
        <div class="chips"><button class="btn ghost" type="button" id="cfg-eload">Load voices</button></div>
        <div id="eleven-quota" class="note"></div>
        <label for="cfg-evoice">Narrator voice<select id="cfg-evoice"><option value="">Click Load voices first</option></select></label>
        <div id="cfg-epreview"></div>
        <label for="cfg-emodel">Voice model<select id="cfg-emodel"><option value="">Automatic: Multilingual v2 (most natural)</option></select></label>
        <div class="chips"><button class="btn" type="submit">Save</button><button class="btn ghost" type="button" id="cfg-eclear">Remove ElevenLabs key</button></div>
        <p class="note" id="cfg-adir"></p>
        <div class="status" id="s-voice" role="status"></div>
      </form>

      <form class="tool" id="f-profile">
        <h2>Channel profile</h2>
        <p class="hint">Every generator reads this profile. The more specific it is, the better the results.</p>
        <label for="pf-name">Channel name<input id="pf-name"></label>
        <div class="row2">
          <label for="pf-lang">Content language<input id="pf-lang" value="English"></label>
          <label for="pf-length">Usual video length<input id="pf-length" placeholder="e.g. 8 to 14 minutes"></label>
        </div>
        <label for="pf-niche">Niche and topics<textarea id="pf-niche" placeholder="e.g. prehistory documentaries: Ice Age megafauna, dinosaurs, ancient seas"></textarea></label>
        <label for="pf-audience">Audience<textarea id="pf-audience" placeholder="e.g. 88% male, mostly 45 and over, 39% from the US"></textarea></label>
        <label for="pf-wins">What has worked<textarea id="pf-wins" placeholder="Best-performing video titles and their pattern. Filled in from Studio data when left empty."></textarea></label>
        <label for="pf-money">Membership, merch, sponsor<textarea id="pf-money" placeholder="e.g. Field Crew and Lead Explorers memberships, Bog Titan merch collection"></textarea></label>
        <label for="pf-style">Narration style<input id="pf-style" placeholder="e.g. cinematic, calm, authoritative"></label>
        <div class="chips"><button class="btn" type="submit">Save profile</button><button class="btn ghost" type="button" id="pf-export">Copy profile (JSON)</button><button class="btn ghost" type="button" id="pf-import">Paste profile (JSON)</button></div>
        <textarea id="pf-json" hidden aria-label="Profile as JSON"></textarea>
        <div class="status" id="s-profile" role="status"></div>
      </form>
    </div>
    <div class="card" style="margin-top:16px">
      <span class="layer">App</span>
      <h3>Data and app</h3>
      <p class="note">All settings, Studio data, calendar plans and AI results are stored only on this computer, in the folder <code id="cfg-dir"></code>. API keys are stored encrypted with Windows protection. Closing the Terra Studio window closes the app.</p>
      <h3 style="margin-top:14px">Backup</h3>
      <p class="note">Save a backup file (profile, Studio data, calendar, AI results) to the Downloads folder, then copy it to a flash drive or Google Drive. API keys and plan thumbnail images are not included. Restore it on a new computer or after reinstalling Windows.</p>
      <div class="chips"><button type="button" class="btn ghost" id="backup-save">Save backup</button><button type="button" class="btn ghost" id="backup-load">Restore from backup</button></div>
      <input type="file" id="backup-file" accept=".json,application/json" hidden>
      <div class="confirm" id="backup-confirm" hidden><span id="backup-confirm-text"></span> <button type="button" class="btn ghost" id="backup-yes">Yes, restore</button> <button type="button" class="btn ghost" id="backup-no">Cancel</button></div>
      <div class="chips"><button type="button" class="btn ghost" data-import>Import Studio data (.zip/.csv)</button><button type="button" class="btn ghost" id="data-clear">Delete Studio data</button><button type="button" class="btn ghost" id="app-quit">Close app</button></div>
      <div class="confirm" id="data-clear-confirm" hidden>Delete all imported Studio data? <button type="button" class="btn ghost" id="data-clear-yes">Yes, delete</button> <button type="button" class="btn ghost" id="data-clear-no">Cancel</button></div>
      <div class="status" id="s-app" role="status"></div>
    </div>
  </section>

  <input type="file" id="file-import" accept=".zip,.csv" multiple hidden>
  <footer>Each AI button runs with the AI you set in Settings (Gemini, Claude API or KIE.ai) or by copy and paste with claude.ai. The app remembers your choice per button.</footer>
</div>
  </main>
</div>

<script>
const $=s=>document.querySelector(s);
const esc=s=>String(s??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
const store={get(k,d){try{const v=localStorage.getItem("ts-"+k);return v?JSON.parse(v):d}catch{return d}},set(k,v){try{localStorage.setItem("ts-"+k,JSON.stringify(v))}catch{}}};
const api=async(path,opts={})=>{opts.headers={...(opts.headers||{}),"X-Terra":"1"};let r;try{r=await fetch(path,opts)}catch{return{error:"Terra Studio is not running. Open it again from its icon."}}let j={};try{j=await r.json()}catch{}if(!r.ok&&!j.error)j.error="The app is not responding ("+r.status+").";return j};
let CFG={profile:{}},YT=null;

/* heartbeat: the app exits a while after this window closes */
const beat=()=>fetch("/api/heartbeat",{method:"POST",headers:{"X-Terra":"1"}}).catch(()=>{});setInterval(beat,15000);beat();

/* tabs */
const tabs=[...document.querySelectorAll("nav.tabs button")];
// The first show() skips scrollIntoView: Chromium moves the Tab starting point there, past the skip link.
// 1.x had separate Script, SEO and Thumbnail pages; they now live as stages of Make.
const OLD_TAB={script:"script",seo:"seo",thumb:"thumb"};
// The app scrolls inside .main and .side only; snap the window back if anything moves it.
addEventListener("scroll",()=>{if(innerWidth>560&&(scrollX||scrollY))scrollTo(0,0)});
function show(name,first){if(OLD_TAB[name])return openMake(null,OLD_TAB[name]);if(!tabs.some(b=>b.dataset.tab===name))name="today";tabs.forEach(b=>{const on=b.dataset.tab===name;b.setAttribute("aria-selected",on);if(on){if(!first)b.scrollIntoView({block:"nearest",inline:"nearest"});$("#page-title").textContent=b.textContent.trim()}$("#p-"+b.dataset.tab).hidden=!on});
  $(".shell").dataset.tab=name;store.set("tab",name);$("#main").scrollTop=0;
  if(name==="dash"){renderDash();if(!first)thumbFollow().catch(()=>{})}if(name==="today")renderToday();if(name==="learn")renderLearn();if(name==="ideas")renderPattern();if(name==="make")renderMake();if(name==="edit"){ED.scan={};edRender()}if(name==="growth")requestAnimationFrame(()=>{if(YT)chart()})}
tabs.forEach(b=>b.addEventListener("click",()=>{if(b.dataset.tab==="make")VD.view="list";if(b.dataset.tab==="edit")ED.view="list";show(b.dataset.tab)}));
function setNav(open){document.documentElement.dataset.nav=open?"open":"closed";store.set("nav",open?"open":"closed");
  const b=$("#nav-tog"),t=open?"Close menu":"Open menu";b.setAttribute("aria-label",t);b.title=t+" (Ctrl+B)";
  $("#nav-tog-arrow").setAttribute("d",open?"m10 5.25-1.75 1.75L10 8.75":"m8.5 5.25 1.75 1.75L8.5 8.75");
  // the charts are drawn in pixels, so they follow the page once it has its new width
  setTimeout(()=>{if(YT&&!$("#p-growth").hidden)chart();if(!$("#p-today").hidden)renderViews()},260)}
const navOpen=()=>document.documentElement.dataset.nav!=="closed";
$("#nav-tog").addEventListener("click",()=>setNav(!navOpen()));
document.addEventListener("keydown",e=>{if((e.ctrlKey||e.metaKey)&&!e.altKey&&!e.shiftKey&&e.key.toLowerCase()==="b"){e.preventDefault();setNav(!navOpen())}});
document.addEventListener("click",e=>{const g=e.target.closest("[data-goto]");if(g)show(g.dataset.goto)});

/* prompt context from the profile */
function channelContext(){
  const p=CFG.profile||{},lines=[];
  lines.push(`You are helping the YouTube channel "${p.name||"(unnamed channel)"}".`);
  if(p.niche)lines.push("Niche and topics: "+p.niche);
  lines.push("Content language: "+(p.lang||"English")+". Write all video-facing text (titles, scripts, descriptions, tags, prompts) in that language.");
  if(p.length)lines.push("Typical video length: "+p.length+".");
  if(p.audience)lines.push("Audience: "+p.audience);
  const wins=p.wins||autoWins();if(wins)lines.push("What has worked on this channel: "+wins);
  if(p.money)lines.push("Monetization: "+p.money);
  if(p.style)lines.push("Narration style: "+p.style);
  lines.push("Keep facts accurate; flag anything uncertain instead of inventing it.");
  lines.push("Writing rules: no em dashes or en dashes (use commas, periods, colons or parentheses); no hype words (unlock, delve, journey, testament, revolutionary, seamless, mind-blowing, game-changer); no \"it's not just X, it's Y\" constructions; no runs of short dramatic fragments; no forced lists of three; no emojis; no invented numbers, dates, names or quotes.");
  lines.push("Write every field in English.");
  return lines.join("\n");
}
function autoWins(){if(!YT||!YT.videos)return "";const top=longForm().sort((a,b)=>b.v-a.v).slice(0,6);if(!top.length)return "";return "Top videos by views: "+top.map(v=>`"${v.t}" (${v.v} views, CTR ${v.ctr}%)`).join("; ")+"."}

/* Claude via the local app */
/* rough cost: USD per million tokens (input, output), shown in rupiah at a fixed rate */
const PRICE={"claude-opus-5-5":[4,20],"claude-sonnet-5-5":[2,10],"claude-haiku-5-5":[0.1,0.5]},KURS=16500;
function costRp(model,u,provider){if(provider==="gemini")return 0;const k=Object.keys(PRICE).find(m=>(model||"").startsWith(m));if(!u)return 0;const [i,o]=k?PRICE[k]:[5,25];return (u.input_tokens*i+u.output_tokens*o)/1e6*KURS}
let LAST={};
async function remember(key,data,at){LAST[key]={at:at||Date.now(),data};const j=await api("/api/last",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({key,value:LAST[key]})});
  const bn=$("#banner-save");if(j?.error){$("#banner-save-t").textContent=`Your latest work could not be saved (${j.error}). It is kept only until the app is closed, so keep the app open and try the step again.`;bn.hidden=false;bn.dataset.key=key}else if(bn&&bn.dataset.key===key)bn.hidden=true;return j}
function spentText(){const s=LAST._spent?.data;const m=new Date().toISOString().slice(0,7);return s&&s.month===m?`Estimated AI cost this month: Rp${nf(Math.round(s.rp))} of ${s.n} runs.`:"No AI cost this month yet."}
async function addSpent(rp){const m=new Date().toISOString().slice(0,7);let s=LAST._spent?.data;if(!s||s.month!==m)s={month:m,rp:0,n:0};s.rp+=rp;s.n+=1;await remember("_spent",s);const el=$("#cfg-spent");if(el)el.textContent=spentText()}
/* KIE.ai bills in credits. The backend's count is used when it sends one, else an estimate from Claude list prices. */
const KIE_USD=.005,KIE_IMG=8,KIE_CLIP=35;
const usdS=x=>x<.005?"under $0.01":"$"+x.toFixed(2);
const kieTxt=c=>`${c<10?(Math.round(c*10)/10).toLocaleString("en-US"):nf(c)} credit${c===1?"":"s"} (${usdS(c*KIE_USD)})`;
const kieCost=j=>typeof j.credits==="number"?j.credits:costRp(j.model,j.usage,"kie")/KURS/KIE_USD;
const kieMonth=()=>{const s=LAST._kie?.data,m=new Date().toISOString().slice(0,7);return s&&s.month===m?s:{month:m,credits:0,text:0,image:0,clip:0}};
function kieSpentText(){const s=kieMonth(),part=(n,w)=>n?`${n} ${w}${n>1?"s":""}`:"",list=[part(s.text,"text run"),part(s.image,"image"),part(s.clip,"clip")].filter(Boolean);
  return list.length?`KIE.ai this month: about ${kieTxt(s.credits)} for ${list.join(", ")}.`:"No KIE.ai cost this month yet."}
let kieBalT=0;
async function addKie(credits,kind){const s={...kieMonth()};s.credits+=credits;s[kind]=(s[kind]||0)+1;await remember("_kie",s);const el=$("#cfg-kspent");if(el)el.textContent=kieSpentText();clearTimeout(kieBalT);kieBalT=setTimeout(kieBalance,1500)}
async function kieBalance(){const el=$("#cfg-kbal");if(!el||!CFG.has_kie){if(el)el.textContent="";return null}
  const j=await api("/api/kie/credits");el.textContent=j.error?"The balance could not be read. "+j.error:"Balance: "+kieBalText(j)+", checked "+new Date().toLocaleTimeString("en-US",{hour:"2-digit",minute:"2-digit"})+".";return j}
const kieBalText=j=>`${(Math.round(j.credits*10)/10).toLocaleString("en-US")} credits, about $${(+j.usd).toFixed(2)}`;
// One label for every button that calls the text AI.
function costTag(u,k){if(runCopy(k))return "";if(CFG.provider==="gemini")return " (free with Gemini)";
  if(CFG.provider==="kie"){const x=costRp(CFG.kie_model,u,"kie")/KURS;return ` (${x<.005?"":"about "}${usdS(x)})`}
  return ` (about Rp${nf(Math.max(1,Math.round(costRp(CFG.model,u,CFG.provider)/10)*10))})`}
/* Run with: each AI button runs with the AI set in Settings, or by copy and paste with claude.ai.
   The last choice is kept per button; the default is Settings. */
const RUN_EST={post:[1200,300],pics:[2500,1500],ideas:[2600,2000],auto:[9000,6000],titles:[1400,300],hook:[1800,700],script:[8000,5200],full:[7000,4200],check:[1500,200],ig:[4500,700],gen:[1500,900],thumb:[1300,900],seo:[2000,1700],shorts:[1500,1100],ai:[5000,1800]};
const RUN_MANY={auto:"In copy mode, Make script in 1 click takes 3 pastes: the topic, the outline, then the script.",script:"In copy mode this takes 2 pastes: the outline, then the script."};
const provName=()=>({kie:"KIE.ai",claude:"Claude",gemini:"Gemini"})[CFG.provider]||"AI";
const runCopy=k=>!CFG.provider||!!k&&store.get("run-"+k,"app")==="copy";
const runCost=k=>{const [i,o]=RUN_EST[k]||[2000,800],c=CFG.provider==="gemini"?"free":costTag({input_tokens:i,output_tokens:o}).trim().slice(1,-1);return (k==="auto"||k==="script"?"up to ":"")+c};
const lc1=t=>/^[A-Z][a-z]/.test(t)?t.charAt(0).toLowerCase()+t.slice(1):t;
const runTxt=(k,t,many)=>runCopy(k)?`Copy prompt${many?"s":""} and ${lc1(t)}`:t;
let RUNN=0;
function runW(k,cards){
  // Make 3 thumbnails pays for its images whichever way the ideas are written.
  const ip=k==="gen"&&imgReady()?IMG_PRICE[imgModel()]*3:0,img=ip?` The 3 images still cost about ${usd(ip)}.`:"";
  if(!CFG.provider)return `<p class="note runw">No AI is set up in Settings, so ${ip?"the ideas come":"this runs"} by copy and paste with claude.ai (free).${img}</p>`;
  const cp=runCopy(k),n="run-"+k+"-"+(++RUNN),c=runCost(k),many=(RUN_MANY[k]?`<p class="note runn" data-runn="${k}"${cp?"":" hidden"}>${RUN_MANY[k]}</p>`:"")+(ip?`<p class="note runn">This price is for the ideas. The 3 images cost about ${usd(ip)} either way.</p>`:"");
  const r=(v,inner)=>`<label><input type="radio" name="${n}" value="${v}" data-runk="${k}"${(v==="copy")===cp?" checked":""}>${inner}</label>`;
  if(cards)return `<div class="runc" role="radiogroup" aria-label="Run with"><span class="runl" aria-hidden="true">Run with</span><div class="opt">${r("app",`<b>${provName()}, straight in the app</b><small>${c.charAt(0).toUpperCase()+c.slice(1)} · ready in about 1 minute</small>`)}${r("copy",`<b>Copy prompt to claude.ai</b><small>Free with your Claude subscription · you paste the answer back</small>`)}</div>${many}</div>`;
  return `<div class="runw" role="radiogroup" aria-label="Run with"><span class="runl" aria-hidden="true">Run with</span><span class="runseg">${r("app",`${provName()}, ${c}`)}${r("copy","claude.ai, free")}</span>${many}</div>`}
function runLbl(b){if(b.dataset.base==null)b.dataset.base=b.textContent;b.textContent=runCopy(b.dataset.run)&&!b.dataset.plain?b.dataset.runcopy||runTxt(b.dataset.run,b.dataset.base):b.dataset.base}
const setRunTxt=(b,t)=>{b.dataset.base=t;runLbl(b)};
function runPaint(){document.querySelectorAll("[data-runw]").forEach(el=>el.innerHTML=runW(el.dataset.runw,el.hasAttribute("data-cards")));document.querySelectorAll("button[data-run]").forEach(runLbl)}
document.addEventListener("change",e=>{const i=e.target.closest?.("input[data-runk]");if(!i)return;const k=i.dataset.runk;store.set("run-"+k,i.value);const cp=runCopy(k);
  document.querySelectorAll(`input[data-runk="${k}"]`).forEach(x=>x.checked=(x.value==="copy")===cp);document.querySelectorAll(`[data-runn="${k}"]`).forEach(x=>x.hidden=!cp);
  document.querySelectorAll(`button[data-run="${k}"]`).forEach(runLbl);
  if(k==="check"&&lastNarr)scRender(lastNarr);if(k==="ig"&&lastNarr)igRender(lastNarr);if(k==="pics")edRender();if(k==="gen")genBar();
  if(!i.isConnected)document.querySelector(`input[data-runk="${k}"]:checked`)?.focus()});
/* Copy mode: the prompt goes to claude.ai (the user's own subscription) and the reply is pasted back. */
function manualAsk(statusEl,prompt){
  const old=statusEl.nextElementSibling;if(old&&old.classList.contains("manual"))old.remove();
  const box=document.createElement("div");box.className="card manual";const id="mp"+Math.random().toString(36).slice(2,8);
  box.innerHTML=`<span class="layer">Use your claude.ai subscription</span>\n  <ol class="steps"><li>Copy the prompt below.</li><li>Open <a href="https://claude.ai/new" target="_blank" rel="noopener">claude.ai</a>, start a new chat, paste it, then send.</li><li>Copy Claude's whole answer, paste it in the box at the bottom, then click <strong>Use answer</strong>.</li></ol>\n  <div class="copybox" style="margin-top:52px"><button type="button" class="btn ghost" data-copy="${id}" data-label="Copy prompt">Copy prompt</button><pre id="${id}" style="max-height:160px">${esc(prompt)}</pre></div>\n  <label style="margin-top:12px">Answer from claude.ai<textarea rows="5" placeholder="Paste the answer here"></textarea></label>\n  <div class="confirm"><button type="button" class="btn" data-act="use">Use answer</button><button type="button" class="btn ghost" data-act="cancel">Cancel</button></div>\n  <div class="status" role="status"></div>`;
  statusEl.after(box);if(!box.isConnected)return Promise.resolve(null);statusEl.className="status";statusEl.textContent="Waiting for the answer from claude.ai.";
  navigator.clipboard?.writeText(prompt).then(()=>{const li=box.querySelector(".steps li");if(li)li.textContent="The prompt is already copied for you. Copy prompt copies it again."}).catch(()=>{});
  return new Promise(res=>{const mo=new MutationObserver(()=>{if(!box.isConnected){mo.disconnect();res(null)}});mo.observe(document.body,{childList:true,subtree:true});
    box.querySelector('[data-act="cancel"]').onclick=()=>{box.remove();statusEl.textContent="";res(null)};
    box.querySelector('[data-act="use"]').onclick=()=>{const d=parseJSON(box.querySelector("textarea").value);const st=box.querySelector(".status");
      if(!d){st.className="status err";st.textContent="The answer could not be read. Make sure Claude's whole answer is copied, from the first { to the last }.";return}
      box.remove();res(d)};
  })}
async function ask(statusEl,btn,prompt,key,label,copy){
  if(typeof copy==="boolean"?copy:runCopy(btn?.dataset?.run)){const full=channelContext()+"\n\n"+prompt+"\n\nReply directly in this chat (not as an artifact or file) with ONLY valid JSON, no markdown fences, no text before or after.";
    const data=await manualAsk(statusEl,full);
    if(data){statusEl.className="status";statusEl.textContent="Done, "+new Date().toLocaleTimeString("en-US",{hour:"2-digit",minute:"2-digit"})+", via claude.ai, result saved";if(key)remember(key,data).catch(()=>{})}
    return data}
  statusEl.className="status";statusEl.textContent=label||"AI is writing… (usually 20 to 90 seconds)";btn.disabled=true;
  // The Make pane is shared by all videos: once another one is open, this answer's status would describe the wrong video.
  const vid=mkId(),mine=()=>mkId()===vid||!statusEl.closest?.("#p-make");
  try{
    const j=await api("/api/generate",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({prompt:channelContext()+"\n\n"+prompt+"\n\nReturn ONLY valid JSON, no markdown fences, no text before or after."})});
    const kie=j.provider==="kie",rp=kie?0:costRp(j.model,j.usage,j.provider),kc=kie?kieCost(j):0;if(rp)addSpent(rp).catch(()=>{});if(kc)addKie(kc,"text").catch(()=>{});
    if(j.error)throw j;
    const data=parseJSON(j.text);
    if(!data)throw{error:"Claude's answer could not be read. Press the button once more."};
    if(mine())statusEl.textContent="Done, "+new Date().toLocaleTimeString("en-US",{hour:"2-digit",minute:"2-digit"})+(j.provider==="gemini"?", via Gemini":kie?`, via KIE.ai${kc?", cost about "+kieTxt(kc):""}`:rp?`, cost about Rp${nf(Math.max(1,Math.round(rp)))}`:"")+", result saved";
    if(key)remember(key,data).catch(()=>{});
    return data;
  }catch(e){if(mine()){statusEl.className="status err";statusEl.textContent=e.error||("Failed: "+(e.message||"try again."))}return null}
  finally{btn.disabled=false}
}
function parseJSON(t){if(!t)return null;try{return JSON.parse(t)}catch{}const a=t.indexOf("{"),b=t.lastIndexOf("}");if(a>=0&&b>a){try{return JSON.parse(t.slice(a,b+1))}catch{}}return null}

function copyBox(label,text){const id="c"+Math.random().toString(36).slice(2,8);return `<div class="card"><span class="layer">${esc(label)}</span><div class="copybox" style="margin-top:52px"><button type="button" class="btn ghost" data-copy="${id}">Copy</button><pre id="${id}">${esc(text)}</pre></div></div>`}
document.addEventListener("click",e=>{const b=e.target.closest("[data-copy]");if(!b)return;const pre=document.getElementById(b.dataset.copy);const txt=pre.textContent;
  const done=()=>{b.textContent="Copied";setTimeout(()=>b.textContent=b.dataset.label||"Copy",1500)};
  const sel=()=>{const r=document.createRange();r.selectNodeContents(pre);const s=getSelection();s.removeAllRanges();s.addRange(r);try{document.execCommand("copy");done()}catch{b.textContent="Press Ctrl+C"}};
  if(navigator.clipboard)navigator.clipboard.writeText(txt).then(done).catch(sel);else sel()});
const head=t=>`<div class="out-head"><span class="layer">${esc(t)}</span></div>`;
const val=id=>$(id).value.trim();

/* Ideas */
$("#ideas-start").value=new Date().toISOString().slice(0,10);
function schedule(n,perMonth,startISO){const gap=Math.round(30/perMonth),d=new Date(startISO+"T12:00:00"),out=[];for(let i=0;i<n;i++){const x=new Date(d);x.setDate(d.getDate()+i*gap);out.push(x)}return out}
const fmtDate=d=>d.toLocaleDateString("en-US",{weekday:"short",day:"numeric",month:"short",year:"numeric"});
/* Animals already made: each published long video title is mapped once to its animal, in LAST._animals as
   {title:{g:genus,n:[other names]}}. Find ideas asks for the missing titles, so it also works in copy mode. */
const aniMap=()=>LAST._animals?.data||{};
const aniNorm=s=>{const w=String(s||"").toLowerCase().replace(/[^a-z0-9 ]+/g," ").replace(/\b(the|a|an)\b/g," ").trim().split(/\s+/).filter(Boolean);
  if(w.length){const l=w[w.length-1];w[w.length-1]=/[^aeiou]ves$/.test(l)&&l.length>5?l.slice(0,-3)+"f":/[^su]s$/.test(l)&&l.length>4?l.slice(0,-1):l}return w.join(" ")};
const aniNames=(g,names)=>{const out=new Set(),raw=String(g||"").trim();if(raw){out.add(aniNorm(raw));if(/^[A-Z][a-z]+ [a-z]+$/.test(raw))out.add(aniNorm(raw.split(" ")[0]))}for(const n of names||[]){const x=aniNorm(n);if(x.length>=3)out.add(x)}return [...out].filter(x=>x.length>=3)};
const ideaNames=x=>aniNames(x.genus,[x.subject,...(Array.isArray(x.names)?x.names:[])]);
const pubAnimals=()=>{const m=aniMap();return longForm().filter(v=>m[v.t]).map(v=>({v,names:aniNames(m[v.t].g,m[v.t].n)})).filter(a=>a.names.length)};
// The newest published long video about the same animal: by the mapping, else (titles not mapped yet) by a name word in the title.
function madeOf(x,mapOnly){const nm=new Set(ideaNames(x)),newest=a=>a.sort((p,q)=>(q.d||"").localeCompare(p.d||""))[0]||null;
  const hit=newest(pubAnimals().filter(a=>a.names.some(n=>nm.has(n))).map(a=>a.v));if(hit||mapOnly)return hit;
  const m=aniMap(),key=String(x.subject||"").trim().split(/[\s,(]+/).find(w=>w.length>=4)||"";
  return key?newest(longForm().filter(v=>!(m[v.t]?.g||m[v.t]?.n?.length)&&(v.t||"").toLowerCase().includes(key.toLowerCase()))):null}
function aniMerge(list,asked){const m={...aniMap()},want=new Map(asked.map(t=>[t.toLowerCase(),t]));let n=0;
  for(const a of Array.isArray(list)?list:[]){const t=want.get(String(a?.title||"").trim().toLowerCase());if(!t||m[t])continue;
    m[t]={g:String(a.genus||"").trim().slice(0,60),n:(Array.isArray(a.names)?a.names:[]).map(x=>String(x).trim().slice(0,60)).filter(Boolean).slice(0,6)};n++}
  return n?remember("_animals",m).catch(()=>{}):null}
function aniAvoid(){const m=aniMap(),seen=new Set(),out=[];for(const v of longForm()){const a=m[v.t];if(!a||!(a.g||a.n?.length))continue;const k=aniNorm(a.g||a.n[0]);if(seen.has(k))continue;seen.add(k);out.push(a.g?a.g+(a.n?.length?` (${a.n.slice(0,2).join(", ")})`:""):a.n.join(", "))}return out}
function renderIdeas(list,want){
  const all=list,made=[];list=all.filter(x=>{const v=madeOf(x,true);if(v)made.push([x,v]);return !v}).slice(0,want||all.length);
  const lf=longForm(),known=lf.filter(v=>aniMap()[v.t]).length;
  const note=lf.length?`<div class="card ani-note"><b>Animals you already made are left out</b><p class="note">${made.length?`${plural(made.length,"idea")} ${made.length===1?"was":"were"} about an animal you already made (${esc([...new Set(made.map(([x])=>x.subject||x.genus))].join(", "))}), so ${made.length===1?"it is":"they are"} not shown. `:""}The app knows the animal behind ${nf(known)} of your ${plural(lf.length,"published long video")}.${known<lf.length?" The rest are looked up the next time you press Find ideas.":""} Press Update Studio data after an upload so the newest video counts too.</p></div>`:"";
  if(!list.length){$("#o-ideas").innerHTML=head("Next topics")+note+`<div class="empty">Every idea was about an animal you already made. Press <strong>Find ideas</strong> again.</div>`;return}
  const dates=schedule(list.length,+$("#ideas-freq").value,$("#ideas-start").value||new Date().toISOString().slice(0,10));
  const plan=list.map((x,i)=>`${dates[i].toISOString().slice(0,10)}  ${x.title}`).join("\n");
  const scored=list.map((x,i)=>({...x,date:isoDay(dates[i]),...fitOf(x)})).sort((a,b)=>b.score-a.score);
  $("#o-ideas").innerHTML=head("Next topics, sorted by score")+note+`<div class="idea-list">${scored.map(x=>`<article class="idea2"><div class="fit" style="--p:${x.score*20}" role="img" aria-label="Score ${x.score} out of 5"><span>${x.score}</span></div><div style="min-width:0"><h3>${esc(x.title)}</h3><div class="tags">${x.tags.map(([ok,t])=>`<span class="tag ${ok?"y":"n"}">${ok?"✓ ":""}${esc(t)}</span>`).join("")}</div><p class="note" style="margin:8px 0 0"><strong>Hook:</strong> ${esc(x.hook)}</p><p class="note" style="margin:4px 0 0">${esc(x.why)}</p></div><div class="idea-act"><button type="button" class="btn${x.score<3?" ghost":""}" data-start="${esc(x.title)}" data-topic="${esc(x.subject||"")}" data-date="${x.date}">Start video</button><button type="button" class="btn ghost" data-plan="${esc(x.title)}" data-date="${x.date}">To calendar, ${esc(fmtShort(x.date))}</button></div></article>`).join("")}</div><div class="chips"><button type="button" class="btn ghost" id="plan-all">Add all to calendar</button></div>`+copyBox("Schedule (copy to your notes or calendar)",plan);
}
const fmtShort=iso=>new Date(iso+"T12:00:00").toLocaleDateString("en-US",{day:"numeric",month:"short"});
// Score an idea against the winners' pattern. The AI only says what the animal is; the app checks the channel history itself.
function fitOf(x){const prev=madeOf(x);
  const tags=[[!!x.mammal,"Mamalia"],[!!x.predator,"Predator"],[!!x.threat,"Threat to humans"],[!!x.size,"Size claim"],[!prev,prev?`Already made ${fmtShort(prev.d)}, ${f1(share(prev))}% watched`:"Never made"]];
  return {tags,score:tags.filter(t=>t[0]).length}}
document.addEventListener("click",async e=>{const b=e.target.closest("[data-start]");if(!b)return;
  let p=plans().find(x=>x.title===b.dataset.start);
  if(!p){p={id:Date.now().toString(36)+Math.random().toString(36).slice(2,6),title:b.dataset.start,date:b.dataset.date||isoDay(new Date()),type:"video",status:"ide",note:""};await savePlans([...plans(),p])}
  if(b.dataset.topic){work(p.id).topic=b.dataset.topic;saveWork()}
  openMake(p.id,"pkg")});
$("#f-ideas").addEventListener("submit",async e=>{e.preventDefault();const n=Math.min(12,Math.max(3,+$("#ideas-n").value||6));
  const m=aniMap(),todo=[...new Set(longForm().map(v=>v.t).filter(t=>t&&!m[t]))].slice(0,60),avoid=aniAvoid();
  const data=await ask($("#s-ideas"),e.submitter||$("#f-ideas .btn"),`Suggest ${n+2} new video ideas for this channel.${val("#ideas-focus")?" Focus: "+val("#ideas-focus")+".":""} Do not repeat or closely overlap these existing videos: ${val("#ideas-avoid")||"none listed"}.${avoid.length?`
Do not suggest any of these animals, the channel already has a video about each: ${avoid.join("; ")}.`:""}
Base the choices on what has worked for this channel: ${patternText()||"giant prehistoric mammals, predators, framed as a threat to humans or rivals"}. Titles under 60 characters, clickable but honest, naming the animal.
For each idea also answer honestly about the main animal: "subject" its usual name, "genus" its scientific genus (one word), "names" its other common names in lowercase, "mammal" true if it is a mammal, "predator" true if it hunted or scavenged large prey, "threat" true if the video frames it as a danger to humans or our ancestors (only when the evidence supports it), "size" true if the title states a size, weight or record.
${todo.length?`Also name the main animal of each of these published video titles: ${JSON.stringify(todo)}. Put them in "published_animals", one entry per title with the title copied exactly; use "" for genus and [] for names when a title is not about one animal.
`:""}JSON shape: {"ideas":[{"title":"","subject":"","genus":"","names":[""],"mammal":true,"predator":true,"threat":true,"size":true,"hook":"one-sentence cold-open hook","why":"why it can perform for this channel (English, one sentence)"}]${todo.length?`,"published_animals":[{"title":"","genus":"","names":[""]}]`:""}}`,null);
  if(!data?.ideas?.length)return;await aniMerge(data.published_animals,todo);const keep={ideas:data.ideas,want:n};remember("ideas",keep).catch(()=>{});renderIdeas(keep.ideas,n)});

/* Script outline */
const ACT_COLORS=["var(--series)","var(--accent)","var(--mid)","var(--ok)","var(--muted)","var(--post)","var(--accent)"];
const ROMAN=["I","II","III","IV","V","VI","VII"];
let lastOutline=null;
function renderScript(s){lastOutline=s;const acts=s.acts||[],total=acts.reduce((a,x)=>a+(+x.words||0),0)||1;
  $("#o-script").innerHTML=head("Outline: "+(s.title||""))+`<div class="card"><span class="layer">Cold open</span><p style="font-size:19px">${esc(s.cold_open)}</p>\n  <div class="strata" aria-label="Word share per act">${acts.map((a,i)=>`<span style="width:${((+a.words||0)/total*100).toFixed(1)}%;background:${ACT_COLORS[i%7]}" title="Act ${i+1}: ${esc(a.words)} words"></span>`).join("")}</div>
  ${acts.map((a,i)=>`<div class="act"><div class="num">${ROMAN[i]||i+1}<small>${esc(a.words)} words</small></div><div style="min-width:0"><h3>${esc(a.name)}</h3><ul>${(a.beats||[]).map(b=>`<li>${esc(b)}</li>`).join("")}</ul>${a.open_loop?`<p class="note"><strong>Open loop:</strong> ${esc(a.open_loop)}</p>`:""}${a.cta?`<p class="note"><strong>CTA:</strong> ${esc(a.cta)}</p>`:""}</div></div>`).join("")}</div>
  ${(s.visuals?.length)?`<div class="card"><span class="layer">Visuals / B-roll list</span><div class="chips" style="margin-top:8px">${s.visuals.map(v=>`<span class="chip">${esc(v)}</span>`).join("")}</div></div>`:""}
  ${acts.some(a=>a.flow_prompts?.length)?copyBox("Video prompts for Google Flow (one per 8-second clip)",acts.map((a,i)=>(a.flow_prompts||[]).map((f,j)=>`[Act ${i+1}.${j+1}] ${f}${s.flow_style?" Style: "+s.flow_style:""}`).join("\n\n")).filter(Boolean).join("\n\n"))+`<p class="note">Paste one prompt per clip in Flow. The visual style is already in each prompt so the clips stay consistent.</p>`:""}
  ${(s.fact_check?.length)?`<div class="card"><span class="layer">Double-check before recording</span><ul>${s.fact_check.map(v=>`<li>${esc(v)}</li>`).join("")}</ul></div>`:""}`}
// A finished script belongs to the video it was written for; paid tools must not attach it to another one.
const ownScript=f=>!f.planId||f.planId===mkId();
const nKey=id=>"n:"+(id||"free"),oKey=id=>"o:"+(id||"free");
const narrOf=id=>LAST[nKey(id)]?.data||null,outlineOf=id=>LAST[oKey(id)]?.data||null;
const saveNarr=(id,d)=>{const r=remember(nKey(id),d).catch(()=>{});vdSoon();return r};
const saveOutline=(id,d)=>{const r=remember(oKey(id),d).catch(()=>{});vdSoon();return r};
let lastNarr=null;
function renderScriptFull(f,partial){lastNarr=f;const parts=f.narration||[],all=parts.map(p=>p.text).join("\n\n"),words=all.split(/\s+/).filter(Boolean).length,mins=(words/140).toLocaleString("en-US",{maximumFractionDigits:1});
  $("#o-scriptfull").innerHTML=copyBox(`Full narration script, ${nf(words)} words, about ${mins} minutes read aloud`,parts.map((p,i)=>`[${p.act||"Act "+(i+1)}]\n${p.text}`).join("\n\n"))+(f.title?`<p class="note">For outline: ${esc(f.title)}</p>`:"");
  if(!partial){setRunTxt($("#script-full-btn"),"Write a new version");scRender(f);pkRender(f);igRender(f);voTool(f)}}
function voTool(f){const box=$("#vo-box");if(!box)return;
  if(!f){box.innerHTML=`<span class="layer">Voice over</span><h3>Turn it into voice with ElevenLabs</h3><p class="note">The voice over is made from the full script, so write that first.</p>`;return}
  const chars=(f.narration||[]).reduce((n,p)=>n+(p.text||"").length,0);
  if(!CFG.has_eleven){box.innerHTML=`<span class="layer">Voice over</span><h3>Turn it into voice with ElevenLabs</h3><p class="note">Add your ElevenLabs API key in Settings, under Voice, so this script can become an MP3 right in the app.</p><button type="button" class="btn ghost" data-goto="settings">Open Settings</button>`;return}
  const run=VO_RUN.has(mkId());
  box.innerHTML=`<span class="layer">Voice over</span><h3>Turn it into voice with ElevenLabs</h3>\n  <label for="vo-voice">Voice<select id="vo-voice">${CFG.eleven_voice?`<option value="${esc(CFG.eleven_voice)}">${esc(CFG.eleven_voice_name||CFG.eleven_voice)}</option>`:`<option value="">Choose a voice in Settings first</option>`}</select></label>\n  <p class="note">This script is about ${nf(chars)} characters, so it uses about ${nf(chars)} characters of your ElevenLabs quota. A long script is split into parts and joined into one file. It is saved in 02 Narration of this video's folder.</p>\n  ${run?`<p class="note">Voice over is being made for this video… it is saved in 02 Narration when it is done.</p>`:""}<button type="button" class="btn" id="vo-btn"${run?" disabled":""}>${run?"Voice over is being made…":`Make voice over (${nf(chars)} characters)`}</button>`}
document.addEventListener("click",e=>{const b=e.target.closest("#vo-btn");if(b&&lastNarr)makeVoice(b)});
// A new take goes first; takes the server moved to "older takes" keep their data.
function addTake(id,j){const w=work(id),old=j.older||[];
  w.takes=[{file:j.file,at:msOf(j.at)||Date.now(),chars:j.chars||null,seconds:j.seconds??null,url:j.url||"/api/audio/"+encodeURIComponent(j.file),where:j.folder?"current":"downloads"},...(w.takes||[]).filter(t=>t.file!==j.file).map(t=>old.includes(t.file)?{...t,where:"older"}:t)];
  w.inuse=j.file;return flushWork()}
// A job keeps running when another video is opened; its messages then go above the steps, naming its own video.
function jobSay(id,el,text,err){const cls=err?"status err":"status";if(mkId()===id){if(el){el.className=cls;el.textContent=text}return}
  const job=$("#vd-job");if(!job)return;job.className=cls;job.textContent=`${plans().find(p=>p.id===id)?.title||"Another video"}: ${text}`;VD.job=""}
// Videos with a voice over on its way; a take is only saved when ElevenLabs is done, so this stops a second paid run meanwhile.
const VO_RUN=new Set();
async function makeVoice(b,force,vid,narr){const st=$("#s-vo"),id=vid??mkId(),f=narr||(id===mkId()?lastNarr:narrOf(id)),voice=$("#vo-voice")?.value||CFG.eleven_voice||"",say=(t,e)=>jobSay(id,st,t,e);
  if(!f){say("Write the full script first.",1);return null}
  if(VO_RUN.has(id)){say("The voice over for this video is already being made. Wait until it is done.");return null}
  if(!force&&takesOf(id).length){say("This video already has a voice over, so no new one was made. Use Make again in the Voice over step if you really want another take.");return null}
  if(!voice){say("Choose a voice first in Settings, under Voice.",1);return null}
  VO_RUN.add(id);if(b)b.disabled=true;say("Making the voice over… this takes 1 to 3 minutes for a 2,000-word script. The finished audio is about as long as the video. Do not close the app.");
  if(mkId()===id)voTool(f);vdSoon();
  try{const folder=await ensureFolder(id);
    const j=await api("/api/eleven/tts",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({title:f.title||"voice over",parts:f.narration.map(p=>p.text),voice,folder})});
    if(j.error){say(j.error,1);return null}
    eqSpend(j.chars);await addTake(id,j);advance(id,"edit");
    say(`Voice over done: ${nf(j.chars)} characters, ${j.chunks} parts, ${(j.bytes/1048576).toLocaleString("en-US",{maximumFractionDigits:1})} MB.${j.older?.length?" The take you had before is kept in older takes.":""}`);
    if(mkId()===id&&VD.step==="voice")VD.open=false;
    ensureFolder(id).then(()=>vdTakes(id));return j}
  finally{VO_RUN.delete(id);if(b)b.disabled=false;if(mkId()===id&&lastNarr)voTool(lastNarr);vdSoon()}}
document.addEventListener("click",async e=>{const b=e.target.closest("#script-full-btn");if(!b||!lastOutline)return;const id=mkId(),st=$("#s-scriptfull");
  const cp=runCopy("full");if(!await writeFull(b,cp)||!narrOf(id))return;let said=mkId()===id?st.textContent:"";const sc=await scAfterWrite(id,st,b,cp);said=narrDone(said,id);
  jobSay(id,st,(said?said+" ":"")+sc.trim()+(takesOf(id).length?" The voice over was made from the older text. Make it again in the Voice over step so it matches.":""))});
const wordsOf=t=>(t||"").split(/\s+/).filter(Boolean).length;
// The fixes change the length, so the count shown is the one of the final script.
const narrDone=(s,id)=>{const nw=wordsOf(narrText(narrOf(id)));return s.replace(/^Narration done: [\d,]+ words(.*?), about \d+ minutes/,(m,x)=>`Narration done: ${nf(nw)} words${x}, about ${Math.round(nw/140)} minutes`)};
// Asked for a whole script in one reply, models stop well short of the target. One call per act keeps each act at its planned length.
let narrPart=null;
async function writeFull(b,cp){
  const id=mkId(),o=lastOutline,w=+$("#script-words").value||2000,st=$("#s-scriptfull"),acts=o.acts||[];
  if(cp||acts.length<2){
    const data=await ask(st,b,`Write the complete voice-over narration for this documentary, following the outline below act by act. The total must be about ${w} words (not shorter than ${Math.round(w*.9)}); keep each act close to its planned word count, in paragraphs of 70 to 95 words. Spoken style: clear sentences, vivid but accurate, no stage directions, no headings inside the text, no bracketed notes. Open with the cold open. Keep open loops and the soft CTAs where the outline puts them. Mark anything uncertain by phrasing it carefully ("scientists think", "the fossils suggest") rather than inventing facts.
${scRules()} The first two sentences name the animal and the danger it posed. Every act except the last ends with a question, with a question mark, in its last two sentences, answered in the next act.
Outline JSON: ${JSON.stringify({title:o.title,cold_open:o.cold_open,acts:acts.map(a=>({name:a.name,words:a.words,beats:a.beats,open_loop:a.open_loop,cta:a.cta}))})}
JSON shape: {"title":"","narration":[{"act":"act name","text":"narration paragraphs for this act"}]}`,null,undefined,!!cp);
    if(data?.narration?.length){data.planId=id;narrPart=null;await saveNarr(id,data);if(mkId()===id)renderScriptFull(data);advance(id,"rekam");return data}return null}
  const sum=acts.reduce((a,x)=>a+(+x.words||0),0),n=acts.length,title=o.title||"";
  const plan=JSON.stringify({title,cold_open:o.cold_open,acts:acts.map(a=>({name:a.name,beats:a.beats}))});
  // A failed act (quota, connection) leaves the finished acts in place; the next click continues from there.
  const narration=narrPart&&narrPart.title===title&&narrPart.w===w&&narrPart.narration.length<n?narrPart.narration:[];
  narrPart={title,w,narration};
  for(let i=narration.length;i<n;i++){const a=acts[i],t=Math.max(150,Math.round(sum?w*(+a.words||0)/sum:w/n)),paras=Math.max(2,Math.round(t/82)),last=i===n-1;
    const prev=narration.length?narration[narration.length-1].text.split(/\s+/).slice(-70).join(" "):"";
    const base=`Write the voice-over narration for act ${i+1} of ${n} ("${a.name}") of this documentary. Length: ${paras} paragraphs of 70 to 95 words each, about ${t} words in total, and not fewer than ${Math.round(t*.9)}. Spoken style: clear sentences, vivid but accurate, concrete numbers and comparisons a viewer can picture, no stage directions, no headings, no bracketed notes. Mark anything uncertain by phrasing it carefully ("scientists think", "the fossils suggest") rather than inventing facts. Cover only this act's beats; other acts are written separately, so do not summarise or repeat them.
${scRules()}
${i===0?hookForScript()+`Open with the cold open. The first two sentences name the animal${scTopic(id)?` (${scTopic(id)})`:""} and the danger it posed.`:`The previous act ended with: """${prev}""" Continue straight on from there without repeating it and without re-introducing the animal.`}
${last?"This is the final act: pay off the opening question and end with a short closing line."+(a.cta?" Soft CTA to include: "+a.cta:""):`End on this open loop so the viewer keeps watching: ${a.open_loop||"a question the next act answers"}. One of the last two sentences must be a question, ending with a question mark, that the next act answers. Do not conclude the film.`}${!last&&a.cta?" Soft CTA to include: "+a.cta:""}
Whole film outline (for context only): ${plan}
This act's beats: ${JSON.stringify(a.beats||[])}`;
    const sx=mkId()===id?st:document.createElement("div");
    let d=await ask(sx,b,base+`\nJSON shape: {"text":"the narration, paragraphs separated by a blank line"}`,null,`Writing act ${i+1} of ${n}: ${a.name}…`,false);
    if(!d?.text){const why=sx.isConnected&&mkId()!==id?"the AI call failed":sx.textContent;jobSay(id,st,`Act ${i+1} not finished (${why}) ${narration.length?`Acts 1 to ${narration.length} is safe. Click the button again to continue.`:"Click the button again."}`,1);return null}
    if(wordsOf(d.text)<t*.8){const more=await ask(mkId()===id?st:document.createElement("div"),b,base+`\nThis draft is too short at ${wordsOf(d.text)} words. Rewrite it at about ${t} words by adding accurate, concrete detail from the beats, not filler or repetition. Draft: """${d.text}"""\nJSON shape: {"text":""}`,null,`Act ${i+1} is too short, adding to it…`,false);if(more?.text&&wordsOf(more.text)>wordsOf(d.text))d=more}
    narration.push({act:a.name,text:String(d.text).trim()});if(mkId()===id)renderScriptFull({title,narration:[...narration]},true)}
  const data={title,narration,planId:id};narrPart=null;await saveNarr(id,data);if(mkId()===id)renderScriptFull(data);advance(id,"rekam");
  const total=wordsOf(narration.map(x=>x.text).join(" "));jobSay(id,st,`Narration done: ${nf(total)} words (target ${nf(w)}), about ${Math.round(total/140)} minutes read aloud. Result saved.`);
  return data}
// The rules scriptCheck counts, given to the writer so a fresh script passes without fixing.
const scRules=()=>`Rules the script check counts, follow them exactly: give the listener something to hold on to at least every 80 words, never more than 80 words without one. It counts a concrete number written as digits (like 3, 40 or 1,200), a size comparison with a number in digits, a moment of danger with a word like hunt, kill, attack, predator, prey, bite, blood, death, fear or deadly, or a question with a question mark. Do not invent numbers; when no sure number fits, ask a question. Sentences: average under 22 words, none over 40. No channel intro: no "welcome back", "in this video", "today we" and no request to subscribe.`;
$("#f-script").addEventListener("submit",e=>{e.preventDefault();runScript(e.submitter||$("#f-script .btn"))});
async function runScript(btn,copy){const id=mkId(),w=+$("#script-words").value||2000,n=Math.min(7,Math.max(3,+$("#script-acts").value||5)),cp=typeof copy==="boolean"?copy:runCopy("script");
  const data=await ask($("#s-script"),btn,`Build a detailed ${n}-act outline for a documentary script. Topic: ${val("#script-topic")}. Central question: ${val("#script-angle")||"choose the strongest one"}. Tone: ${$("#script-tone").value}. Target length: about ${w} words total (act word counts must add up to about ${w}).
${hookForScript()}Include a vivid 2-3 sentence cold open that pays off within the first 30 seconds, 3-5 beats per act, open loops across act breaks for retention, at most two soft CTAs (membership or merch from the profile) placed where they don't break the story, a visual/B-roll list, and facts to double-check.
Also write a "flow_style" line (one sentence, English) fixing one consistent visual style, lighting and camera look for the whole video, and for every act 2-4 "flow_prompts": English text-to-video prompts for Google Flow (Veo), each describing one 8-second shot (subject, action, setting, camera movement, lighting), self-contained (repeat key subject details, no references like "same as before"), scientifically accurate anatomy, no on-screen text, 16:9.
JSON shape: {"title":"","cold_open":"","flow_style":"","acts":[{"name":"","words":0,"beats":[""],"open_loop":"","cta":"","flow_prompts":[""]}],"visuals":[""],"fact_check":[""]}. Exactly ${n} acts. Use "" for open_loop or cta when not needed.`,null,undefined,cp);
  if(!data?.acts?.length)return false;await saveOutline(id,data);
  if(mkId()!==id){$("#s-script").textContent="Outline saved for another video. Open that video to write its full script.";return true}
  renderScript(data);
  // One click runs the whole chain: outline, full narration, then the ElevenLabs voice when a voice is set up.
  if(!$("#script-auto").checked)return true;const st=$("#s-script"),say=(t,e)=>jobSay(id,st,t,e);
  say("Step 2 of 3: writing the full narration…");vdFollow(id,"outline","script");
  const full=await writeFull($("#script-full-btn"),cp);if(!full){say("Outline done. The full narration is not finished; open the Full script step and press Write full narration script to continue.");return false}
  // The voice over waits for the check and its fixes, so the MP3 matches the final script.
  const sc=narrOf(id)?await scAfterWrite(id,st,btn,cp):"";
  if(mkId()===id){const e=$("#s-scriptfull");e.textContent=narrDone(e.textContent,id)}
  if(SC_RUN.has(id)||SC_EDITED[id]){say("Outline and full narration done. No voice over yet: the script was changed while it was being checked. Make the voice over in the Voice over step once the Script check is done."+sc);return true}
  if(cp&&$("#script-fix").checked&&checkNarr(narrOf(id)).findings.some(x=>!x.ok)){say("Outline and full narration done. No voice over yet, so it can match the fixed script."+sc+" Then make the voice over in the Voice over step.");return true}
  const nt=takesOf(id).length;if(nt){say(`Outline and full narration done. No new voice over: this video already has one (${nt} take${nt>1?"s":""}). Make it again in the Voice over step if the script changed.`+sc);return true}
  if(VO_RUN.has(id)){say("Outline and full narration done. No new voice over: one is already being made for this video."+sc);return true}
  if(!(CFG.has_eleven&&CFG.eleven_voice)){say("Outline and full narration done. Voice over skipped: set up ElevenLabs in Settings first."+sc);return true}
  say("Step 3 of 3: making the voice over…");vdFollow(id,["script","check"],"voice");
  const vo=await makeVoice(mkId()===id?$("#vo-btn"):null,false,id,narrOf(id));say((vo?"Done: the outline, full narration and MP3 voice over are ready. The Flow clip prompts are under the outline.":"Outline and full narration done. The voice over was not made, see the Voice over step.")+sc,!vo);return true}
// Length presets; the last choice is remembered.
function scriptLen(){const w=+$("#script-words").value||2000;document.querySelectorAll("#script-len [data-w]").forEach(b=>b.setAttribute("aria-pressed",+b.dataset.w===w));
  $("#script-len-note").textContent=`${nf(w)} words is roughly ${Math.round(w/140)} minutes of video and ${nf(Math.round(w*6.1/1000)*1000)} characters of ElevenLabs voice over.`}
$("#script-len").addEventListener("click",e=>{const b=e.target.closest("[data-w]");if(!b)return;$("#script-words").value=b.dataset.w;store.set("sw",+b.dataset.w);scriptLen()});
$("#script-words").addEventListener("input",e=>{store.set("sw",+e.target.value||2000);scriptLen()});

/* Script check: rules counted in the browser, no AI. They are known weak patterns, not a prediction of retention. */
const SC_WPM=145,SC_WEAK=110,SC_RISK=180;
const SC_NUM=/^(?:two|three|four|five|six|seven|eight|nine|ten|eleven|twelve|thirteen|fourteen|fifteen|sixteen|seventeen|eighteen|nineteen|twenty|thirty|forty|fifty|sixty|seventy|eighty|ninety|hundreds?|thousands?|millions?|billions?|dozens?|half|twice|double|triple)$/;
const SC_THREAT=/^(?:(?:hunt|kill|attack|danger|blood|crush|fear|death|predator)[a-z]*|prey(?:ed|ing|s)?|dead(?:ly|lier|liest)?|bit(?:e|es|ing|ten))$/;
const SC_INTRO=/welcome back|in this video|today,? we|hey,? guys|subscribe/gi;
const SC_FWD=/\b(?:next|soon|later|about to|yet|until|but first|find out|the answer|would change|was coming|were coming|to come|not over|only the beginning|worse|before long|in a moment|we will see|we'll see|wait)\b/i;
const SC_STOP=/^(?:giant|that|this|with|from|when|what|were|they|their|prehistoric|ancient|extinct|animal|largest|biggest|story|truth|real)$/;
function scSentences(t){const out=[],re=/[.!?]+["'”’)\]]*(?=\s|$)|\n\s*\n/g;let s=0,m;
  const push=(a,b)=>{const raw=t.slice(a,b),body=raw.trim();if(/[a-z0-9]/i.test(body)){const from=a+raw.length-raw.trimStart().length;out.push({from,to:from+body.length,words:wordsOf(body)})}};
  while((m=re.exec(t))){push(s,m[0].includes("\n")?m.index:m.index+m[0].length);s=m.index+m[0].length}
  push(s,t.length);return out}
const scList=a=>a.length<2?String(a[0]??""):a.slice(0,-1).join(", ")+" and "+a[a.length-1];
const scMin=a=>!a.length?"":a.length===1?"Minute "+a[0]:a.every((m,i)=>!i||m===a[i-1]+1)?`Minutes ${a[0]} to ${a[a.length-1]}`:"Minutes "+scList(a);
const scIsMark=x=>{const w=x.toLowerCase();return /[\d?]/.test(w)||w.split(/[^a-z]+/).some(p=>SC_NUM.test(p)||SC_THREAT.test(p))};
function scriptCheck(text,opts){const t=String(text||""),o=opts||{},words=[],findings=[];let m;
  for(const re=/\S+/g;(m=re.exec(t));)words.push({from:m.index,to:m.index+m[0].length,mark:scIsMark(m[0])});
  const n=words.length,total=Math.max(1,Math.ceil(n/SC_WPM));
  if(!n)return {score:0,words:0,minutes:[],findings:[]};
  const S=scSentences(t),wordAt=c=>{const i=words.findIndex(w=>w.to>c);return i<0?n-1:i},minOf=c=>Math.floor(wordAt(c)/SC_WPM)+1;
  const sentAt=c=>S.find(s=>s.to>c)||S[S.length-1];
  const bad=(id,rule,level,from,to,title,detail,pen=true)=>{const a=minOf(from),b=minOf(Math.max(from,to-1)),minutes=[];for(let i=a;i<=b;i++)minutes.push(i);findings.push({id,rule,level,minutes,title,detail,from,to,ok:false,pen})};
  const good=(id,rule,title,detail)=>findings.push({id,rule,level:"ok",minutes:[],title,detail,from:0,to:0,ok:true});
  // 1. The animal is named in the first two sentences.
  const topic=String(o.topic||"").trim(),names=[...new Set([topic.toLowerCase(),...topic.toLowerCase().split(/[^a-z0-9-]+/).filter(w=>w.length>=4&&!SC_STOP.test(w))])].filter(Boolean);
  if(names.length&&S.length){const has=s=>{const x=t.slice(s.from,s.to).toLowerCase();return names.some(k=>x.includes(k))},at=S.findIndex(has),two=S[Math.min(1,S.length-1)];
    if(at>=0&&at<2)good("name","name","The animal is named in the first two sentences",`"${topic}" comes up in sentence ${at+1}.`);
    else if(at<0)findings.push({id:"name",rule:"name",level:"info",minutes:[],title:`"${topic}" is not named in the script`,detail:"The check looked for the topic from the Topic step. If this script is about another animal, ignore this line. It does not change the score.",from:0,to:0,ok:true});
    else bad("name","name","weak",S[0].from,two.to,`The animal is not named until sentence ${at+1}`,"A viewer who clicked for this animal should hear its name and the danger in the first two sentences.")}
  // 2. Flat stretches: runs of words with no number, no threat word and no question.
  const runs=[];let a=0;for(let i=0;i<=n;i++){if(i===n||words[i].mark){if(i-a>SC_WEAK)runs.push({a,b:i-1,len:i-a});a=i+1}}
  let longest=0,cur=0;for(const w of words){cur=w.mark?0:cur+1;if(cur>longest)longest=cur}
  const acts=Array.isArray(o.acts)?o.acts:[];
  // A flat stretch that runs over an act break is cut to the act that holds most of it, so a fix never joins two acts.
  const inAct=(from,to)=>{let best=null,most=0;for(const k of acts){const v=Math.min(to,k.to)-Math.max(from,k.from);if(v>most){most=v;best=k}}return best?[Math.max(from,best.from),Math.min(to,best.to)]:[from,to]};
  // Every stretch is listed so a fix never uncovers a hidden one; only the 5 longest count against the score, as in 2.5.0.
  runs.sort((x,y)=>y.len-x.len).forEach((r,i)=>bad("flat-"+i,"flat",r.len>SC_RISK?"risk":"weak",...inAct(sentAt(words[r.a].from).from,sentAt(words[r.b].to-1).to),`${r.len} words with no number, no danger and no question`,(i?"Another flat stretch. ":"The longest flat stretch. ")+"That is over "+Math.round(r.len/SC_WPM*60/5)*5+" seconds with nothing new to hold on to.",i<5));
  if(!runs.length)good("flat","flat","No long flat stretch",`The longest run without a number, a danger word or a question is ${longest} words.`);
  // 3. Every act but the last ends on a question or a pointer forward.
  if(acts.length>1){let open=0;acts.slice(0,-1).forEach((act,i)=>{const end=S.filter(s=>s.from>=act.from&&s.to<=act.to).slice(-2);if(!end.length)return;const x=t.slice(end[0].from,end[end.length-1].to);
      if(x.includes("?")||SC_FWD.test(x))return;open++;bad("loop-"+i,"loop","weak",end[0].from,end[end.length-1].to,`Act ${i+1} ends without a question for act ${i+2}`,"Nothing tells the viewer what they would miss by leaving.")});
    if(!open)good("loop","loop","Every act ends on a question or a pointer forward","Each act break gives a reason to keep watching.")}
  // 4. Channel intro phrases in the first 60 words.
  const head=t.slice(0,words[Math.min(59,n-1)].to),hits=[...head.matchAll(SC_INTRO)];
  if(hits.length){const last=hits[hits.length-1];bad("intro","intro","risk",sentAt(hits[0].index).from,sentAt(last.index+last[0].length-1).to,`Channel intro in the opening: "${[...new Set(hits.map(h=>h[0].toLowerCase()))].join('", "')}"`,"The first seconds should be the scene, not the channel.")}
  else good("intro","intro",'No channel intro, no "welcome back"',"The script opens straight on the scene.");
  // 5. Sentence length for reading aloud.
  if(S.length){const avg=Math.round(S.reduce((x,s)=>x+s.words,0)/S.length),by=[...S].sort((x,y)=>y.words-x.words),max=by[0].words,long=by.filter(s=>s.words>40),tell=`Average ${avg} words, longest ${max}.`;
    if(long.length)long.forEach((s,i)=>bad("len-"+i,"len","weak",s.from,s.to,`One sentence runs ${s.words} words`,tell+" A sentence this long is hard to follow by ear.",i<3));
    else if(avg>22)bad("len-0","len","weak",by[0].from,by[0].to,`Sentences average ${avg} words`,tell+" Aim for an average under 22 so it is easy to read aloud.");
    else good("len","len","Sentences are short enough to read aloud",tell)}
  const fails=findings.filter(f=>!f.ok).sort((x,y)=>x.from-y.from),state=Array(total).fill("ok");
  for(const f of fails)for(const k of f.minutes)if(state[k-1]!=="risk")state[k-1]=f.level;
  const score=Math.max(0,10-fails.reduce((x,f)=>x+(f.pen?f.level==="risk"?2:1:0),0));
  return {score,words:n,minutes:state.map((s,i)=>({n:i+1,state:s})),findings:[...fails,...findings.filter(f=>f.ok)]}}
const narrText=f=>(f?.narration||[]).map(p=>p.text||"").join("\n\n");
function narrActs(f){let at=0;return (f?.narration||[]).map((p,i)=>{const a={name:p.act||"Act "+(i+1),from:at,to:at+(p.text||"").length};at=a.to+2;return a})}
const scTopic=(id=mkId())=>(work(id).topic||"").trim()||(plans().find(p=>p.id===id)?.title||"").split(/[:,]/)[0].trim();
const checkNarr=f=>scriptCheck(narrText(f),{topic:scTopic(f?.planId||mkId()),acts:narrActs(f)});
// Puts new text over a character range of the joined narration. A range that crosses an act break lands in the first act it touches.
function narrReplace(f,from,to,text){const acts=narrActs(f);let done=false;
  return {...f,narration:f.narration.map((p,i)=>{const a=acts[i],t=p.text||"";if(to<=a.from||from>=a.to)return p;
    const head=done?"":t.slice(0,Math.max(0,from-a.from))+text;done=true;return {...p,text:(head+t.slice(Math.min(t.length,Math.max(0,to-a.from)))).trim()}}).filter(p=>p.text)}}
function scFixPrompt(f,x){const t=narrText(f),before=t.slice(x.from,x.to),n=wordsOf(before),topic=scTopic(f?.planId||mkId()),need=Math.max(1,Math.ceil(n/60));
  // The check counts flat runs across the passage edges, so unmarked words just outside it shrink the room at each end.
  const W=s=>s.split(/\s+/).filter(Boolean),pre=W(t.slice(0,x.from)),post=W(t.slice(x.to));let lead=0,tail=0;while(lead<pre.length&&!scIsMark(pre[pre.length-1-lead]))lead++;while(tail<post.length&&!scIsMark(post[tail]))tail++;
  const fst=Math.max(5,Math.min(50,70-lead)),lst=Math.max(5,Math.min(50,70-tail));
  const how={name:`The first sentence must name the animal${topic?` ("${topic}")`:""}, and the first two sentences must show the danger it posed.`,
    flat:`The check only counts these as something to hold on to: a number written in digits (like 3, 40 or 1,200), a question ending with a question mark, or one of these danger words: hunt, kill, attack, danger, blood, crush, fear, death, predator, prey, deadly, bite (forms like hunted, killer or attacking count too). Digits or a question mark are safest; a size comparison counts only with a number in digits, and danger told in other words does not count. This passage is ${n} words, so put in at least ${need}: the first within the first ${fst} words${lead>=20?` (the ${lead} words just before this passage have none)`:""}, the last within the last ${lst} words${tail>=20?` (the ${tail} words just after it have none)`:""}, and never more than 70 words between two of them. Do not invent numbers: use numbers already in the script or ones you are sure of; when no sure number fits, ask a question that the following lines answer.`,
    loop:"This passage ends an act. Its last sentence must be a question, ending with a question mark, that the next act answers. Do not answer it here.",
    intro:"Remove the channel greeting, any line about what the video will do and any request to subscribe. Open straight on the scene.",
    len:"Every sentence must be under 30 words: split long sentences into short ones that are easy to read aloud. Keep every fact."}[x.rule]||"";
  return `Rewrite one passage of a documentary voice-over script. Problem found: ${x.title}. ${how}
Keep the meaning, the facts, the tone and the spoken style. Keep the length at about ${n} words (between ${Math.round(n*.85)} and ${Math.round(n*1.15)}). No headings, no stage directions, no bracketed notes. The passage must still join smoothly with the text before and after it.
Text before (context only, do not rewrite): """${t.slice(0,x.from).split(/\s+/).slice(-60).join(" ")}"""
Passage to rewrite: """${before}"""
Text after (context only, do not rewrite): """${t.slice(x.to).split(/\s+/).slice(0,60).join(" ")}"""
JSON shape: {"text":"the rewritten passage"}`}
// A rewrite far off the original length is a model slip, not a fix. A short act ending may grow by one question.
function scClean(d,before){const s=String(d?.text||"").trim(),a=wordsOf(s),b=Math.max(1,wordsOf(before));return s&&a>=b*.7&&(a<=b*1.35||a-b<=25)?s:""}
function scCost(before){return costTag({input_tokens:(channelContext().length+1800+before.length)/4,output_tokens:before.length/3+30},"check")}
const scSnip=(s,end)=>{s=String(s||"").replace(/\s+/g," ").trim();if(s.length<=300)return s;return end?"…"+s.slice(s.indexOf(" ",s.length-290)+1):s.slice(0,s.lastIndexOf(" ",290))+"…"};
// Snippets start a few words before the first change, so the before and after show the part that differs.
function scPair(b,a,end){if(end)return [scSnip(b,1),scSnip(a,1)];const B=b.split(/\s+/).filter(Boolean),A=a.split(/\s+/).filter(Boolean);let i=0;while(i<B.length&&i<A.length&&B[i]===A[i])i++;
  const s=Math.max(0,i-6),cut=W=>(s?"…":"")+scSnip(W.slice(s).join(" "));return [cut(B),cut(A)]}
function scAfterFor(snip,a,end){if(end)return scSnip(a,1);const B=snip.replace(/^…/,"").split(/\s+/).slice(0,4).join(" "),A=a.split(/\s+/).filter(Boolean);
  let j=0;for(let i=0;i+4<=A.length;i++)if(A.slice(i,i+4).join(" ")===B){j=i;break}return (j?"…":"")+scSnip(A.slice(j).join(" "))}
const scWhat=x=>x.rule==="flat"?`flat stretch of ${parseInt(x.title)} words`:x.title.charAt(0).toLowerCase()+x.title.slice(1);
const scMinAt=(t,c)=>Math.floor(wordsOf(t.slice(0,c))/SC_WPM)+1;
const scMarkUp=s=>String(s).split(/(\s+)/).map(p=>/\S/.test(p)&&scIsMark(p)?`<mark>${esc(p)}</mark>`:esc(p)).join("");
// After [a,b) is replaced by text D characters longer, later ranges move and overlapping ones join the new range.
function scMove(list,a,b,D){const ov=list.filter(p=>p.from<b&&a<p.to),rest=list.filter(p=>!ov.includes(p));for(const p of rest)if(p.from>=b){p.from+=D;p.to+=D}
  return {rest,ov,from:Math.min(a,...ov.map(p=>p.from)),to:Math.max(b,...ov.map(p=>p.to))+D}}
// Before and after of each AI fix, kept in work(id).check while the script is still the fixed text.
function scLog(id,f,x,data,auto){const w=work(id),t=narrText(f),nt=narrText(data),k=w.check||{},fresh=k.fixSig!==pkHash(t);
  const m=scMove(fresh?[]:(k.fixes||[]).map(r=>({...r})),x.from,x.to,nt.length-t.length),o=m.ov[0],end=(o?.rule||x.rule)==="loop";
  const a=nt.slice(m.from,m.to),p=o?[o.before,scAfterFor(o.before,a,end)]:scPair(t.slice(x.from,x.to),a,end);
  const r={rule:o?.rule||x.rule,what:o?.what||scWhat(x),before:p[0],from:m.from,to:m.to,after:p[1]};
  w.check={...k,was:fresh?checkNarr(f).score:k.was,fixes:[...m.rest,r].sort((p,q)=>p.from-q.from).slice(-15),fixSig:pkHash(nt),fixAt:Date.now(),leave:"",auto:!!auto||!fresh&&!!k.auto};saveWork()}
function scCostLine(before){if(runCopy("check"))return "Copy-paste mode: nothing is rewritten for you. Fix all gives you one prompt per place to copy to claude.ai; paste each answer back and the next one follows.";
  if(CFG.provider==="gemini")return "Free with Gemini. One click, not one per place.";
  const c=scCost(before).trim().slice(1,-1);return `${c.charAt(0).toUpperCase()+c.slice(1)} per place with ${CFG.provider==="kie"?"KIE.ai":"Claude"}, at most 2 tries each. One click, not one per place.`}
let SC={text:"",fixes:{},msg:{},note:""};
const SC_RUN=new Map();
function scRender(f){const box=$("#sc-box");if(!box||!f)return;const t=narrText(f);if(SC.text!==t)SC={text:t,fixes:{},msg:{},note:SC.note};
  const id=mkId(),c=checkNarr(f),fails=c.findings.filter(x=>!x.ok),k=work(id).check||{},sig=pkHash(t),rec=k.fixSig===sig&&k.fixes?.length?k:null,run=SC_RUN.has(id);
  const hit=r=>fails.some(x=>x.from<r.to&&r.from<x.to),good=rec?rec.fixes.filter(r=>!hit(r)).length:0;
  const fx=new Set();if(rec)for(const r of rec.fixes){for(let i=scMinAt(t,r.from),e=scMinAt(t,Math.max(r.from,r.to-1));i<=e;i++)fx.add(i)}
  const weak=c.minutes.filter(m=>m.state==="weak").map(m=>m.n),risk=c.minutes.filter(m=>m.state==="risk").map(m=>m.n),fixed=c.minutes.filter(m=>m.state==="ok"&&fx.has(m.n)).map(m=>m.n);
  const sum=[weak.length&&`minute${weak.length>1?"s":""} ${scList(weak)} weak`,risk.length&&`minute${risk.length>1?"s":""} ${scList(risk)} likely drop`,fixed.length&&`minute${fixed.length>1?"s":""} ${scList(fixed)} fixed for you`].filter(Boolean);
  const open=!!box.querySelector(".sc-changes[open]"),first=fails[0]?t.slice(fails[0].from,fails[0].to):"";
  box.innerHTML=`<span class="layer">Script check</span><h3 id="sc-h" tabindex="-1">${esc(f.title||scTopic()||"This script")} · ${nf(c.words)} words · about ${c.minutes.length} minute${c.minutes.length>1?"s":""}</h3>
  <div class="sc-score"><b>${c.score} / 10</b><span>${rec?`was <s>${rec.was} / 10</s> · ${good===rec.fixes.length?plural(good,"place")+" fixed for you":`${nf(good)} of ${plural(rec.fixes.length,"rewritten place")} fixed`} · ${esc(vdWhen(rec.fixAt))}`:`${fails.length?`${plural(fails.length,"place")} to fix.`:"Nothing to fix."} Checked on your PC, no AI and no cost.`}</span></div>
  <div class="sc-mins" role="img" aria-label="Minute by minute: ${sum.length?sum.join(", ")+", the rest fine":"every minute fine"}">${c.minutes.map(m=>{const ok=m.state==="ok",f2=ok&&fx.has(m.n);return `<div${ok?f2?' class="f"':"":` class="${m.state==="risk"?"r":"w"}"`}>${m.n}${m.state==="risk"?"!":m.state==="weak"?"~":f2?" ✓":""}</div>`}).join("")}</div>
  <div class="sc-key"><span><i></i>Holds attention</span>${rec?`<span><i class="f"></i>Fixed for you (✓)</span>`:""}<span><i class="w"></i>Weak (~)</span><span><i class="r"></i>Likely drop (!)</span></div>
  ${rec?`<details class="sc-changes"${open?" open":""}><summary>See what was changed (${plural(rec.fixes.length,"place")})</summary><div class="sc-ch">${rec.fixes.map(r=>{const a=scMinAt(t,r.from),e=scMinAt(t,Math.max(r.from,r.to-1)),ms=[];for(let i=a;i<=e;i++)ms.push(i);
    return `<p class="sc-at">${scMin(ms)} · ${esc(r.what)}</p><p class="sc-old"><span class="sr">Before: </span>${esc(r.before)}</p><p class="sc-new"><span class="sr">After: </span>${scMarkUp(r.after)}</p>`}).join("")}</div></details>`:""}
  ${run?`<div class="sc-left"><p><b>Fixing now…</b> The script check updates after each rewrite.</p></div>`:fails.length&&k.leave!==sig?`<div class="sc-left"><p>${rec?`<b>${plural(fails.length,"place")} still to fix${rec.auto?" after the automatic fixes":""}.</b>`:`<b>${plural(fails.length,"place")} to fix.</b>`} Fix all rewrites ${fails.length>1?"them":"it"} and checks again.</p>
    ${runW("check")}<div class="chips"><button type="button" class="btn sm" data-scall>${runTxt("check","Fix all",1)} (${plural(fails.length,"place")})</button><button type="button" class="btn ghost sm" data-scleave>Leave it</button></div><p class="note">${esc(scCostLine(first))}</p><div class="status" id="s-scall" role="status"></div></div>`:""}
  <ul class="sc-finds">${c.findings.map(x=>{if(x.ok)return `<li${x.level==="info"?"":' class="ok"'}><div><b>${esc(x.title)}</b><span>${esc(x.detail)}</span></div>${x.level==="info"?`<span class="pill">note</span>`:`<span class="pill good">passed</span>`}</li>`;
    const p=SC.fixes[x.id],before=t.slice(x.from,x.to);
    return `<li data-sc="${x.id}"><div><b><span class="pill bad">${scMin(x.minutes)}${x.level==="risk"?", likely drop":""}</span>${esc(x.title)}</b><span>${esc(x.detail)}</span></div><button type="button" class="btn ghost sm" data-scfix="${x.id}" data-run="check" data-base="${esc((p?"Try again":"Fix with AI")+scCost(before))}"${run?" disabled":""}>${esc(runTxt("check",p?"Try again":"Fix with AI"))}${esc(scCost(before))}</button><div class="status" role="status">${esc(SC.msg[x.id]||"")}</div>${p?`<div class="sc-ba"><div><small>Before · ${wordsOf(before)} words</small>${esc(before)}</div><div><small>After · ${wordsOf(p)} words</small>${esc(p)}</div><div class="confirm"><button type="button" class="btn" data-scuse="${x.id}">Use this</button><button type="button" class="btn ghost" data-sckeep="${x.id}">Keep mine</button></div></div>`:""}</li>`}).join("")}</ul>
  <p class="note">These are patterns counted from the text. They do not predict how long people will watch.</p><div class="status" id="s-sc" role="status">${esc(SC.note)}</div>`;SC.note="";vdCheckSeen(f,c)}
document.addEventListener("click",async e=>{const b=e.target.closest("[data-scfix],[data-scuse],[data-sckeep]");if(!b||!lastNarr)return;
  const f=lastNarr,id=b.dataset.scfix||b.dataset.scuse||b.dataset.sckeep,x=checkNarr(f).findings.find(y=>y.id===id&&!y.ok);if(!x)return;const t=narrText(f),before=t.slice(x.from,x.to);
  if(b.dataset.sckeep){delete SC.fixes[id];SC.msg[id]="Kept your version.";scRender(f);$(`[data-scfix="${id}"]`)?.focus();return}
  if(b.dataset.scuse){const after=SC.fixes[id];if(!after)return;const data=narrReplace(f,x.from,x.to,after);
    SC.note="Passage replaced and saved."+(takesOf(mkId()).length?" The voice over was made from the older text. Make it again in the Voice over step so it matches.":"");
    scLog(mkId(),f,x,data);await saveNarr(mkId(),data);renderScriptFull(data);$("#sc-h")?.focus();return}
  const st=b.parentElement.querySelector(".status"),d=await ask(st,b,scFixPrompt(f,x),null,"AI is rewriting this passage… (usually 10 to 40 seconds)");if(!d||narrText(lastNarr)!==t)return;
  const after=scClean(d,before);if(after)SC.fixes[id]=after;SC.msg[id]=after?st.textContent.replace(", result saved","")+". Compare the two, then choose.":"The rewrite came back empty or at a very different length. Press the button once more.";
  scRender(f);$(after?`[data-scuse="${id}"]`:`[data-scfix="${id}"]`)?.focus()});
document.addEventListener("click",async e=>{const b=e.target.closest("[data-scall],[data-scleave]");if(!b||!lastNarr)return;const id=mkId(),f=lastNarr;
  if(b.dataset.scleave!==undefined){const w=work(id);w.check={...(w.check||{}),leave:pkHash(narrText(f))};saveWork();SC.note="Left as it is. The places stay listed below; the score is a guide, not a rule.";scRender(f);$("#sc-h")?.focus();return}
  $("#sc-box").querySelectorAll("button,input").forEach(x=>x.disabled=true);const cp=runCopy("check"),st=$("#s-scall"),r=await scAutoFix(st,b,id,{tries:cp?1:2,live:false,copy:cp}),n=narrOf(id);if(!r||!n)return;
  const c=checkNarr(n);vdCheckSave(id,n,c);flushWork();
  const why=r.stopped==="error"?" The AI call failed: "+st.textContent:r.stopped==="cancel"?" Stopped.":r.stopped==="edited"?" Stopped because the script was changed meanwhile.":"";
  const note=(r.fixed?`${plural(r.fixed,"place")} fixed. Score ${c.score} / 10.`:`Nothing was replaced. Score ${c.score} / 10.`)+why+scRejLine(r)+(r.fixed&&takesOf(id).length?" The voice over was made from the older text. Make it again in the Voice over step so it matches.":"");
  if(mkId()!==id){jobSay(id,null,note);return}SC.note=note;renderScriptFull(n);$("#sc-h")?.focus()});
// Rewrites every failing place, checking again after each rewrite: at most `tries` per place and 10 rewrites in all.
async function scAutoFix(st,btn,id,o={}){const tries=o.tries||2,live=o.live!==false,cp=!!o.copy;while(SC_RUN.has(id))await SC_RUN.get(id);let f=narrOf(id);if(!f)return null;
  let end;SC_RUN.set(id,new Promise(r=>end=r));
  const was=checkNarr(f).score,places=[];let calls=0,total=0,nos=0,rejected=0,rej=false,stopped="";if(live&&mkId()===id)scRender(f);
  // The average sentence length finding moves to the next longest sentence after each split, so it is one place by its rule.
  const kOf=x=>x.rule==="len"&&/^Sentences average/.test(x.title)?"len-avg":"",hit=(p,x)=>kOf(x)?p.key===kOf(x):!p.key&&p.from<x.to&&x.from<p.to;
  const mark=(x,D,ok,n,no)=>{const k=kOf(x),m=scMove(places.filter(p=>!p.key),x.from,x.to,D),keep=places.filter(p=>p.key&&p.key!==k),was=places.find(p=>k&&p.key===k);
    if(k){for(const p of m.ov)p.to+=D;places.splice(0,places.length,...keep,...m.rest,...m.ov,{key:k,from:0,to:0,n,no,ok:ok||!!was?.ok})}
    else places.splice(0,places.length,...keep,...m.rest,{from:m.from,to:m.to,n,no,ok:ok||m.ov.some(p=>p.ok)})};
  try{while(calls<10){f=narrOf(id);const t=narrText(f),over=x=>places.filter(p=>hit(p,x));
      const todo=checkNarr(f).findings.filter(x=>!x.ok&&over(x).every(p=>p.n<tries)).sort((a,b)=>(b.level==="risk")-(a.level==="risk")||b.from-a.from);if(!todo.length)break;
      const x=todo[0],before=t.slice(x.from,x.to),ov=over(x),no=ov.find(p=>p.no)?.no||++nos,again=ov.length>0;total=Math.max(total,nos+todo.filter(y=>y!==x&&!over(y).length).length);
      const label=`Script check: fixing weak part ${no} of ${total}${again?", second try":""}…`,vis=mkId()===id,sx=vis?st:document.createElement("div");if(!vis)jobSay(id,st,label);
      // A paste card can only be shown while this video is open.
      if(cp&&!vis){stopped="cancel";break}
      const pr=ask(sx,btn,scFixPrompt(f,x),null,label,cp);if(cp)sx.textContent=(rej?"The last answer was left out because it was much shorter or longer than the original. ":"")+`Place ${no} of ${total}: ${scWhat(x)}. Copy the prompt to claude.ai, then paste the answer below.`;rej=false;
      const d=await pr;if(!d){stopped=cp?"cancel":"error";break}calls++;
      // The narration may have been edited meanwhile; the rewrite only fits the text it was made from.
      if(narrText(narrOf(id))!==t){stopped="edited";break}
      const after=scClean(d,before),n=1+Math.max(0,...over(x).map(p=>p.n));
      if(!after||after===before.trim()){if(!after){rejected++;rej=true}mark(x,0,false,n,no);continue}
      const data=narrReplace(f,x.from,x.to,after);mark(x,narrText(data).length-t.length,true,n,no);
      scLog(id,f,x,data,1);await saveNarr(id,data);if(mkId()===id){if(live)renderScriptFull(data);else lastNarr=data}}}
  finally{SC_RUN.delete(id);end()}
  const left=checkNarr(narrOf(id)).findings.filter(x=>!x.ok);
  return {was,fixed:places.filter(p=>p.ok&&!left.some(x=>hit(p,x))).length,calls,rejected,stopped}}
const scRejLine=r=>r?.rejected?` ${r.rejected===1?"1 answer was":r.rejected+" answers were"} left out because ${r.rejected===1?"it was":"they were"} much shorter or longer than the original; press Fix all to try again.`:"";
// After a new narration: check, fix every failing place when allowed, check again. Returns the line for the status.
const SC_EDITED={};
async function scAfterWrite(id,st,btn,copy){const f=narrOf(id);if(!f)return "";const c0=checkNarr(f),auto=$("#script-fix").checked,cp=typeof copy==="boolean"?copy:runCopy(btn?.dataset?.run);
  const r=auto&&!cp&&c0.score<10?await scAutoFix(st,btn,id):null;SC_EDITED[id]=r?.stopped==="edited";const n=narrOf(id),c=checkNarr(n),left=c.findings.filter(x=>!x.ok).length;vdCheckSave(id,n,c);flushWork();
  if(mkId()===id)renderScriptFull(n);
  let s=` Script check: ${c.score} out of 10`+(r?.fixed?` (was ${r.was}), ${plural(r.fixed,"place")} fixed for you`:"");
  if(!left)return s+".";
  if(cp)return s+`, ${plural(left,"place")} to fix. Use Fix all or Leave it in the Script check step`+(CFG.provider?"; Fix all lets you choose how it runs.":"; Fix all walks you through claude.ai.");
  if(r?.stopped==="error")return s+`. Fixing stopped because an AI call failed; ${plural(left,"place")} left, use Fix all in the Script check step.`;
  return s+`, ${plural(left,"place")} ${r?"still to fix":"to fix"}; see the Script check step.`+scRejLine(r)}
$("#script-fix").checked=store.get("scfix",true);
$("#script-fix").addEventListener("change",e=>store.set("scfix",e.target.checked));

/* Edit pack: one voice file per act, subtitles and text files in one folder for Premiere. Finished acts stay in work(id).pack. */
const pkHash=s=>{let h=5381;for(let i=0;i<s.length;i++)h=(h*33^s.charCodeAt(i))>>>0;return h.toString(36)};
const pkSlug=s=>String(s||"").trim().toLowerCase().replace(/[^a-z0-9]+/g,"-").slice(0,60).replace(/^-+|-+$/g,"");
const pkPost=(path,body)=>api(path,{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(body)});
const pkClock=t=>`${Math.floor(t/60)}:${String(Math.floor(t%60)).padStart(2,"0")}`;
const pkLong=t=>t<60?`${Math.round(t)} s`:`${Math.floor(t/60)} min ${Math.round(t%60)} s`;
function pkActs(f){const n=(f?.narration||[]).filter(p=>(p.text||"").trim());
  return (n.length?n:[{act:"",text:String(f?.text||"")}]).map((p,i)=>({name:String(p.act||"").trim()||"Act "+(i+1),text:String(p.text||"").trim()}))}
// The quota is only known after "Load voices" in Settings; later spending is subtracted here.
const eqSpend=n=>{const q=store.get("eq",null);if(q&&n)store.set("eq",{...q,left:Math.max(0,q.left-n)})};
const srtT=t=>{const m=Math.round(t*1000),h=Math.floor(m/36e5),mi=Math.floor(m%36e5/6e4),se=Math.floor(m%6e4/1e3),ms=m%1e3,z=(n,l=2)=>String(n).padStart(l,"0");return `${z(h)}:${z(mi)}:${z(se)},${z(ms,3)}`};
let PEEK="";
let PK={run:false,at:-1,msg:"",err:false,id:""};
function pkState(f){const w=mkW(),acts=pkActs(f),want=pkSlug(scTopic()||f.title)||"video";
  const sig=a=>pkHash([CFG.eleven_voice,CFG.eleven_model,a.text].join("|"));
  // A new folder is started only when no kept act matches this script, so renaming the topic never drops paid voice files.
  if(!w.pack||(w.pack.want!==want&&!acts.some((a,i)=>w.pack.acts[i]?.sig===sig(a))))w.pack={want,slug:"",acts:[]};
  const p=w.pack,need=acts.map((a,i)=>p.acts[i]?.sig!==sig(a));
  return {w,p,acts,sig,need,todo:need.some(Boolean),chars:acts.reduce((n,a,i)=>n+(need[i]?a.text.length:0),0),total:acts.reduce((n,a)=>n+a.text.length,0)}}
// Each act's cue times start at zero, so they are shifted by the length of the acts before it.
function pkCues(p,n){let off=0;const out=[];for(const a of p.acts.slice(0,n)){for(const c of a?.cues||[])out.push({start:+(c.start+off).toFixed(3),end:+(c.end+off).toFixed(3),text:c.text});off+=a?.seconds||0}return out}
function pkFiles(f,w,acts,cues){const files=[{name:"00-script.txt",text:(f.title?f.title+"\n\n":"")+acts.map((a,i)=>(/^act\s*\d+/i.test(a.name)?a.name:`Act ${i+1} · ${a.name}`).toUpperCase()+"\n\n"+a.text).join("\n\n\n")+"\n"}];
  const o=lastOutline&&(!f.title||!lastOutline.title||f.title===lastOutline.title)?lastOutline:null,fl=(o?.acts||[]).flatMap((a,i)=>(a.flow_prompts||[]).filter(Boolean).map((t,j)=>`[${i+1}.${j+1}] ${t}`));
  if(fl.length)files.push({name:"flow-prompts.txt",text:(o.flow_style?`STYLE (use on every clip): ${o.flow_style}\n\n`:"")+fl.join("\n\n")+"\n"});
  // SEO text made before this script was written belongs to another video.
  const seo=w.seo,title=w.pick||mkPlan()?.title||f.title||"";
  if(title||seo)files.push({name:"title-and-description.txt",text:`TITLE\n${title}\n`+(seo?.description?`\nDESCRIPTION\n${seo.description}\n`:"")+(seo?.tags?.length?`\nTAGS\n${seo.tags.join(", ")}\n`:"")});
  if(w.briefs?.list?.length)files.push({name:"infographics.txt",text:igFile(f,w.briefs.list,cues)});
  return files}
function pkRender(f){const box=$("#pk-box");if(!box||!f)return;
  if(!CFG.has_eleven||!CFG.eleven_voice){box.innerHTML=`<span class="layer">Edit pack for Premiere</span><h3 id="pk-h">Make edit pack</h3><p class="note">The edit pack needs an ElevenLabs key and a voice. ${CFG.has_eleven?"Choose a voice in Settings, under Voice.":"Add your ElevenLabs API key in Settings, under Voice."}</p><button type="button" class="btn ghost" data-goto="settings">Open Settings</button>${pkClips(f,pkState(f).p)}`;return}
  // Progress belongs to the video the pack was started for.
  const busy=PK.run&&PK.id!==mkId(),K=PK.id===mkId()?PK:{run:false,at:-1,msg:"",err:false};
  const s=pkState(f),{p,acts,need}=s,n=acts.length,kept=need.filter(x=>!x).length,ready=!!p.done&&!s.todo,cues=ready?pkCues(p,n):[];
  const stale=ready&&p.text!==pkHash(JSON.stringify(pkFiles(f,s.w,acts,cues))),q=store.get("eq",null),secs=p.acts.slice(0,n).reduce((t,a)=>t+(a?.seconds||0),0);
  const sep=(CFG.pack_dir||"").includes("\\")?"\\":"/",dir=VF[mkId()]?.dir||p.dir||(CFG.pack_dir?CFG.pack_dir+sep+p.want:"Downloads"+sep+"Terra Studio"+sep+p.want),hasFlow=pkFiles(f,s.w,acts,[]).some(x=>x.name==="flow-prompts.txt");
  const label=busy?"Another edit pack is being made…":K.run?"Making edit pack…":!s.todo?(p.done?"Update text files (no voice characters used)":"Finish edit pack (no voice characters used)"):p.done?`Update edit pack (about ${nf(s.chars)} characters)`:kept?`Continue edit pack (about ${nf(s.chars)} characters left)`:`Make edit pack (about ${nf(s.chars)} characters)`;
  const run1=K.run&&K.at>=0&&K.at<n,run2=K.run&&K.at===n,a=run1?acts[K.at]:null;
  const li=(state,text,small)=>`<li${state?` class="${state}"`:""}><i aria-hidden="true">${state==="done"?"✓":""}</i><span><b class="sr">${state==="done"?"Done: ":state==="run"?"In progress: ":state==="part"?"Partly done: ":"Not started: "}</b>${text}</span><small>${small}</small></li>`;
  const focus=document.activeElement?.id;
  // Text files are rebuilt here from the same data that was saved, so no read route is needed.
  const peeks={};if(ready)for(const x of pkFiles(f,s.w,acts,cues))peeks[x.name]=x.text;
  if(ready&&cues.length)peeks["subtitle.srt"]=cues.slice(0,6).map((c,i)=>`${i+1}\n${srtT(c.start)} --> ${srtT(c.end)}\n${c.text}`).join("\n\n");
  box.innerHTML=`<span class="layer">Edit pack for Premiere</span>
  <div class="pk"><div><h3 id="pk-h">Make edit pack</h3><span>Voice over per act, subtitles, Google Flow prompts, script and thumbnail, all in one folder.</span></div>
  <div class="chips"><button type="button" class="btn" id="pk-go"${K.run||busy?' aria-disabled="true"':""}>${label}</button><button type="button" class="btn ghost" id="pk-open"${p.slug||s.w.folder?"":" disabled"}>Open folder</button></div></div>
  <p class="note">This script is ${nf(s.total)} characters in ${n} act${n>1?"s":""}. ${s.todo?`Making the pack uses about ${nf(s.chars)} characters of your ElevenLabs quota${kept?`, because ${kept} finished act${kept>1?"s are":" is"} kept`:""}.`:"Every act already has its voice, so nothing more is used from your ElevenLabs quota."}${q?` Your quota had about ${nf(q.left)} characters left when it was last checked.`:" Load voices in Settings to see how much quota is left."}</p>
  ${q&&s.chars>q.left?`<p class="note err">That may not be enough for the whole pack. Acts that finish are kept, so you can continue after the quota refills.</p>`:""}
  <ul class="pk-steps">
  ${li(run1?"run":s.todo?(kept?"part":""):"done","ElevenLabs voice over, one file per act",run1?`act ${K.at+1} of ${n}: ${esc(a.name)}, ${nf(a.text.length)} characters`:s.todo?(kept?`${kept} of ${n} acts done, `:"")+`about ${nf(s.chars)} characters`:`${n} file${n>1?"s":""}, ${pkLong(secs)}`)}
  ${li(run2?"run":ready?"done":"","Subtitle .srt from the voice over's own timing",ready?`${nf(cues.length)} lines`:"no AI call")}
  ${li(run2?"run":ready&&hasFlow?"done":"","Google Flow prompts per scene, in act order",hasFlow?"already in the script":"this outline has no Flow prompts")}
  ${li(run2?"run":ready?"done":"",`Save to ${esc(dir).replace(/([\\/])/g,"$1<wbr>")}`,ready&&p.files?`${p.files.length} files`:"")}
  </ul>
  <div class="status${K.err?" err":""}" id="s-pack" role="status">${esc(K.run||K.err||!stale?K.msg:"The title, description or infographic briefs changed after the pack was made. Click Update text files to save them in the folder.")}</div>
  ${ready&&p.files?`<ul class="pk-files" aria-label="Files in the edit pack">${p.files.map(x=>peeks[x]?`<li><button type="button" data-peek="${esc(x)}" aria-expanded="${PEEK===x}">${esc(x)}</button></li>`:`<li>${esc(x)}</li>`).join("")}</ul>${peeks[PEEK]?`<pre class="ig-peek" tabindex="0" aria-label="Start of ${esc(PEEK)}">${esc(peeks[PEEK].slice(0,600))}${peeks[PEEK].length>600?"\n…":""}</pre>`:""}<p class="note">In Premiere: drag the folder into the Project panel. Put the act MP3s in order on the audio track, then import subtitle.srt. The same .srt can be uploaded in YouTube Studio, unless you use Send to Premiere: its 1 s act pauses need 08 Premiere\\subtitles-youtube.srt.</p>`:""}
  ${pkClips(f,p)}
  <p class="note">The voice over is already in the pack, cut per act. The Voice over step makes one long MP3 instead; only make it when you want one long file, because it uses the quota again.</p>`;
  if(focus==="pk-go"||focus==="pk-open")$("#"+focus)?.focus()}
/* KIE.ai clips: one 8-second Veo clip per Flow prompt. Money is only spent after a second click inside the page. */
let KC={open:false,ask:"",run:"",id:"",at:"",msg:"",err:false};
function pkFlow(f){const o=lastOutline&&(!f.title||!lastOutline.title||f.title===lastOutline.title)?lastOutline:null;
  return (o?.acts||[]).flatMap((a,i)=>(a.flow_prompts||[]).filter(Boolean).map((t,j)=>({n:`${i+1}.${j+1}`,text:t,prompt:t+(o.flow_style?" Style: "+o.flow_style:"")})))}
function pkClips(f,p){const fl=pkFlow(f);if(!fl.length)return "";const mine=KC.id===mkId(),price=usd(KIE_CLIP*KIE_USD),on=!!CFG.has_kie;
  return `<details class="pk-clips" id="pk-clips"${KC.open?" open":""}><summary>Video clips from the Flow prompts (optional, ${fl.length} prompt${fl.length>1?"s":""})</summary>
  <p class="note">KIE.ai can make each 8-second clip with Veo 3.1 Lite and save it in this pack folder. One clip costs about ${KIE_CLIP} credits (${price}) and can take up to 10 minutes. Pasting the prompts into Google Flow yourself still works and costs nothing here.${on?"":" The buttons are off until a KIE.ai key is saved in Settings."}</p>
  ${on?"":`<button type="button" class="btn ghost" data-goto="settings">Open Settings</button>`}
  <ol class="pk-cl">${fl.map(c=>{const saved=p.clips?.[c.n],fresh=saved&&saved.sig===pkHash(c.prompt),run=KC.run===c.n&&mine,asking=mine&&KC.ask===c.n&&!KC.run;
    return `<li><b>${c.n}</b><span>${esc(c.text)}</span>
    <div class="chips"><button type="button" class="btn ghost" data-clip="${c.n}"${!on||(KC.run&&!run)?" disabled":""}${run?' aria-disabled="true"':""}${asking?' aria-expanded="true"':""}>${run?"Making clip… keep the app open":`${saved?"Make again":"Make clip"} (about ${price})`}</button>${saved?`<small>${fresh?"Saved as":"Saved from an older prompt as"} ${esc(saved.file)}</small>`:""}</div>
    ${asking?`<div class="confirm"><span>Spend about ${KIE_CLIP} KIE.ai credits (${price}) on this one clip?${saved?" The saved clip is replaced.":""}</span><button type="button" class="btn" data-clipyes="${c.n}">Yes, make this clip</button><button type="button" class="btn ghost" data-clipno="${c.n}">Cancel</button></div>`:""}
    ${mine&&KC.at===c.n&&KC.msg?`<div class="status${KC.err?" err":""}" role="status">${esc(KC.msg)}</div>`:""}</li>`}).join("")}</ol></details>`}
async function makeClip(n){const f=lastNarr;if(!f||KC.run||!CFG.has_kie||!ownScript(f))return;const id=mkId(),{p}=pkState(f),c=pkFlow(f).find(x=>x.n===n);if(!c)return;
  KC={...KC,ask:"",run:n,id,at:n,err:false,msg:`KIE.ai is making clip ${n}. This can take up to 10 minutes. Do not close the app.`};pkRender(lastNarr);
  const folder=await ensureFolder(id),j=await pkPost("/api/kie/clip",{slug:p.slug||p.want,title:p.want,name:n,prompt:c.prompt,folder});
  if(j.error||!j.file)KC={...KC,run:"",err:true,msg:`Clip ${n} was not made. ${j.error||"Try again."}`};
  else{p.slug=j.slug;p.dir=j.dir;p.clips={...(p.clips||{}),[n]:{file:j.file,sig:pkHash(c.prompt)}};if(p.files&&!p.files.includes(j.file))p.files=[...p.files,j.file].sort();await flushWork();
    const cr=typeof j.credits==="number"&&j.credits>0?j.credits:KIE_CLIP;addKie(cr,"clip").catch(()=>{});
    KC={...KC,run:"",err:false,msg:`Clip ${n} is saved as ${j.file}. It cost about ${kieTxt(cr)}.`}}
  if(lastNarr)pkRender(lastNarr);if(mkId()===id)$(`[data-clip="${n}"]`)?.focus()}
document.addEventListener("toggle",e=>{if(e.target.id==="pk-clips")KC.open=e.target.open},true);
document.addEventListener("click",e=>{const a=e.target.closest("[data-clip]"),y=e.target.closest("[data-clipyes]"),no=e.target.closest("[data-clipno]");
  if(a){if(KC.run||!CFG.has_kie)return;const n=a.dataset.clip,same=KC.ask===n&&KC.id===mkId();KC={...KC,ask:same?"":n,id:mkId(),at:n,msg:"",err:false};pkRender(lastNarr);$(same?`[data-clip="${n}"]`:`[data-clipyes="${n}"]`)?.focus();return}
  if(y){makeClip(y.dataset.clipyes);return}
  if(no){KC={...KC,ask:""};pkRender(lastNarr);$(`[data-clip="${no.dataset.clipno}"]`)?.focus()}});
async function makePack(){const f=lastNarr;if(!f||PK.run||!ownScript(f))return null;const id=mkId(),s=pkState(f),{w,p,acts}=s,n=acts.length,thumb=mkPlan()?.thumb?id:"";
  const fail=msg=>{PK={run:false,at:-1,msg,err:true,id};pkRender(lastNarr);return null};
  if(acts.some(a=>!a.text))return fail("The script is empty.");
  PK={run:true,at:-1,msg:"",err:false,id};const folder=await ensureFolder(id);
  for(let i=0;i<n;i++){if(!s.need[i])continue;const a=acts[i];
    PK.at=i;PK.msg=`Making the voice for act ${i+1} of ${n}: ${a.name}. ${nf(a.text.length)} characters. Do not close the app.`;pkRender(lastNarr);
    const j=await pkPost("/api/pack/voice",{slug:p.slug||p.want,index:i,name:a.name,text:a.text,title:p.want,folder});
    if(j.error||!j.file){const kept=acts.filter((x,k)=>p.acts[k]?.sig===s.sig(x)).length;
      return fail(`Act ${i+1} was not made. ${j.error||"Try again."}${kept?` ${kept} finished act${kept>1?"s are":" is"} kept. Click the button again to continue.`:""}`)}
    p.slug=j.slug;p.dir=j.dir;p.done=0;p.acts[i]={sig:s.sig(a),file:j.file,seconds:j.seconds,chars:j.chars,cues:j.cues||[]};eqSpend(j.chars);await saveCues(id||"free");await flushWork()}
  PK.at=n;PK.msg="Writing the subtitles and text files…";pkRender(lastNarr);
  p.acts.length=n;const cues=pkCues(p,n),files=pkFiles(f,w,acts,cues);
  const r=await pkPost("/api/pack/finish",{slug:p.slug||p.want,files,cues,thumb,folder});
  if(r.error)return fail(`The voice files are saved, but the text files are not. ${r.error} Click the button again.`);
  p.slug=r.slug;p.dir=r.dir;p.files=r.files||[];p.text=pkHash(JSON.stringify(files));p.done=Date.now();saveWork();
  PK={run:false,at:-1,err:false,id,msg:`Done. ${p.files.length} files are in ${r.dir}.${thumb&&!r.thumbnail?" The thumbnail was not found, so it is not in the folder.":""}`};
  pkRender(lastNarr);igRender(lastNarr);advance(id,"edit");ensureFolder(id).then(vdSoon);return r}
document.addEventListener("click",async e=>{
  const pe=e.target.closest("[data-peek]");if(pe){PEEK=PEEK===pe.dataset.peek?"":pe.dataset.peek;pkRender(lastNarr);$(`[data-peek="${CSS.escape(pe.dataset.peek)}"]`)?.focus();return}
  if(e.target.closest("#pk-go")){makePack();return}
  if(e.target.closest("#pk-open")){const w=mkW(),slug=w.pack?.slug;if(!slug&&!w.folder)return;const r=w.folder?await pkPost("/api/video/open",{name:w.folder}):await pkPost("/api/pack/open",{slug});if(r.error&&!PK.run){PK={run:false,at:-1,msg:r.error,err:true,id:mkId()};pkRender(lastNarr)}}});

/* Infographic briefs: the app finds the moments, Claude with the Remotion skill builds the clips. */
const IG_KIND={size:["Size comparison","size-comparison"],number:["Big number","big-number"],map:["Map","map"],timeline:["Timeline","timeline"],chart:["Chart","chart"]};
const igNorm=s=>String(s||"").toLowerCase().replace(/[^a-z0-9]+/g," ").trim();
let IG={msg:"",err:false,show:0};
// Where the quoted sentence is spoken: real cue times when a finished pack matches this script, else 145 words per minute.
function igTime(f,quote,cues){const all=igNorm(narrText(f)),q=igNorm(quote);if(!q)return null;
  let at=all.indexOf(q);if(at<0){const head=q.split(" ").slice(0,6);at=head.length>=4?all.indexOf(head.join(" ")):-1}if(at<0)return null;
  const wi=at?all.slice(0,at).trim().split(" ").length:0,nw=all.split(" ").length;
  if(cues?.length){const cw=cues.map(c=>igNorm(c.text).split(" ").filter(Boolean).length),tot=cw.reduce((a,b)=>a+b,0);
    if(Math.abs(tot-nw)<=nw*.03){let k=0;for(let i=0;i<cues.length;i++){if(wi<k+cw[i])return {t:cues[i].start+(cues[i].end-cues[i].start)*(wi-k)/cw[i],real:true};k+=cw[i]}}}
  return {t:wi/SC_WPM*60,real:false}}
function igCues(f){const s=pkState(f);return s.p.done&&!s.todo?pkCues(s.p,s.acts.length):null}
const igName=(m,i)=>`${String(i+1).padStart(2,"0")}-${IG_KIND[m.kind][1]}.mov`;
function igBrief(f,m,i,cues){const at=igTime(f,m.quote,cues),name=(CFG.profile?.name||"").trim();
  return `Use the Remotion skill. Make one ${m.seconds}-second clip: 1920x1080, 30 fps, ${m.seconds*30} frames. Transparent background, rendered as ProRes 4444 (.mov with alpha), so it overlays footage in Premiere.

Style: ${name?name+". ":""}Dark stone background if not transparent, warm amber accent #F2A230, off-white text, bold condensed sans. No stock icons.

Content: ${IG_KIND[m.kind][0]}. ${m.title}. ${m.detail}
Use only the numbers written here. They come from the script.

Voice over at this moment${at?` (about ${pkClock(at.t)})`:""}: "${m.quote}"
Output file: ${igName(m,i)}`}
function igFile(f,list,cues){return `INFOGRAPHIC BRIEFS

Paste one brief at a time into Claude with the Remotion skill. Put each finished .mov on a video track above the footage, at the time shown.
The numbers in these briefs come from the script. Check them the same way you check the script.
`+list.map((m,i)=>`\n===== ${i+1}. ${IG_KIND[m.kind][0]}: ${m.title} =====\n\n${igBrief(f,m,i,cues)}\n`).join("")}
function igCost(f){return costTag({input_tokens:(channelContext().length+1200+narrText(f).length)/4,output_tokens:600},"ig")}
function igRender(f){const box=$("#ig-box");if(!box||!f)return;const b=mkW().briefs,list=b?.list||[],cues=list.length?igCues(f):null,focus=document.activeElement?.id;
  const times=list.map(m=>igTime(f,m.quote,cues)),real=times.some(t=>t?.real),show=Math.min(IG.show,list.length-1);
  box.innerHTML=`<span class="layer">Infographics with Claude</span><h3 id="ig-h" tabindex="-1">${list.length?`${list.length} infographic moment${list.length>1?"s":""} found`:"Infographic briefs for Claude"}</h3>
  <p class="note">The app finds the moments in your script that deserve a graphic: a size comparison, a timeline, a map, one big number. It writes a ready brief for each. Paste a brief into Claude with the Remotion skill, and Claude builds the animated clip. Making the clips uses your Claude subscription.</p>
  ${runW("ig")}<button type="button" class="btn${list.length?" ghost":""}" id="ig-find" data-run="ig" data-base="${esc((list.length?"Find them again":"Find infographic moments")+igCost(f))}">${runTxt("ig",list.length?"Find them again":"Find infographic moments")}${igCost(f)}</button><div class="status${IG.err?" err":""}" id="s-ig" role="status">${esc(IG.msg)}</div>
  ${list.length?`<ul class="ig-list">${list.map((m,i)=>`<li><div><b><span class="pill${times[i]?" good":""}">${times[i]?pkClock(times[i].t):"time not found"} · ${m.seconds} s</span>${esc(IG_KIND[m.kind][0])}: ${esc(m.title)}</b><span>${esc(m.detail)}</span></div><button type="button" class="btn ghost" data-brief="${i}" aria-label="Copy brief ${i+1}: ${esc(m.title)}">Copy brief</button></li>`).join("")}</ul>
  <p class="note">${real?"The times come from the voice over in the edit pack.":"The times are estimates at 145 words per minute. They become exact once the edit pack is made."}${b.sig!==pkHash(narrText(f))?" The script changed after these were found. Find them again if a sentence is gone.":""}</p>
  <p class="note"><strong>Check the numbers.</strong> The numbers in each brief come from the script. They need the same checking as the script.</p>
  <div class="ig-peek-h"><b id="ig-peek-n">Brief ${show+1}: ${esc(igName(list[show],show))}</b><span>all briefs are saved as infographics.txt in the edit pack</span></div>
  <pre class="ig-peek" id="ig-peek" tabindex="0" aria-labelledby="ig-peek-n">${esc(igBrief(f,list[show],show,cues))}</pre>`:""}`;
  if(focus==="ig-find")$("#ig-find")?.focus()}
async function findMoments(btn){const f=lastNarr,w=mkW(),st=$("#s-ig");if(!f||!ownScript(f))return null;
  const d=await ask(st,btn,`Find the 3 to 5 moments in this documentary narration that most deserve an animated infographic: a size comparison, one big number, a map, a timeline or a simple chart. Pick moments where a graphic explains something faster than footage can. Spread them over the film. Use only numbers and facts that are in the narration, and do not add new ones.
For each moment give: "kind" (one of size, number, map, timeline, chart), "title" (short, for example "Smilodon beside a grizzly bear and a man"), "detail" (one or two sentences: what is drawn, with the exact numbers from the narration, and how it animates), "seconds" (4 to 8, how long the graphic stays on screen), "quote" (the one sentence of the narration it belongs to, copied word for word).
Narration: """${narrText(f)}"""
JSON shape: {"moments":[{"kind":"size","title":"","detail":"","seconds":6,"quote":""}]}`,null,"AI is reading the script for infographic moments… (usually 20 to 60 seconds)");
  if(!d)return null;
  const clean=s=>String(s??"").replace(/\s+/g," ").trim(),list=(Array.isArray(d.moments)?d.moments:Array.isArray(d)?d:[]).map(m=>({kind:IG_KIND[String(m?.kind||"").toLowerCase()]?String(m.kind).toLowerCase():"chart",title:clean(m?.title).replace(/[.]+$/,""),detail:clean(m?.detail),seconds:Math.min(8,Math.max(4,Math.round(+m?.seconds)||6)),quote:clean(m?.quote).replace(/^["“”']+|["“”']+$/g,"")})).filter(m=>m.title&&m.detail).slice(0,5);
  if(!list.length){IG={msg:"No usable moments came back. Press the button once more.",err:true,show:0};igRender(lastNarr);return null}
  w.briefs={sig:pkHash(narrText(f)),at:Date.now(),list};saveWork();
  IG={msg:st.textContent.replace(", result saved","")+". Briefs saved.",err:false,show:0};igRender(lastNarr);pkRender(lastNarr);$("#ig-h")?.focus();return list}
document.addEventListener("click",e=>{
  const fb=e.target.closest("#ig-find");if(fb&&lastNarr){findMoments(fb);return}
  const b=e.target.closest("[data-brief]");if(!b||!lastNarr)return;const i=+b.dataset.brief,m=mkW().briefs?.list?.[i],pre=$("#ig-peek");if(!m||!pre)return;
  const txt=igBrief(lastNarr,m,i,igCues(lastNarr));IG.show=i;pre.textContent=txt;$("#ig-peek-n").textContent=`Brief ${i+1}: ${igName(m,i)}`;
  const done=()=>{b.textContent="Copied";setTimeout(()=>b.textContent="Copy brief",1500)};
  // Without clipboard access the brief is selected, so Ctrl+C still copies it.
  const sel=()=>{const r=document.createRange();r.selectNodeContents(pre);const s=getSelection();s.removeAllRanges();s.addRange(r);let ok=false;try{ok=document.execCommand("copy")}catch{}if(ok)done();else{b.textContent="Press Ctrl+C";pre.focus();setTimeout(()=>b.textContent="Copy brief",3000)}};
  if(navigator.clipboard)navigator.clipboard.writeText(txt).then(done).catch(sel);else sel()});

/* SEO pack */
function renderSEO(s){const tags=(s.tags||[]).join(", ");
  $("#o-seo").innerHTML=head("SEO package")+(s.keywords?`<div class="card"><span class="layer">Keywords</span><p><strong>Main:</strong> ${esc(s.keywords.primary)}</p><p><strong>Supporting:</strong> ${esc((s.keywords.secondary||[]).join(", "))}</p><p class="note">Put the main keyword in the title, in the first sentence of the description, and say it in the first 30 seconds of narration (YouTube reads the transcript).</p></div>`:"")
  +`<div class="card"><span class="layer">Title options</span><ol class="titles">${(s.titles||[]).map(t=>`<li>${esc(t.text)}<span class="len">${String(t.text||"").length} chars, ${esc(t.angle||"")}</span></li>`).join("")}</ol><p class="note">Aim for under 60 characters so it is not cut off on phones. Test 2 or 3 titles with Test &amp; Compare in YouTube Studio.</p></div>`
  +copyBox("Description (with chapters)",s.description||"")+copyBox("Hashtag",(s.hashtags||[]).join(" "))+copyBox(`Tags (${tags.length}/500 characters)`,tags)+copyBox("Pinned comment",s.pinned_comment||"")+(s.community_post?copyBox("YouTube Community post (publish day)",s.community_post):"")}
$("#f-seo").addEventListener("submit",async e=>{e.preventDefault();const id=mkId();
  const data=await ask($("#s-seo"),e.submitter||$("#f-seo .btn"),`Create a YouTube SEO pack. Topic: ${val("#seo-topic")}. Key facts or outline: ${val("#seo-facts")||"none given"}. Video length: ${$("#seo-mins").value} minutes.
First pick ONE primary search keyword (what a viewer would actually type) and 2-3 secondary keywords. Give 5 title options (each under 60 characters, honest, varied angles, at least 3 containing the primary keyword or the subject's common name; "angle" is a 1-2 word English label). A description: strong first 2 lines (shown in search) with the primary keyword in the first sentence, 1 short paragraph, a CHAPTERS list with plausible timestamps spread over the length starting at 00:00, placeholders [membership link] and [merch link], then 3 hashtags at the end. 3 hashtags. 10-15 tags, total under 450 characters, mixing broad and long-tail phrases. A pinned comment that asks a question to spark replies. A YouTube Community post for release day (under 600 characters, one surprising fact, then a 3-4 option poll written as a list).
JSON shape: {"keywords":{"primary":"","secondary":[""]},"titles":[{"text":"","angle":""}],"description":"","hashtags":[""],"tags":[""],"pinned_comment":"","community_post":""}`,null);
  if(data?.titles){work(id).seo={...data,at:Date.now()};saveWork();if(mkId()===id){renderSEO(data);if(lastNarr)pkRender(lastNarr)}}});

/* Thumbnail */
function renderThumb(list){$("#o-thumb").innerHTML=head("Thumbnail concepts")+`<div class="thumbs">${list.map((c,i)=>{const id="tp"+i+Math.random().toString(36).slice(2,6);return `<article class="card"><div class="thumb-text">${esc(c.text)}</div><h3 style="margin-top:12px">${esc(c.name)}</h3><p><strong>Composition:</strong> ${esc(c.composition)}</p><p class="note"><strong>Why people click:</strong> ${esc(c.why)}</p><div class="copybox" style="margin-top:52px"><button type="button" class="btn ghost" data-copy="${id}" data-label="Copy for Flow">Copy for Flow</button><pre id="${id}">${esc(c.prompt)}</pre></div></article>`}).join("")}</div><p class="note">Quick rules: at most 4 words, one big subject, high contrast, still readable at small phone size. The thumbnail text adds to the title, it does not repeat it.</p>`}
$("#f-thumb").addEventListener("submit",async e=>{e.preventDefault();const id=mkId();
  const data=await ask($("#s-thumb"),e.submitter||$("#f-thumb .btn"),`Create 3 distinct YouTube thumbnail concepts. Topic: ${val("#thumb-topic")}. Video title: ${val("#thumb-title")||"not decided"}. Visual style: ${$("#thumb-style").value}.
Each concept: "name" short English label, "text" overlay of max 4 words, uppercase, that complements (not repeats) the title, "composition" one sentence, "why" one sentence in English on why it gets clicks, "prompt" a detailed text-to-image prompt in English for Google Flow / Imagen (16:9, leave empty space for the overlay text, do not render any text in the image, accurate anatomy and details).
JSON shape: {"concepts":[{"name":"","text":"","composition":"","why":"","prompt":""}]}`,null);
  if(data?.concepts?.length){work(id).flowThumb={at:Date.now(),list:data.concepts};saveWork();if(mkId()===id)renderThumb(data.concepts)}});

/* Shorts */
function renderShorts(list){$("#o-shorts").innerHTML=head("Shorts ideas")+list.map(s=>`<div class="card"><h3>${esc(s.title)}</h3><p><strong>Seconds 0 to 2:</strong> ${esc(s.hook)}</p><p class="note">${esc(s.outline)}</p><div class="meta"><span>${esc(s.length)}</span><span>CTA: ${esc(s.cta)}</span></div></div>`).join("")}
$("#f-shorts").addEventListener("submit",async e=>{e.preventDefault();
  const data=await ask($("#s-shorts"),e.submitter||$("#f-shorts .btn"),`Turn this long video into 5 YouTube Shorts ideas (vertical, under 60 seconds) that send viewers to the full video. Source video: ${val("#shorts-topic")}. Best moments: ${val("#shorts-facts")||"pick the most surprising"}.
Each: "title" (under 50 characters), "hook" what happens in the first 2 seconds (visual + line), "outline" one sentence, "length" like "40 seconds", "cta" short.
JSON shape: {"shorts":[{"title":"","hook":"","outline":"","length":"","cta":""}]}`,"shorts");
  if(data?.shorts?.length)renderShorts(data.shorts)});

/* Data and growth */
const nf=n=>Math.round(n||0).toLocaleString("en-US");
const f1=n=>(n||0).toLocaleString("en-US",{maximumFractionDigits:1});
const cur=()=>(YT&&YT.currency)||"IDR";
const moneyShort=n=>cur()==="IDR"&&Math.abs(n)>=1e6?"Rp"+(n/1e6).toLocaleString("en-US",{maximumFractionDigits:1})+"M":money(n);
const money=n=>{const c=cur();return c==="IDR"?"Rp"+nf(n):c==="USD"?"$"+nf(n):nf(n)+" "+c};
const longForm=()=>(YT&&YT.videos||[]).filter(v=>v.dur>=120);
const BN=["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"];
function monthly(){const m=new Map();(YT.daily||[]).forEach(([d,v])=>{const k=d.slice(0,7);m.set(k,(m.get(k)||0)+v)});return [...m.entries()].sort()}
function lastDays(n,offset=0){const d=YT.daily||[];return d.slice(Math.max(0,d.length-n-offset),d.length-offset).reduce((a,x)=>a+x[1],0)}
let MONTHS=[];
const mLabel=(m,i)=>BN[+m.slice(5,7)-1]+" "+m.slice(0,4)+(i===MONTHS.length-1&&YT.partialLast?" (not complete)":"");

function renderGrowth(){
  const has=YT&&(YT.videos?.length||YT.daily?.length);
  $("#g-empty").hidden=!!has;$("#g-full").hidden=!has;
  if(!has){$("#meter").innerHTML="";return}
  MONTHS=monthly();
  const t=YT.totals||{};
  $("#g-range").textContent="YouTube Studio data"+(YT.range?", "+YT.range:"")+(YT.imported_at?", imported "+new Date(YT.imported_at).toLocaleDateString("en-US"):"");
  const k=[];if(t.views!=null)k.push([nf(t.views),"total views"]);if(t.hours!=null)k.push([nf(t.hours),"watch hours"]);if(t.subs!=null)k.push([(t.subs>=0?"+":"")+nf(t.subs),"net subscribers"]);if(t.revenue!=null)k.push([money(t.revenue),"estimated revenue"]);if(YT.daily?.length)k.push([nf(lastDays(30)),"views in the last 30 days"]);
  $("#g-kpis").innerHTML=k.map(([b,l])=>`<div><b>${b}</b><span>${l}</span></div>`).join("");
  if(YT.daily?.length>=60){const a=lastDays(30),b=lastDays(30,30),pct=b?Math.round((a/b-1)*100):0;$("#meter").innerHTML=`<span class="layer">Views in the last 30 days</span><b>${nf(a)}</b> <span class="${a<b?"no":"ok"}">${a<b?"down":"up"} ${Math.abs(pct)}%</span> compared with the 30 days before`}
  if(!(YT.daily?.length>=60))$("#meter").innerHTML="";
  if(MONTHS.length){chart();$("#g-mtable").innerHTML=`<tr><th>Month</th><th>Views</th></tr>`+MONTHS.map(([m,v],i)=>`<tr><td>${mLabel(m,i)}</td><td>${nf(v)}</td></tr>`).join("")}
  $("#g-chart-wrap").hidden=!MONTHS.length;
  diagnose();table();extras();incomeSetup();
  const titles=(YT.videos||[]).filter(v=>v.dur>=120).map(v=>v.t);if(titles.length&&!$("#ideas-avoid").value)$("#ideas-avoid").value=titles.join("; ");
}

function chart(){
  const svg=$("#g-chart");if(!svg||!MONTHS.length)return;const W=Math.max(560,svg.clientWidth||560),H=240,pl=48,pb=26,pt=26,data=MONTHS;
  const peak=Math.max(...data.map(d=>d[1]),1),step=niceStep(peak/4),max=step*4,bw=(W-pl-8)/data.length,y=v=>pt+(H-pt-pb)*(1-v/max),base=H-pb,mono='font-family="Familjen Grotesk,system-ui,sans-serif"';
  let g="";for(let t=0;t<=max;t+=step)g+=`<line x1="${pl}" x2="${W-4}" y1="${y(t)}" y2="${y(t)}" stroke="var(--line)"/><text x="${pl-6}" y="${y(t)+4}" text-anchor="end" font-size="11" fill="var(--muted)" ${mono}>${short(t)}</text>`;
  const peakI=data.reduce((b,d,i)=>d[1]>data[b][1]?i:b,0),lastFull=YT.partialLast?data.length-2:data.length-1;
  data.forEach(([m,v],i)=>{const w=Math.max(2,bw-2),x=pl+i*bw+1,top=y(v),r=Math.min(4,w/2,base-top);
    const d=base-top<1?"":`M${x},${base}V${top+r}Q${x},${top} ${x+r},${top}H${x+w-r}Q${x+w},${top} ${x+w},${top+r}V${base}Z`;
    g+=`<path d="${d}" fill="${i===data.length-1&&YT.partialLast?"url(#hx)":"var(--series)"}"/><rect class="hit" data-i="${i}" x="${pl+i*bw}" y="${pt}" width="${bw}" height="${base-pt}" fill="transparent" tabindex="0" aria-label="${mLabel(m,i)}: ${nf(v)} views"/>`;
    const mo=+m.slice(5,7);if(mo===1||i===0)g+=`<text x="${x}" y="${H-8}" font-size="11" fill="var(--muted)" ${mono}>${BN[mo-1]} ${m.slice(2,4)}</text>`;else if(data.length<=36&&mo%3===1&&i>2)g+=`<text x="${x}" y="${H-8}" font-size="11" fill="var(--muted)" ${mono}>${BN[mo-1]}</text>`;
    if(i===peakI)g+=`<text x="${Math.min(Math.max(x+w/2,pl+30),W-40)}" y="${top-8}" text-anchor="middle" font-size="12" font-weight="500" fill="var(--ink)" ${mono}>${nf(v)}</text>`;
    if(i===lastFull&&i!==peakI)g+=`<text x="${x+w}" y="${top-8}" text-anchor="end" font-size="12" font-weight="500" fill="var(--ink)" ${mono}>${BN[mo-1]}: ${nf(v)}</text>`});
  svg.setAttribute("viewBox",`0 0 ${W} ${H}`);svg.innerHTML=g;
}
function niceStep(x){const p=Math.pow(10,Math.floor(Math.log10(Math.max(x,1)))),n=x/p;return (n<=1?1:n<=2?2:n<=2.5?2.5:n<=5?5:10)*p}
function short(n){return n>=1e6?f1(n/1e6)+"M":n>=1e3?f1(n/1e3)+"K":String(n)}
addEventListener("resize",()=>{if(YT&&!$("#p-growth").hidden)chart()});
(function hover(){const wrap=$("#g-chart-wrap"),tip=$("#g-tip");
  const showTip=el=>{const i=+el.dataset.i,[m,v]=MONTHS[i],r=el.getBoundingClientRect(),wr=wrap.getBoundingClientRect();tip.textContent=`${mLabel(m,i)}: ${nf(v)} views`;tip.hidden=false;let left=r.left-wr.left+wrap.scrollLeft+r.width/2;left=Math.max(90,Math.min(left,wrap.scrollWidth-90));tip.style.left=left+"px";tip.style.top=(r.top-wr.top+60)+"px"};
  wrap.addEventListener("pointerover",e=>{const h=e.target.closest(".hit");if(h)showTip(h)});wrap.addEventListener("pointerleave",()=>tip.hidden=true);
  wrap.addEventListener("focusin",e=>{const h=e.target.closest(".hit");if(h)showTip(h)});wrap.addEventListener("focusout",()=>tip.hidden=true)})();

function stats(g){const v=g.reduce((a,x)=>a+x.v,0),h=g.reduce((a,x)=>a+x.h,0),imp=g.reduce((a,x)=>a+x.imp,0),cl=g.reduce((a,x)=>a+x.imp*x.ctr/100,0);return{n:g.length,avg:g.length?v/g.length:0,ctr:imp?cl/imp*100:0,avd:v?h*60/v:0}}
function diagnose(){
  const lf=longForm(),ul=$("#g-diag"),tb=$("#g-cmp");if(lf.length<4){tb.innerHTML="";ul.innerHTML="<li>A comparison needs data for at least 4 long videos. Import the Content file from Studio.</li>";return}
  const dates=lf.map(v=>v.d).filter(Boolean).sort(),latest=dates[dates.length-1]||"";
  const cut=latest?new Date(new Date(latest+"T12:00:00").getTime()-90*864e5).toISOString().slice(0,10):"";
  const top=[...lf].sort((a,b)=>b.v-a.v).slice(0,6),recent=lf.filter(v=>v.d&&v.d>cut&&!top.includes(v));
  const a=stats(top),b=stats(recent.length?recent:lf.slice(-6));
  tb.innerHTML=`<tr><th></th><th>6 best videos</th><th>${recent.length||6} videos from the last 90 days</th></tr>\n  <tr><td>Average views</td><td>${nf(a.avg)}</td><td class="${b.avg<a.avg/3?"flag":""}">${nf(b.avg)}</td></tr>
  <tr><td>CTR thumbnail</td><td>${f1(a.ctr)}%</td><td class="${b.ctr<a.ctr*0.75?"flag":""}">${f1(b.ctr)}%</td></tr>\n  <tr><td>Average view duration</td><td>${f1(a.avd)} min</td><td class="${b.avd<a.avd*0.75?"flag":""}">${f1(b.avd)} min</td></tr>`;
  const li=[];
  if(b.ctr<a.ctr*0.75)li.push(`<strong>CTR fell from ${f1(a.ctr)}% to ${f1(b.ctr)}%.</strong> Videos are shown but rarely clicked. Fix titles and thumbnails first, with the SEO package and Thumbnail tools.`);
  else li.push(`CTR of the newest videos (${f1(b.ctr)}%) is still in line with the best videos (${f1(a.ctr)}%).`);
  if(b.avd<a.avd*0.75)li.push(`<strong>View duration fell from ${f1(a.avd)} to ${f1(b.avd)} minutes.</strong> Viewers leave sooner. Check the retention graph in Studio and strengthen the cold open in the Script outline tool.`);
  li.push(`<strong>Best-performing videos:</strong> ${top.slice(0,3).map(v=>esc(v.t)).join("; ")}. Look for the same topic pattern and title angle for the next ideas.`);
  const totalRev=lf.reduce((s,v)=>s+(v.rev||0),0);if(totalRev>0){const top3=[...lf].sort((x,y)=>(y.rev||0)-(x.rev||0)).slice(0,3).reduce((s,v)=>s+(v.rev||0),0);li.push(`${Math.round(top3/totalRev*100)}% of long-video revenue comes from just 3 videos.`)}
  const sh=(YT.videos||[]).filter(v=>v.dur<120);if(sh.length){const sv=sh.reduce((s,v)=>s+v.v,0),ss=sh.reduce((s,v)=>s+v.s,0);li.push(`${sh.length} Shorts brought in ${nf(sv)} views and ${nf(ss)} subscriber.${sv/sh.length<1000?" Shorts are not working yet; make them from the strongest moments of long videos.":""}`)}
  ul.innerHTML=li.map(x=>`<li>${x}</li>`).join("");
}
$("#g-ai-btn").addEventListener("click",async e=>{
  const lf=longForm(),top=[...lf].sort((a,b)=>b.v-a.v).slice(0,12),rec=[...lf].sort((a,b)=>(b.d||"").localeCompare(a.d||"")).slice(0,12);
  const row=v=>`${v.d} | ${v.t} | ${Math.round(v.dur/60)} min | ${v.v} views | CTR ${v.ctr}% | avg view ${(v.v?v.h*60/v.v:0).toFixed(1)} min | ${v.s} subs | revenue ${Math.round(v.rev||0)} ${cur()}`;
  const extra=[YT.traffic?.length?"Traffic sources: "+YT.traffic.slice(0,8).map(r=>`${r.name} ${r.views} views CTR ${r.ctr??"n/a"}%`).join("; "):"",YT.geo?.length?"Geography: "+YT.geo.slice(0,8).map(r=>`${r.name} ${r.views} views revenue ${Math.round(r.rev||0)}`).join("; "):""].filter(Boolean).join("\n");
  const data=await ask($("#s-ai"),e.currentTarget,`Analyse this channel's YouTube Studio data like an experienced YouTube strategist. Explain what drove the best period, why recent videos underperform (if they do), and give a concrete plan for the next 4 uploads.
Monthly views: ${MONTHS.map(([m,v])=>m+" "+v).join(", ")}
Top videos (date | title | length | views | CTR | avg view duration | subs | revenue):
${top.map(row).join("\n")}
Most recent videos:
${rec.map(row).join("\n")}
${extra}
Write everything in English, plain and direct, citing the numbers above. JSON shape: {"summary":"2-3 sentences","findings":[{"title":"","detail":""}],"plan":[{"title":"","detail":""}]}`,"ai");
  if(data)renderAI(data)
});
function renderAI(data){$("#g-ai").innerHTML=`<div class="card"><p>${esc(data.summary)}</p>${(data.findings||[]).length?`<h3>Findings</h3><ul class="diag">${data.findings.map(f=>`<li><strong>${esc(f.title)}.</strong> ${esc(f.detail)}</li>`).join("")}</ul>`:""}${(data.plan||[]).length?`<h3>Plan for the next 4 uploads</h3><ol class="diag">${data.plan.map(f=>`<li><strong>${esc(f.title)}.</strong> ${esc(f.detail)}</li>`).join("")}</ol>`:""}</div>`}

let sortKey="v",sortDir=-1;
const COLS=[["t","Title"],["d","Publish"],["v","Views"],["ctr","CTR %"],["avd","Watched (min)"],["s","Subs"],["rev","Revenue"]];
function table(){const rows=longForm().map(x=>({...x,avd:x.v?x.h*60/x.v:0})).sort((a,b)=>(a[sortKey]>b[sortKey]?1:a[sortKey]<b[sortKey]?-1:0)*sortDir);
  const lf=longForm(),ctrs=lf.map(v=>v.ctr).sort((a,b)=>a-b),med=ctrs[Math.floor(ctrs.length/2)]||0;
  $("#g-table").innerHTML=`<tr>${COLS.map(([k,l])=>`<th data-k="${k}" tabindex="0" aria-sort="${k===sortKey?(sortDir>0?"ascending":"descending"):"none"}">${l}${k===sortKey?(sortDir>0?" ▲":" ▼"):""}</th>`).join("")}</tr>`+
  rows.map(x=>`<tr><td>${esc(x.t)}</td><td>${x.d?new Date(x.d+"T12:00:00").toLocaleDateString("en-US",{day:"numeric",month:"short",year:"2-digit"}):""}</td><td>${nf(x.v)}</td><td class="${x.ctr>=med*1.25?"good":x.ctr<med*0.75?"flag":""}">${f1(x.ctr)}</td><td>${f1(x.avd)}</td><td>${nf(x.s)}</td><td>${money(x.rev)}</td></tr>`).join("")}
$("#g-table").addEventListener("click",e=>{const th=e.target.closest("th");if(!th)return;const k=th.dataset.k;if(k===sortKey)sortDir*=-1;else{sortKey=k;sortDir=k==="t"?1:-1}table();$(`#g-table th[data-k="${k}"]`)?.focus()});
$("#g-table").addEventListener("keydown",e=>{if((e.key==="Enter"||e.key===" ")&&e.target.matches("th")){e.preventDefault();e.target.click()}});

function extras(){const out=[];
  if(YT.traffic?.length){const tot=YT.traffic.reduce((s,r)=>s+r.views,0)||1;out.push(`<div class="card"><span class="layer">Traffic sources</span><h3>Where viewers come from</h3><div style="overflow-x:auto"><table><tr><th>Source</th><th>Views</th><th>CTR</th></tr>${YT.traffic.slice(0,8).map(r=>`<tr><td>${esc(r.name)}</td><td>${f1(r.views/tot*100)}%</td><td>${r.ctr!=null?f1(r.ctr)+"%":"none"}</td></tr>`).join("")}</table></div><p class="note">Browse features = the YouTube home page. Home only places videos with good CTR and view duration.</p></div>`)}
  if(YT.geo?.length){out.push(`<div class="card"><span class="layer">Revenue per 1,000 views by country</span><h3>Which viewers are worth most</h3><div style="overflow-x:auto"><table><tr><th>Country</th><th>Views</th><th>${cur()} / 1.000</th></tr>${YT.geo.slice(0,10).map(r=>{const rpm=r.views?(r.rev||0)/r.views*1000:0;return `<tr><td>${esc(r.name)}</td><td>${nf(r.views)}</td><td>${money(rpm)}</td></tr>`}).join("")}</table></div></div>`)}
  if(YT.age?.rows?.length){out.push(`<div class="card"><span class="layer">Age and gender</span><h3>Who the viewers are</h3><div style="overflow-x:auto"><table><tr>${YT.age.headers.map(h=>`<th>${esc(h)}</th>`).join("")}</tr>${YT.age.rows.slice(0,20).map(r=>`<tr>${r.map(c=>`<td>${esc(c)}</td>`).join("")}</tr>`).join("")}</table></div></div>`)}
  $("#g-extra").innerHTML=out.join("");$("#g-extra").hidden=!out.length}

function incomeSetup(){
  document.querySelectorAll(".cur").forEach(s=>s.textContent=cur()==="IDR"?"Rp":cur());
  const paid=longForm().filter(v=>v.rev>0&&v.v>500),rpms=paid.map(v=>v.rev/v.v*1000).sort((a,b)=>a-b);
  const saved=store.get("sim",null);
  if(saved){$("#g-views").value=saved.views;$("#g-rpm").value=saved.rpm;$("#g-members").value=saved.m;$("#g-mprice").value=saved.mp}
  else if(rpms.length){$("#g-rpm").value=Math.round(rpms[Math.floor(rpms.length/2)]);$("#g-views").value=Math.round(lastDays(30)/1000)*1000||1000}
  $("#g-rpm-note").textContent=rpms.length?`The RPM of your earning videos ranges from ${money(rpms[0])} to ${money(rpms[rpms.length-1])} per 1,000 views (median ${money(rpms[Math.floor(rpms.length/2)])}). Fill in the real member count from Studio.`:"Fill in the RPM from the Revenue tab in YouTube Studio.";
  const ms=MONTHS.map(m=>m[1]),best=ms.length?Math.max(...ms):0;
  $("#g-presets").innerHTML=[["Now (30 days)",Math.round(lastDays(30))],["Best month",best]].filter(p=>p[1]>0).map(([l,v])=>`<button type="button" class="btn ghost" data-views="${v}">${l}: ${nf(v)}</button>`).join("");
  income();
}
function income(){const n=id=>Math.max(0,+$(id).value||0);const ads=n("#g-views")/1000*n("#g-rpm"),mem=n("#g-members")*n("#g-mprice")*0.7;
  $("#g-income").innerHTML=`<div class="big">${money(ads+mem)}<span style="font-size:16px;font-family:var(--f-body)"> / month</span></div><div class="meta" style="margin-top:6px"><span>Ads: ${money(ads)}</span><span>Memberships after YouTube's 30% cut: ${money(mem)}</span><span>Not counting merch and sponsors</span></div>`;
  store.set("sim",{views:n("#g-views"),rpm:n("#g-rpm"),m:n("#g-members"),mp:n("#g-mprice")})}
$("#g-presets").addEventListener("click",e=>{const b=e.target.closest("[data-views]");if(b){$("#g-views").value=b.dataset.views;income()}});
["#g-views","#g-rpm","#g-members","#g-mprice"].forEach(id=>$(id).addEventListener("input",income));

const CHECK=[["Check the retention graph of the last 3 videos","Note the second where most viewers leave, then fix the opening of the next video."],["Upload on the same day and time","Use the calendar in the Ideas tool. Match it with the graph of when your viewers are active in Studio."],["Make 3 to 5 Shorts from each long video","Link them to the full video with the Related video feature."],["Test a title or thumbnail with Test & Compare","Replace a thumbnail with a low CTR after 48 hours."],["Make a series playlist","Adds watch time per session."],["Add an end screen to the next video in the series","Nudges viewers to keep watching."],["Mention the membership once, at the right moment","Explain what members get."],["Prepare a simple media kit for sponsors","Start contacting sponsors once average views are stable."],["Reply to and pin comments in the first 24 hours","Early comments signal engagement."],["Check the source of every big fact","Viewer trust is a long-term asset."]];
const done=store.get("check",{});
$("#g-check").innerHTML=CHECK.map(([t,s],i)=>`<li><input type="checkbox" id="ck${i}" ${done[i]?"checked":""}><label for="ck${i}" style="display:block;font-weight:500">${esc(t)}<small>${esc(s)}</small></label></li>`).join("");
$("#g-check").addEventListener("change",e=>{done[e.target.id.slice(2)]=e.target.checked;store.set("check",done)});

/* import */
let importStatus=null;
document.addEventListener("click",e=>{const b=e.target.closest("[data-import]");if(!b)return;importStatus=b.closest("#g-empty")?$("#s-import-empty"):b.closest("#p-settings")?$("#s-app"):$("#s-import");$("#file-import").click()});
$("#file-import").addEventListener("change",async e=>{const files=[...e.target.files];e.target.value="";if(!files.length)return;const st=importStatus||$("#s-import");st.className="status";st.textContent="Importing…";
  const msgs=[];for(const f of files){const j=await api("/api/import",{method:"POST",headers:{"X-Filename":encodeURIComponent(f.name)},body:await f.arrayBuffer()});if(j.error){st.className="status err";st.textContent=f.name+": "+j.error;return}msgs.push(...(j.found||[]))}
  st.textContent=msgs.length?"Imported: "+msgs.join(", ")+".":"No table was recognised in that file. Make sure the file comes from Studio's advanced mode export.";await loadData()});

/* settings */
const PROFILE_FIELDS=[["name","#pf-name"],["lang","#pf-lang"],["length","#pf-length"],["niche","#pf-niche"],["audience","#pf-audience"],["wins","#pf-wins"],["money","#pf-money"],["style","#pf-style"]];
async function loadConfig(){CFG=await api("/api/config");if(CFG.error){CFG={profile:{}};runPaint();return}
  $("#cfg-model").value=CFG.model||"claude-sonnet-5-5";$("#cfg-effort").value=CFG.effort||"medium";
  $("#cfg-key-hint").textContent=CFG.has_key?"Saved: key ending in "+CFG.key_hint+". Leave the field empty to keep using this key.":"No Claude key saved yet.";
  $("#banner-key").hidden=!!CFG.provider||store.get("banner-off",false);
  $("#cfg-provider").value=CFG.provider_choice&&CFG.provider_choice!==""?CFG.provider_choice:(CFG.provider||"manual");showProv();
  $("#cfg-gkey-hint").textContent=CFG.has_gemini?"Saved: key ending in "+CFG.gemini_hint+". Leave the field empty to keep using this key.":"No Gemini key saved yet.";
  if(CFG.gemini_model&&![...$("#cfg-gmodel").options].some(o=>o.value===CFG.gemini_model))$("#cfg-gmodel").insertAdjacentHTML("beforeend",`<option value="${esc(CFG.gemini_model)}">${esc(CFG.gemini_model)}</option>`);$("#cfg-gmodel").value=CFG.gemini_model||"";$("#cfg-dir").textContent=CFG.dir||"";voiceFields();kieFields();imgFields();ytFields();runPaint();if(lastNarr&&$("#o-scriptfull"))renderScriptFull(lastNarr);
  const p=CFG.profile||{};PROFILE_FIELDS.forEach(([k,id])=>{if(p[k]!=null)$(id).value=p[k]});
  $("#hdr-channel").textContent=p.name||""}
function readProfile(){const p={};PROFILE_FIELDS.forEach(([k,id])=>p[k]=$(id).value.trim());return p}
async function saveConfig(extra,st){const body={model:$("#cfg-model").value,effort:$("#cfg-effort").value,profile:readProfile(),...extra};const j=await api("/api/config",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(body)});
  if(j.error){st.className="status err";st.textContent=j.error;return false}st.className="status";st.textContent="Saved.";await loadConfig();return true}
const PROV_HINT={manual:"Each AI button prepares a prompt to copy into claude.ai. Free because it uses your subscription, but it needs copy and paste.",gemini:"Results appear straight in the app. Uses a free API key from Google AI Studio.",claude:"Results appear straight in the app at the best quality. Billed by Anthropic per use, separate from your claude.ai subscription.",kie:"Results appear straight in the app, written by Claude through KIE.ai. One key pays for scripts and thumbnails as you use them."};
function showProv(){const v=$("#cfg-provider").value;$("#prov-hint").textContent=PROV_HINT[v]||"";$("#grp-gemini").hidden=v!=="gemini";$("#grp-claude").hidden=v!=="claude";$("#grp-kie").hidden=v!=="kie"}
$("#cfg-provider").addEventListener("change",showProv);
const kieKeyOk=k=>/^\S{8,199}$/.test(k);
function kieFields(){const saved=CFG.has_kie?"Saved: key ending in "+CFG.kie_hint+". Leave the field empty to keep using this key.":"No KIE.ai key saved yet.";
  $("#cfg-kkey-hint").textContent=saved;$("#cfg-ikkey-hint").textContent=CFG.has_kie?saved+" It is the same key as under AI connection.":saved;
  const s=$("#cfg-kmodel");if(CFG.kie_model&&![...s.options].some(o=>o.value===CFG.kie_model))s.insertAdjacentHTML("beforeend",`<option value="${esc(CFG.kie_model)}">${esc(CFG.kie_model)}</option>`);s.value=CFG.kie_model||"claude-sonnet-5-5";
  $("#cfg-kspent").textContent=kieSpentText();$("#cfg-kcheck").disabled=$("#cfg-kclear").disabled=!CFG.has_kie;if(!CFG.has_kie)$("#cfg-kbal").textContent=""}
function keyFields(st){const k=$("#cfg-key").value.trim(),g=$("#cfg-gkey").value.trim(),q=$("#cfg-kkey").value.trim(),x={provider:$("#cfg-provider").value,gemini_model:$("#cfg-gmodel").value,kie_model:$("#cfg-kmodel").value};
  if(q){if(!kieKeyOk(q)){st.className="status err";st.textContent="The KIE.ai key does not look right. Copy it again from kie.ai/api-key.";return null}x.kie_key=q}
  if(k){if(!k.startsWith("sk-ant-")){st.className="status err";st.textContent="A Claude API key starts with sk-ant-. Check the key you pasted.";return null}x.api_key=k}
  if(g){if(!/^[A-Za-z0-9_\-]{20,}$/.test(g)){st.className="status err";st.textContent="The Gemini API key does not look right. Copy it again from AI Studio.";return null}x.gemini_key=g}
  return x}
$("#f-key").addEventListener("submit",async e=>{e.preventDefault();const st=$("#s-key"),x=keyFields(st);if(!x)return;
  if(x.provider==="gemini"&&!x.gemini_key&&!CFG.has_gemini){st.className="status err";st.textContent="Paste the Gemini API key first.";return}
  if(x.provider==="claude"&&!x.api_key&&!CFG.has_key){st.className="status err";st.textContent="Paste the Claude API key first.";return}
  if(x.provider==="kie"&&!x.kie_key&&!CFG.has_kie){st.className="status err";st.textContent="Paste the KIE.ai API key first.";return}
  if(await saveConfig(x,st)){$("#cfg-key").value="";$("#cfg-gkey").value="";$("#cfg-kkey").value="";if(x.kie_key)kieBalance()}});
$("#cfg-test").addEventListener("click",async e=>{const st=$("#s-key"),btn=e.currentTarget,x=keyFields(st);if(!x)return;if(!await saveConfig(x,st))return;$("#cfg-key").value="";$("#cfg-gkey").value="";$("#cfg-kkey").value="";
  if(x.provider==="kie"&&!CFG.has_kie){st.className="status err";st.textContent="Paste the KIE.ai API key first.";return}
  if(!CFG.provider){st.className="status";st.textContent="Copy-paste mode is on. There is no connection to test.";return}
  st.className="status";st.textContent="Testing…";btn.disabled=true;
  let bal="";
  // The balance call is free, so a bad key or an empty balance is caught before anything is spent.
  if(CFG.provider==="kie"){const t=await api("/api/kie/test",{method:"POST",headers:{"Content-Type":"application/json"},body:"{}"});
    if(t.error){btn.disabled=false;st.className="status err";st.textContent=t.error;return}
    bal=" Balance: "+kieBalText(t)+".";$("#cfg-kbal").textContent="Balance: "+kieBalText(t)+".";
    if(!(t.credits>0)){btn.disabled=false;st.className="status err";st.textContent="The key works, but the balance is 0 credits. Top up at kie.ai, then test again.";return}}
  const j=await api("/api/generate",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({prompt:"Reply with exactly: OK",test:true})});btn.disabled=false;
  const kie=j.provider==="kie",rp=kie?0:costRp(j.model,j.usage,j.provider),kc=kie?kieCost(j):0;if(rp)addSpent(rp).catch(()=>{});if(kc)addKie(kc,"text").catch(()=>{});
  if(j.error){st.className="status err";st.textContent=(bal?"The key works, but the test message failed. ":"")+j.error}else{st.className="status";st.textContent="Connected to "+(j.model||"AI")+(kie?" through KIE.ai.":".")+bal}});
$("#cfg-kcheck").addEventListener("click",async e=>{const b=e.currentTarget;b.disabled=true;$("#cfg-kbal").textContent="Reading the balance…";await kieBalance();b.disabled=!CFG.has_kie});
$("#cfg-kclear").addEventListener("click",async()=>{if(await saveConfig({clear_kie:true,provider:$("#cfg-provider").value==="kie"?"manual":$("#cfg-provider").value,...(CFG.image_provider==="kie"?{image_provider:"gemini"}:{})},$("#s-key")))$("#s-key").textContent="KIE.ai key removed."});
$("#cfg-gmodels").addEventListener("click",async e=>{const st=$("#s-key"),g=$("#cfg-gkey").value.trim();st.className="status";st.textContent="Loading model list…";
  const j=await api("/api/gemini-models",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({key:g})});
  if(j.error){st.className="status err";st.textContent=j.error;return}fillGModels(j.models||[],j.default);st.textContent=`${(j.models||[]).length} models available. Automatic choice: ${j.default||"-"}.`});
function fillGModels(list,def){const sel=$("#cfg-gmodel"),cur=sel.value||CFG.gemini_model||"";sel.innerHTML=`<option value="">Automatic: ${esc(def||"latest Gemini Flash")}</option>`+list.map(m=>`<option value="${esc(m)}">${esc(m)}</option>`).join("");sel.value=list.includes(cur)?cur:""}
$("#cfg-gclear").addEventListener("click",async()=>{if(await saveConfig({clear_gemini:true,provider:$("#cfg-provider").value==="gemini"?"manual":$("#cfg-provider").value},$("#s-key")))$("#s-key").textContent="Gemini key removed."});
$("#cfg-clear").addEventListener("click",async()=>{if(await saveConfig({clear_key:true,provider:$("#cfg-provider").value==="claude"?"manual":$("#cfg-provider").value},$("#s-key")))$("#s-key").textContent="Claude key removed."});
/* ElevenLabs */
let EVOICES=[];
function voiceFields(){$("#cfg-ekey-hint").textContent=CFG.has_eleven?"Saved: key ending in "+CFG.eleven_hint+". Leave the field empty to keep using this key.":"No ElevenLabs key saved yet.";
  const vs=$("#cfg-evoice");if(CFG.eleven_voice&&![...vs.options].some(o=>o.value===CFG.eleven_voice))vs.innerHTML=`<option value="${esc(CFG.eleven_voice)}">${esc(CFG.eleven_voice_name||CFG.eleven_voice)}</option>`;vs.value=CFG.eleven_voice||"";
  const ms=$("#cfg-emodel");if(CFG.eleven_model&&![...ms.options].some(o=>o.value===CFG.eleven_model))ms.insertAdjacentHTML("beforeend",`<option value="${esc(CFG.eleven_model)}">${esc(CFG.eleven_model)}</option>`);ms.value=CFG.eleven_model||"";
  $("#cfg-adir").textContent=CFG.audio_dir?"MP3 files are saved in "+CFG.audio_dir:"";showPreview()}
function showPreview(){const v=EVOICES.find(x=>x.id===$("#cfg-evoice").value);$("#cfg-epreview").innerHTML=v?.preview?`<p class="note">${esc(v.desc||"")}</p><audio controls preload="none" src="${esc(v.preview)}" style="width:100%"></audio>`:""}
$("#cfg-evoice").addEventListener("change",showPreview);
$("#cfg-eload").addEventListener("click",async e=>{const st=$("#s-voice"),k=$("#cfg-ekey").value.trim(),b=e.currentTarget;
  if(!k&&!CFG.has_eleven){st.className="status err";st.textContent="Paste the ElevenLabs API key first.";return}
  st.className="status";st.textContent="Loading voices and quota…";b.disabled=true;
  const j=await api("/api/eleven/info",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({key:k})});b.disabled=false;
  if(j.error){st.className="status err";st.textContent=j.error;return}
  EVOICES=j.voices||[];const cur=$("#cfg-evoice").value||CFG.eleven_voice;
  $("#cfg-evoice").innerHTML=`<option value="">Choose a voice</option>`+EVOICES.map(v=>`<option value="${esc(v.id)}">${esc(v.name)}${v.desc?", "+esc(v.desc):""}</option>`).join("");$("#cfg-evoice").value=EVOICES.some(v=>v.id===cur)?cur:"";
  const mc=$("#cfg-emodel").value||CFG.eleven_model;$("#cfg-emodel").innerHTML=`<option value="">Automatic: Multilingual v2 (most natural)</option>`+(j.models||[]).map(m=>`<option value="${esc(m.id)}">${esc(m.name)}</option>`).join("");$("#cfg-emodel").value=(j.models||[]).some(m=>m.id===mc)?mc:"";
  const reset=j.reset?new Date(j.reset*1000).toLocaleDateString("en-US",{day:"numeric",month:"long"}):"";
  $("#eleven-quota").innerHTML=`<div class="qbar" role="img" aria-label="Quota used ${nf(j.used)} of ${nf(j.limit)} characters"><span style="width:${j.limit?Math.min(100,j.used/j.limit*100).toFixed(1):0}%"></span></div>Plan ${esc(j.tier||"-")}: <strong>${nf(j.left)}</strong> of ${nf(j.limit)} characters${reset?", refills "+reset:""}. One 2,000-word video is about 12,000 characters.`;
  store.set("eq",{left:j.left,limit:j.limit,at:Date.now()});
  st.textContent=`${EVOICES.length} voices loaded. Pick one, listen to the sample, then Save.`;showPreview()});
$("#f-voice").addEventListener("submit",async e=>{e.preventDefault();const st=$("#s-voice"),k=$("#cfg-ekey").value.trim(),sel=$("#cfg-evoice");
  if(!k&&!CFG.has_eleven){st.className="status err";st.textContent="Paste the ElevenLabs API key first.";return}
  const x={eleven_model:$("#cfg-emodel").value};if(k)x.eleven_key=k;if(sel.value){x.eleven_voice=sel.value;x.eleven_voice_name=EVOICES.find(v=>v.id===sel.value)?.name||sel.selectedOptions[0]?.textContent||""}
  if(await saveConfig(x,st)){$("#cfg-ekey").value="";st.textContent=CFG.eleven_voice?"Saved. The voice over button appears under the full narration script.":"Key saved. Click Load voices, then pick a narrator."}});
$("#cfg-eclear").addEventListener("click",async()=>{if(await saveConfig({clear_eleven:true},$("#s-voice")))$("#s-voice").textContent="ElevenLabs key removed."});
/* Image key: a second Gemini key on a billed project, so text generation can stay on the free key. */
const IMG_PRICE={"gemini-3.1-flash-image":.067,"gemini-3.1-flash-lite-image":.0336,"gemini-nano-banana-2.1":.0336,"nano-banana-2":KIE_IMG*KIE_USD};
// Images come from Gemini or from KIE.ai; every gate asks these instead of the Gemini key alone.
const imgKie=()=>CFG.image_provider==="kie",imgReady=()=>imgKie()?!!CFG.has_kie:!!CFG.has_image,imgModel=()=>imgKie()?CFG.kie_image_model:CFG.image_model,imgWho=()=>imgKie()?"KIE.ai":"Gemini";
const imgWait=()=>imgKie()?"KIE.ai is drawing… usually under a minute":"Gemini is drawing… usually 10 to 40 seconds";
function showImgProv(){const k=$("#cfg-iprov").value==="kie",pr=IMG_PRICE[k?(CFG.kie_image_model||"nano-banana-2"):$("#cfg-imodel").value];$("#grp-igem").hidden=k;$("#grp-ikie").hidden=!k;$("#cfg-itest").textContent="Test image"+(pr?` (about ${usd(pr)})`:"")}
function openImgKey(){show("settings");$("#f-image").scrollIntoView({block:"start"});$(imgKie()?"#cfg-ikkey":"#cfg-ikey").focus()}
const usd=x=>"$"+x.toFixed(2);
const imgMonth=()=>{const s=LAST._img?.data,m=new Date().toISOString().slice(0,7);return s&&s.month===m?s:{month:m,n:0,usd:0}};
const imgSpentText=()=>{const s=imgMonth();return s.n?`This month: ${plural(s.n,"image")}, about ${usd(s.usd)}.`:"No images made this month yet."};
async function addImg(n,model,provider){const s={...imgMonth()};s.n+=n;s.usd+=n*(IMG_PRICE[model]||0);await remember("_img",s);$("#cfg-ispent").textContent=imgSpentText();genBar();if(provider==="kie")for(let i=0;i<n;i++)await addKie(KIE_IMG,"image")}
function imgFields(){$("#cfg-ikey-hint").textContent=CFG.has_image?"Saved: key ending in "+CFG.image_hint+". Leave the field empty to keep using this key.":"No image key saved yet.";
  const s=$("#cfg-imodel");if(CFG.image_model&&![...s.options].some(o=>o.value===CFG.image_model))s.insertAdjacentHTML("beforeend",`<option value="${esc(CFG.image_model)}">${esc(CFG.image_model)}</option>`);s.value=CFG.image_model||"gemini-3.1-flash-image";
  $("#cfg-iprov").value=imgKie()?"kie":"gemini";showImgProv();
  $("#cfg-ispent").textContent=imgSpentText();if(!$("#p-make").hidden)genBar()}
async function saveImageCfg(st){const k=$("#cfg-ikey").value.trim(),q=$("#cfg-ikkey").value.trim(),x={image_model:$("#cfg-imodel").value,image_provider:$("#cfg-iprov").value};if(k)x.image_key=k;
  if(x.image_provider==="kie"&&q){if(!kieKeyOk(q)){st.className="status err";st.textContent="The KIE.ai key does not look right. Copy it again from kie.ai/api-key.";return false}x.kie_key=q;
    // A first key saved here must not switch the text AI to a paid provider without the user choosing it.
    if(!CFG.provider)x.provider="manual"}
  const ok=await saveConfig(x,st);if(ok){$("#cfg-ikey").value="";$("#cfg-ikkey").value="";if(x.kie_key)kieBalance()}return ok}
$("#cfg-iprov").addEventListener("change",showImgProv);$("#cfg-imodel").addEventListener("change",showImgProv);
$("#f-image").addEventListener("submit",async e=>{e.preventDefault();const st=$("#s-image");
  if(await saveImageCfg(st))st.textContent=imgKie()?(CFG.has_kie?"Saved. Images are now made by KIE.ai. Click Test image to make sure the key has credit."+(CFG.provider==="kie"?"":" Scripts and ideas stay as they are under AI connection."):"Choice saved. Paste the KIE.ai key first, then Save."):CFG.has_image?"Saved. Click Test image to make sure billing is active.":"Model saved. Paste the key first, then Save."});
$("#cfg-itest").addEventListener("click",async e=>{const st=$("#s-image"),b=e.currentTarget,out=$("#cfg-itest-out");
  if(!await saveImageCfg(st))return;
  if(!imgReady()){st.className="status err";st.textContent=imgKie()?"Paste the KIE.ai key first.":"Paste the Gemini key for images first.";return}
  b.disabled=true;out.innerHTML="";st.className="status";st.textContent=imgWait()+".";
  const j=await api("/api/image",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({id:"test",slot:0,prompt:"A giant prehistoric cave hyena standing at the mouth of a dark cave at dusk, warm orange light from inside the cave, photorealistic, cinematic, wide 16:9 frame. No text, letters, logos or watermarks."})});
  b.disabled=false;
  if(j.error){st.className="status err";st.textContent=j.error;
    if(/tidak tersedia/.test(j.error)){const m=await api("/api/image-models",{method:"POST"});const s=$("#cfg-imodel");
      (m.models||[]).forEach(n=>{if(![...s.options].some(o=>o.value===n))s.insertAdjacentHTML("beforeend",`<option value="${esc(n)}">${esc(n)}</option>`)});
      if(m.models?.length)st.textContent+=" The models available for this key have been added to the list above.";}
    return}
  addImg(1,j.model,j.provider).catch(()=>{});
  st.textContent=j.provider==="kie"?"It works. The KIE.ai key has credit, and the Make 3 thumbnails button in the Thumbnail step is ready.":"It works. The key and billing are active, and the Make 3 thumbnails button in the Thumbnail step is ready.";
  out.innerHTML=`<img class="gtest" src="/api/gen/${encodeURIComponent(j.file)}?v=${j.v}" alt="Test image from ${j.provider==="kie"?"KIE.ai":"Gemini"}: a giant hyena at a cave mouth">`});
$("#cfg-iclear").addEventListener("click",async()=>{if(await saveConfig({clear_image:true},$("#s-image")))$("#s-image").textContent="Image key removed."});
/* YouTube Studio */
function ytFields(){const on=!!CFG.yt_connected;$("#yt-on").hidden=!on;$("#yt-setup").open=!CFG.yt_client_id;
  $("#yt-name").textContent=on?(CFG.yt_channel?"Connected: "+CFG.yt_channel:"Connected"):"";
  $("#yt-last").textContent=CFG.yt_synced?"Last pulled "+new Date(CFG.yt_synced*1000).toLocaleString("en-US",{day:"numeric",month:"short",hour:"2-digit",minute:"2-digit"})+". Data is pulled each time the app opens.":"Never pulled yet.";
  $("#yt-connect").textContent=on?"Reconnect":"Save and connect YouTube";
  if(!$("#yt-id").value)$("#yt-id").value=CFG.yt_client_id||"";
  $("#yt-secret-hint").textContent=CFG.has_yt_secret?"Client secret saved. Leave the field empty to keep using it.":"";
  document.querySelectorAll("[data-ytsync]").forEach(b=>b.hidden=!on)}
async function ytSync(st,btn){if(btn)btn.disabled=true;if(st){st.className="status";st.textContent="Pulling data from YouTube…"}
  const j=await api("/api/yt/sync",{method:"POST",headers:{"Content-Type":"application/json"},body:"{}"});if(btn)btn.disabled=false;
  if(j.error){if(st){st.className="status err";st.textContent=j.error}return false}
  if(st)st.textContent=`Done: ${nf(j.videos)} video, ${nf(j.days)} days of data (${j.range}).${j.revenue?"":" Revenue is not included because this account does not give access to revenue data."}`;
  await loadConfig();await loadData();return true}
$("#f-yt").addEventListener("submit",async e=>{e.preventDefault();const st=$("#s-yt"),id=$("#yt-id").value.trim(),sec=$("#yt-secret").value.trim();
  if(!/\.apps\.googleusercontent\.com$/.test(id)){st.className="status err";st.textContent="A Client ID ends with .apps.googleusercontent.com. Copy it again from Google Cloud.";return}
  if(!sec&&!CFG.has_yt_secret){st.className="status err";st.textContent="Paste the Client secret too.";return}
  const x={yt_client_id:id};if(sec)x.yt_secret=sec;if(!await saveConfig(x,st))return;$("#yt-secret").value="";
  const j=await api("/api/yt/connect",{method:"POST",headers:{"Content-Type":"application/json"},body:"{}"});
  if(j.error){st.className="status err";st.textContent=j.error;return}
  st.className="status";st.innerHTML=`The Google sign-in page opened in your browser. Choose the account that owns the channel and allow access, then come back here. If it did not open, <a href="${esc(j.url)}" target="_blank" rel="noopener">click here</a>.`;
  const t0=Date.now(),iv=setInterval(async()=>{await loadConfig();if(CFG.yt_connected){clearInterval(iv);st.textContent="YouTube connected. Pulling data…";ytSync(st)}else if(Date.now()-t0>300000)clearInterval(iv)},3000)});
$("#yt-sync").addEventListener("click",e=>ytSync($("#s-yt"),e.currentTarget));
$("#yt-off").addEventListener("click",async()=>{if(await saveConfig({clear_yt:true},$("#s-yt")))$("#s-yt").textContent="YouTube disconnected. The data already pulled is kept."});
document.addEventListener("click",e=>{const b=e.target.closest("[data-ytsync]");if(b)ytSync($("#s-import")||null,b)});
$("#f-profile").addEventListener("submit",async e=>{e.preventDefault();await saveConfig({},$("#s-profile"))});
$("#pf-export").addEventListener("click",async e=>{const t=JSON.stringify(readProfile(),null,2),b=e.currentTarget;$("#pf-json").hidden=false;$("#pf-json").value=t;try{await navigator.clipboard.writeText(t);b.textContent="Copied"}catch{$("#pf-json").select();b.textContent="Press Ctrl+C"}});
$("#pf-import").addEventListener("click",()=>{const ta=$("#pf-json");if(ta.hidden){ta.hidden=false;ta.value="";ta.placeholder="Paste the profile JSON here, then click Paste profile again";ta.focus();return}
  let p;try{p=JSON.parse(ta.value)}catch{$("#s-profile").className="status err";$("#s-profile").textContent="That text is not a valid profile JSON.";return}
  PROFILE_FIELDS.forEach(([k,id])=>{if(p[k]!=null)$(id).value=p[k]});ta.hidden=true;saveConfig({},$("#s-profile"))});
$("#backup-save").addEventListener("click",async()=>{const st=$("#s-app");const j=await api("/api/backup");if(j.error){st.className="status err";st.textContent=j.error;return}
  const name=`terra-studio-backup-${isoDay(new Date())}.json`,url=URL.createObjectURL(new Blob([JSON.stringify(j)],{type:"application/json"})),a=document.createElement("a");a.href=url;a.download=name;document.body.append(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(url),2000);
  st.className="status";st.textContent=`Backup saved as ${name} in the Downloads folder.`});
let pendingBackup=null;
$("#backup-load").addEventListener("click",()=>$("#backup-file").click());
$("#backup-file").addEventListener("change",async e=>{const f=e.target.files[0];e.target.value="";if(!f)return;const st=$("#s-app");let j;try{j=JSON.parse(await f.text())}catch{st.className="status err";st.textContent="That file is not a Terra Studio backup.";return}
  if(j.app!=="terra-studio"){st.className="status err";st.textContent="That file is not a Terra Studio backup.";return}
  pendingBackup=j;$("#backup-confirm-text").textContent=`Replace the current data with the backup from ${new Date(j.created*1000).toLocaleDateString("en-US",{day:"numeric",month:"long",year:"numeric"})}?`;$("#backup-confirm").hidden=false});
$("#backup-no").addEventListener("click",()=>{pendingBackup=null;$("#backup-confirm").hidden=true});
$("#backup-yes").addEventListener("click",async()=>{if(!pendingBackup)return;const st=$("#s-app");const j=await api("/api/restore",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(pendingBackup)});pendingBackup=null;$("#backup-confirm").hidden=true;
  if(j.error){st.className="status err";st.textContent=j.error;return}st.className="status";st.textContent="Backup restored.";await loadConfig();await loadData();await loadLast();renderDash()});
$("#data-clear").addEventListener("click",()=>$("#data-clear-confirm").hidden=false);
$("#data-clear-no").addEventListener("click",()=>$("#data-clear-confirm").hidden=true);
$("#data-clear-yes").addEventListener("click",async()=>{await api("/api/data",{method:"DELETE"});$("#data-clear-confirm").hidden=true;$("#s-app").className="status";$("#s-app").textContent="Studio data deleted.";await loadData()});
$("#app-quit").addEventListener("click",async()=>{await fetch("/api/quit",{method:"POST",headers:{"X-Terra":"1"}}).catch(()=>{});document.body.innerHTML='<div class="wrap"><h1>Terra Studio is closed.</h1><p class="sub">You can close this window.</p></div>'});

async function loadData(){const j=await api("/api/data");YT=(j&&!j.error&&(j.videos||j.daily))?j:null;
  if(YT&&YT.daily?.length){const ld=new Date(YT.daily[YT.daily.length-1][0]+"T12:00:00"),dim=new Date(ld.getFullYear(),ld.getMonth()+1,0).getDate();YT.partialLast=ld.getDate()<dim}
  renderGrowth();renderDash();renderToday();renderLearn();renderPattern()}
/* Dashboard and calendar */
const TYPE_LABEL={video:"Video",short:"Shorts",post:"Post"},STATUS_LABEL={ide:"Idea",naskah:"Script",rekam:"Voice",edit:"Edit",siap:"Ready to upload",tayang:"Published"};
const plans=()=>LAST.plans?.data||[];
async function savePlans(list){list.sort((a,b)=>a.date.localeCompare(b.date));await remember("plans",list);renderDash();renderPipe();if(!$("#p-make").hidden)renderMake()}
const isoDay=d=>`${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,"0")}-${String(d.getDate()).padStart(2,"0")}`;
let calMonth=(()=>{const d=new Date();return new Date(d.getFullYear(),d.getMonth(),1)})();
let mcMonth=new Date(calMonth),weekStart=(()=>{const d=new Date();d.setHours(12,0,0,0);return d})();
let view="week",typeF="all",query="",mcFocus=null;
const STAGES=["ide","naskah","rekam","edit","siap","tayang"];
const DOW=["Sun","Mon","Tue","Wed","Thu","Fri","Sat"];
const addDays=(d,n)=>{const x=new Date(d);x.setDate(x.getDate()+n);return x};
const match=p=>(typeF==="all"||p.type===typeF)&&(!query||(p.title||"").toLowerCase().includes(query));
const pubs=()=>(YT?.videos||[]).filter(v=>v.d&&(typeF==="all"||(typeF==="short"?v.dur<120:typeF==="video"&&v.dur>=120))&&(!query||(v.t||"").toLowerCase().includes(query)));
// The plan image is a file in the video's 06 Thumbnail (tfile), else an image the app keeps (thumb). The file stays where it is.
const vFolder=id=>(WORK||LAST.work?.data||{})[id]?.folder||"";
const storeUrl=p=>p.thumb?`/api/thumb/${encodeURIComponent(p.id)}?v=${encodeURIComponent(p.thumb)}`:"";
const thumbUrl=p=>{const f=p.tfile&&vFolder(p.id);return f?`/api/vthumb/${encodeURIComponent(f)}/${encodeURIComponent(p.tfile)}?v=${p.tat||0}`:storeUrl(p)};
// Images from before 2.6 were always set by hand.
const thumbMine=p=>typeof p.tmine==="boolean"?p.tmine:!!p.thumb;
const vtList=async(id,strict)=>{const f=vFolder(id);if(!f)return [];const j=await api("/api/vthumbs/"+encodeURIComponent(f));return j.error?(strict?null:[]):j.files||[]};
// Unless Sigit chose one himself, a plan shows the newest thumbnail saved in its video folder.
async function thumbFollow(ids){const list=plans().map(p=>({...p}));let ch=false;
  for(const p of list){if((ids&&!ids.includes(p.id))||p.type==="post"||!vFolder(p.id))continue;const mine=thumbMine(p);if(mine&&!p.tfile)continue;
    const l=await vtList(p.id,1);if(!l)continue;const n=l[0];
    if(mine){if(!l.some(x=>x.file===p.tfile)){delete p.tfile;delete p.tat;p.tmine=false;ch=true}else continue}
    if(n&&(p.tfile!==n.file||p.tat!==n.at*1000)){Object.assign(p,{tfile:n.file,tat:n.at*1000,tmine:false});ch=true}
    else if(!n&&p.tfile){delete p.tfile;delete p.tat;ch=true}}
  if(ch)await savePlans(list);return ch}
function cardHTML(p){const st=STAGES.indexOf(p.status),pct=Math.round((Math.max(st,0)+1)/STAGES.length*100),cls=p.status==="ide"?"ide":p.type;
  return `<button type="button" class="k ${esc(cls)}${p.status==="tayang"?" published":""}" data-plan-id="${esc(p.id)}">${thumbUrl(p)?`<img src="${thumbUrl(p)}" alt="">`:""}<span class="in"><span class="lb">${p.status==="ide"?"Idea, ":""}${TYPE_LABEL[p.type]||""}</span><span class="tt">${esc(p.title)}</span><span class="pg" role="img" aria-label="Status ${esc(STATUS_LABEL[p.status]||"")}"><i style="width:${pct}%"></i></span><span class="ft">${esc(STATUS_LABEL[p.status]||"")}</span></span></button>`}
function renderWeek(){const today=isoDay(new Date()),end=addDays(weekStart,6);
  $("#wk-title").textContent=weekStart.getMonth()===end.getMonth()?`${weekStart.getDate()} to ${end.getDate()} ${BN[end.getMonth()]} ${end.getFullYear()}`:`${weekStart.getDate()} ${BN[weekStart.getMonth()]} to ${end.getDate()} ${BN[end.getMonth()]}`;
  let h="";for(let i=0;i<7;i++){const d=addDays(weekStart,i),iso=isoDay(d);
    const items=plans().filter(p=>p.date===iso&&match(p)).map(cardHTML).join("")+pubs().filter(v=>v.d===iso).map(v=>`<div class="k pub"><span class="in"><span class="lb">Published, ${v.dur<120?"Shorts":"long video"}</span><span class="tt">${esc(v.t)}</span><span class="ft">${nf(v.v)} views</span></span></div>`).join("");
    h+=`<div class="day${iso===today?" today":""}"><div class="dh"><b>${d.getDate()}</b>${DOW[d.getDay()]}</div>${items}<button type="button" class="add" data-new="${iso}" aria-label="Add a plan for ${d.getDate()} ${BN[d.getMonth()]}">+ Add</button></div>`}
  $("#wk").innerHTML=h}
function renderCal(){const y=calMonth.getFullYear(),m=calMonth.getMonth(),first=new Date(y,m,1),days=new Date(y,m+1,0).getDate(),lead=(first.getDay()+6)%7,today=isoDay(new Date());
  const title=first.toLocaleDateString("en-US",{month:"long",year:"numeric"});if(view==="month")$("#wk-title").textContent=title;
  const byDay={};const add=(d,html)=>{(byDay[d]=byDay[d]||[]).push(html)};const pre=`${y}-${String(m+1).padStart(2,"0")}`;
  pubs().forEach(v=>{if(v.d.startsWith(pre))add(v.d,`<span class="ev pub" title="${esc(v.t)}, ${nf(v.v)} views"><i>${v.dur<120?"Shorts":"Published"}</i>${esc(v.t)}</span>`)});
  plans().filter(match).forEach(p=>add(p.date,`<button type="button" class="ev ${esc(p.type)}${p.status==="tayang"?" done":""}" data-plan-id="${esc(p.id)}" title="${esc(p.title)}, ${STATUS_LABEL[p.status]||""}"><i>${STATUS_LABEL[p.status]||""}</i>${esc(p.title)}</button>`));
  const head=["Mon","Tue","Wed","Thu","Fri","Sat","Sun"].map(d=>`<div class="cal-dow" aria-hidden="true">${d}</div>`).join("");
  let cells="";for(let i=0;i<lead;i++)cells+=`<div class="cal-day off" aria-hidden="true"></div>`;
  for(let d=1;d<=days;d++){const iso=`${pre}-${String(d).padStart(2,"0")}`;
    cells+=`<div class="cal-day${iso===today?" today":""}"><button type="button" class="cal-num" data-new="${iso}" aria-label="Add a plan for ${d} ${title}">${d}</button>${(byDay[iso]||[]).join("")}</div>`}
  const tail=(7-(lead+days)%7)%7;for(let i=0;i<tail;i++)cells+=`<div class="cal-day off" aria-hidden="true"></div>`;
  $("#cal").innerHTML=head+cells}
function renderMini(){const y=mcMonth.getFullYear(),m=mcMonth.getMonth(),days=new Date(y,m+1,0).getDate(),lead=(new Date(y,m,1).getDay()+6)%7,today=isoDay(new Date()),pre=`${y}-${String(m+1).padStart(2,"0")}`;
  $("#mc-title").textContent=new Date(y,m,1).toLocaleDateString("en-US",{month:"long",year:"numeric"});
  const kind={},pub={};plans().filter(match).forEach(p=>{if(p.date.startsWith(pre)&&!kind[p.date])kind[p.date]=p.type});pubs().forEach(v=>{if(v.d.startsWith(pre))pub[v.d]=1});
  // One tab stop for the whole month; arrow keys move between days.
  const stop=mcFocus&&mcFocus.startsWith(pre)?mcFocus:today.startsWith(pre)?today:pre+"-01";
  let h=["M","T","W","T","F","S","S"].map(d=>`<span class="dow" aria-hidden="true">${d}</span>`).join("");for(let i=0;i<lead;i++)h+=`<span class="d e" aria-hidden="true"></span>`;
  for(let d=1;d<=days;d++){const iso=`${pre}-${String(d).padStart(2,"0")}`,k=kind[iso];
    h+=`<button type="button" tabindex="${iso===stop?0:-1}" class="d${k?" "+k:""}${pub[iso]?" pub":""}${iso===today?" today":""}" data-day="${iso}" aria-label="${d} ${$("#mc-title").textContent}${k?", has a plan: "+(TYPE_LABEL[k]||""):""}${pub[iso]?", has a published video":""}">${d}</button>`}
  $("#mc").innerHTML=h;
  const n=plans().filter(p=>p.date.startsWith(pre)&&p.status!=="tayang").length;$("#mc-sub").textContent=n?`${n} plans this month`:"No plans this month yet"}
function renderNext(){const today=isoDay(new Date()),p=plans().filter(x=>x.date>=today&&x.status!=="tayang")[0],el=$("#next-up");
  if(!p){el.className="next noimg";el.innerHTML=`<div class="top"><span>Next upload</span></div><h3>Nothing scheduled</h3><p>Make a video plan so the upload schedule shows here.</p><div class="row"><button type="button" class="p" data-act="new">Make a plan</button></div>`;return}
  const d=new Date(p.date+"T12:00:00"),days=Math.round((d-new Date(today+"T12:00:00"))/864e5),when=days===0?"Today":days===1?"Tomorrow":`${days} days left`;
  el.className="next"+(thumbUrl(p)?"":" noimg");
  el.innerHTML=`<div class="top"><span>${d.toLocaleDateString("en-US",{weekday:"long",day:"numeric",month:"short"})}</span><span class="badge">${when}</span></div><h3>${esc(p.title)}</h3><div class="row"><button type="button" class="p" data-act="tools" data-id="${esc(p.id)}">Work on it</button><button type="button" class="s" data-plan-id="${esc(p.id)}">Edit</button></div>${thumbUrl(p)?`<img class="stk" src="${thumbUrl(p)}" alt="">`:""}`}
function renderStages(){const today=isoDay(new Date()),list=plans().filter(p=>p.date>=today&&p.status!=="tayang");const C={ide:"var(--s-ide)",naskah:"var(--s-naskah)",rekam:"var(--s-rekam)",edit:"var(--s-edit)",siap:"var(--s-siap)"};
  $("#stages").innerHTML=STAGES.slice(0,5).map(s=>`<li style="--c:${C[s]}"><i></i>${STATUS_LABEL[s]}<b>${list.filter(p=>p.status===s).length}</b></li>`).join("")}
const vcRange=()=>{const r=store.get("vr","30");return ["30","90","12"].includes(r)?r:"30"};
function viewSeries(){const d=YT?.daily||[],r=vcRange();
  if(r==="12"){const end=dataEnd(),part=YT.partialLast;return monthly().slice(-12).map(([m,v],i,a)=>{const mo=BN[+m.slice(5,7)-1];return {v,short:mo,long:mo+" "+m.slice(0,4)+(part&&i===a.length-1?` (to day ${+end.slice(8)})`:"")}})}
  return d.slice(-(+r)).map(([k,v])=>{const lbl=+k.slice(8)+" "+BN[+k.slice(5,7)-1];return {v,short:lbl,long:lbl+" "+k.slice(0,4)}})}
let VC=null;
function renderViews(){const box=$("#vc"),svg=$("#vc-svg"),d=YT?.daily||[],r=vcRange();if(!box)return;
  $("#vc-seg").querySelectorAll("button").forEach(b=>b.setAttribute("aria-pressed",b.dataset.r===r));
  $("#vc-tp").hidden=true;VC=null;
  if(d.length<14){$("#vc-sub").textContent="The chart appears once Studio data is imported or YouTube is connected.";svg.innerHTML="";return}
  const W=box.clientWidth,H=box.clientHeight;if(!W)return;
  const s=viewSeries(),n=s.length,pl=44,pr=4,pt=8,pb=24,pw=W-pl-pr,ph=H-pt-pb,top=Math.max(...s.map(x=>x.v),1);
  const ts=niceStep(top/5);
  const nt=Math.ceil(top/ts),max=ts*nt,step=pw/n,bw=Math.max(2,step-(n>40?1.5:n>20?3:8)),rx=Math.min(4,bw/2),y=v=>pt+ph-v/max*ph;
  const every=(n<=12?[1,2,3,6]:[5,10,15,30]).find(k=>k*step>=50)||n;
  let h="";
  for(let i=0;i<=nt;i++){const v=ts*i,yy=y(v);h+=`<line x1="${pl}" x2="${W-pr}" y1="${yy}" y2="${yy}"/><text x="${pl-8}" y="${yy+4}" text-anchor="end">${v>=1000?f1(v/1000)+"K":nf(v)}</text>`}
  s.forEach((x,i)=>{const bx=pl+i*step+(step-bw)/2,t=Math.min(y(x.v),pt+ph-1);
    h+=`<path class="b" data-i="${i}" d="M${bx},${pt+ph}V${t+rx}a${rx},${rx} 0 0 1 ${rx},-${rx}h${bw-2*rx}a${rx},${rx} 0 0 1 ${rx},${rx}V${pt+ph}z"/>`;
    if((n-1-i)%every===0)h+=`<text x="${i===n-1?bx+bw:bx+bw/2}" y="${H-6}" text-anchor="${i===n-1?"end":"middle"}">${x.short}</text>`});
  svg.setAttribute("viewBox",`0 0 ${W} ${H}`);svg.innerHTML=h;
  const sum=s.reduce((a,x)=>a+x.v,0),peak=s.reduce((b,x)=>x.v>b.v?x:b,s[0]);
  $("#vc-sub").innerHTML=r==="12"?`${n} months: <b>${nf(sum)}</b> views. Peak ${peak.long}, ${nf(peak.v)}.`:`${n} days: <b>${nf(sum)}</b> views, an average of ${nf(sum/n)} per day.`;
  VC={s,pl,step,W,y,i:-1}}
function vcShow(i){const tp=$("#vc-tp");if(!VC)return;
  $("#vc-svg").querySelectorAll(".b").forEach(b=>b.classList.toggle("on",+b.dataset.i===i));
  const x=VC.s[i];VC.i=x?i:-1;if(!x){tp.hidden=true;return}
  tp.hidden=false;tp.innerHTML=`${x.long}<b>${nf(x.v)} views</b>`;
  const cx=VC.pl+(i+.5)*VC.step,tw=tp.offsetWidth;
  tp.style.transform=`translate(${Math.max(0,Math.min(VC.W-tw,cx-tw/2))}px,${Math.max(0,VC.y(x.v)-tp.offsetHeight-8)}px)`}
(function(){const box=$("#vc");if(!box)return;
  const at=e=>{if(VC)vcShow(Math.floor((e.clientX-box.getBoundingClientRect().left-VC.pl)/VC.step))};
  box.addEventListener("pointermove",at);box.addEventListener("pointerdown",at);
  box.addEventListener("pointerleave",()=>vcShow(-1));box.addEventListener("blur",()=>vcShow(-1));
  box.addEventListener("keydown",e=>{const d={ArrowLeft:-1,ArrowRight:1}[e.key];if(!d||!VC)return;e.preventDefault();const n=VC.s.length;vcShow(VC.i<0?(d>0?0:n-1):Math.min(n-1,Math.max(0,VC.i+d)))});
  $("#vc-seg").addEventListener("click",e=>{const b=e.target.closest("button");if(!b)return;store.set("vr",b.dataset.r);renderViews()});
  let w=0;new ResizeObserver(()=>{const n=box.clientWidth;if(n&&n!==w){w=n;if(!$("#p-today").hidden)renderViews()}}).observe(box)})();

function renderTop(){const list=longForm().sort((a,b)=>b.v-a.v).slice(0,5);
  $("#topv").innerHTML=list.length?list.map(v=>`<li><span class="pl" aria-hidden="true"><svg viewBox="0 0 14 14"><path d="M4 2.5v9l7.5-4.5z"/></svg></span><span class="t" title="${esc(v.t)}">${esc(v.t)}</span><span class="v">${nf(v.v)}</span>${v.ctr?`<span class="c">${(+v.ctr).toLocaleString("en-US",{maximumFractionDigits:1})}%</span>`:""}</li>`).join(""):`<li class="empty-s">No video data yet.</li>`}
function renderKpis(){const el=$("#td-kpis");if(!el)return;const t=YT?.totals||{},d=YT?.daily||[],since=d.length?`since ${BN[+d[0][0].slice(5,7)-1]} ${d[0][0].slice(0,4)}`:"";
  let note="";if(d.length>=60){const a=lastDays(30),b=lastDays(30,30);if(b){const p=Math.round((a/b-1)*100);note=`<em class="${p<0?"dn":"upc"}">${p<0?"down":"up"} ${Math.abs(p)}%</em> from the 30 days before`}}
  const k=[["Views, 30 days",d.length?nf(lastDays(30)):"-",note],["Net subscribers",t.subs!=null?(t.subs>=0?"+":"")+nf(t.subs):"-",since],["Watch hours",t.hours!=null?nf(t.hours):"-",since],["Estimated revenue",t.revenue!=null?moneyShort(t.revenue):"-",since]];
  el.innerHTML=k.map(([l,v,n])=>`<div class="box kpi"><span>${l}</span><b>${v}</b><small>${n}</small></div>`).join("")}

function renderBoard(){$("#wk").hidden=view!=="week";$("#cal-wrap").hidden=view!=="month";if(view==="week")renderWeek();else renderCal()}
function renderDash(){if(!$("#wk"))return;renderBoard();renderMini();renderNext();renderStages()}
let editing=null;
// The thumbnail part of the plan dialog. sel: "f:<file in 06 Thumbnail>", "store", "new" or "".
const PL={list:[],sel:"",file:null,src:"",touched:false};
function plSel(p){return p.tfile&&vFolder(p.id)?"f:"+p.tfile:p.thumb?"store":""}
function plRender(){const p=editing||{},n=PL.list.length,mine=editing&&thumbMine(editing),tiles=PL.list.slice(0,6).map(x=>({k:"f:"+x.file,src:x.url+"?v="+x.at,name:x.file}));
  if(PL.sel.startsWith("f:")&&!tiles.some(t=>t.k===PL.sel)){const x=PL.list.find(y=>"f:"+y.file===PL.sel);if(x)tiles.push({k:PL.sel,src:x.url+"?v="+x.at,name:x.file})}
  if(p.thumb)tiles.push({k:"store",src:storeUrl(p),name:"From your computer"});
  if(PL.src)tiles.push({k:"new",src:PL.src,name:PL.file?.name||"New file"});
  const grid=$("#pl-tgrid"),many=n>0||tiles.length>1;
  $("#pl-thumbs-n").textContent=n?`· ${n} saved in 06 Thumbnail`:"(optional)";
  grid.hidden=!many;grid.innerHTML=many?tiles.map(t=>`<button type="button" data-plt="${esc(t.k)}" aria-pressed="${t.k===PL.sel}"><img src="${esc(t.src)}" alt="" loading="lazy"><small>${esc(t.name)}</small><span class="on" aria-hidden="true">✓<span class="lb"> In calendar</span></span><span class="sr">${t.k===PL.sel?", in calendar":""}</span></button>`).join(""):"";
  if(!many)grid.innerHTML="";
  const single=!many&&PL.sel?tiles.find(t=>t.k===PL.sel):null;$("#pl-thumb-one")?.remove();if(single)grid.insertAdjacentHTML("afterend",`<img id="pl-thumb-one" class="pl-one" src="${esc(single.src)}" alt="">`);
  const pick=$("#pl-thumb-pick");pick.textContent=many?"Use another file from the computer":"Choose image";pick.className=many?"linkish pl-other":"btn ghost";
  $("#pl-thumb-del").hidden=!PL.sel;
  const note=$("#pl-thumbs-note"),more=n>6?` ${plural(n-6,"older file")} not shown.`:"";
  note.hidden=!n;note.textContent=!n?"":(!PL.touched&&editing&&!mine&&PL.sel?"The newest saved thumbnail is used until you click another.":"Your click decides; a newer saved thumbnail will not replace it.")+more}
function openPlan(p){editing=p.id?p:null;Object.assign(PL,{list:[],sel:p.id?plSel(p):"",file:null,src:"",touched:false});$("#plan-dlg-title").textContent=editing?"Edit plan":"New plan";$("#pl-title").value=p.title||"";$("#pl-date").value=p.date||isoDay(new Date());$("#pl-type").value=p.type||"video";$("#pl-status").value=p.status||"ide";$("#pl-note").value=p.note||"";$("#pl-del").hidden=!editing;$("#pl-tools").hidden=!editing;
  plRender();$("#plan-dlg").showModal();$("#pl-title").focus();
  if(editing&&vFolder(p.id))(async()=>{const id=p.id;await thumbFollow([id]);const l=await vtList(id);if(editing?.id!==id||!$("#plan-dlg").open)return;
    editing=plans().find(x=>x.id===id)||editing;PL.list=l;if(!PL.touched)PL.sel=plSel(editing);plRender()})()}
$("#pl-tgrid").addEventListener("click",e=>{const b=e.target.closest("[data-plt]");if(!b)return;PL.sel=b.dataset.plt;PL.touched=true;plRender();$(`#pl-tgrid [data-plt="${CSS.escape(PL.sel)}"]`)?.focus()});
$("#pl-thumb-pick").addEventListener("click",()=>$("#pl-thumb-file").click());
$("#pl-thumb-file").addEventListener("change",e=>{const f=e.target.files[0];e.target.value="";if(!f)return;if(f.size>8*1024*1024){alert("The image is too large, 8 MB at most.");return}PL.file=f;PL.src=URL.createObjectURL(f);PL.sel="new";PL.touched=true;plRender()});
$("#pl-thumb-del").addEventListener("click",()=>{PL.sel="";PL.touched=true;plRender();$("#pl-thumb-pick").focus()});
$("#plan-form").addEventListener("submit",async e=>{if(e.submitter?.value!=="save")return;const list=plans().filter(x=>!editing||x.id!==editing.id);
  const id=editing?.id||Date.now().toString(36)+Math.random().toString(36).slice(2,6),np={...(editing||{})};let thumb=np.thumb||"";
  if(PL.touched){np.tmine=true;
    if(PL.sel==="new"&&PL.file){const r=await api("/api/thumb?id="+encodeURIComponent(id),{method:"POST",headers:{"Content-Type":PL.file.type||"application/octet-stream"},body:PL.file});if(r.ok){thumb=String(Date.now());delete np.tfile;delete np.tat}else alert(r.error||"The thumbnail could not be saved.")}
    else if(PL.sel==="store"){delete np.tfile;delete np.tat}
    else if(PL.sel.startsWith("f:")){const x=PL.list.find(y=>"f:"+y.file===PL.sel);if(x){np.tfile=x.file;np.tat=x.at*1000}}
    else{delete np.tfile;delete np.tat;if(thumb){await api("/api/thumb?id="+encodeURIComponent(id),{method:"DELETE"});thumb=""}}}
  delete np.thumb;
  list.push({...np,id,title:$("#pl-title").value.trim(),date:$("#pl-date").value,type:$("#pl-type").value,status:$("#pl-status").value,note:$("#pl-note").value.trim(),...(thumb?{thumb}:{})});
  const d=new Date($("#pl-date").value+"T12:00:00");calMonth=new Date(d.getFullYear(),d.getMonth(),1);mcMonth=new Date(calMonth);await savePlans(list)});
$("#pl-del").addEventListener("click",async()=>{if(!editing)return;$("#plan-dlg").close();if(editing.thumb)await api("/api/thumb?id="+encodeURIComponent(editing.id),{method:"DELETE"});await savePlans(plans().filter(x=>x.id!==editing.id))});
$("#pl-tools").addEventListener("click",()=>{$("#plan-dlg").close();if(editing)openMake(editing.id)});
$("#banner-close").addEventListener("click",()=>{store.set("banner-off",true);$("#banner-key").hidden=true});
const isDark=()=>document.documentElement.dataset.skin==="batu";
const skinName=()=>{$("#skin-name").textContent=isDark()?"Dark look":"Light look";$("#skin-tog").setAttribute("aria-checked",isDark())};
$("#plan-new").addEventListener("click",()=>openPlan({}));$("#rail-plus").addEventListener("click",()=>openPlan({}));
$("#skin-tog").addEventListener("click",()=>{const k=isDark()?"terang":"batu";document.documentElement.dataset.skin=k;store.set("look",k);skinName();api("/api/skin?skin="+k,{method:"POST"});if(YT&&!$("#p-growth").hidden)chart()});
document.querySelectorAll("#p-dash .seg button").forEach(b=>b.addEventListener("click",()=>{view=b.dataset.view;document.querySelectorAll("#p-dash .seg button").forEach(x=>x.setAttribute("aria-pressed",x===b));renderBoard()}));
const shift=n=>{if(view==="week")weekStart=addDays(weekStart,7*n);else calMonth=new Date(calMonth.getFullYear(),calMonth.getMonth()+n,1);renderBoard()};
$("#wk-prev").addEventListener("click",()=>shift(-1));$("#wk-next").addEventListener("click",()=>shift(1));
$("#wk-today").addEventListener("click",()=>{const d=new Date();d.setHours(12,0,0,0);weekStart=d;calMonth=new Date(d.getFullYear(),d.getMonth(),1);renderBoard()});
$("#pp-q").addEventListener("input",e=>{query=e.target.value.trim().toLowerCase();renderBoard();renderMini()});
document.querySelectorAll("#mc-pills button").forEach(b=>b.addEventListener("click",()=>{typeF=b.dataset.f;document.querySelectorAll("#mc-pills button").forEach(x=>x.setAttribute("aria-pressed",x===b));renderMini();renderBoard()}));
$("#mc-prev").addEventListener("click",()=>{mcMonth=new Date(mcMonth.getFullYear(),mcMonth.getMonth()-1,1);renderMini()});
$("#mc-next").addEventListener("click",()=>{mcMonth=new Date(mcMonth.getFullYear(),mcMonth.getMonth()+1,1);renderMini()});
$("#mc").addEventListener("keydown",e=>{const b=e.target.closest("[data-day]"),step={ArrowLeft:-1,ArrowRight:1,ArrowUp:-7,ArrowDown:7}[e.key];if(!b||step==null)return;e.preventDefault();
  const d=addDays(new Date(b.dataset.day+"T12:00:00"),step);mcFocus=isoDay(d);mcMonth=new Date(d.getFullYear(),d.getMonth(),1);renderMini();$(`#mc [data-day="${mcFocus}"]`).focus()});
document.addEventListener("click",async e=>{
  const day=e.target.closest("[data-day]");if(day){const d=new Date(day.dataset.day+"T12:00:00");weekStart=d;mcFocus=day.dataset.day;calMonth=new Date(d.getFullYear(),d.getMonth(),1);view="week";document.querySelectorAll("#p-dash .seg button").forEach(x=>x.setAttribute("aria-pressed",x.dataset.view==="week"));show("dash");return}
  const act=e.target.closest("[data-act]");if(act){if(act.dataset.act==="new")return openPlan({});const p=plans().find(x=>x.id===act.dataset.id);if(p)openMake(p.id);return}
  const n=e.target.closest("[data-new]");if(n)return openPlan({date:n.dataset.new});
  const pi=e.target.closest("[data-plan-id]");if(pi){const p=plans().find(x=>x.id===pi.dataset.planId);if(p)openPlan(p);return}
  const pl=e.target.closest("[data-plan]");if(pl){await savePlans([...plans(),{id:Date.now().toString(36)+Math.random().toString(36).slice(2,6),title:pl.dataset.plan,date:pl.dataset.date,type:"video",status:"ide",note:""}]);pl.textContent="Added to calendar";pl.disabled=true;return}
  if(e.target.closest("#plan-all")){const btns=[...document.querySelectorAll("#o-ideas [data-plan]:not([disabled])")];const add=btns.map((b,i)=>({id:Date.now().toString(36)+i+Math.random().toString(36).slice(2,5),title:b.dataset.plan,date:b.dataset.date,type:"video",status:"ide",note:""}));btns.forEach(b=>{b.textContent="Added to calendar";b.disabled=true});if(add.length)await savePlans([...plans(),...add]);e.target.textContent=add.length?`${add.length} ideas added to the calendar`:"All already in the calendar"}
});

/* 2.0 growth loop: Today, Learn, Ideas pattern and the Make workspace.
   Everything here is plain rules on the channel's own numbers; only the buttons that say "AI" call a model. */
const med=a=>{const b=a.filter(x=>x!=null&&!isNaN(x)).sort((x,y)=>x-y),m=b.length>>1;return b.length?(b.length%2?b[m]:(b[m-1]+b[m])/2):null};
const share=v=>v&&v.v&&v.dur?Math.min(100,v.h*3600/v.v/v.dur*100):null;
const avdMin=v=>v&&v.v?v.h*60/v.v:null;
const ctrOf=v=>v&&v.ctr>0?+v.ctr:null,impOf=v=>v&&v.imp>0?+v.imp:null;
const uploads=()=>longForm().filter(v=>v.d&&v.v>0).sort((a,b)=>a.d.localeCompare(b.d));
const winners=()=>[...longForm()].sort((a,b)=>b.v-a.v).slice(0,6);
const range=(a,fmt)=>{const b=a.filter(x=>x!=null);if(!b.length)return "-";const lo=Math.min(...b),hi=Math.max(...b);return fmt(lo)===fmt(hi)?fmt(lo):fmt(lo)+" to "+fmt(hi)};
const THREAT=/hunt|killer|kill|butcher|predator|\bate\b|eats?\b|eating|devour|terror|deadl|monster|crush|apex|nightmare|fear|slaughter|ripper|stalk|prey|bite|jaw|savage|beast|menace|danger|attack|blood/i;
// In spoken openings, putting people in the scene also counts as the danger.
const HOOK_DANGER=new RegExp(THREAT.source+"|ancestors|humans|our species|people",'i');
const SIZE=/\d|giant|biggest|largest|huge|colossal|massive|\bton|\blbs?\b|pound|feet|foot|meter|metre|tall|titan|mega|heaviest|strongest/i;
const dataEnd=()=>YT?.daily?.length?YT.daily[YT.daily.length-1][0]:isoDay(new Date());
const daysBetween=(a,b)=>Math.round((new Date(b+"T12:00:00")-new Date(a+"T12:00:00"))/864e5);
const pctTxt=x=>x==null?"-":f1(x)+"%";
function usShare(){const g=YT?.geo||[];const tv=g.reduce((s,r)=>s+(+r.views||0),0),tr=g.reduce((s,r)=>s+(+r.rev||0),0),us=g.find(r=>/united states|amerika serikat|^us$/i.test(r.name||""));
  return us&&tv?{views:Math.round(us.views/tv*100),rev:tr?Math.round((us.rev||0)/tr*100):null}:null}
function channelNumbers(){const up=uploads(),W=winners(),R=up.slice(-5);
  const n={up,W,R,wS:med(W.map(share)),rS:med(R.map(share)),wC:med(W.map(ctrOf)),rC:med(R.map(ctrOf)),wI:med(W.map(impOf)),rI:med(R.map(impOf))};
  n.ret=n.wS&&n.rS!=null&&n.rS<n.wS*0.6;n.ctr=n.wC&&n.rC!=null&&n.rC<n.wC*0.75;n.reach=n.wI&&n.rI!=null&&n.rI<n.wI*0.2;
  n.lever=n.ret?"ret":n.ctr?"ctr":n.reach?"reach":"ok";return n}
function lessonFor(v,n){const s=share(v),c=ctrOf(v),i=impOf(v);
  const best=[...n.W].sort((a,b)=>(share(b)||0)-(share(a)||0))[0];
  if(s!=null&&s<10)return `Only ${f1(s)}% watched, viewers leave early. Compare its first minute with "${best?best.t:"best videos"}".`;
  if(c&&n.wC&&c<n.wC*0.6)return `CTR ${f1(c)}%, far below your best videos (${f1(n.wC)}%). The title or thumbnail does not pull clicks.`;
  if(i&&n.wI&&i<n.wI*0.05&&s>=20)return `Viewers stay (${f1(s)}%), but YouTube only showed it ${nf(i)} times. A stronger topic and package opens up reach.`;
  if(s>=20)return `Close to your best videos (${f1(s)}% watched). Repeat how this video opens.`;
  return s==null?"Video length is not in the data yet.":`${f1(s)}% watched, below your best videos (${f1(n.wS)}%). Get to the heart of the story sooner.`}

function spark(vals,lo,hi,color){const v=vals.filter(x=>x!=null);if(v.length<2)return "";const w=300,h=46,n=v.length,x=i=>4+i*(w-8)/(n-1),y=t=>h-4-(Math.min(hi,Math.max(lo,t))-lo)/((hi-lo)||1)*(h-8);
  const d=v.map((t,i)=>`${i?"L":"M"}${x(i).toFixed(1)} ${y(t).toFixed(1)}`).join("");
  return `<svg class="spk" viewBox="0 0 ${w} ${h}" preserveAspectRatio="none" aria-hidden="true"><path d="${d}L${x(n-1)} ${h}L${x(0)} ${h}Z" fill="${color}" fill-opacity=".14" stroke="none"/><path d="${d}" fill="none" stroke="${color}" stroke-width="2" vector-effect="non-scaling-stroke"/></svg>`}

function renderNextVideo(){const el=$("#td-next");if(!el)return;const today=isoDay(new Date()),list=plans().filter(x=>x.type==="video"&&x.status!=="tayang"),p=list.filter(x=>x.date>=today)[0]||list[list.length-1];
  if(!p){el.className="next noimg";el.innerHTML=`<div class="top"><span>Next video</span></div><h3>No video scheduled</h3><p>The app picks a topic, title and hook from the pattern of your best videos, then writes the script.</p><div class="row"><button type="button" class="p" data-act="one">Make script in 1 click</button></div>`;return}
  const d=new Date(p.date+"T12:00:00"),days=daysBetween(today,p.date),when=days<0?"past due":days===0?"Today":days===1?"Tomorrow":`${days} days left`,early=p.status==="ide"||p.status==="naskah";
  el.className="next"+(thumbUrl(p)?"":" noimg");
  el.innerHTML=`<div class="top"><span>Next video · ${d.toLocaleDateString("en-US",{weekday:"long",day:"numeric",month:"short"})}</span><span class="badge">${when}</span></div><h3>${esc(p.title)}</h3><p>Current step: ${STATUS_LABEL[p.status]||p.status}.</p><div class="row">${early?`<button type="button" class="p" data-act="one" data-id="${esc(p.id)}">Make script in 1 click</button><button type="button" class="s" data-act="open" data-id="${esc(p.id)}">Open</button>`:`<button type="button" class="p" data-act="open" data-id="${esc(p.id)}">Continue</button>`}</div>${thumbUrl(p)?`<img class="stk" src="${thumbUrl(p)}" alt="">`:""}`}
$("#td-next").addEventListener("click",e=>{const b=e.target.closest("[data-act]");if(!b)return;
  if(b.dataset.act==="open")return openMake(b.dataset.id);
  if(b.dataset.id)openMake(b.dataset.id,"outline");else $("#td-new").click();
  oneClick($("#mk-one"),b.dataset.id?null:$("#s-vl"))});
function renderStg(){const el=$("#td-stg");if(!el)return;const list=plans().filter(p=>p.type!=="post"&&p.status!=="tayang");
  el.innerHTML=PIPE.map(([s,l])=>{const n=list.filter(p=>p.status===s).length;return `<li class="${n?"":"z"}" title="${l}"><b>${n}</b>${l==="Ready to upload"?"Ready":l}</li>`}).join("")}

function renderToday(){if(!$("#td-kpis"))return;const has=uploads().length>=6,dl=YT?.daily||[];
  $("#today-sub").textContent=new Date().toLocaleDateString("en-US",{weekday:"long",day:"numeric",month:"long",year:"numeric"})+(dl.length?` · data up to ${fmtShort(dataEnd())}`:"");
  $("#td-empty").hidden=has;$("#td-full").hidden=$("#td-grow").hidden=!has;$("#td-gradebox").hidden=!has;
  renderKpis();renderViews();renderTop();renderNextVideo();renderStg();renderPipe();if(!has)return;
  const n=channelNumbers(),{W,R}=n;
  const set=(h,p,label,fn)=>{$("#dx-h").textContent=h;$("#dx-p").textContent=p;const b=$("#dx-go");b.textContent=label;b.onclick=fn};
  if(n.lever==="ret")set("Viewers leave in the first minute.","Fix the first 60 seconds of every script first.","Open hook coach",()=>openMake(null,"hook"));
  else if(n.lever==="ctr")set("Videos are shown, but rarely clicked.","Fix the title and thumbnail first, before writing the script.","Open video package",()=>openMake(null,"pkg"));
  else if(n.lever==="reach")set("YouTube rarely shows your new videos.","Pick topics close to your best videos.","Find the next topic",()=>show("ideas"));
  else set("Recent uploads are in line with your best videos.","Keep the schedule and keep picking topics that match the pattern.","Find the next topic",()=>show("ideas"));
  const bar=(lbl,val,txt,w,cls)=>`<div><div class="lbl"><span>${lbl}</span><b>${val}</b></div><div class="track"><div class="fill ${cls}" style="width:${Math.max(w,3)}%">${txt}</div></div></div>`;
  let cmp;
  if(n.lever==="ctr"&&n.wC&&n.rC)cmp=bar("CTR, 6 best videos",pctTxt(n.wC),"",n.wC/8*100,"win")+bar("CTR, last 5 uploads",pctTxt(n.rC),"",n.rC/8*100,"now");
  else if(n.lever==="reach"&&n.wI&&n.rI)cmp=bar("Thumbnail impressions per best video",nf(n.wI),"",100,"win")+bar("Thumbnail impressions per recent upload",nf(n.rI),"",n.rI/n.wI*100,"now");
  else{const sc=Math.max(40,Math.max(n.wS||0,n.rS||0)*1.2);
    cmp=bar("Share watched, 6 best videos",pctTxt(n.wS),n.wS/sc*100>30?`average ${f1(med(W.map(avdMin)))} min`:"",n.wS/sc*100,"win")+bar("Share watched, last 5 uploads",pctTxt(n.rS),n.rS/sc*100>30?`${f1(med(R.map(avdMin)))} min`:"",n.rS/sc*100,"now")}
  $("#dx-cmp").innerHTML=cmp+`<small>Median values; both bars use the same scale.</small>`;
  renderGrow(n);renderGrade(n)}

const weekKey=()=>{const d=new Date();d.setDate(d.getDate()-((d.getDay()+6)%7));return isoDay(d)};
/* How to get more views: plain rules on the channel's own numbers, ranked by the size of the gap.
   A rule only shows when the data behind it is in; ticks and their baseline numbers live in LAST.week. */
const TR={browse:/browse features|fitur jelajah/i,sugg:/suggested videos|video (yang )?disarankan/i,shorts:/shorts feed|feed shorts/i,end:/end screens?|layar akhir/i};
function trShare(re){const t=YT?.traffic||[],tot=t.reduce((s,r)=>s+(+r.views||0),0),r=t.find(x=>re.test(x.name||""));return tot&&r?r.views/tot*100:null}
// Evening (19:00) in each country, written in WIB. Countries not listed get no publish time rule.
const TZ_WIB=[[/united states|amerika serikat|^us$/i,"the US","US","07:00"],[/canada|kanada/i,"Canada","Canada","07:00"],[/united kingdom|inggris|britania/i,"the UK","UK","02:00"],
  [/australia/i,"Australia","Australia","15:00"],[/india/i,"India","India","20:30"],[/germany|jerman/i,"Germany","Germany","01:00"],[/indonesia/i,"Indonesia","Indonesia","19:00"]];
function topCountry(){const g=YT?.geo||[],tv=g.reduce((s,r)=>s+(+r.views||0),0),tr=g.reduce((s,r)=>s+(+r.rev||0),0);if(!tv)return null;
  const by=tr>0?"rev":"views",c=[...g].sort((a,b)=>(+b[by]||0)-(+a[by]||0))[0],z=TZ_WIB.find(x=>x[0].test(c.name||""));if(!z)return null;
  return {name:z[1],tag:z[2],wib:z[3],views:c.views/tv*100,rev:tr>0?(+c.rev||0)/tr*100:null,by}}
const BIGW=/giant|biggest|largest|huge|colossal|massive|titan|mega|heaviest|monster/i,gwPat=v=>THREAT.test(v.t||"")||BIGW.test(v.t||"");
const gwCost=k=>runCopy(k)?"free":runCost(k);
const pc=x=>Math.round(x)+"%";
function growRules(n){const {W,R}=n,lf=longForm(),end=dataEnd(),out=[],add=(k,g,o)=>out.push({k,gap:g,...o}),EV=(t,c)=>[t,c||""];
  if(n.wC&&n.rC!=null&&n.rC<n.wC*.9){const g=1-n.rC/n.wC,br=trShare(TR.browse),ip=imgReady()?IMG_PRICE[imgModel()]:0;
    add("ctr",g,{big:g>=.25,t:"Test 3 thumbnails on your next upload",why:"Fewer people click your recent videos than your best ones. A clearer thumbnail is the quickest fix.",
      ev:[EV(`CTR last 5 uploads ${pctTxt(n.rC)}`,"bad"),EV(`best videos ${range(W.map(ctrOf),f1)}%`,"good"),br!=null&&EV(`${pc(br)} of views come from the home page`)],
      act:"Do it",cost:"20 min"+(ip?" · about "+usd(ip*3):"")})}
  if(n.wS&&n.rS!=null&&n.rS<n.wS*.9){const g=1-n.rS/n.wS,am=med(R.map(avdMin));
    add("hook",g,{big:g>=.25,t:"Open straight on the animal and the danger",why:"Viewers leave your recent videos sooner than your best ones. Fix the first 60 seconds before the voice over.",
      ev:[EV(`watched ${pc(n.rS)} on recent videos`,"bad"),EV(`best videos ${range(W.map(share),Math.round)}%`,"good"),am!=null&&EV(`average view about ${f1(am)} min`)],
      act:"Do it",cost:"15 min · "+gwCost("hook")})}
  const hit=W.filter(gwPat).length,oth=lf.filter(v=>!W.includes(v)&&!gwPat(v)&&v.d&&daysBetween(v.d,end)>=30),mo=med(oth.map(v=>v.v)),mw=med(W.map(v=>v.v));
  if(W.length>=6&&hit>=4&&oth.length>=3&&mw&&mo<mw*.5){const g=1-mo/mw;
    add("topic",g*.5,{big:hit>=5&&g>=.8,t:"Keep the next 3 topics to giant animals and predators",why:`${hit} of your 6 best videos name a giant or a threat in the title. Videos without one got far fewer views.`,
      ev:[EV(`${hit} of 6 best: giant or threat in the title`,"good"),EV(`other topics: median ${nf(mo)} views`,"bad")],act:"Find ideas",cost:"2 min · "+gwCost("ideas")})}
  const old=lf.filter(v=>v.d&&daysBetween(v.d,end)>=180).sort((a,b)=>b.v-a.v),ma=med(lf.map(v=>v.v));
  if(old.length>=2&&ma&&old[1].v>=ma*3){const [a,b]=old;
    add("refresh",.5*(1-ma/b.v),{t:"New thumbnail on your 2 biggest old videos",why:`"${a.t}" and "${b.t}" are your biggest videos. A fresh thumbnail can help YouTube show them again, and their end screens send viewers to newer videos.`,
      ev:[EV(`${nf(b.v)}+ views each`),ctrOf(a)&&ctrOf(b)&&EV(`CTR now ${f1(ctrOf(a))}% and ${f1(ctrOf(b))}%`)],act:"Show which",ghost:1,cost:"30 min",old:old.slice(0,6)})}
  const sg=trShare(TR.sugg),es=trShare(TR.end),best=W[0];
  if(sg!=null&&sg<15&&best)add("end",.5*(15-sg)/15,{t:"End screen: point every video to your best one",why:`Only ${pc(sg)} of views come from suggested videos. An end screen to "${best.t}" keeps people on your channel.`,
    ev:[EV(`suggested ${pc(sg)} of views`,"bad"),es!=null&&EV(`end screens ${f1(es)}% of views`)],act:"How",ghost:1,cost:"5 min · free",best});
  const tc=topCountry(),ts=tc&&(tc.by==="rev"?tc.rev:tc.views);
  if(tc&&ts>=25)add("time",.4*ts/100,{t:`Publish at ${tc.wib} WIB`,why:`That is evening in ${tc.name}, where ${ts>=50?"most":"a big part"} of your ${tc.by==="rev"?"money":"views"} comes from.`,
    ev:[EV(`${tc.tag} ${pc(tc.views)} of views`),tc.rev!=null&&EV(`${pc(tc.rev)} of revenue`,tc.rev>=50?"good":"")],cost:"free"});
  const today=isoDay(new Date()),nx=plans().filter(p=>p.type==="video"&&p.status!=="tayang"&&p.date>=today&&daysBetween(today,p.date)<=14)[0];
  if(nx)add("post",.08,{t:"One Community post on upload day",why:"A poll reaches people who already subscribed. Small effect, but almost no work: the app writes it.",
    ev:[EV(`next upload ${fmtShort(nx.date)}`),EV("reaches subscribers only")],act:"Write post",ai:"post",ghost:1,cost:"5 min",nx});
  const sh=(YT?.videos||[]).filter(v=>v.dur>0&&v.dur<120&&v.d);
  if(sh.length>=3){const tot=sh.reduce((s,v)=>s+v.v,0),rec=sh.filter(v=>daysBetween(v.d,end)<=180),rv=rec.reduce((s,v)=>s+v.v,0),rm=med(rec.map(v=>v.v)),lm=med(R.map(v=>v.v)),feed=trShare(TR.shorts);
    const yrs={};sh.forEach(v=>yrs[v.d.slice(0,4)]=(yrs[v.d.slice(0,4)]||0)+v.v);const [yr,yv]=Object.entries(yrs).sort((a,b)=>b[1]-a[1])[0];
    if(tot&&rec.length>=2&&rv/tot>=.25&&lm&&rm>=lm)add("shorts",.3*Math.min(1,rm/lm/4),{t:"Keep making Shorts",why:`Your Shorts from the last 6 months got a median of ${nf(rm)} views, more than your recent long videos. One Short cut from each long video costs little.`,
      ev:[EV(`recent Shorts: median ${nf(rm)} views`,"good"),EV(`recent long videos: median ${nf(lm)} views`),feed!=null&&EV(`Shorts feed ${pc(feed)} of views`)],cost:"30 min"});
    else if(tot){const low=rv/tot<.25,yo=yv/tot>=.5&&yr<end.slice(0,4);
      if(low||(lm&&rm<lm))add("shorts",-1,{skip:1,t:"Shorts",why:`${low?`${yo?`Your Shorts brought views mostly in ${yr}`:"Most of your Shorts views come from Shorts older than 6 months"}, and ${rec.length>1?`the ${rec.length} Shorts from the last 6 months barely work`:rec.length?"the one Short from the last 6 months barely works":"you made none in the last 6 months"}.`:`Your recent Shorts get fewer views than your recent long videos (median ${nf(rm)} against ${nf(lm)}).`} For a channel this size, an hour on thumbnails and hooks pays off more. This moves up if new Shorts start to work.`,
        ev:[feed!=null&&EV(`Shorts feed ${pc(feed)} of views${yv/tot>=.5?", mostly "+yr:""}`),EV(`last 6 months: ${pc(rv/tot*100)} of Shorts views`,low?"bad":"")],cost:"skip for now"})}}
  if(n.lever==="reach"&&!out.some(x=>x.k==="topic"))add("reach",1-n.rI/n.wI,{big:1,t:"Pick topics close to your best videos",why:"YouTube rarely shows your new videos: each gets far fewer impressions than your best ones did.",
    ev:[EV(`impressions per recent upload ${nf(n.rI)}`,"bad"),EV(`per best video ${nf(n.wI)}`,"good")],act:"Find ideas",cost:"2 min · "+gwCost("ideas")});
  // The rule behind "Biggest problem right now" goes first, so the two boxes agree.
  const lead={ret:"hook",ctr:"ctr",reach:out.some(x=>x.k==="topic")?"topic":"reach"}[n.lever],key=x=>x.gap+(x.k===lead?1:0);out.forEach(x=>{if(x.k===lead)x.big=1});
  out.sort((a,b)=>key(b)-key(a));let nb=0;
  out.forEach(x=>{x.ev=x.ev.filter(Boolean);x.grp=x.skip?2:x.big&&nb<3?(nb++,0):1});
  const first=out.find(x=>!x.skip);if(!nb&&first)first.grp=0;
  return out.sort((a,b)=>a.grp-b.grp)}
const GW={n:null,items:[],open:new Set()};
const gwState=()=>{const d=LAST.week?.data||{};return {wk:d.wk,done:d.wk===weekKey()?d.done||[]:[],base:d.base||{}}};
function gwSince(k){const b=gwState().base[k],n=GW.n;if(!b||daysBetween(b.at,isoDay(new Date()))>56)return "";
  // New data means a later import; ticks saved before 2.6.0 only know the data end date.
  if(b.imp?!(+YT?.imported_at>b.imp):!(YT?.daily?.length&&b.end<dataEnd()))return `<p class="gw-since">Ticked ${fmtShort(b.at)}. After your next Update Studio data, this shows whether CTR and share watched moved.</p>`;
  // Uploads made after the tick say the most; without any, the last-5 medians are compared.
  const nw=n.up.filter(v=>v.d>b.at),c=nw.length?med(nw.map(ctrOf)):n.rC,w=nw.length?med(nw.map(share)):n.rS;
  const mv=(l,a,z)=>a==null||z==null?"":`${l} ${pctTxt(a)} → <span class="${z>a?"good":z<a?"bad":""}">${pctTxt(z)}</span>`,parts=[mv(nw.length?"CTR":"CTR of last 5 uploads",b.rC,c),mv("share watched",b.rS,w)].filter(Boolean);
  return parts.length?`<p class="gw-since">Since you ticked it on ${fmtShort(b.at)}${nw.length?`, ${plural(nw.length,"new upload")}`:""}: ${parts.join(", ")}.</p>`:""}
function gwPast(st){const L=Object.keys(st.base).filter(k=>!GW.items.some(x=>x.k===k)).map(k=>[k,gwSince(k)]).filter(([,h])=>h);if(!L.length)return "";
  return `<div class="gw-grp"><h3>Ticked earlier</h3>${L.map(([k,h])=>`<div class="gw-mv gw-skip"><span class="gw-n" aria-hidden="true">✓</span><div class="gw-b"><b class="gw-t">${esc(st.base[k].t||"A step you ticked")}</b><p>${["ctr","hook","topic","reach"].includes(k)?"The gap to your best videos has closed, so this is off the list.":"Off the list now: the numbers behind it changed."}</p>${h}</div></div>`).join("")}</div>`}
function gwMore(x){if(!GW.open.has(x.k))return "";
  if(x.k==="refresh")return `<ol class="gw-more gw-old">${x.old.map((v,i)=>`<li${i<2?' class="hi"':""}><span>${esc(v.t)}</span><small>${nf(v.v)} views${ctrOf(v)?` · CTR ${f1(ctrOf(v))}%`:""} · ${fmtShort(v.d)}${i<2?" · start here":""}</small></li>`).join("")}</ol>`;
  if(x.k==="end")return `<ol class="gw-more gw-how"><li>In YouTube Studio, open Content and click a video.</li><li>Under Elements on the right, click End screen.</li><li>Click Element, then Video, then Choose specific video, and pick "${esc(x.best.t)}".</li><li>Do your 5 newest videos first. It takes about a minute each.</li></ol>`;
  if(x.k==="post"){const s=LAST.gw_post?.data;
    return `<div class="gw-more">${runW("post")}<button type="button" class="btn sm" data-run="post" data-base="Write the post" data-gw-write>${runTxt("post","Write the post")}</button><div class="status" role="status" id="gw-post-st">${esc(GW.msg||"")}</div>${s?.post?copyBox(`Community post for "${s.title||""}"`,s.post+(s.poll?.length?"\n\nPoll:\n"+s.poll.map(o=>"- "+o).join("\n"):"")):""}</div>`}
  return ""}
function renderGrow(n){const el=$("#gw-list");if(!el)return;GW.n=n;GW.items=growRules(n);const st=gwState();
  $("#gw-upd").textContent=YT?.imported_at?"Updated "+fmtShort(isoDay(new Date(YT.imported_at))):"Data up to "+fmtShort(dataEnd());
  if(!GW.items.length){el.innerHTML=`<p class="gw-none">Your recent uploads are in line with your best videos. Keep the schedule and keep picking topics like your best ones.</p>`+gwPast(st);return}
  const H=["Do this week","Worth doing, small effort","Not worth it right now"];let i=0,nTop=0;
  keepPaste("gw-post-st",()=>el.innerHTML=H.map((h,g)=>{const list=GW.items.filter(x=>x.grp===g);if(!list.length)return "";
    return `<div class="gw-grp"><h3>${h}</h3>${list.map(x=>{const on=st.done.includes(x.k),top=g===0&&nTop++<2,id="gw-"+x.k;
      return `<div class="gw-mv${top?" top":""}${x.skip?" gw-skip":""}${on?" done":""}" data-gw="${x.k}"><span class="gw-n" aria-hidden="true">${x.skip?"–":++i}</span><div class="gw-b"><b class="gw-t" id="${id}">${esc(x.t)}</b><p>${esc(x.why)}</p>${x.ev.length?`<div class="gw-ev">${x.ev.map(([t,c])=>`<span${c?` class="${c}"`:""}>${esc(t)}</span>`).join("")}</div>`:""}${gwSince(x.k)}${gwMore(x)}</div>`
        +`<div class="gw-side">${x.act?`<button type="button" class="btn sm${x.ghost?" ghost":""}" data-gw-go="${x.k}"${x.ghost?` aria-expanded="${GW.open.has(x.k)}"`:""}>${x.act}</button>`:""}<small>${esc(x.cost)}</small>${x.skip?"":`<label class="gw-tick"><input type="checkbox" data-gw-tick="${x.k}" aria-describedby="${id}"${on?" checked":""}>Done</label>`}</div></div>`}).join("")}</div>`}).join("")+gwPast(st));
  el.querySelectorAll("button[data-run]").forEach(runLbl)}
$("#gw-list").addEventListener("click",async e=>{const g=e.target.closest("[data-gw-go]");
  if(g){const k=g.dataset.gwGo;if(k==="ctr")return openMake(null,"thumb");if(k==="hook")return openMake(null,"hook");if(k==="topic"||k==="reach")return show("ideas");
    GW.open.has(k)?GW.open.delete(k):GW.open.add(k);renderGrow(GW.n);$(`[data-gw-go="${k}"]`)?.focus();return}
  const w=e.target.closest("[data-gw-write]");if(!w)return;const x=GW.items.find(y=>y.k==="post");if(!x)return;const t=x.nx.title;
  const st=$("#gw-post-st"),d=await ask(st,w,`Write one YouTube Community post for the upload day of the new video "${t}". Under 600 characters. Open with one surprising, accurate fact about the animal, say the video is out today, then ask which animal viewers want next. Give 3 or 4 short poll options, each a prehistoric animal that fits this channel.\nJSON shape: {"post":"","poll":[""]}`,null);
  if(!d&&!st.isConnected&&runCopy("post")){GW.msg="The paste box was closed. Press Write the post again.";renderGrow(GW.n);return}
  if(d?.post){await remember("gw_post",{title:t,post:d.post,poll:Array.isArray(d.poll)?d.poll.slice(0,5).map(String):[]}).catch(()=>{});GW.msg=$("#gw-post-st")?.textContent||"";renderGrow(GW.n)}});
$("#gw-list").addEventListener("change",e=>{const c=e.target.closest("[data-gw-tick]");if(!c)return;const k=c.dataset.gwTick,st=gwState(),n=GW.n,base={...st.base};
  let done=[...st.done];if(c.checked){done=[...new Set([...done,k])];base[k]={at:isoDay(new Date()),end:dataEnd(),imp:+YT?.imported_at||0,rC:n.rC,rS:n.rS,t:GW.items.find(x=>x.k===k)?.t||""}}else{done=done.filter(x=>x!==k);delete base[k]}
  remember("week",{wk:weekKey(),done,base}).catch(()=>{});renderGrow(n);$(`[data-gw-tick="${k}"]`)?.focus()});
function renderGrade(n){const up=n.up,L=up[up.length-1],prev=up.slice(-11,-1),age=daysBetween(L.d,dataEnd());
  $("#td-last-sub").textContent=`${L.t} · ${fmtShort(L.d)}${age<7?`, only ${Math.max(age,0)} days old: numbers still moving`:""}`;
  const rows=[["Share watched",share(L),med(prev.map(share)),pctTxt],["CTR",ctrOf(L),med(prev.map(ctrOf)),pctTxt],["Thumbnail impressions",impOf(L),med(prev.map(impOf)),nf],["Views",L.v,med(prev.map(v=>v.v)),nf]].filter(r=>r[1]!=null&&r[2]!=null);
  $("#td-grade").innerHTML=`<div class="grade">${rows.map(([k,v,m,f])=>{const ok=v>=m;return `<div class="gr"><span>${k}</span><span class="num"><b>${f(v)}</b> <span class="muted">vs ${f(m)} usual</span></span><span class="pill ${ok?"good":"bad"}">${ok?"above usual":"below usual"}</span></div>`}).join("")}</div><p class="sub" style="margin-top:12px"><b>Lesson:</b> ${esc(lessonFor(L,n))}</p>`}

const PIPE=[["ide","Idea"],["naskah","Script"],["rekam","Voice"],["edit","Edit"],["siap","Ready to upload"]];
// Status only moves forward, so a manual "Edit" is never pulled back by re-running an earlier step.
async function advance(id,status){const p=plans().find(x=>x.id===id);if(!p||STAGES.indexOf(status)<=STAGES.indexOf(p.status))return;
  await remember("plans",plans().map(x=>x.id===id?{...x,status}:x)).catch(()=>{});renderDash();renderPipe();renderStg();renderNextVideo()}
const NEXT={ide:["Package and script","Make it in 1 click","one"],naskah:["Write the full script","Write script in 1 click","one"],rekam:["Make the voice over","Open voice over","vo"],edit:["Edit in Premiere","Mark as edited","siap"],siap:["Upload to YouTube","Mark as published","tayang"]};
function renderPipe(){const el=$("#td-pipe");if(!el)return;const today=isoDay(new Date()),rank=s=>-STAGES.indexOf(s);
  const list=plans().filter(p=>p.type!=="post"&&p.status!=="tayang").sort((a,b)=>rank(a.status)-rank(b.status)||a.date.localeCompare(b.date));
  if(!list.length){el.innerHTML=`<li class="nx-empty">Nothing in progress. Press "New video" and the app suggests a topic.</li>`;return}
  el.innerHTML=list.map(p=>{const [step,label,act]=NEXT[p.status]||NEXT.ide,late=p.date<today;
    return `<li><button type="button" class="nx-t" data-make="${esc(p.id)}"><b>${esc(p.title)}</b><small>${p.type==="short"?"Short · ":""}${fmtShort(p.date)}${late?" · past due":""}</small></button><span class="pill st-${p.status}">${STATUS_LABEL[p.status]||p.status}</span><span class="nx-s">Next: ${step}</span><button type="button" class="btn ${act==="one"?"":"ghost"} sm" data-nx="${act}" data-id="${esc(p.id)}">${label}</button></li>`}).join("")}
document.addEventListener("click",e=>{const b=e.target.closest("[data-make]");if(b)openMake(b.dataset.make)});
$("#td-pipe").addEventListener("click",async e=>{const b=e.target.closest("[data-nx]");if(!b)return;const id=b.dataset.id,a=b.dataset.nx;
  if(a==="one"){openMake(id,"outline");return oneClick($("#mk-one"))}
  if(a==="vo")return openMake(id,"voice");
  b.disabled=true;await advance(id,a)});

$("#td-new").addEventListener("click",()=>{store.set("mk","");const w=work("");w.topic="";w.titles=[];w.thumb="";w.hook="";w.pick="";saveWork();VD.view="list";show("make");$("#vl-new")?.focus()});

function renderLearn(){if(!$("#ln-full"))return;const up=uploads(),has=up.length>=6;$("#ln-empty").hidden=has;$("#ln-full").hidden=!has;if(!has)return;
  const n=channelNumbers(),V=up.slice(-48).filter(v=>share(v)!=null),W=900,H=260,pl=34,pr=8,pt=12,pb=28,bw=(W-pl-pr)/V.length,top=Math.max(40,Math.ceil(Math.max(...V.map(share))/10)*10),y=t=>pt+(1-t/top)*(H-pt-pb);
  $("#ln-sub").textContent=`Average share of each video watched, per upload since ${fmtShort(V[0].d)} ${V[0].d.slice(0,4)}. The dashed line is your 6 best videos (${pctTxt(n.wS)}). Hover or focus a bar for its title.`;
  let s=`<svg viewBox="0 0 ${W} ${H}" role="img" aria-label="Share of each video watched, ${V.length} upload">`;
  for(let t=0;t<=top;t+=10)s+=`<line x1="${pl}" x2="${W-pr}" y1="${y(t)}" y2="${y(t)}" stroke="var(--line)"/><text x="${pl-6}" y="${y(t)+4}" text-anchor="end" font-size="11" fill="var(--muted)" stroke="none">${t}%</text>`;
  let lastLbl=-9;V.forEach((v,i)=>{const p=share(v),c=p>=20?"var(--series)":p<10?"url(#hx)":"var(--mid)";
    s+=`<rect x="${pl+i*bw+1}" y="${y(p)}" width="${Math.max(bw-2,2)}" height="${y(0)-y(p)}" rx="3" fill="${c}" stroke="none"/><rect class="hit" data-i="${i}" x="${pl+i*bw}" y="${pt}" width="${bw}" height="${H-pt-pb}" fill="transparent" stroke="none" tabindex="0" aria-label="${esc(v.t)}: ${f1(p)}% watched"/>`;
    if(i-lastLbl>=7&&(i===0||v.d.slice(0,7)!==V[i-1].d.slice(0,7))){lastLbl=i;s+=`<text x="${pl+i*bw}" y="${H-8}" font-size="11" fill="var(--muted)" stroke="none">${BN[+v.d.slice(5,7)-1]} ${v.d.slice(2,4)}</text>`}});
  if(n.wS)s+=`<line x1="${pl}" x2="${W-pr}" y1="${y(n.wS)}" y2="${y(n.wS)}" stroke="var(--ink)" stroke-dasharray="4 4" stroke-width="1.2"/><text x="${W-pr}" y="${y(n.wS)-6}" text-anchor="end" font-size="11.5" fill="var(--ink)" stroke="none">best ${f1(n.wS)}%</text>`;
  const ch=$("#ln-chart");ch.innerHTML=s+`</svg><div class="ctip" hidden></div>`;const tip=ch.querySelector(".ctip");
  const showTip=el=>{const v=V[+el.dataset.i],box=ch.getBoundingClientRect(),b=el.getBoundingClientRect();tip.innerHTML=`<b>${esc(v.t)}</b>${fmtShort(v.d)} ${v.d.slice(0,4)} · ${f1(share(v))}% watched (${f1(avdMin(v))} min) · ${nf(v.v)} views`;tip.hidden=false;tip.style.left=Math.min(Math.max(b.left-box.left-110,0),Math.max(box.width-250,0))+"px"};
  ch.onmouseover=e=>{if(e.target.classList?.contains("hit"))showTip(e.target)};ch.onfocusin=e=>{if(e.target.classList?.contains("hit"))showTip(e.target)};ch.onmouseleave=()=>tip.hidden=true;ch.onfocusout=()=>tip.hidden=true;
  $("#ln-cards").innerHTML=`<tr><th>Upload</th><th>Watched</th><th>CTR</th><th>Impressions</th><th>Views</th><th>Grade</th><th>Lesson</th></tr>`+up.slice(-8).reverse().map(v=>{const p=share(v),cls=p>=20?"good":p<10?"bad":"";return `<tr><td><b>${esc(v.t)}</b><br><span class="muted">${fmtShort(v.d)} ${v.d.slice(0,4)}</span></td><td>${pctTxt(p)}</td><td>${pctTxt(ctrOf(v))}</td><td>${impOf(v)?nf(v.imp):"-"}</td><td>${nf(v.v)}</td><td><span class="pill ${cls}">${p>=20?"near best":p<10?"left early":"below best"}</span></td><td>${esc(lessonFor(v,n))}</td></tr>`}).join("")}

function renderPattern(){const box=$("#id-pattern-box");if(!box)return;const W=winners(),up=uploads();box.hidden=up.length<6;if(box.hidden)return;
  const thr=W.filter(v=>THREAT.test(v.t)).length,n=channelNumbers();
  $("#id-pattern-sub").textContent=`Of the 6 videos with the most views (${nf(Math.min(...W.map(v=>v.v)))} views and up): ${W.map(v=>`"${v.t}"`).join("; ")}.`;
  $("#id-pattern").innerHTML=[[`${thr} of 6`,"the title names a predator or a threat"],[range(W.map(ctrOf),x=>f1(x))+"%","CTR thumbnail"],[range(W.map(v=>v.dur/60),x=>Math.round(x))+" min","video length"],[range(W.map(share),x=>Math.round(x))+"%","share watched"]].map(([b,s])=>`<div><b>${b}</b><span>${s}</span></div>`).join("");
  const miss=up.filter(v=>!W.includes(v)&&THREAT.test(v.t)&&share(v)!=null&&share(v)<10).pop();
  $("#id-pattern-note").textContent=miss?`Topic alone is not enough: "${miss.t}" (${fmtShort(miss.d)}) matches the pattern but only ${f1(share(miss))}% is watched. That is why every idea still goes through the hook coach.`:"The idea scores below use this pattern. Topics scoring 4 or 5 are closest to your best videos."}
function patternText(){const W=winners();if(W.length<6)return "";const thr=W.filter(v=>THREAT.test(v.t)).length;
  return `${thr} of the 6 most-viewed videos frame the animal as a predator or a threat in the title (${W.map(v=>`"${v.t}"`).join("; ")}); they run ${range(W.map(v=>v.dur/60),x=>Math.round(x))} minutes`}

/* Make: one video from package to upload. Per-video work is saved under LAST.work, keyed by plan id. */
let WORK=null,workTimer=0;
// Subtitle cues are most of a video's work data, so each video keeps them under "c:<id>" and "work" stays far below the 2 MB save limit.
const cKey=id=>"c:"+(id||"free");
const saveCues=(k,W=WORK)=>remember(cKey(k),(W[k]?.pack?.acts||[]).map(a=>a?.cues||[])).catch(()=>{});
function loadWork(){const W=LAST.work?.data||{};
  for(const [k,w] of Object.entries(W)){const acts=w.pack?.acts||[],c=LAST[cKey(k)]?.data||[];
    if(acts.some(a=>a?.cues))saveCues(k,W);else acts.forEach((a,i)=>{if(a&&c[i])a.cues=c[i]})}
  return W}
const work=id=>{WORK=WORK||loadWork();const k=id||"free";return WORK[k]=WORK[k]||{}};
const workOut=()=>JSON.parse(JSON.stringify(WORK,(k,v)=>k==="cues"?undefined:v));
const flushWork=()=>{clearTimeout(workTimer);vdSoon();return remember("work",workOut()).catch(()=>{})};
const saveWork=()=>{clearTimeout(workTimer);vdSoon();workTimer=setTimeout(()=>remember("work",workOut()).catch(()=>{}),600)};
const mkId=()=>{const id=store.get("mk","");return plans().some(p=>p.id===id)?id:""};
const mkPlan=()=>plans().find(p=>p.id===mkId());
const mkW=()=>work(mkId());
const topicKey=()=>{const t=(mkW().topic||"").trim();return (t.split(/[\s,:(]+/).find(w=>w.length>=4)||t).toLowerCase()};
/* 2.5: a list of videos, then one video at a time in 12 steps. A step is done when its result is saved for that video; steps are never stored separately. */
const VD_STEPS=[["topic","Topic","Pick an animal and an angle that match your best videos."],["titles","Title & thumbnail text","Title ideas, pick one, plus the thumbnail text."],["hook","Hook (first 60 s)","The opening the viewer hears first."],["outline","Outline","Acts, beats and Google Flow prompts."],["script","Full script","The narration, ready to read aloud."],["check","Script check","Weak places where viewers may leave. Runs on your PC, no cost."],["voice","Voice over","One ElevenLabs MP3 of the whole script."],["pack","Edit pack","MP3 per act, subtitles and text files, sorted into the video folder."],["info","Infographics","Briefs for Claude with the Remotion skill."],["thumb","Thumbnail","An image with your text on top."],["seo","SEO","Description, tags and a pinned comment."],["upload","Upload checklist","Before you press Publish in YouTube Studio."]];
const VD_N=VD_STEPS.length,vdName=k=>(VD_STEPS.find(s=>s[0]===k)||[])[1]||k;
const VD_NEED={script:"outline",check:"script",voice:"script",pack:"script",info:"script"};
const VD_REVEAL={topic:"Change…",titles:"Change…",hook:"Change…",outline:"Show outline or redo…",script:"Show full script or redo…",check:"Show the check",pack:"Show edit pack",info:"Show briefs or redo…",thumb:"Show thumbnails or redo…",seo:"Show SEO package or redo…",upload:"Show checklist"};
const VD_WHERE={outline:["03 Images",1],script:["01 Script",1],voice:["02 Narration"],pack:["02 Narration, 01 Script, 03 Images, 05 Infographics and 07 Upload"],info:["05 Infographics",1],thumb:["06 Thumbnail"],seo:["07 Upload",1]};
const VD_FOLDERS=[["01 Script","The script, from the edit pack"],["02 Narration","Voice over takes, MP3 per act, subtitles"],["03 Images","Flow prompts; your images",1],["04 Video clips","Veo clips; your Flow clips",1],["05 Infographics","Briefs; your Remotion renders",1],["06 Thumbnail","From the Thumbnail step"],["07 Upload","Title, description, tags"],["08 Premiere","Your project and exports",1]];
const VD_IC={next:'<svg viewBox="0 0 14 14"><path d="M2.5 7h9M8 3.5 11.5 7 8 10.5"/></svg>',cal:'<svg viewBox="0 0 14 14"><rect x="1.5" y="2.5" width="11" height="10" rx="1.5"/><path d="M1.5 6h11M4.5 1v3M9.5 1v3"/></svg>',doc:'<svg viewBox="0 0 14 14"><path d="M3 1.5h5l3 3v8H3z"/><path d="M5 7.5h4M5 10h4"/></svg>',mic:'<svg viewBox="0 0 14 14"><rect x="5" y="1.5" width="4" height="7" rx="2"/><path d="M3 7a4 4 0 0 0 8 0M7 11v2"/></svg>',dir:'<svg viewBox="0 0 14 14"><path d="M1.5 3.5a1 1 0 0 1 1-1H6l1.5 1.5h4a1 1 0 0 1 1 1v5.5a1 1 0 0 1-1 1h-9a1 1 0 0 1-1-1z"/></svg>',ok:'<svg viewBox="0 0 14 14"><path d="m2.5 7.5 3 3 6-6.5"/></svg>'};
const STAGE_MAP={pkg:"titles",hook:"hook",script:"script",seo:"seo"},PUB_KEYS=["t60","thumb","tc","desc","end","pin","time","comm"];
const VD={view:"list",step:"",open:null,loaded:null,q:"",f:"all",job:""},VF={},VFP={};
const VD_EMPTY={};["#o-script","#o-seo","#o-thumb"].forEach(s=>VD_EMPTY[s]=$(s).innerHTML);
const stamp=(w,...ks)=>{w.at={...(w.at||{})};for(const k of ks)w.at[k]=Date.now()};
const msOf=t=>!t?0:t<1e12?t*1000:t;
const vdWhen=t=>t?new Date(t).toLocaleString("en-US",{month:"short",day:"numeric",hour:"2-digit",minute:"2-digit",hourCycle:"h23"}):"";
const vdDay=t=>t?new Date(t).toLocaleDateString("en-US",{month:"short",day:"numeric"}):"";
const vdIn=d=>d<0?`${-d} day${d===-1?"":"s"} past due`:d===0?"today":d===1?"tomorrow":`in ${d} days`;
const plural=(n,w)=>`${nf(n)} ${w}${n===1?"":"s"}`;
const takesOf=id=>[...(work(id).takes||[])].sort((a,b)=>(b.at||0)-(a.at||0));
const takeInUse=id=>{const l=takesOf(id);return l.find(t=>t.file===work(id).inuse)||l[0]||null};
const setH=(el,h)=>{if(el&&el._h!==h){el._h=h;el.innerHTML=h}};
// A redraw must not drop an open claude.ai paste box: the old status line and box move into the new markup.
const keepPaste=(id,draw)=>{const o=document.getElementById(id),b=o?.nextElementSibling?.classList.contains("manual")?o.nextElementSibling:null;draw();
  const n=b&&document.getElementById(id);if(n&&n!==o){n.replaceWith(o);o.after(b)}};
let vdT=0;const vdSoon=()=>{clearTimeout(vdT);vdT=setTimeout(()=>{if(!$("#p-make").hidden)renderMake()},120)};
function packDone(id,n){const p=work(id).pack;if(!p?.done||!n)return false;return pkActs(n).every((a,i)=>p.acts?.[i]?.sig===pkHash([CFG.eleven_voice,CFG.eleven_model,a.text].join("|")))}
// Everything a step list needs, read from what is saved for this one video.
function vdInfo(id){const p=plans().find(x=>x.id===id),w=work(id),n=narrOf(id),o=outlineOf(id),A=w.at||{},R={},nT=narrText(n),words=wordsOf(nT),tk=takesOf(id),u=takeInUse(id);
  const r=(...a)=>a.filter(Boolean).join(" · ");
  if((w.topic||"").trim())R.topic=r(w.topic.trim(),vdDay(A.topic));
  if(w.pick&&(w.thumb||"").trim())R.titles=r("Picked: "+w.pick,vdDay(A.titles));
  const hw=wordsOf(w.hook);if(hw)R.hook=r(`${Math.round(hw/140*60)} s`,vdDay(A.hook));
  if(o?.acts?.length)R.outline=r(plural(o.acts.length,"act"),vdDay(LAST[oKey(id)]?.at));
  if(words)R.script=r(plural(words,"word"),vdWhen(LAST[nKey(id)]?.at));
  // A check with places left is only done once the owner pressed Leave it.
  if(words&&w.check?.sig===pkHash(nT)&&(!w.check.fails||w.check.leave===w.check.sig))R.check=r(`${w.check.score} / 10`,w.check.fails?plural(w.check.fails,"place")+" to fix":"nothing to fix",vdWhen(w.check.at));
  if(tk.length)R.voice=r((u?.seconds?pkClock(u.seconds)+" ":"")+"MP3",vdWhen(u?.at),plural(tk.length,"take"));
  if(packDone(id,n))R.pack=r(plural(w.pack.files?.length||0,"file"),vdWhen(w.pack.done));
  if(w.briefs?.list?.length)R.info=r(plural(w.briefs.list.length,"brief"),vdDay(w.briefs.at));
  const tf=VF[id]?.folders?.find(x=>x.name==="06 Thumbnail")?.files||0;if((p&&thumbUrl(p))||tf)R.thumb=r(p&&thumbUrl(p)?"In calendar":plural(tf,"file")+" in 06 Thumbnail",vdDay(p?.tat||A.thumb));
  if(w.seo?.description||w.seo?.titles)R.seo=r(plural((w.seo.tags||[]).length,"tag"),vdDay(w.seo.at));
  const ticked=PUB_KEYS.filter(k=>w.pub?.[k]).length;if(p?.status==="tayang"||ticked===PUB_KEYS.length)R.upload=p?.status==="tayang"?r("Published",fmtShort(p.date)):r("All 8 ticked",vdWhen(A.upload));
  const next=VD_STEPS.map(s=>s[0]).find(k=>!R[k])||"";
  return {p,w,n,o,R,next,count:Object.keys(R).length,words,tk,u,ticked}}
const vdTile=(hot,ic,label,big,ft)=>`<div class="vd-tile${hot?" hot":""}"><div class="vd-th"><span>${label}</span><span class="vd-ic" aria-hidden="true">${VD_IC[ic]}</span></div><div class="vd-big">${big}</div><div class="vd-ft">${ft}</div></div>`;
const vdBar=(n,cls)=>`<div class="vd-track${cls?" "+cls:""}" role="img" aria-label="${n} of ${VD_N} steps done"><i style="width:${(n/VD_N*100).toFixed(1)}%"></i></div>`;

function openMake(id,stage){if(!id)id=mkId()||plans().filter(p=>p.type!=="post"&&p.status!=="tayang")[0]?.id||"";
  if(!id||!plans().some(p=>p.id===id)){VD.view="list";show("make");return}
  if(VD.view!=="detail"||store.get("mk","")!==id||$("#p-make").hidden)VD.focus=true;
  store.set("mk",id);VD.view="detail";VD.step=STAGE_MAP[stage]||stage||"";VD.open=null;show("make")}
function mkStage(s){VD.step=STAGE_MAP[s]||s;VD.open=null;if(mkPlan())VD.view="detail"}
function renderMake(){if(VD.view==="detail"&&mkPlan())renderDetail();else{VD.view="list";renderList()}}

function renderList(){$("#vl").hidden=false;$("#vd").hidden=true;
  const today=isoDay(new Date()),all=plans().filter(p=>p.type!=="post"),I=Object.fromEntries(all.map(p=>[p.id,vdInfo(p.id)])),live=all.filter(p=>p.status!=="tayang");
  $("#vl-empty").hidden=!!all.length;$("#vl-card").hidden=$("#vl-tiles").hidden=!all.length;
  const up=live.filter(p=>p.date>=today)[0]||live[0],left=live.reduce((a,p)=>a+VD_N-I[p.id].count,0),doneN=live.reduce((a,p)=>a+I[p.id].count,0);
  const made=all.filter(p=>I[p.id].tk.length).length,takes=all.reduce((a,p)=>a+I[p.id].tk.length,0),week=live.filter(p=>daysBetween(today,p.date)<=7).length;
  setH($("#vl-tiles"),(up?vdTile(1,"next","Next upload",`${esc(fmtShort(up.date))} <small>${vdIn(daysBetween(today,up.date))}</small>`,`<span class="vd-delta">${I[up.id].count}/${VD_N}</span><span class="vd-ell">${esc(up.title)}</span>`):vdTile(1,"next","Next upload",`– <small>nothing planned</small>`,"Press New video to start one"))
    +vdTile(0,"cal","In progress",`${live.length} <small>video${live.length===1?"":"s"}</small>`,`${week} due in the next 7 days`)
    +vdTile(0,"ok","Steps left",`${left} <small>of ${live.length*VD_N}</small>`,`<span class="vd-delta ok">${doneN}</span> steps done`)
    +vdTile(0,"mic","Voice overs",`${made} <small>made</small>`,takes?`${plural(takes,"take")} kept, newest in use`:"None yet"));
  const q=VD.q.trim().toLowerCase(),f=VD.f;
  let rows=all.filter(p=>f==="done"?p.status==="tayang":p.status!=="tayang").filter(p=>f!=="week"||daysBetween(today,p.date)<=7).filter(p=>!q||(p.title||"").toLowerCase().includes(q)||(work(p.id).topic||"").toLowerCase().includes(q));
  if(f==="done")rows=rows.reverse();
  $("#vl-h").textContent=f==="done"?"Published videos":"Videos in progress";
  setH($("#vl-rows"),rows.length?rows.map(p=>{const x=I[p.id],late=p.status!=="tayang"&&p.date<today,ini=((work(p.id).topic||p.title||"?").trim()[0]||"?").toUpperCase();
    return `<tr data-vid="${esc(p.id)}"><td class="vd-mono">${esc(p.date)}</td><td><div class="vd-name"><span class="vd-av" aria-hidden="true">${esc(ini)}</span><button type="button" class="vd-open" data-vid-open="${esc(p.id)}">${esc(p.title)}</button></div></td><td><div class="vd-pcell">${vdBar(x.count,"sm")}<span>${x.count}/${VD_N}</span></div></td><td><span class="pill st-${esc(p.status)}">${esc(STATUS_LABEL[p.status]||p.status)}</span></td><td>${x.next?esc(vdName(x.next)):"All done"}${late?` <span class="vd-late">past due</span>`:""}</td><td><button type="button" class="btn ghost sm" data-plan-id="${esc(p.id)}" aria-label="Edit plan: ${esc(p.title)}">Edit plan</button></td></tr>`}).join("")
    :`<tr><td colspan="6" class="vd-none">${q?"No video matches your search.":f==="done"?"Videos you mark as published show up here.":f==="week"?"Nothing is due in the next 7 days.":"Nothing in progress. Press New video to start one."}</td></tr>`);
  renderMigCard();vdMigCheck()}

function vdLoad(id){VD.loaded=id;VD.job="";VD.said="";const p=plans().find(x=>x.id===id),w=work(id);
  if(!w.topic&&p)w.topic=p.title.split(/[:,]/)[0].trim();
  $("#mk-topic").value=w.topic||"";$("#mk-titles").value=(w.titles||(p?[p.title]:[])).join("\n");$("#mk-thumbtext").value=w.thumb||"";$("#mk-hook").value=w.hook||"";
  const t=w.pick||p?.title||w.topic||"";["#script-topic","#seo-topic","#thumb-topic","#shorts-topic"].forEach(s=>{$(s).value=t});$("#thumb-title").value=w.pick||"";
  $("#mk-done").hidden=!p;
  ["#s-auto","#s-titles","#s-hook","#s-script","#s-scriptfull","#s-vo","#s-gen","#s-thumb","#s-seo","#s-done","#vd-job","#s-folder"].forEach(s=>{const el=$(s);if(el){el.className="status";el.textContent=""}});
  if(p?.status==="tayang")$("#s-done").textContent="This video is already marked as published.";
  if(!PK.run){PK.msg="";PK.err=false}if(!KC.run)KC={...KC,ask:"",msg:""};IG={msg:"",err:false,show:0};PEEK="";
  const o=outlineOf(id);if(o?.acts?.length)renderScript(o);else{lastOutline=null;$("#o-script").innerHTML=VD_EMPTY["#o-script"]}
  const n=narrOf(id);if(n?.narration?.length)renderScriptFull(n);else vdNoNarr();
  if(w.seo?.titles)renderSEO(w.seo);else $("#o-seo").innerHTML=VD_EMPTY["#o-seo"];
  if(w.flowThumb?.list?.length)renderThumb(w.flowThumb.list);else $("#o-thumb").innerHTML=VD_EMPTY["#o-thumb"];
  if(w.hooks?.length)renderHooks(w.hooks);else $("#o-hook").innerHTML="";
  renderAuto();renderTitles();renderThumbPrev();renderGen();renderRules();renderPub();
  ensureFolder(id).then(()=>vdTakes(id)).then(()=>{if(mkId()===id)vdSoon()})}
function vdNoNarr(){lastNarr=null;setRunTxt($("#script-full-btn"),"Write full narration script");$("#o-scriptfull").innerHTML=`<div class="empty">The full narration appears here, written act by act from the outline.</div>`;
  const msg=(h,t)=>`<span class="layer">${h}</span><p class="note">${t}</p>`;
  $("#sc-box").innerHTML=msg("Script check","The check reads the full script, so write that first. It runs on your PC and costs nothing.");
  $("#pk-box").innerHTML=msg("Edit pack for Premiere","The edit pack is made from the full script: one MP3 per act, subtitles and the text files. Write the full script first.");
  $("#ig-box").innerHTML=msg("Infographics with Claude","The app finds the infographic moments in the full script, so write that first.");
  voTool(null)}

function renderDetail(){const id=mkId(),p=mkPlan();$("#vl").hidden=true;$("#vd").hidden=false;markPick();
  if(VD.loaded!==id)vdLoad(id);
  const I=vdInfo(id),{w,R,tk,u}=I,today=isoDay(new Date());
  if(!VD_STEPS.some(s=>s[0]===VD.step)){VD.step=I.next||"upload";VD.open=null}
  const k=VD.step,done=!!R[k];if(VD.open===null)VD.open=!done;
  $("#vd-h").textContent=p.title;
  $("#vd-sub").textContent=`Upload ${new Date(p.date+"T12:00:00").toLocaleDateString("en-US",{weekday:"short",month:"short",day:"numeric"})} · ${vdIn(daysBetween(today,p.date))}`;
  setH($("#vd-pill"),`<span class="pill st-${esc(p.status)}">${esc(STATUS_LABEL[p.status]||p.status)}</span>`);
  const F=VF[id],files=F&&!F.error?F.total:null,used=files!=null?F.folders.filter(x=>x.files+(x.older||0)>0).length:0,c=w.check,ci=tk.indexOf(u);
  setH($("#vd-tiles"),`<div class="vd-tile hot"><div class="vd-th"><span>Next step</span><span class="vd-ic" aria-hidden="true">${VD_IC.next}</span></div><div class="vd-big vd-bn">${esc(I.next?vdName(I.next):"All done")}</div><div class="vd-ft"><button type="button" class="vd-go" data-vs-go="${I.next||"upload"}">${I.next?"Do it now":"Open checklist"}</button></div></div>`
    +vdTile(0,"doc","Script",I.words?`${nf(I.words)} <small>words</small>`:`– <small>not yet</small>`,c?.sig===pkHash(narrText(I.n))?`<span class="vd-delta">${c.score}/10</span> script check`:I.words?"Script check not run yet":"Comes after the outline")
    +vdTile(0,"mic","Voice over",u?`${u.seconds?pkClock(u.seconds):"–"} <small>min</small>`:`– <small>not yet</small>`,u?`${plural(tk.length,"take")} · ${ci===0?"newest in use":`take ${tk.length-ci} in use`}`:"Comes after the script")
    +vdTile(0,"dir","Folder",files!=null?`${files} <small>file${files===1?"":"s"}</small>`:`– <small>no folder</small>`,files!=null?`${used} of 8 folders used`:F?.error?esc(F.error):"Made when the video opens"));
  $("#vd-n").textContent=`${I.count} of ${VD_N}`;$("#vd-left").textContent=I.count===VD_N?"All done. Ready to upload.":`${VD_N-I.count} left before upload`;
  $("#vd-bar").style.width=(I.count/VD_N*100).toFixed(1)+"%";$("#vd-bar-l").setAttribute("aria-label",`${I.count} of ${VD_N} steps done`);
  const fo=document.activeElement?.closest?.("#vd-steps")?document.activeElement.dataset.vs:null;
  setH($("#vd-steps"),VD_STEPS.map(([s,t],i)=>{const st=R[s]?"done":s===I.next?"next":"todo";return `<li><button type="button" class="vd-st is-${st}" data-vs="${s}"${s===k?' aria-current="step"':""}><i aria-hidden="true">${st==="done"?"✓":i+1}</i><b>${esc(t)}</b><small>${st==="done"?esc(R[s]):s==="voice"&&VO_RUN.has(id)?"Being made…":st==="next"?"Next":"Not started"}</small><span class="sr">, ${st==="done"?"done":st==="next"?"next step":"not started"}</span></button></li>`}).join(""));
  if(fo&&document.activeElement===document.body)$(`#vd-steps [data-vs="${fo}"]`)?.focus();
  const ae=document.activeElement,hf=ae?.closest?.("#vd-head")?ae.id||"vd-step-h":"";
  setH($("#vd-head"),vdHead(I,k));
  if(hf&&(!document.activeElement||document.activeElement===document.body))(document.getElementById(hf)||$("#vd-step-h"))?.focus();
  const say=`${vdName(k)}, ${done?"done":k===I.next?"next step":"not started"}`;if(VD.said!==say){VD.said=say;$("#vd-say").textContent=say}
  const rb=$("#vd-head [data-vd-open]");if(rb){rb.textContent=VD.open?"Hide":rb.dataset.label;rb.setAttribute("aria-expanded",VD.open)}
  $("#vo-again-btn")?.setAttribute("aria-expanded",VD.open);
  document.querySelectorAll("#vd-pane [data-tool]").forEach(el=>el.hidden=el.dataset.tool!==k||(done&&!VD.open));
  $("#vo-again").hidden=!(k==="voice"&&done);$("#vo-box").hidden=k==="voice"&&done;
  if(k==="voice"&&done)$("#vo-again-t").textContent=vdAgainText(I);
  const wh=VD_WHERE[k];$("#vd-where").innerHTML=wh&&w.folder&&!(k==="voice"&&done)?(wh[1]?`Goes into <b>${esc(wh[0])}</b> when the edit pack is made.`:`Saved in <b>${esc(wh[0])}</b>.`):"";
  const job=$("#vd-job");if(VD.job&&VD.job===k){job.textContent="";VD.job=""}
  vdFolderCard(id);
  if(VD.focus){VD.focus=false;$("#vd-h").focus()}}
function vdHead(I,k){const [,t,d]=VD_STEPS.find(s=>s[0]===k),{w,p,n,o,R}=I,done=!!R[k],nx=k===I.next;
  let h=`<span class="vd-state ${done?"is-ok":nx?"is-next":"is-todo"}">${done?"✓ Done":nx?"Next step":"Not started"}</span><h3 class="vd-step-h" id="vd-step-h" tabindex="-1">${esc(t)}</h3>`;
  if(!done){h+=`<p class="sub">${esc(d)}</p>`;const need=VD_NEED[k];if(need&&!R[need])h+=`<p class="vd-need">Comes after <b>${esc(vdName(need))}</b>, which is not done yet. <button type="button" class="linkish" data-vs-go="${need}">Go to ${esc(vdName(need))}</button></p>`;return h}
  const F=[],act=[];let extra="";const fact=(a,b)=>F.push([a,b]);
  if(k==="topic"){fact("Topic",w.topic.trim());fact("Upload",fmtShort(p.date))}
  else if(k==="titles"){fact("Title",w.pick);fact("Thumbnail text",w.thumb.trim());fact("Title length",plural(w.pick.length,"character"))}
  else if(k==="hook"){const hw=wordsOf(w.hook);fact("Words",nf(hw));fact("Read aloud",`about ${Math.round(hw/140*60)} s`);extra=`<div class="vd-peek">${esc(w.hook.trim())}</div>`;act.push(`<button type="button" class="btn ghost" data-vd-copy="hook">Copy</button>`)}
  else if(k==="outline"){const sum=o.acts.reduce((a,x)=>a+(+x.words||0),0),fl=o.acts.reduce((a,x)=>a+(x.flow_prompts||[]).filter(Boolean).length,0);fact("Acts",String(o.acts.length));fact("Planned words",nf(sum));fact("Flow prompts",String(fl));if(o.cold_open)extra=`<div class="vd-peek">${esc(o.cold_open)}</div>`}
  else if(k==="script"){fact("Words",nf(I.words));fact("Read aloud",`about ${Math.round(I.words/140)} min`);fact("Written",vdWhen(LAST[nKey(p.id)]?.at)||"–");extra=`<div class="vd-peek">${esc(narrText(n).slice(0,420))}…</div>`;act.push(`<button type="button" class="btn ghost" data-vd-copy="script">Copy script</button>`)}
  else if(k==="check"){fact("Score",`${w.check.score} / 10`);fact("Places to fix",String(w.check.fails||0));fact("Checked",vdWhen(w.check.at))}
  else if(k==="voice")return h+vdVoiceHead(I);
  else if(k==="pack"){const pk=w.pack,secs=pk.acts.reduce((a,x)=>a+(x?.seconds||0),0);fact("Files",String(pk.files?.length||0));fact("Voice per act",`${plural(pk.acts.length,"file")}, ${pkLong(secs)}`);fact("Made",vdWhen(pk.done));act.push(`<button type="button" class="btn" data-vd-folder="">Open folder</button>`,`<button type="button" class="btn ghost" data-ed-open="${esc(p.id)}">Open in Editing <span aria-hidden="true">&rarr;</span></button>`)}
  else if(k==="info"){fact("Briefs",String(w.briefs.list.length));fact("Found",vdWhen(w.briefs.at)||"–")}
  else if(k==="thumb"){const tu=thumbUrl(p);fact("In calendar",p.tfile&&vFolder(p.id)?p.tfile:p.thumb?"A file from your computer":"Not set yet");fact("Chosen by",!tu?"Nobody yet":thumbMine(p)?"You":"Newest saved file");if(tu&&p.tat)fact("Saved",vdWhen(p.tat));if(tu)extra=`<img class="vd-thumb" src="${tu}" alt="The thumbnail in the calendar">`;if(w.folder)act.push(`<button type="button" class="btn" data-vd-folder="06 Thumbnail">Open folder</button>`)}
  else if(k==="seo"){fact("Main keyword",w.seo.keywords?.primary||"–");fact("Tags",String((w.seo.tags||[]).length));fact("Made",vdWhen(w.seo.at)||"–");act.push(`<button type="button" class="btn ghost" data-vd-copy="desc">Copy description</button>`)}
  else if(k==="upload"){fact("Checklist",`${I.ticked} of ${PUB_KEYS.length} ticked`);fact("Status",STATUS_LABEL[p.status]||p.status)}
  return h+`<div class="vd-facts">${F.map(([a,b])=>`<div><small>${esc(a)}</small><b>${esc(b)}</b></div>`).join("")}</div>${extra}<div class="chips">${act.join("")}<button type="button" class="btn ghost" data-vd-open data-label="${esc(VD_REVEAL[k])}">${esc(VD_REVEAL[k])}</button></div>`}
function vdVoiceHead(I){const {tk,u}=I,n=tk.length,run=VO_RUN.has(I.p?.id);
  return `<div class="vd-facts"><div><small>Length</small><b>${u.seconds?pkClock(u.seconds):"–"}</b></div><div><small>Made</small><b>${esc(vdWhen(u.at))}</b></div><div><small>Characters used</small><b>${u.chars?nf(u.chars):"–"}</b></div></div>
  <audio class="vd-audio" controls preload="metadata" src="${esc(u.url)}" aria-label="Voice over, take ${n-tk.indexOf(u)}"></audio>
  <div class="vd-takes" role="group" aria-label="Takes, newest first. Pick one to use it."><span>Takes:</span>${tk.map((t,i)=>`<button type="button" data-take="${esc(t.file)}" aria-pressed="${t===u}" title="${esc(t.file)}">${n-i} · ${esc(new Date(t.at).toLocaleTimeString("en-US",{hour:"2-digit",minute:"2-digit",hourCycle:"h23"}))}${new Date(t.at).toDateString()===new Date().toDateString()?"":", "+esc(vdDay(t.at))}<span class="sr">${t===u?", in use":""}</span></button>`).join("")}</div>
  <p class="note">${n>1?"The newest take is used unless you pick another. Older takes stay in 02 Narration, in the folder older takes. Nothing is deleted.":"Saved in 02 Narration of this video's folder."}</p>
  <div class="chips"><button type="button" class="btn" data-vd-folder="02 Narration">Open folder</button><button type="button" class="btn ghost" id="vo-again-btn" aria-controls="vo-again"${run?" disabled":""}>${run?"A new take is being made…":"Make again…"}</button></div>`}
function vdAgainText(I){const {tk,u,n}=I,c=narrText(n).length,days=[...new Set(tk.map(t=>vdDay(t.at)))],ci=tk.indexOf(u);
  return `Making it again uses about ${nf(c)} ElevenLabs characters. You made it ${tk.length===1?"once":tk.length+" times"}${days.length===1?" on "+days[0]:`, between ${days[days.length-1]} and ${days[0]}`}; ${ci===0?"the newest one is in use":`take ${tk.length-ci} is in use`}. A new take becomes the one in use, and the others are kept.`}
function vdFolderCard(id){const F=VF[id];
  if(!F||F.error){$("#vd-path").textContent=F?.error||"The folder is made when the video opens.";setH($("#vd-folders"),"");$("#vd-fsum").textContent="";return}
  $("#vd-path").textContent=F.dir;const used=F.folders.filter(x=>x.files+(x.older||0)>0).length;$("#vd-fsum").innerHTML=`<b>${used}</b> with files`;
  setH($("#vd-folders"),VD_FOLDERS.map(([name,lim,drop])=>{const f=F.folders.find(x=>x.name===name)||{files:0},c=f.files,o=f.older||0,has=c+o>0;
    return `<li><button type="button" class="vd-fd" data-sub="${esc(name)}"><span class="vd-fd-h"><span class="vd-av sm${has?" on":""}" aria-hidden="true">${esc(name.slice(0,2))}</span><span><span class="sr">Open </span>${esc(name.slice(3))}</span></span><span class="vd-n">${c} <small>file${c===1?"":"s"}${o?` · ${o} older`:""}</small></span><span class="vd-lim">${esc(lim)}</span>${has?`<span class="vd-has">Has files</span>`:drop?`<span class="vd-drop">Drop here</span>`:`<span class="vd-emp">Empty</span>`}</button></li>`}).join(""))}
// The server names the folder; the app only keeps the name it was given.
async function ensureFolder(id){const p=plans().find(x=>x.id===id);if(!id||!p)return "";const w=work(id);
  if(VFP[id])return VFP[id];
  VFP[id]=(async()=>{const j=await pkPost("/api/video/folder",w.folder?{name:w.folder}:{title:p.title,date:p.date,new:true});
    if(j.error||!j.name){VF[id]={error:j.error||"The video folder could not be made."};return w.folder||""}
    VF[id]=j;if(w.folder!==j.name){w.folder=j.name;await flushWork()}return j.name})();
  try{return await VFP[id]}finally{delete VFP[id]}}
function vdApplyTakes(id,j){const w=work(id),old=w.takes||[],by=Object.fromEntries(old.map(t=>[t.file,t]));
  const list=(j.takes||[]).map(t=>({file:t.file,at:msOf(t.at),seconds:t.seconds??by[t.file]?.seconds??null,chars:by[t.file]?.chars??null,url:t.url,where:t.where}));
  const loose=old.filter(t=>t.where==="downloads"&&!list.some(x=>x.file===t.file));
  w.takes=[...list,...loose];w.inuse=j.inuse||[...loose].sort((a,b)=>b.at-a.at)[0]?.file||null;saveWork()}
async function vdTakes(id){const w=work(id);if(!w.folder)return;const j=await pkPost("/api/video/takes",{name:w.folder});if(!j.error)vdApplyTakes(id,j)}
async function vdPickTake(file){const id=mkId(),w=mkW(),t=(w.takes||[]).find(x=>x.file===file),job=$("#vd-job");if(!t||t.file===takeInUse(id)?.file)return;
  if(t.where!=="downloads"&&w.folder){const j=await pkPost("/api/video/take",{name:w.folder,file});if(j.error){job.className="status err";job.textContent=j.error;return}vdApplyTakes(id,j);ensureFolder(id).then(vdSoon)}
  else{w.inuse=file;saveWork()}
  renderDetail();$(`[data-take="${CSS.escape(file)}"]`)?.focus();job.className="status";job.textContent=`Take ${takesOf(id).length-takesOf(id).indexOf(takeInUse(id))} is now the voice over in use.`}
function vdSelect(k,toHead){VD.step=k;VD.open=null;renderDetail();
  if(k==="check"&&lastNarr)scRender(lastNarr);
  const pane=$("#vd-pane"),m=$("#main"),r=pane.getBoundingClientRect(),mr=m.getBoundingClientRect(),top=mr.top+($(".topbar")?.offsetHeight||0);
  if(r.top<top||r.top>mr.bottom-120)m.scrollTop+=r.top-top-8;
  if(toHead)$("#vd-step-h")?.focus()}
// A one-click chain moves the pane along with it, but only when Sigit is still watching the step before.
function vdFollow(id,from,to){if(VD.view==="detail"&&mkId()===id&&!$("#p-make").hidden&&[].concat(from).includes(VD.step)){VD.step=to;VD.open=true;renderDetail()}}
function vdCheckSave(id,f,c){const w=work(id),sig=pkHash(narrText(f)),fails=c.findings.filter(x=>!x.ok).length;if(w.check?.sig===sig&&w.check.score===c.score&&w.check.fails===fails)return;w.check={...w.check,score:c.score,fails,sig,at:Date.now()};saveWork()}
function vdCheckSeen(f,c){if(VD.view==="detail"&&VD.step==="check"&&!$("#p-make").hidden&&f===lastNarr)vdCheckSave(mkId(),f,c)}
async function vdCopy(text,b){const done=()=>{const l=b.textContent;b.textContent="Copied";setTimeout(()=>b.textContent=l,1500)};try{await navigator.clipboard.writeText(text);done()}catch{b.textContent="Copy failed"}}
// Status lines of the topic and outline steps also show above the steps while another step is open.
(()=>{const src={"s-auto":"topic","s-script":"outline"};const mo=new MutationObserver(ms=>{const el=ms[ms.length-1].target.closest?.(".status")||ms[ms.length-1].target.parentElement;if(!el||!src[el.id]||VD.view!=="detail"||VD.step===src[el.id])return;const job=$("#vd-job");job.className=el.className;job.textContent=el.textContent;VD.job=src[el.id]});
  Object.keys(src).forEach(id=>mo.observe(document.getElementById(id),{childList:true,characterData:true,subtree:true}))})();
document.addEventListener("click",e=>{const g=e.target.closest("[data-vd-go]");if(g)vdSelect(g.dataset.vdGo,true)});
$("#vd").addEventListener("click",async e=>{const t=e.target;let b;
  if((b=t.closest("[data-vs]")))return vdSelect(b.dataset.vs);
  if((b=t.closest("[data-vs-go]")))return vdSelect(b.dataset.vsGo,true);
  if((b=t.closest("[data-vd-open]"))){VD.open=!VD.open;renderDetail();return}
  if((b=t.closest("[data-take]")))return vdPickTake(b.dataset.take);
  if((b=t.closest("#vo-again-btn"))){VD.open=true;renderDetail();$("#vo-again-no")?.focus();return}
  if((b=t.closest("#vo-again-no"))){VD.open=false;renderDetail();$("#vo-again-btn")?.focus();return}
  if((b=t.closest("#vo-again-yes"))){const j=await makeVoice(b,true);if(j){renderDetail();$("#vo-again-btn")?.focus()}return}
  if((b=t.closest("[data-vd-copy]"))){const w=mkW(),k=b.dataset.vdCopy,n=narrOf(mkId());return vdCopy(k==="hook"?w.hook.trim():k==="desc"?w.seo?.description||"":(n?.narration||[]).map((p,i)=>`[${p.act||"Act "+(i+1)}]\n${p.text}`).join("\n\n"),b)}
  const sub=(b=t.closest("[data-vd-folder],[data-sub],#vd-fopen"))?b.dataset.vdFolder??b.dataset.sub??"":null;
  if(sub!==null){const name=await ensureFolder(mkId()),st=$("#s-folder");if(!name){st.className="status err";st.textContent=VF[mkId()]?.error||"The video folder could not be made.";return}
    const r=await pkPost("/api/video/open",{name,...(sub?{sub}:{})});st.className=r.error?"status err":"status";st.textContent=r.error||`Opened ${sub||"the video folder"} in Explorer.`;return}
  if(t.closest("#vd-back")){const id=mkId();VD.view="list";renderMake();$("#main").scrollTop=0;$(`[data-vid-open="${CSS.escape(id)}"]`)?.focus()}});
$("#vl-rows").addEventListener("click",e=>{if(e.target.closest("[data-plan-id]"))return;const r=e.target.closest("[data-vid]");if(r)openMake(r.dataset.vid)});
$("#vl-q").addEventListener("input",e=>{VD.q=e.target.value;renderList()});
$("#vl-seg").addEventListener("click",e=>{const b=e.target.closest("[data-vf]");if(!b)return;VD.f=b.dataset.vf;$("#vl-seg").querySelectorAll("button").forEach(x=>x.setAttribute("aria-pressed",x===b));renderList()});
async function vdNew(btn){const st=$("#s-vl");store.set("mk","");Object.assign(work(""),{topic:"",titles:[],thumb:"",hook:"",pick:""});
  const id=await autoFill(btn,true,st);if(!id)return;const note=st.textContent;st.textContent="";openMake(id);const job=$("#vd-job");job.className="status";job.textContent=note}
$("#vl-new").addEventListener("click",e=>vdNew(e.currentTarget));$("#vl-new2").addEventListener("click",e=>vdNew(e.currentTarget));

/* Results that 2.4 kept once for the whole app move into the video they belong to. The old copies stay in place. */
async function vdMigrateLast(){if(LAST.m25)return;const P=plans().filter(p=>p.type!=="post");if(!P.length)return;
  const norm=s=>String(s||"").trim().toLowerCase(),has=id=>P.some(p=>p.id===id),done={};
  const byTitle=t=>{t=norm(t);if(!t)return null;const hit=P.filter(p=>{const w=work(p.id);return [p.title,w.pick,...(w.titles||[])].some(x=>norm(x)===t)});return hit.length===1?hit[0].id:null};
  const sf=LAST.scriptfull,ol=LAST.script,vo=LAST.vo,seo=LAST.seo,th=LAST.thumb;let nid=null;
  if(sf?.data?.narration?.length){nid=has(sf.data.planId)?sf.data.planId:byTitle(sf.data.title);if(nid&&!LAST[nKey(nid)]){await remember(nKey(nid),{...sf.data,planId:nid},sf.at);done.scriptfull=nid}}
  if(ol?.data?.acts?.length){const oid=byTitle(ol.data.title)||(nid&&norm(ol.data.title)===norm(sf.data.title)?nid:null);if(oid&&!LAST[oKey(oid)]){await remember(oKey(oid),ol.data,ol.at);done.script=oid}}
  if(vo?.data?.file){const vid=nid&&norm(vo.data.title)===norm(sf.data.title)?nid:byTitle(vo.data.title);if(vid){const w=work(vid);w.takes=w.takes||[];if(!w.takes.some(t=>t.file===vo.data.file)){w.takes.push({file:vo.data.file,at:vo.at,chars:vo.data.chars||null,seconds:vo.data.seconds??null,url:"/api/audio/"+encodeURIComponent(vo.data.file),where:"downloads"});w.inuse=w.inuse||vo.data.file}done.vo=vid}}
  // 2.4 kept SEO only globally and gave it to the edit pack of the narration written before it.
  if(seo?.data?.titles){const sid=P.find(p=>{const s=work(p.id).seo;return s?.description&&s.description===seo.data.description})?.id||seo.data.titles.map(t=>byTitle(t?.text??t)).find(Boolean)||(nid&&seo.at>sf.at?nid:null);if(sid&&!work(sid).seo?.titles){work(sid).seo={...seo.data,at:seo.at};done.seo=sid}}
  if(th?.data?.concepts?.length){const tid=P.find(p=>work(p.id).gen?.concepts?.[0]?.name===th.data.concepts[0].name)?.id;if(tid&&!work(tid).flowThumb){work(tid).flowThumb={at:th.at,list:th.data.concepts};done.thumb=tid}}
  await flushWork();await remember("m25",{done})}

/* Files from before 2.5 (voice overs loose in Downloads, flat edit pack folders) move into the video folders after one click. */
let MIG=null;
async function vdMigCheck(){if(MIG||LAST.m25f)return;MIG={state:"busy"};
  const P=plans().filter(p=>p.type!=="post"),names={},videos=[];
  const got=await Promise.all(P.map(p=>work(p.id).folder?Promise.resolve({name:work(p.id).folder}):pkPost("/api/video/folder",{title:p.title,date:p.date,new:true,create:false})));
  // Only a pack that really has files names an old folder; "want" is just the topic, which two videos can share.
  const slugOf=w=>w.pack?.slug&&(w.pack.done||w.pack.acts?.some(a=>a?.file))?w.pack.slug:"";
  const uses={};P.forEach(p=>{const s=slugOf(work(p.id));if(s)uses[s]=(uses[s]||0)+1});
  P.forEach((p,i)=>{const name=got[i]?.name;if(!name||Object.values(names).includes(name))return;names[p.id]=name;const w=work(p.id),n=narrOf(p.id),o=outlineOf(p.id),sl=slugOf(w);
    videos.push({name,id:p.id,title:p.title,titles:[...new Set([w.pick,n?.title,o?.title].filter(Boolean))],slug:sl&&uses[sl]===1?[sl]:[]})});
  if(!videos.length){MIG=null;return}
  const j=await pkPost("/api/video/migrate",{dry:true,videos});
  MIG=j.error||!j.count?{state:"none"}:{state:"ready",moves:j.moves,videos,names,shared:(j.errors||[]).filter(e=>e.videos).length};if(VD.view==="list"&&!$("#p-make").hidden)renderMigCard()}
function migGroups(list){const by={};for(const m of list){const id=Object.keys(MIG.names).find(k=>MIG.names[k]===m.video);(by[m.video]=by[m.video]||{id,video:m.video,pack:0,voice:0,thumb:0})[m.kind]++}return Object.values(by)}
const migParts=g=>[g.pack&&plural(g.pack,"edit pack file"),g.voice&&plural(g.voice,"voice over")+(g.voice>1?", newest in use":""),g.thumb&&plural(g.thumb,"thumbnail")].filter(Boolean).join(", ");
function renderMigCard(){const el=$("#vl-mig");if(!MIG||!["ready","result"].includes(MIG.state)){el.hidden=true;return}el.hidden=false;
  const title=g=>plans().find(p=>p.id===g.id)?.title||g.video;
  if(MIG.state==="ready"){const gs=migGroups(MIG.moves),n=MIG.moves.length;
    setH(el,`<div><h2 class="vd-h2" id="vl-mig-h" tabindex="-1">Move ${plural(n,"older file")} into video folders</h2><p class="sub">Files the app made before version 2.5 are loose in Downloads or in old edit pack folders. They can move into the folder of the video they belong to. Nothing is deleted, and no file replaces another: a number is added to the name instead.</p></div>
    <ul class="vd-mlist">${gs.slice(0,6).map(g=>`<li><b>${esc(title(g))}</b><span>${esc(migParts(g))}</span></li>`).join("")}${gs.length>6?`<li><span>and ${gs.length-6} more videos</span></li>`:""}</ul>${MIG.shared?`<p class="note">${plural(MIG.shared,"older file or folder")} could belong to more than one video, so ${MIG.shared===1?"it stays":"they stay"} where ${MIG.shared===1?"it is":"they are"}. Move ${MIG.shared===1?"it":"them"} by hand if you like.</p>`:""}
    <div class="chips"><button type="button" class="btn" id="mig-go">Move ${plural(n,"file")}</button><button type="button" class="btn ghost" id="mig-no">Not now, don't ask again</button></div><div class="status" id="s-mig" role="status"></div>`);return}
  const r=MIG.result,ok=[...(r.moved||[]),...(r.copied||[])],gs=migGroups(ok);
  setH(el,`<div><h2 class="vd-h2" id="vl-mig-h" tabindex="-1">${plural(ok.length,"file")} moved into video folders</h2><p class="sub">Nothing was deleted.${r.copied?.length?` ${plural(r.copied.length,"file")} sat on another drive, so ${r.copied.length===1?"it was":"they were"} copied and the original kept.`:""}</p></div>
    <ul class="vd-mlist">${gs.map(g=>`<li><b>${esc(title(g))}</b><span>${esc(migParts(g))}, now in ${esc(g.video)}</span></li>`).join("")}${(r.failed||[]).map(f=>`<li class="err"><b>Not moved: ${esc(f.from||f.file||"")}</b><span>${esc(f.error)}</span></li>`).join("")}</ul>
    <div class="chips"><button type="button" class="btn ghost" id="mig-close">Close</button></div>`)}
$("#vl-mig").addEventListener("click",async e=>{
  if(e.target.closest("#mig-no")){MIG={state:"none"};await remember("m25f",{dismissed:true});renderMigCard();$("#vl-new").focus();return}
  if(e.target.closest("#mig-close")){MIG={state:"none"};renderMigCard();$("#vl-new").focus();return}
  const b=e.target.closest("#mig-go");if(!b||MIG?.state!=="ready")return;const st=$("#s-mig");b.disabled=true;st.className="status";st.textContent="Moving the files…";
  const j=await pkPost("/api/video/migrate",{dry:false,videos:MIG.videos});b.disabled=false;
  if(j.error){st.className="status err";st.textContent=j.error;return}
  const ok=[...(j.moved||[]),...(j.copied||[])],ids=new Set();
  for(const m of ok){const id=Object.keys(MIG.names).find(k=>MIG.names[k]===m.video);if(!id)continue;const w=work(id);ids.add(id);if(!w.folder)w.folder=m.video;
    if(m.kind==="pack"&&w.pack)delete w.pack.dir;
    if(m.kind==="voice"){const t=(w.takes||[]).find(x=>x.where==="downloads"&&x.file===m.name);if(t)Object.assign(t,{file:m.file,url:m.url,where:/older/.test(m.sub)?"older":"current"})}}
  await flushWork();await Promise.all([...ids].map(id=>ensureFolder(id).then(()=>vdTakes(id))));
  await remember("m25f",{at:Date.now(),moved:(j.moved||[]).length,copied:(j.copied||[]).length,failed:(j.failed||[]).length});
  MIG={...MIG,state:"result",result:j};renderList();$("#vl-mig-h")?.focus()});
function renderAuto(){const w=mkW(),has=!!(w.topic||"").trim(),full=has&&w.titles?.length>1&&w.thumb&&w.hook;
  $("#mk-auto-h").textContent=!has?"Not sure what to make?":full?"Filled in. Check it, then go on to the script.":`Topic: ${w.topic}`;
  $("#mk-auto-p").textContent=!has?"One click: AI picks a topic that matches your best videos, fills in the titles, thumbnail text and hook, then writes the full script and voice over.":full?"Title, thumbnail and hook are ready. One more click for the full script and voice over.":"One click: AI fills in the title, thumbnail text and hook for this topic, then writes the full script and voice over.";
  const mk=$("#mk-auto");mk.dataset.runcopy=!has?"Copy prompt and suggest a topic":full?"Copy prompt and refill the package":"Copy prompt and fill the package";setRunTxt(mk,!has?"Just suggest a topic":full?"Refill package":"Fill title, thumbnail & hook");$("#mk-auto-new").hidden=!has}
// One AI call fills the whole package, so Sigit can start from a suggestion instead of a blank page.
async function autoFill(btn,newTopic,stEl,copy){const startId=mkId(),w=mkW(),topic=newTopic?"":(w.topic||"").trim(),st=stEl||$("#s-auto");
  const done=[...longForm().map(v=>v.t),...plans().map(p=>p.title)].slice(-80).join("; ");
  const d=await ask(st,btn,`${topic?`Plan the package for a documentary about: ${topic}.`:`Pick the single best next documentary topic for this channel and plan its package. Do not repeat or closely overlap: ${done||"none"}.${aniAvoid().length?` Do not pick any of these animals, the channel already has a video about each: ${aniAvoid().join("; ")}.`:""}`}
What works on this channel: ${patternText()||"giant prehistoric mammal predators framed as a threat to humans"}. Viewers of recent videos left in the first minute, so the opening matters most.
Return: "subject" the animal's usual name; "mammal","predator","threat","size" honest true/false about the animal and the angle; "why" one English sentence on why this topic fits the channel; "titles" 5 title options, best first, each under 60 characters, naming the animal, with a size or number people can picture and a threat or rivalry angle where the evidence supports it; "thumb" thumbnail text of at most 4 words, uppercase, adding information the best title does not repeat; "hook" the first 60 seconds of narration (120-160 words, English): name the animal in the first sentence, state the danger before 15 seconds, say the thumbnail words before 15 seconds, promise a specific payoff at the end, no channel intro, no "subscribe", accurate facts with uncertain claims phrased carefully.
JSON shape: {"subject":"","mammal":true,"predator":true,"threat":true,"size":true,"why":"","titles":[""],"thumb":"","hook":""}`,null,undefined,copy);
  if(!d?.titles?.length)return false;
  // The package belongs to the video that was open when the button was pressed, not to the one open now.
  let id=newTopic||!plans().some(p=>p.id===startId)?"":startId;
  if(!id){const last=plans().map(p=>p.date).sort().pop(),base=last&&last>isoDay(new Date())?last:isoDay(new Date()),date=isoDay(addDays(new Date(base+"T12:00:00"),7));
    id=Date.now().toString(36)+Math.random().toString(36).slice(2,6);await savePlans([...plans(),{id,title:d.titles[0],date,type:"video",status:"ide",note:d.why||""}]);store.set("mk",id)}
  const x=work(id);Object.assign(x,{topic:d.subject||topic,titles:d.titles,pick:d.titles[0],thumb:d.thumb||"",hook:d.hook||""});stamp(x,"topic","titles","hook");saveWork();advance(id,"naskah");
  const f=fitOf(d);if(mkId()===id){VD.loaded=null;VD.step="";VD.open=null;renderMake()}
  jobSay(id,st,`${d.subject||topic}: score ${f.score} out of 5. ${d.why||""} The first title is selected; change it if you like another better.`);return id}
// The whole video in one click: package first when it is missing, then outline, narration and voice.
async function oneClick(btn,stEl){let st=stEl||$("#s-auto");const id0=mkId(),w=mkW(),full=(w.topic||"").trim()&&w.titles?.length>1&&w.hook;
  btn.disabled=true;
  const cp=runCopy("auto");
  try{const id=full?id0:await autoFill($("#mk-auto"),false,st,cp);if(!id)return;
    const note=mkId()===id?st.textContent:"";openMake(id,"outline");st=$("#s-auto");st.className="status";st.textContent=(full?"":note+" ")+"Now writing the script; progress shows in the Outline and Full script steps.";
    const ok=await runScript($("#f-script .btn[type=submit]"),cp);
    const stop=!ok&&cp&&!$("#s-script").textContent.trim();
    jobSay(id,st,ok?"Script done. Check it in the Full script step, then make the thumbnail.":stop?"Stopped. Press Make script in 1 click again to continue.":"Script not finished. See the message in the Outline step.",!ok&&!stop);vdSoon()}
  finally{btn.disabled=false}}
$("#mk-one").addEventListener("click",e=>oneClick(e.currentTarget));
$("#mk-auto").addEventListener("click",e=>autoFill(e.currentTarget,false));
$("#mk-auto-new").addEventListener("click",e=>autoFill(e.currentTarget,true));
$("#mk-topic").addEventListener("input",e=>{mkW().topic=e.target.value;stamp(mkW(),"topic");saveWork();renderTitles();renderRules();renderAuto()});
$("#mk-titles").addEventListener("input",e=>{mkW().titles=e.target.value.split("\n");saveWork();renderTitles()});
$("#mk-thumbtext").addEventListener("input",e=>{mkW().thumb=e.target.value;stamp(mkW(),"titles");saveWork();renderThumbPrev();renderRules()});
$("#mk-hook").addEventListener("input",e=>{mkW().hook=e.target.value;stamp(mkW(),"hook");saveWork();renderRules()});
function titleChecks(t){const k=topicKey();return [[t.length<=60,"≤60"],[SIZE.test(t),"Size"],[THREAT.test(t),"Threat"],[!!k&&t.toLowerCase().includes(k),"Name"]]}
function renderTitles(){const w=mkW(),list=(w.titles||[]).map(s=>s.trim()).filter(Boolean);
  $("#mk-tlist").innerHTML=list.map((t,i)=>{const c=titleChecks(t);return `<label class="trow"><input type="radio" name="mk-pick-title" value="${i}" ${w.pick===t?"checked":""}><span class="t">${esc(t)}<small>${t.length} characters</small></span><span class="checks">${c.map(([ok,k])=>`<i class="${ok?"y":""}">${k}<span class="sr">${ok?" passed":" not yet"}</span></i>`).join("")}</span></label>`}).join("");
  $("#mk-tlist").onchange=e=>{w.pick=list[+e.target.value];stamp(w,"titles");saveWork();$("#thumb-title").value=w.pick;["#script-topic","#seo-topic","#thumb-topic","#shorts-topic"].forEach(s=>$(s).value=w.pick);renderThumbPrev()}}
function renderThumbPrev(){const w=mkW(),t=(w.thumb||"").trim(),words=t.split(/\s+/).filter(Boolean),pick=(w.pick||"").toLowerCase();
  $("#mk-thumbprev span").textContent=t||"Thumbnail text";$("#mk-thumbprev").classList.toggle("ph",!t);
  const rep=words.filter(x=>x.length>3&&pick.includes(x.toLowerCase()));
  $("#mk-thumbnote").textContent=!t?"Type text to see a preview.":words.length>4?`${words.length} words, too many for a phone screen. Cut it to 4 words or fewer.`:rep.length?`The word "${rep.join(", ")}" is already in the title. A thumbnail is stronger when it adds new information.`:`${words.length} words, good.`}
/* Thumbnail images: Gemini draws the background, the app adds the text so the letters are always right. */
const genW=()=>{const w=mkW();return w.gen=w.gen||{concepts:[],imgs:[],pick:null,pos:"tl"}};
const GENBUSY=new Set(),GIMG={};
const loadImg=u=>GIMG[u]=GIMG[u]||new Promise((res,rej)=>{const i=new Image();i.onload=()=>res(i);i.onerror=()=>{delete GIMG[u];rej()};i.src=u});
const genUrl=x=>`/api/gen/${encodeURIComponent(x.file)}?v=${x.v}`;
function genBar(){const g=genW(),has=g.imgs?.some(x=>x?.file),price=IMG_PRICE[imgModel()],b=$("#gen-go"),tag=price?` (about ${usd(price*3)})`:"";if(b.dataset.arm)return;$('[data-runw="gen"]').hidden=!imgReady();
  if(!imgReady()){$("#gen-h").textContent=imgKie()?"Add the KIE.ai key first":"Add the image key first";$("#gen-p").textContent=imgKie()?"Images are set to KIE.ai in Settings, but no KIE.ai key is saved yet. The key is set once.":"Images are made by Gemini using the Google Cloud credit from your subscription, or by KIE.ai for about $0.04 each. The key is set once in Settings.";b.dataset.plain=b.dataset.base="Open Settings";b.textContent="Open Settings";return}
  $("#gen-h").textContent=has?"Want 3 new images?":"Make 3 thumbnails with "+imgWho();
  $("#gen-p").textContent=imgKie()?`3 images cost about ${nf(KIE_IMG*3)} KIE.ai credits (${usd(price*3)}). ${imgSpentText()}`:`3 images${price?", about "+usd(price*3)+",":""} is taken from your Google Cloud credit. ${imgSpentText()}`;
  delete b.dataset.plain;setRunTxt(b,(has?"Make 3 new":"Make 3 thumbnails")+tag)}
// At most 3 lines; short lines keep the letters large on a phone.
function thumbLines(t){const words=(t||"").trim().toUpperCase().split(/\s+/).filter(Boolean);if(!words.length)return [];
  for(let lim=10;lim<40;lim+=2){const lines=[];let cur="";for(const w of words){if(cur&&(cur+" "+w).length>lim){lines.push(cur);cur=w}else cur=cur?cur+" "+w:w}lines.push(cur);if(lines.length<=3)return lines}
  return [words.join(" ")]}
function drawThumb(cv,img,text,pos){const c=cv.getContext("2d"),W=cv.width,H=cv.height;c.shadowColor="transparent";c.fillStyle="#14110D";c.fillRect(0,0,W,H);
  if(img){const s=Math.max(W/img.naturalWidth,H/img.naturalHeight),w=img.naturalWidth*s,h=img.naturalHeight*s;c.drawImage(img,(W-w)/2,(H-h)/2,w,h)}
  const lines=pos==="none"?[]:thumbLines(text);if(!lines.length)return;
  const right=pos==="tr",bottom=pos==="bl",u=W/1280;
  const g=c.createLinearGradient(right?W:0,0,right?W*.3:W*.7,0);g.addColorStop(0,"rgba(8,6,4,.78)");g.addColorStop(1,"rgba(8,6,4,0)");c.fillStyle=g;c.fillRect(0,0,W,H);
  if("fontStretch" in c)c.fontStretch="expanded";
  const font=s=>`800 ${s}px Archivo, "Arial Black", Arial, sans-serif`;let size=168*u;
  for(;size>56*u;size-=4*u){c.font=font(size);if(Math.max(...lines.map(l=>c.measureText(l).width))<=W*.6&&lines.length*size*.96<=H*.66)break}
  c.font=font(size);c.textBaseline="top";c.textAlign=right?"right":"left";c.lineJoin="round";
  const lh=size*.96,x=right?W-64*u:64*u,y0=bottom?H-56*u-lines.length*lh:56*u;
  lines.forEach((l,i)=>{const y=y0+i*lh;c.shadowColor="rgba(0,0,0,.55)";c.shadowBlur=size*.12;c.shadowOffsetY=size*.04;c.lineWidth=size*.07;c.strokeStyle="rgba(8,6,4,.6)";c.strokeText(l,x,y);
    c.shadowColor="transparent";c.fillStyle=i===lines.length-1&&lines.length>1?"#F2A230":"#fff";c.fillText(l,x,y)})}
function renderGen(){const g=genW(),id=mkId(),cs=(g.concepts||[]).slice(0,3);genBar();$("#gen-pos").value=g.pos||"tl";
  $("#gen-list").hidden=$("#gen-posrow").hidden=!cs.length;
  $("#gen-list").innerHTML=cs.map((c,i)=>{const x=g.imgs?.[i]||{},busy=GENBUSY.has(id+":"+i);
    return `<article class="gth${genOn(i)?" pick":""}" data-slot="${i}"><div class="gimg">${x.file?`<canvas width="1280" height="720" role="img" aria-label="Thumbnail ${i+1}: ${esc(c.name)}"></canvas>`:""}${busy||!x.file?`<div class="gph${busy?" busy":""}">${busy?imgWait():esc(x.err||"No image yet")}</div>`:""}</div>
    <h3>${i+1}. ${esc(c.name)}</h3><p>${esc(c.composition)}</p>\n    <label>Text on image<input maxlength="40" data-g="text" value="${esc(c.text)}"></label>
    <div class="chips"><button type="button" class="btn${genOn(i)?"":" ghost"}" data-g="pick"${x.file?"":" disabled"}>${genOn(i)?"Selected":"Pick this"}</button><button type="button" class="btn ghost" data-g="save"${x.file?"":" disabled"}>Save JPG</button><button type="button" class="btn ghost" data-g="redo"${busy?" disabled":""}>${x.file?"Redo":"Try again"}${IMG_PRICE[imgModel()]?` (about ${usd(IMG_PRICE[imgModel()])})`:""}</button></div>
    <p class="note" data-g="msg" role="status">${x.file&&x.err?esc(x.err):""}</p></article>`}).join("");
  paintGen().then(renderPhone)}
async function paintGen(only){const g=genW();try{await document.fonts.load("800 100px Archivo")}catch{}
  for(const art of document.querySelectorAll("#gen-list .gth")){const i=+art.dataset.slot,cv=art.querySelector("canvas"),x=g.imgs?.[i];if(!cv||!x?.file||(only!=null&&only!==i))continue;
    try{drawThumb(cv,await loadImg(genUrl(x)),g.concepts[i]?.text,g.pos||"tl")}catch{drawThumb(cv,null,g.concepts[i]?.text,g.pos||"tl")}}}
function renderPhone(){const g=genW(),w=mkW(),cv=g.pick!=null&&$(`#gen-list [data-slot="${g.pick}"] canvas`);$("#gen-phone").hidden=!cv;if(!cv)return;
  const src=cv.toDataURL("image/jpeg",.8),t=w.pick||mkPlan()?.title||w.topic||"";$("#gen-feed-img").src=$("#gen-side-img").src=src;
  $("#gen-feed-title").textContent=$("#gen-side-title").textContent=t;$("#gen-feed-ch").textContent=(CFG.profile?.name||"Your channel")+" · new"}
const imgPrompt=(c,pos)=>{const side=pos==="tr"?"right":"left",other=pos==="tr"?"left":"right";
  return `${c.prompt}\n\nFormat: wide 16:9 YouTube thumbnail background, cinematic, high contrast, one large clear subject on the ${other} side of the frame. Keep the ${side} third of the frame darker and uncluttered because a headline is added there later. Scientifically plausible anatomy. Do not render any text, letters, numbers, captions, logos, watermarks or borders anywhere in the image.`};
async function genImage(i,vid,gg){const id=vid??mkId(),g=gg||genW(),c=g.concepts[i],k=id+":"+i;if(!c||GENBUSY.has(k))return false;
  GENBUSY.add(k);if(mkId()===id)renderGen();
  const j=await api("/api/image",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({...(id?{id}:{}),slot:i,prompt:imgPrompt(c,g.pos)})});
  GENBUSY.delete(k);g.imgs=g.imgs||[];
  if(j.error)g.imgs[i]={...(g.imgs[i]||{}),err:j.error};else{g.imgs[i]={file:j.file,v:j.v};addImg(1,j.model,j.provider).catch(()=>{})}
  saveWork();
  // Still on the same video: redraw, and refresh the saved thumbnail if this slot is the chosen one.
  if(mkId()===id){renderGen();if(!j.error&&g.pick===i){await paintGen(i);await applyPick(i)}}
  return !j.error}
async function genAll(btn){const id=mkId(),w=mkW(),g=genW(),st=$("#s-gen");
  if(!imgReady()){openImgKey();return}
  const topic=(w.pick||w.topic||"").trim();
  if(!topic){st.className="status err";st.textContent='No topic yet. Fill in the Topic step first.';return}
  if(g.imgs?.some(x=>x?.file)&&!btn.dataset.arm){btn.dataset.arm="1";btn.textContent="Click again to replace";setTimeout(()=>{if(btn.dataset.arm){delete btn.dataset.arm;genBar()}},5000);return}
  delete btn.dataset.arm;genBar();
  const main=(w.thumb||"").trim();
  const d=await ask(st,btn,`Create 3 distinct YouTube thumbnail concepts. Topic: ${w.topic||topic}. Video title: ${w.pick||"not decided"}. Visual style: ${$("#thumb-style").value}.
${main?`The overlay text "${main}" is already chosen: concept 1 uses exactly that text; concepts 2 and 3 each use a different text so they can be A/B tested.`:"Each concept has its own overlay text."}
Each concept: "name" short English label, "text" overlay of max 4 words, uppercase, that complements (not repeats) the title, "composition" one sentence in English, "why" one sentence in English on why it gets clicks, "prompt" a detailed text-to-image prompt in English (16:9, one large subject on the right two thirds, the left third dark and empty for the overlay text, do not render any text in the image, accurate anatomy and details).
JSON shape: {"concepts":[{"name":"","text":"","composition":"","why":"","prompt":""}]}`,null);
  if(!d?.concepts?.length)return;
  w.flowThumb={at:Date.now(),list:d.concepts};if(mkW()===w)renderThumb(d.concepts);
  g.concepts=d.concepts.slice(0,3).map(c=>({name:String(c.name||"Concept"),text:String(c.text||main).slice(0,40),composition:String(c.composition||""),prompt:String(c.prompt||c.composition||topic)}));
  g.imgs=[];g.pick=null;saveWork();if(mkId()===id)renderGen();
  jobSay(id,st,`Concepts ready. ${imgWho()} is drawing 3 thumbnails…`);btn.disabled=true;
  const ok=(await Promise.all(g.concepts.map((_,i)=>genImage(i,id,g)))).filter(Boolean).length;btn.disabled=false;
  jobSay(id,st,ok===g.concepts.length?`${ok} thumbnails done. Pick one; the text can be changed under each image.`:ok?`${ok} of ${g.concepts.length} images done. Click Try again on the one that failed.`:(g.imgs.find(x=>x?.err)?.err||"The image could not be made. Try again."),!ok)}
const thumbBlob=cv=>new Promise(r=>cv.toBlob(r,"image/jpeg",.92));
async function saveJpg(i,blob){const id=mkId(),w=work(id),name=`${w.pick||mkPlan()?.title||w.topic||"terra"} thumbnail ${i+1}`,folder=await ensureFolder(id);
  return api("/api/save-jpg?name="+encodeURIComponent(name)+(folder?"&folder="+encodeURIComponent(folder):""),{method:"POST",headers:{"Content-Type":"image/jpeg"},body:blob})}
const genOn=i=>{const g=genW(),p=mkPlan();return g.pick===i&&(!g.pickFile||!p||p.tfile===g.pickFile)};
function markPick(){document.querySelectorAll("#gen-list .gth").forEach(a=>{const on=genOn(+a.dataset.slot),b=a.querySelector('[data-g="pick"]');a.classList.toggle("pick",on);b.classList.toggle("ghost",!on);b.textContent=on?"Selected":"Pick this"})}
// Choosing a thumbnail makes it the plan image on the calendar and writes the JPG to Downloads.
async function applyPick(i){const g=genW(),id=mkId(),art=$(`#gen-list [data-slot="${i}"]`),cv=art?.querySelector("canvas"),msg=art?.querySelector('[data-g="msg"]');if(!cv)return;
  g.pick=i;stamp(mkW(),"thumb");saveWork();markPick();renderPhone();
  const blob=await thumbBlob(cv),done=[],bad=[],s=await saveJpg(i,blob);
  // The calendar points to the saved file; without a video folder the app keeps its own copy as before.
  if(id&&s.file&&s.folder){g.pickFile=s.file;saveWork();await remember("plans",plans().map(x=>x.id===id?{...x,tfile:s.file,tat:Date.now(),tmine:true}:x));renderDash();renderPipe();markPick();done.push("shown in the Calendar")}
  else if(id){const r=await api("/api/thumb?id="+encodeURIComponent(id),{method:"POST",headers:{"Content-Type":"image/jpeg"},body:blob});
    if(r.ok){g.pickFile="";saveWork();await remember("plans",plans().map(x=>{if(x.id!==id)return x;const y={...x,thumb:String(Date.now()),tmine:true};delete y.tfile;delete y.tat;return y}));renderDash();renderPipe();done.push("shown in the Calendar")}else bad.push(r.error||"The plan image could not be saved.")}
  if(s.path){done.push("saved in "+s.path);$("#gen-saved").textContent="Last file: "+s.path}else bad.push(s.error||"The JPG could not be saved.");
  if(msg){msg.className=bad.length?"note err":"note";msg.textContent=(done.length?"Selected: "+done.join(", ")+". ":"")+bad.join(" ")}if(id)ensureFolder(id).then(vdSoon)}
let genTextTimer=0;
$("#gen-go").addEventListener("click",e=>genAll(e.currentTarget));
$("#gen-folder").addEventListener("click",async()=>{const f=await ensureFolder(mkId());if(f)pkPost("/api/video/open",{name:f,sub:"06 Thumbnail"});else api("/api/open-folder",{method:"POST"})});
$("#gen-pos").addEventListener("change",async e=>{const g=genW();g.pos=e.target.value;saveWork();await paintGen();if(g.pick!=null)applyPick(g.pick)});
$("#gen-list").addEventListener("input",e=>{if(e.target.dataset.g!=="text")return;const g=genW(),i=+e.target.closest(".gth").dataset.slot;g.concepts[i].text=e.target.value;saveWork();
  paintGen(i).then(()=>{if(g.pick===i){renderPhone();clearTimeout(genTextTimer);genTextTimer=setTimeout(()=>applyPick(i),900)}})});
$("#gen-list").addEventListener("click",async e=>{const b=e.target.closest("button[data-g]");if(!b)return;const art=b.closest(".gth"),i=+art.dataset.slot,msg=art.querySelector('[data-g="msg"]');
  if(b.dataset.g==="pick")return applyPick(i);
  if(b.dataset.g==="redo"){const ok=await genImage(i);const m=$(`#gen-list [data-slot="${i}"] [data-g="msg"]`);if(m&&!ok){m.className="note err";m.textContent=genW().imgs[i]?.err||"The image could not be made."}return}
  if(b.dataset.g==="save"){const cv=art.querySelector("canvas");if(!cv)return;b.disabled=true;const s=await saveJpg(i,await thumbBlob(cv));b.disabled=false;
    msg.className=s.path?"note":"note err";msg.textContent=s.path?"Saved in "+s.path:(s.error||"The JPG could not be saved.");if(s.path){$("#gen-saved").textContent="Last file: "+s.path;thumbFollow([mkId()])}}});
function renderRules(){const w=mkW(),txt=(w.hook||"").trim(),words=txt.split(/\s+/).filter(Boolean),f25=words.slice(0,25).join(" ").toLowerCase(),f35=words.slice(0,35).join(" "),k=topicKey();
  const thumbW=(w.thumb||"").toLowerCase().split(/\s+/).filter(x=>x.length>=3&&!["the","and","our","for","with","that","this","from","was"].includes(x));
  const R=!txt?[[null,"Write the opening in the box beside this. The checks appear as you type."]]:[
    [k?f25.includes(k):null,k?"Animal named in the first 10 seconds":"Animal named in the first 10 seconds: fill in the Topic step first"],
    [HOOK_DANGER.test(f35),"Danger or threat named before 0:15"],
    [/by the end|at the end|you'll see|you will see|stay with|before this video ends|the answer|what (really )?happened|di akhir/i.test(txt),"A promise at the end, so viewers stay"],
    [!/subscribe|welcome (back )?to|this channel|hello everyone|hi everyone|hey guys|hey everyone/i.test(txt),"No channel intro or subscribe request"],
    [thumbW.length?thumbW.some(x=>f35.toLowerCase().includes(x)):null,thumbW.length?`Thumbnail words ("${w.thumb.trim()}") spoken before 0:15`:"Thumbnail words spoken before 0:15: fill in the thumbnail text in the Title & thumbnail text step first"],
    [words.length>=110&&words.length<=170,`Right length for 60 seconds (110 to 170 words, now ${words.length})`]];
  $("#mk-rules").innerHTML=R.map(([ok,t])=>`<li><span class="${ok===true?"y":ok===false?"n":"u"}" aria-hidden="true">${ok===true?"✓":ok===false?"✗":"–"}</span><span>${esc(t)}<span class="sr">${ok===true?", passed":ok===false?", not yet":""}</span></span></li>`).join("");
  $("#mk-hook-len").textContent=words.length?`${words.length} words, about ${Math.round(words.length/140*60)} seconds read aloud (140 words per minute).`:""}
function hookForScript(){const w=mkW(),h=(w.hook||"").trim();let s="";if(w.pick)s+=`Video title: ${w.pick}. `;if(w.thumb)s+=`Thumbnail text: ${w.thumb}. `;if(h.split(/\s+/).length>=20)s+=`Use this exact opening, word for word, as the cold open and first part of act 1: """${h}"""\n`;return s}
$("#mk-titles-ai").addEventListener("click",async e=>{const w=mkW(),topic=w.topic||mkPlan()?.title||"";const st=$("#s-titles");if(!topic){st.className="status err";st.textContent="Fill in the topic first.";return}
  const d=await ask(st,e.currentTarget,`Write 5 YouTube title options for a documentary about: ${topic}. What works on this channel: ${patternText()||"giant prehistoric predators framed as a threat to humans"}. Each under 60 characters, honest, naming the animal, ideally with a size or number people can picture and a threat or rivalry angle. Vary the angle.
JSON shape: {"titles":[""]}`,null);
  if(d?.titles?.length){const cur=(w.titles||[]).map(s=>s.trim()).filter(Boolean);w.titles=[...cur,...d.titles.filter(t=>!cur.includes(t))];saveWork();if(mkW()===w){$("#mk-titles").value=w.titles.join("\n");renderTitles()}}});
$("#mk-hook-ai").addEventListener("click",async e=>{const w=mkW(),topic=w.topic||mkPlan()?.title||"",st=$("#s-hook");if(!topic){st.className="status err";st.textContent="Fill in the topic first.";return}
  const d=await ask(st,e.currentTarget,`Write 2 alternative openings (the first 60 seconds, 120-160 words each, spoken narration) for a documentary about ${topic}.${w.pick?" Title: "+w.pick+".":""}${w.thumb?" Thumbnail text: "+w.thumb+".":""}
Rules from where this channel's viewers dropped off: name and show the animal in the first sentence; state the danger or threat before 15 seconds; say the thumbnail words before 15 seconds; promise a specific payoff at the end; no channel intro, no "subscribe", no "millions of years ago" warm-up. Keep every fact accurate; phrase uncertain claims carefully.
${(w.hook||"").trim()?"Current draft to improve:\n"+w.hook.trim():""}
JSON shape: {"hooks":[{"text":"","why":"one sentence in English on what changed"}]}`,null);
  if(d?.hooks?.length){w.hooks=d.hooks;saveWork();if(mkW()===w)renderHooks(d.hooks)}});
function renderHooks(list){$("#o-hook").innerHTML=list.map((h,i)=>`<div class="card"><span class="layer">Version ${i+1}</span><p>${esc(h.text)}</p><p class="note">${esc(h.why||"")}</p><button type="button" class="btn ghost" data-hook="${i}">Use this version</button></div>`).join("");
  $("#o-hook").onclick=e=>{const b=e.target.closest("[data-hook]");if(!b)return;mkW().hook=list[+b.dataset.hook].text;stamp(mkW(),"hook");saveWork();$("#mk-hook").value=mkW().hook;renderRules();$("#mk-hook").focus()}}
function renderPub(){const w=mkW(),us=usShare(),best=winners()[0],done=w.pub||{};
  const items=[["t60","Title chosen, under 60 characters",w.pick?`"${w.pick}"`:"Pick a title in the Title & thumbnail text step"],["thumb","Thumbnail done, text of at most 4 words, readable at phone size",""],["tc","Test & Compare: 2 or 3 thumbnails tested in YouTube Studio",""],["desc","Description with chapters, keyword in the first sentence","Copy it from the SEO step"],["end","End screen points to your best video",best?`"${best.t}"`:""],["pin","Pinned comment with a question",""],["time",us?"Scheduled for 07:00 WIB, evening in America":"The publish time is set in YouTube Studio",us?`US viewers: ${us.views}% views`:""],["comm","Community post on publish day",""]];
  $("#mk-pub").innerHTML=items.map(([k,t,s])=>`<li><input type="checkbox" id="pub-${k}" data-pub="${k}" ${done[k]?"checked":""}><label for="pub-${k}">${esc(t)}${s?`<small>${esc(s)}</small>`:""}</label></li>`).join("");
  $("#mk-pub").onchange=e=>{const c=e.target.closest("[data-pub]");if(!c)return;w.pub={...(w.pub||{}),[c.dataset.pub]:c.checked};if(PUB_KEYS.every(k=>w.pub[k]))stamp(w,"upload");saveWork()}}
$("#mk-done").addEventListener("click",async()=>{const p=mkPlan();if(!p)return;await savePlans(plans().map(x=>x.id===p.id?{...x,status:"tayang"}:x));$("#s-done").className="status";$("#s-done").textContent="Marked as published. Its report card appears in Learn after the next data pull."});

/* Editing: every long video, from its edit pack to a Premiere sequence. All times come from the per-act MP3s
   and their subtitle cues, and one plan feeds both this page and the files Send to Premiere writes. */
const ED_GAP=1;
const ED={view:"list",id:"",pub:false,zoom:"all",scan:{},scanP:{},msg:"",err:false,msgId:"",sel:-1,send:"",focus:false,ai:{msg:"",err:false}};
const ED_ST={script:["Needs script","wait","Write script"],pack:["Needs edit pack","wait","Make edit pack"],ready:["Ready to edit","ready","Send to Premiere"],editing:["Editing","ready","Open checklist"],edited:["Edited","done","Upload checklist"],pub:["Published","done",""]};
const ED_RULES={R1:"Shots are 4 to 7 s. Short cues are merged, long ones split at word gaps.",R2:"Cut on cue edges, never mid-word.",R3:"Hook (0:00 to 1:00): a new picture every 2.5 to 4 s, first change by 0:03.",R4:"Slow zoom on stills, 100 to 108%, alternate the direction.",R5:"A video clip goes on a motion word inside its own act (clip 2.1 belongs to act 2).",R6:"An infographic goes at its brief's sentence, for the brief's length.",R7:"A label at the first mention of a genus name or a period, 3.5 s, using only words from the narration.",R8:"An ambience bed from the first place word of an act (cave, river, plain, forest…).",R9:"An impact sound on an impact word (snap, crack, crush, bite).",R10:"A creature sound in the pause after a sound word (call, roar, growl).",R11:"A low riser that ends on a reveal or death word (vanished, extinct, gone).",R12:"A soft whoosh 4 frames before each infographic.",R13:"At most about 2 sound effects a minute, and none in the first 3 s of a sentence with a number.",R14:"Act start: whoosh, new music bed, optional title card for 2 to 3 s.",R15:"One music bed per act, 18 to 24 dB under the voice. Mood from the act's place and its danger words.",R16:"A 1 s pause at every act end, built into the edit guide.",R17:"Music 6 dB lower during each pause.",R18:"Last 20 s: end screen, no new graphics, calm pictures, music resolves.",R19:"Optional: export at about -14 LUFS, true peak -1 dB.",check:"The script check: a long stretch with no number, no danger word and no question."};
const ED_WHY={R1:"shot length",R2:"cut on cue edges",R3:"fast hook",R4:"slow zoom",R5:"clip in its own act",R6:"infographic at its sentence",R7:"label at first mention",R8:"ambience from a place word",R9:"impact word",R10:"creature sound",R11:"riser on a reveal word",R12:"whoosh before infographic",R13:"sound effect limit",R14:"act start",R15:"one music bed per act",R16:"act pause",R17:"music lower in pauses",R18:"end screen",R19:"loudness"};
const edWhy=w=>String(w).split(/\s*[\/,+]\s*/).map(r=>r==="check"?"script check":`${r} ${ED_WHY[r]||""}`.trim()).join("; ");
const ED_W={motion:/^(?:run|runs|ran|running|charg\w*|leap\w*|lunge\w*|chas(?:e|ed|es|ing)|sprint\w*|swim\w*|swam|dash\w*|pounc\w*|attack\w*|rush\w*|fled|flee\w*|stalk\w*|crept|creep\w*|walk\w*|roam\w*|burst\w*|dive|dived|dove|diving|plung\w*|jump\w*|climb\w*|dragg\w*|drag|rac(?:e|ed|ing)|stampede\w*|gallop\w*|swoop\w*|crash\w*|prowl\w*|wander\w*|march\w*|migrat\w*|surg\w*|sweep\w*|swept|flew|flying|tackl\w*|grabb\w*|seiz\w*|sprang|hunt\w*)$/,
  impact:/^(?:snap|snaps|snapped|crack|cracks|cracked|crunch\w*|crush|crushed|crushes|crushing|shatter\w*|smash\w*|slam|slams|slammed|bite|bites|biting|tore|torn|rip|ripped|clamp\w*|thud\w*|struck)$/,
  creature:/^(?:roar\w*|growl\w*|howl\w*|cry|cries|cried|scream\w*|shriek\w*|bellow\w*|hiss\w*|snarl\w*|whoop\w*|grunt\w*|cackl\w*|laugh\w*|yelp\w*|trumpet\w*|squeal\w*|call|calls)$/,
  reveal:/^(?:vanish\w*|extinct|extinction|disappear\w*|perish\w*|gone|wiped)$/,
  period:/^(?:pleistocene|pliocene|miocene|oligocene|eocene|paleocene|palaeocene|holocene|cretaceous|jurassic|triassic|permian|carboniferous|devonian|silurian|ordovician|cambrian|neolithic|paleolithic|palaeolithic)$/,
  latin:/^[A-Z][a-z]{3,}(?:odon|dus|ops|therium|saurus|cuta|ceros|lophus|nyx|ornis|pithecus|smilus|cyon|felis|tops|suchus|raptor|mys|thera|ichthys|odus|cetus|lestes|felis|leo|arctos)$/,
  species:/^[a-z]{5,}(?:is|us|um|ae|ii|ensis|ens|or|ops|oides)$/};
// [word test, label, search words]; the label names the bed in the sound list.
const ED_SET=[[/^(?:caves?|caverns?)$/,"cave interior, low wind",["cave","cavern"]],[/^(?:rivers?|streams?|riverbanks?)$/,"river flowing",["river","stream"]],[/^(?:lakes?|ponds?|shores?)$/,"lake shore, light water",["lake","shore"]],[/^(?:seas?|oceans?|waves|coasts?|beach\w*)$/,"sea waves",["ocean","waves","coast"]],[/^(?:forests?|woods|woodlands?|jungles?)$/,"forest birds and wind",["forest","jungle","woods"]],[/^(?:plains?|grasslands?|savann?ahs?|steppes?|prairies?)$/,"open plain wind",["plain","grassland","savanna"]],[/^(?:swamps?|marsh\w*|wetlands?)$/,"swamp insects",["swamp","marsh"]],[/^(?:deserts?|dunes?)$/,"desert wind",["desert","dunes"]],[/^(?:mountains?|cliffs?|valleys?)$/,"mountain wind",["mountain","valley"]],[/^(?:ice|snow|glaciers?|tundra|blizzards?)$/,"cold wind",["snow","winter","blizzard","tundra"]],[/^(?:rain|storms?|thunder\w*)$/,"rain",["rain","storm","thunder"]]];
const edPlans=()=>plans().filter(p=>p.type==="video");
const edNorm=s=>String(s).toLowerCase().replace(/[^a-z0-9]+/g,"");
const edClock=t=>{t=Math.max(0,t);const h=Math.floor(t/3600),m=Math.floor(t%3600/60),s=Math.floor(t%60);return h?`${h}:${String(m).padStart(2,"0")}:${String(s).padStart(2,"0")}`:`${m}:${String(s).padStart(2,"0")}`};
const edChap=t=>{const c=edClock(t);return c.length<5?"0"+c:c};
const edSnip=(s,n=8,end)=>{const w=String(s||"").split(/\s+/).filter(Boolean);return (w.length<=n?w.join(" "):end?"…"+w.slice(-n).join(" "):w.slice(0,n).join(" ")+"…").replace(/[.,;:]+(…?)$/,"$1")};
const edFlow=id=>(outlineOf(id)?.acts||[]).flatMap((a,i)=>(a.flow_prompts||[]).filter(Boolean).map((t,j)=>({n:`${i+1}.${j+1}`,act:i,text:String(t)})));
function edReady(id){const n=narrOf(id),p=work(id).pack,acts=pkActs(n);
  if(!packDone(id,n))return {ok:false,stale:!!p?.done};
  const A=p.acts.slice(0,acts.length);if(A.some(a=>!a?.cues?.length||!(a.seconds>0)))return {ok:false,cues:true};
  // A cheap guard: the cues come from the same text, so their words should match the script's.
  const cw=A.reduce((x,a)=>x+a.cues.reduce((y,c)=>y+igNorm(c.text).split(" ").filter(Boolean).length,0),0),nw=igNorm(narrText(n)).split(" ").filter(Boolean).length;
  return Math.abs(cw-nw)>nw*.03?{ok:false,guard:true}:{ok:true}}
function edState(id){const p=plans().find(x=>x.id===id);
  if(p?.status==="tayang")return "pub";if(p?.status==="siap")return "edited";if(work(id).edit?.sent)return "editing";
  if(!wordsOf(narrText(narrOf(id))))return "script";return edReady(id).ok?"ready":"pack"}
const edCanPlan=id=>{const p=work(id).pack,n=narrOf(id);return !!p?.done&&pkActs(n).every((a,i)=>p.acts?.[i]?.cues?.length&&p.acts[i].seconds>0)};
function edClipFile(id,c){const list=ED.scan[id]?.clips||[],saved=work(id).pack?.clips?.[c.n]?.file,pre="clip-"+c.n.replace(".","-");
  if(saved&&list.includes(saved))return saved;return list.find(f=>{const l=f.toLowerCase();return (l.startsWith(pre+".")||l.startsWith(pre+" ("))&&/\.(mp4|mov|m4v)$/.test(l)})||""}
function edIgFile(id,i,m){const list=ED.scan[id]?.infographics||[],want=igName(m,i),pre=String(i+1).padStart(2,"0")+"-";
  return list.includes(want)?want:list.find(f=>f.startsWith(pre)&&/\.(mov|mp4|m4v)$/i.test(f))||""}
// A Sound library file whose name holds one of the search words, most specific word first.
function edLib(id,words){const L=ED.scan[id]?.sounds||[];
  for(const w of words){if(w.length<4)continue;const f=L.find(s=>s.file.toLowerCase().replace(/\.[^.]+$/,"").split(/[^a-z0-9]+/).some(t=>t===w||t.startsWith(w)));if(f)return f}return null}
async function edScan(id,force){const w=work(id);if(!w.folder)return null;if(ED.scan[id]&&!force)return ED.scan[id];if(ED.scanP[id])return ED.scanP[id];
  ED.scanP[id]=(async()=>{const j=await pkPost("/api/edit/scan",{folder:w.folder});ED.scan[id]=j.error?{error:j.error}:j;return ED.scan[id]})();
  try{return await ED.scanP[id]}finally{delete ED.scanP[id]}}

/* The plan: acts, shots, clips, infographics, labels, sound ideas and markers, all on one clock that includes the act pauses. */
function edPlan(id){const p=plans().find(x=>x.id===id),n=narrOf(id),w=work(id),pk=w.pack,acts=pkActs(n),N=acts.length;
  const A=[];let t=0;
  for(let i=0;i<N;i++){const a=pk.acts[i];A.push({i,name:acts[i].name,file:a.file,secs:a.seconds,start:t,end:t+a.seconds,cues:a.cues||[]});t+=a.seconds+ED_GAP}
  const total=A.length?A[A.length-1].end:0,C=[],W=[],items=[],add=o=>{items.push(o);return o};
  // Word times inside a cue are a straight-line split of the cue, so they are estimates.
  A.forEach(a=>a.cues.forEach(c=>{const toks=String(c.text).split(/\s+/).filter(Boolean),s=a.start+c.start,e=a.start+Math.max(c.end,c.start),d=(e-s)/Math.max(1,toks.length),k=C.length;
    C.push({act:a.i,start:s,end:e,text:String(c.text),w0:W.length,w1:W.length+toks.length,num:toks.some(x=>/\d/.test(x)||SC_NUM.test(edNorm(x)))});
    toks.forEach((raw,j)=>W.push({raw,w:edNorm(raw),t:s+d*j,te:s+d*(j+1),c:k,act:a.i}))}));
  const quoteOf=k=>C[W[k].c]?.text||"",words=(a,b)=>W.slice(a,b).map(x=>x.raw).join(" ");
  const actW=A.map(a=>{const cs=C.filter(c=>c.act===a.i);return cs.length?[cs[0].w0,cs[cs.length-1].w1]:[0,0]});

  // Shots (R1-R3): cues merged or split to shot length, cut only between words.
  const shots=[];
  A.forEach(a=>{let cur=null;const flush=()=>{if(cur)shots.push(cur);cur=null};
    for(const c of C.filter(c=>c.act===a.i)){const hook=c.start<60,hi=hook?4:7,lo=hook?2.5:4,k=Math.max(1,Math.ceil((c.end-c.start)/hi-1e-6));
      // Split points move to a nearby comma when there is one, so a shot ends on a pause.
      const cut=[c.w0];for(let j=1;j<k;j++){const b=c.w0+Math.round((c.w1-c.w0)*j/k);let best=b;for(let d=0;d<=3;d++){const hit=[b-d,b+d].find(x=>x>cut[j-1]+1&&x<c.w1-1&&/[,;:\u2013\u2014-]$/.test(W[x-1].raw));if(hit){best=hit;break}}cut.push(Math.max(best,cut[j-1]+1))}cut.push(c.w1);
      for(let j=0;j<k;j++){const a0=cut[j],a1=cut[j+1];if(a1<=a0)continue;
        const part={start:j?W[a0].t:c.start,end:a1<c.w1?W[a1].t:c.end,w0:a0,w1:a1,act:a.i};
        if(cur&&cur.end-cur.start<lo&&part.end-cur.start<=hi){cur.end=part.end;cur.w1=part.w1}else{flush();cur=part}}}
    flush();const last=shots[shots.length-1],prev=shots[shots.length-2];
    if(last&&prev&&last.act===a.i&&prev.act===a.i&&last.end-last.start<1.5){prev.end=last.end;prev.w1=last.w1;shots.pop()}});
  if(shots[0]&&shots[0].end>3){const s=shots[0];let k=-1;for(let i=s.w0+1;i<s.w1;i++)if(W[i].t<=3&&W[i].t>=1)k=i;
    if(k>0){const tail={...s,start:W[k].t,w0:k},nx=shots[1];shots[0]={...s,end:W[k].t,w1:k};
      if(tail.end-tail.start<2&&nx&&nx.act===s.act){nx.start=tail.start;nx.w0=tail.w0}else shots.splice(1,0,tail)}}
  shots.forEach((s,i)=>{const nx=shots[i+1],a=A[s.act];if(i===0||shots[i-1].act!==s.act)s.start=a.start;s.end=nx&&nx.act===s.act?nx.start:a.end;s.text=words(s.w0,s.w1)});
  const shotAt=k=>shots.find(s=>k>=s.w0&&k<s.w1);

  // Acts, pauses, music beds (R14-R17).
  const dens=A.map(a=>W.filter(x=>x.act===a.i&&SC_THREAT.test(x.w)).length/Math.max(1,a.secs/60)),med=[...dens].sort((x,y)=>x-y)[Math.floor(dens.length/2)]||0;
  const mood=i=>i===0?["dark, low pulse",["dark","suspense","documentary"]]:i===N-1&&N>1?["sad, then it resolves",["sad","emotional","calm"]]:dens[i]>=med?["tense, driving",["tense","action","drums"]]:["rising, curious",["mystery","curious","rising"]];
  A.forEach(a=>{const m=mood(a.i),bedEnd=a.i<N-1?a.end+ED_GAP:a.end,lib=edLib(id,m[1]);
    add({t:a.start,end:a.end,lane:"act",track:"A1",cat:"ACT",row:false,mark:true,label:`${a.i+1} · ${a.name.replace(/^act\s*\d+\s*[·:.-]?\s*/i,"")}`,what:`Act ${a.i+1}: ${a.name}, ${pkLong(a.secs)}.`,why:"R16",quote:edSnip(words(...actW[a.i]),14)});
    add({t:a.start,end:bedEnd,lane:"mus",track:"A4",cat:"MUSIC",row:a.i===0,mark:true,label:m[0],search:m[1],lib,act:a.i,what:`Act ${a.i+1} music bed: ${m[0]}, 18 to 24 dB under the voice.${lib?` Placed from Sound library: ${lib.file}.`:""}`,why:"R15"});
    if(a.i>0){add({t:a.start,end:a.start+2.5,lane:"txt",track:"V3",cat:"TEXT",row:false,mark:true,label:`Act ${a.i+1} · ${a.name}`,what:`Optional title card "Act ${a.i+1} · ${a.name.replace(/^act\s*\d+\s*[·:.-]?\s*/i,"")}", 2 to 3 s.`,why:"R14"});
      add({t:a.start,lane:"all",track:"all",cat:"ACT START",mark:false,what:`Act ${a.i+1} starts: whoosh, new music bed (${m[0]}), optional title card for 2 to 3 s.`,why:"R14 / R15",quote:edSnip(words(...actW[a.i]),14)})}
    if(a.i<N-1)add({t:a.end,end:a.end+ED_GAP,lane:"mark",track:"marker",cat:"PAUSE",mark:true,label:"pause",what:`1 s pause after "${edSnip(words(...actW[a.i]),8,1)}". Music 6 dB lower.`,why:"R16 / R17"})});

  // Video clips (R5), video only, at a motion word inside their own act.
  const flows=edFlow(id),clips=[];
  A.forEach(a=>{const fl=flows.filter(f=>f.act===a.i);if(!fl.length)return;const sh=shots.filter(s=>s.act===a.i),[w0,w1]=actW[a.i],used=new Set();let last=-99;
    fl.forEach((f,j)=>{let s=null,k=-1;
      for(let i=w0;i<w1&&!s;i++)if(ED_W.motion.test(W[i].w)){const x=shotAt(i);if(x&&!used.has(x)&&x.start-last>=20){s=x;k=i}}
      if(!s){const want=a.start+a.secs*(j+1)/(fl.length+1);s=sh.filter(x=>!used.has(x)).sort((x,y)=>Math.abs(x.start-want)-Math.abs(y.start-want))[0]}
      if(!s)return;used.add(s);last=s.start;const len=Math.min(8,Math.max(4,s.end-s.start)),file=edClipFile(id,f);
      clips.push(add({t:s.start,end:Math.min(s.start+len,a.end),lane:"clip",track:"V1",cat:"CLIP",n:f.n,file,found:!!file,mark:!file,label:f.n,
        what:(file?`Clip ${f.n} on "${edSnip(k>=0?quoteOf(k):s.text,9)}", trimmed to ${Math.round(len)} s.`:`Clip ${f.n} is not in 04 Video clips yet (${edSnip(f.text,8)}). Make it in the Edit pack step or in Google Flow.`)+(k<0?" No motion word in this act, so it is spread over the act.":""),
        why:"R5",quote:k>=0?quoteOf(k):s.text}))})});
  const hookClip=clips.find(c=>c.t<60&&c.found);
  add({t:0,end:Math.min(60,total),lane:"mark",track:"V1",cat:"HOOK",mark:true,label:"hook",what:`Hook: a new picture every 2.5 to 4 s, first change by 0:03.${hookClip?` Clip ${hookClip.n} is placed here.`:""}`,why:"R3"});

  // Infographics (R6) at their brief's sentence, with a whoosh just before (R12).
  const NT=[];W.forEach((x,k)=>igNorm(x.raw).split(" ").filter(Boolean).forEach(s=>NT.push([s,k])));
  const find=q=>{const qt=igNorm(q).split(" ").filter(Boolean),hit=L=>{for(let i=0;i+L.length<=NT.length;i++){let ok=true;for(let j=0;j<L.length;j++)if(NT[i+j][0]!==L[j]){ok=false;break}if(ok)return NT[i][1]}return -1};
    if(!qt.length)return -1;let k=hit(qt);if(k<0&&qt.length>=4)k=hit(qt.slice(0,6));return k};
  const briefs=w.briefs?.list||[],igs=[],igLost=[];
  briefs.forEach((m,i)=>{const k=find(m.quote),name=igName(m,i);if(k<0){igLost.push(name);return}
    const at=W[k].t,len=m.seconds,file=edIgFile(id,i,m),hook=at<60&&len>4,late=at+len>total-20,kind=IG_KIND[m.kind][0];
    igs.push(add({t:at,end:Math.min(at+len,total),lane:"ig",track:"V2",cat:"INFOGRAPHIC",file,found:!!file,name,mark:!file,label:name.slice(0,2)+" "+kind.toLowerCase(),
      what:file?`${file} (found), ${len} s, on "${edSnip(m.quote,8)}".${hook?" It sits inside the hook, so trim it to 4 s.":""}${late?" It runs into the end screen, so move it earlier.":""}`:`${name} missing (${kind}, ${len} s). Make it in the Infographics step.${hook?" Inside the hook, keep it to 4 s.":""}`,
      why:hook?"R6 + R3":"R6",quote:m.quote,ok:file,miss:file?"":name}))});

  // Labels (R7): genus names and periods, first mention only, words from the narration only.
  const clean=r=>r.replace(/^[^A-Za-z0-9]+|[^A-Za-z0-9]+$/g,""),labels=[],seen=new Set(),topic=edNorm(scTopic(id).split(/\s+/)[0]||"");
  const periodAt=k=>{const x=W[k];if(ED_W.period.test(x.w))return [k,k+1];if(x.w==="ice"&&W[k+1]?.w==="age")return [k,k+2];
    if(x.w==="ago"&&W[k-1]?.w==="years"){let s=k-1;while(s>k-6&&s>0&&(/\d/.test(W[s-1].raw)||SC_NUM.test(W[s-1].w)||/^(?:about|around|nearly|some|over|almost|roughly|million|thousand|billion)$/.test(W[s-1].w)))s--;return s<k-1?[s,k+1]:null}return null};
  for(let k=0;k<W.length&&labels.length<6;k++){const raw=clean(W[k].raw);
    const genus=raw.length>4&&/^[A-Z][a-z]+$/.test(raw)&&(ED_W.latin.test(raw)||edNorm(raw)===topic&&topic.length>4||ED_W.species.test(clean(W[k+1]?.raw||"")));
    if(genus&&!seen.has(raw)&&labels.filter(l=>l.kind==="g").length<4){seen.add(raw);const sp=clean(W[k+1]?.raw||""),name=ED_W.species.test(sp)&&!/[.,;:!?]$/.test(W[k].raw)?raw+" "+sp:raw;
      let per="";for(let j=k;j<W.length&&W[j].c<=W[k].c+1;j++){const r=periodAt(j);if(r){per=clean(words(...r));seen.add("p:"+per.toLowerCase());break}}
      labels.push({k,kind:"g",text:name+(per?" · "+per:"")});continue}
    const r=periodAt(k);if(r){const per=clean(words(...r)),key="p:"+per.toLowerCase();if(!seen.has(key)&&labels.filter(l=>l.kind==="p").length<2){seen.add(key);labels.push({k,kind:"p",text:per})}k=r[1]-1}}
  const lab=[];labels.sort((a,b)=>(a.kind==='g'?0:1)-(b.kind==='g'?0:1)||a.k-b.k).forEach(l=>{if(!lab.some(x=>Math.abs(W[x.k].t-W[l.k].t)<5))lab.push(l)});
  lab.sort((a,b)=>a.k-b.k).forEach(l=>add({t:W[l.k].t,end:W[l.k].t+3.5,lane:"txt",track:"V3",cat:"TEXT",mark:true,label:l.text,what:`Label "${l.text}", 3.5 s.`,why:"R7",quote:quoteOf(l.k)}));

  // Ambience (R8): one bed per act from its first place word.
  A.forEach(a=>{const [w0,w1]=actW[a.i];for(let k=w0;k<w1;k++){const s=ED_SET.find(x=>x[0].test(W[k].w));if(!s)continue;if(a.end-W[k].t<20)break;const lib=edLib(id,s[2]);
    add({t:W[k].t,end:a.end,lane:"amb",track:"A3",cat:"AMBIENCE",mark:true,label:s[1].split(",")[0],search:s[2],lib,what:`${s[1].charAt(0).toUpperCase()+s[1].slice(1)} ambience (first place word: "${clean(W[k].raw)}").${lib?` Placed from Sound library: ${lib.file}.`:""}`,why:"R8",quote:quoteOf(k)});break}});

  // Sound effects (R9-R14), capped at about 2 a minute; act and infographic whooshes come first.
  const cand=[];
  A.slice(1).forEach(a=>cand.push({t:a.start,pri:1,row:false,kind:"whoosh",label:"whoosh",search:["whoosh","transition","swoosh"],what:`Soft whoosh into act ${a.i+1}.`,why:"R14"}));
  igs.forEach(g=>cand.push({t:Math.max(0,g.t-4/30),pri:2,kind:"whoosh",label:"whoosh",search:["whoosh","swoosh","transition"],what:`Soft whoosh, 4 frames before ${g.file||g.name}.`,why:"R12",quote:g.quote}));
  W.forEach((x,k)=>{const c=C[x.c],early=c.num&&x.t-c.start<3,word=clean(x.raw);
    if(ED_W.reveal.test(x.w)&&!(c.num&&x.te-c.start<3))cand.push({t:Math.max(A[x.act].start,x.te-6),end:x.te,pri:3,kind:"riser",label:"riser",search:["riser","rise","tension"],what:`Low riser that ends on "${word}" (estimated, nudge by ear).`,why:"R11",quote:c.text});
    else if(ED_W.impact.test(x.w)&&!early)cand.push({t:x.t,pri:4,kind:"impact",label:word.toLowerCase(),search:[x.w,"impact","crack","hit"],what:`${/bite|bit|clamp/.test(x.w)?"Bite or crunch":/crack|snap|crunch|shatter/.test(x.w)?"Bone crack":"Heavy impact"} on "${word}" (estimated, nudge by ear).`,why:"R9",quote:c.text});
    else if(ED_W.creature.test(x.w)&&!early)cand.push({t:c.end+.05,pri:5,kind:"creature",label:word.toLowerCase(),search:[x.w.replace(/(?:ed|ing|s)$/,""),"growl","animal","creature"],what:`Creature sound (${word.toLowerCase()}) in the pause after "${edSnip(c.text,8,1)}".`,why:"R10",quote:c.text})});
  const sfx=[],sfxItems=[];cand.sort((a,b)=>a.pri-b.pri||a.t-b.t).forEach(x=>{if(x.t>=total-20&&x.pri>2)return;if(sfx.filter(y=>Math.abs(y.t-x.t)<30).length>=2||sfx.some(y=>Math.abs(y.t-x.t)<1.5))return;sfx.push(x)});
  sfx.sort((a,b)=>a.t-b.t).forEach(x=>{x.lib=edLib(id,x.search);sfxItems.push(add({...x,lane:"sfx",track:"A2",cat:"SFX",mark:true,what:x.what+(x.lib?` Placed from Sound library: ${x.lib.file}.`:""),why:x.why+(x.pri>2?", R13":"")}))});

  // Weak spots from the script check, mapped through the cues of their act.
  const nT=narrText(n),NA=narrActs(n),chk=scriptCheck(nT,{topic:scTopic(id),acts:NA});
  const timeAt=ch=>{let i=NA.findIndex(a=>ch<a.to+1);if(i<0)i=NA.length-1;const a=NA[i],nw=Math.max(1,wordsOf(nT.slice(a.from,a.to))),wb=wordsOf(nT.slice(a.from,Math.max(a.from,ch))),[w0,w1]=actW[i]||[0,0],k=Math.min(w1,w0+Math.round(wb*(w1-w0)/nw));return k<w1?W[k].t:A[i]?.end||total};
  const weak=chk.findings.filter(f=>!f.ok&&f.rule==="flat").map(f=>{const t0=timeAt(f.from),t1=Math.max(t0+1,timeAt(f.to));
    return add({t:t0,end:t1,lane:"mark",track:"marker",cat:"WEAK SPOT",mark:true,label:"weak spot",what:`Weak spot: ${parseInt(f.title)} words with no number, no danger word and no question (about ${Math.round(t1-t0)} s). Add a clip, a zoom-in or a sound accent.`,why:"check"})});
  add({t:Math.max(0,total-20),end:total,lane:"mark",track:"marker",cat:"END SCREEN",mark:true,label:"end screen",what:"End screen: no new graphics, calm pictures, music resolves.",why:"R18"});
  items.sort((a,b)=>a.t-b.t);
  const pics=w.edit?.pics?.sig===pkHash(shots.map(s=>s.text).join("|"))?w.edit.pics.list:null;
  return {id,p,title:p?.title||"",A,total,narr:A.reduce((x,a)=>x+a.secs,0),words:wordsOf(nT),shots,clips,igs,igLost,briefs:briefs.length,sfx:sfxItems,items,weak,pics,
    music:items.filter(x=>x.lane==="mus"),amb:items.filter(x=>x.lane==="amb"),labels:items.filter(x=>x.lane==="txt"&&x.why==="R7"),flows:flows.length}}

/* What Send to Premiere writes. */
function edSteps(P,tok){const d=work(P.id).edit||{},sent=tok?"{edit-guide.xml}":d.sent?.file||"edit-guide.xml",nm=f=>tok?`{${f}}`:(d.sent?.files||[]).find(x=>x.replace(/ \(\d+\)(?=\.\w+$)/,"")===f)||f,subs=nm("subtitles-youtube.srt"),cl=P.clips,cf=cl.filter(c=>c.found),cm=cl.filter(c=>!c.found),gf=P.igs.filter(g=>g.found),gm=P.igs.filter(g=>!g.found);
  const nums=a=>scList(a.map(g=>g.name.slice(0,2)));
  return [["import","Import the edit guide",`File › Import (Ctrl+I), pick 08 Premiere\\${sent}, then double-click the new sequence in the new bin. The act MP3s are on A1 with the 1 s pauses.`],
    ["shots",`Import ${nm("shots.srt")} as a caption track`,`Drag it onto the sequence. Each block is one suggested shot (${nf(P.shots.length)} in all), so cut V1 at the block edges. For YouTube Studio captions, upload 08 Premiere\\${subs}: it has the 1 s pauses, and 02 Narration\\subtitle.srt does not.`],
    ["clips","Check the video clips on V1",!cl.length?"This outline has no Flow prompts, so there are no clips to place.":(cf.length?`${plural(cf.length,"clip")} ${cf.length===1?"is":"are"} placed, video only.`:"No clip file was found yet.")+(cm.length?` Missing from 04 Video clips: ${scList(cm.map(c=>c.n))}.`:"")],
    ["images","Fill V1 with your images","One per shot block. Slow zoom from 100 to 108%, and alternate the direction (R4)."],
    ["igs","Check the infographics on V2",!P.briefs?"No infographic briefs yet. The Infographics step finds them.":(gf.length?`${nums(gf)} ${gf.length===1?"is":"are"} placed. Trim any render whose length differs from its brief.`:"None is made yet.")+(gm.length?` Make ${nums(gm)} in the Infographics step.`:"")+(P.igLost.length?` The sentence for ${scList(P.igLost)} was not found in the voice over.`:"")],
    ["text","Add the text labels at the TEXT markers",P.labels.length?`${plural(P.labels.length,"label")}: ${P.labels.slice(0,3).map(l=>l.label).join("; ")}${P.labels.length>3?"; …":""}. Act title cards are optional.`:"No genus name or period was found. Act title cards are optional."],
    ["music","Music on A4",`One bed per act: ${P.music.map(m=>`act ${m.act+1}: ${m.label}`).join("; ")}. Keep it 18 to 24 dB under the voice.`],
    ["amb","Ambience on A3",P.amb.length?P.amb.map(a=>`${edClock(a.t)} ${a.label}`).join(", ")+".":"No place word was found, so pick one quiet bed per act yourself."],
    ["sfx","Sound effects on A2",`Jump through the ${plural(P.sfx.length,"SFX marker")} (Window › Markers).`],
    ["weak","Fix the weak spots",P.weak.length?`At ${scList(P.weak.map(x=>edClock(x.t)))}: a new clip, a zoom-in or a sound accent.`:"The script check found none."],
    ["end","End screen in the last 20 seconds",`From ${edClock(Math.max(0,P.total-20))}: no new graphics, calm pictures, music resolves.`],
    ["export","Optional: export at about -14 LUFS","Loudness normalisation, true peak -1 dB (R19). Then press Mark as edited."]]}
function edFiles(P){const lib=ED.scan[P.id]?.library||"Downloads\\Terra Studio\\Sound library",line=x=>`${edClock(x.t)}${x.end&&x.end-x.t>=5?"-"+edClock(x.end):""}`;
  const srt=P.shots.map((s,i)=>`${i+1}\n${srtT(s.start)} --> ${srtT(s.end)}\n${(P.pics?.[i]||s.text).replace(/\s+/g," ").trim()}`).join("\n\n")+"\n";
  const subs=P.A.flatMap(a=>a.cues.map(c=>({start:a.start+c.start,end:a.start+c.end,text:c.text}))).map((c,i)=>`${i+1}\n${srtT(c.start)} --> ${srtT(c.end)}\n${c.text}`).join("\n\n")+"\n";
  const chapters=`CHAPTERS (paste into the YouTube description)\n\n${P.A.map(a=>`${edChap(a.start)} ${a.name.replace(/^act\s*\d+\s*[·:.-]?\s*/i,"")}`).join("\n")}\n\nThese times include the 1 second pause between acts, so they match the edit guide.\n`;
  const sec=(h,list)=>`${h}\n${list.length?list.map(x=>`${line(x)}  ${x.what}  Search: ${(x.search||[]).join(", ")}`).join("\n"):"(none)"}\n`;
  const sounds=`SOUND LIST: ${P.title}\n\nEvery music, ambience and sound effect idea in the edit guide, with words to search for.\n\nWhere to find sounds: YouTube Studio > Audio library. YouTube says its music and sound effects are copyright-safe and won't be claimed through Content ID. If a track is marked Creative Commons, credit the artist in the description.\nYour own files: put them in ${lib}. A file whose name holds a search word (for example "growl") is placed on its track by the next Send to Premiere.\nTimes inside a sentence are estimated, so nudge sound effects by ear.\n\n`
    +sec("MUSIC (A4)",P.music)+"\n"+sec("AMBIENCE (A3)",P.amb)+"\n"+sec("SOUND EFFECTS (A2)",P.sfx);
  const steps=edSteps(P,1),check=`EDIT CHECKLIST: ${P.title}\n${edClock(P.narr)} narration + ${P.A.length-1} pauses of 1 s = ${edClock(P.total)}\n\nFIRST IMPORT\n1. Open your Premiere project for this video, or make a new one.\n2. File > Import (Ctrl+I), choose 08 Premiere\\{edit-guide.xml}. If Premiere shows an import (translation) report, close it.\n3. A new bin appears in the Project panel. Double-click the sequence inside it.\n4. If a Link Media window opens, click Locate and pick the file whose name is shown in the window title. Keep "Relink others automatically" ticked; usually the rest relink too.\n5. Window > Markers shows every marker. Click one to jump to it.\n\nIN THIS ORDER\n`
    +steps.map(([,h,s],i)=>`${i+1}. ${h}\n   ${s}`).join("\n")+`\n\nWHAT GOES WHERE\n`+P.items.filter(x=>x.row!==false).map(x=>`${line(x)}  [${x.track}]  ${x.what}`).join("\n")+"\n";
  return {"shots.srt":srt,...(P.A.some(a=>a.cues.length)?{"subtitles-youtube.srt":subs}:{}),"sound-list.txt":sounds,"chapters.txt":chapters,"edit-checklist.txt":check}}
function edBody(P){const T={V1:[],V2:[],V3:[],A1:[],A2:[],A3:[],A4:[]},r3=x=>Math.round(x*1000)/1000;
  P.A.forEach(a=>T.A1.push({sub:"02 Narration",file:a.file,start:r3(a.start),end:r3(a.end),in:0,seconds:r3(a.secs)}));
  P.clips.filter(c=>c.found).forEach(c=>T.V1.push({sub:"04 Video clips",file:c.file,start:r3(c.t),end:r3(c.end),in:0,seconds:8}));
  P.igs.filter(g=>g.found).forEach(g=>T.V2.push({sub:"05 Infographics",file:g.file,start:r3(g.t),end:r3(g.end),in:0,seconds:r3(g.end-g.t)}));
  // A library sound never runs past the next one on its track. A riser ends on its word: it starts after the sound before it and stops where a sound inside it begins.
  const lib=(key,list)=>{const L=list.filter(x=>x.lib),N=L.filter(x=>x.kind!=="riser"),k=[];
    N.forEach((x,i)=>{const nx=N[i+1]?.t??Infinity,len=Math.min(x.lib.seconds,x.end?x.end-x.t:x.kind==="whoosh"?2:4,nx-x.t);
      if(len>=.2)k.push({file:x.lib.file,start:x.t,end:x.t+len,in:0,seconds:x.lib.seconds})});
    L.filter(x=>x.kind==="riser").forEach(x=>{const len=Math.min(x.lib.seconds,x.end-x.t),c={file:x.lib.file,start:x.end-len,end:x.end,in:Math.max(0,x.lib.seconds-len),seconds:x.lib.seconds};
      k.sort((a,b)=>a.start-b.start).forEach(q=>{if(q.end<=c.start||q.start>=c.end)return;if(q.end<=c.end-.2){c.in+=q.end-c.start;c.start=q.end}else c.end=Math.max(c.start,q.start)});
      if(c.end-c.start>=.2)k.push(c)});
    k.sort((a,b)=>a.start-b.start).forEach(c=>T[key].push({lib:true,file:c.file,start:r3(c.start),end:r3(c.end),in:r3(c.in),seconds:r3(c.seconds)}))};
  lib("A2",P.sfx);lib("A3",P.amb);lib("A4",P.music);
  const markers=P.items.filter(x=>x.mark).map(x=>({name:x.cat==="ACT"?`ACT ${x.label}`:x.label&&x.label!==x.cat.toLowerCase()?`${x.cat} · ${String(x.label).slice(0,40)}`:x.cat,comment:`${x.what} / ${x.track} / ${edWhy(x.why)}`,start:r3(x.t),...(x.end&&x.end-x.t>=1?{end:r3(x.end)}:{})}));
  return {folder:work(P.id).folder,title:P.title,seconds:r3(P.total),tracks:T,markers,files:edFiles(P)}}

async function edSend(id,st){const w=work(id);if(ED.send)return;const say=(m,err)=>{ED.msg=m;ED.err=!!err;ED.msgId=id;if(st){st.className="status"+(err?" err":"");st.textContent=m}};
  ED.send=id;say("Writing the edit guide into 08 Premiere…");edRender();
  try{const r=edReady(id);if(!r.ok)return say(r.stale?"Voice or script changed since the edit pack. Make the edit pack again first.":"The edit pack is not finished yet. Make it in Make video, step 8.",true);
    const name=w.folder||await ensureFolder(id);if(!name)return say(VF[id]?.error||"The video folder could not be made.",true);
    const S=await edScan(id,true);if(!S||S.error)return say(S?.error||"The video folder could not be read.",true);
    const P=edPlan(id),lost=P.A.filter(a=>!S.narration.includes(a.file));
    if(lost.length)return say(`${lost[0].file} is not in this video's 02 Narration folder. Open the video in Make video once so older files move in, or make the edit pack again.`,true);
    const j=await pkPost("/api/edit/premiere",edBody(P));if(j.error)return say(j.error,true);
    w.edit={...(w.edit||{}),sent:{at:Date.now(),file:j.guide,files:j.files}};await flushWork();
    say(`Saved in 08 Premiere: ${j.files.join(", ")}. In Premiere: File › Import, pick ${j.guide}, then double-click the new sequence.${j.library_made?` An empty Sound library folder is ready in ${j.library}.`:""}`);
    edScan(id,true).then(()=>edRender());advance(id,"edit")}
  finally{ED.send="";edRender()}}

/* Optional: one AI call suggests the picture for every shot. Off until pressed. */
function edPicsCost(P){return costTag({input_tokens:(channelContext().length+900+P.shots.reduce((x,s)=>x+s.text.length,0))/4,output_tokens:P.shots.length*14},"pics")}
async function edPics(btn){const id=ED.id,P=edPlan(id),st=$("#s-ed-ai");if(!P.shots.length)return;
  const d=await ask(st,btn,`For each numbered shot of this documentary narration, suggest the one picture to show: a short image description (at most 12 words) for an image search or an image generator. Prehistoric animals must look accurate for their time. Keep the list in order and give exactly ${P.shots.length} lines.
Shots:
${P.shots.map((s,i)=>`${i+1}. ${s.text}`).join("\n")}
JSON shape: {"pictures":["picture for shot 1","picture for shot 2"]}`,null,"AI is choosing a picture for each shot… (usually 30 to 90 seconds)");
  const list=Array.isArray(d?.pictures)?d.pictures.map(x=>String(x??"").replace(/\s+/g," ").trim().slice(0,160)):[];
  if(!d){const s2=!st.isConnected&&runCopy("pics")&&$("#s-ed-ai");if(s2){s2.className="status err";s2.textContent="The paste box was closed. Press Suggest shot pictures again."}return}if(list.length<P.shots.length*.9){st.className="status err";st.textContent=`Only ${list.length} of ${P.shots.length} pictures came back. Press the button once more.`;return}
  const w=work(id);w.edit={...(w.edit||{}),pics:{sig:pkHash(P.shots.map(s=>s.text).join("|")),at:Date.now(),list:P.shots.map((s,i)=>list[i]||s.text)}};saveWork();edRender();
  const s2=$("#s-ed-ai");if(s2){s2.className="status";s2.textContent=st.textContent.replace(", result saved","")+`. Saved: shots.srt now names a picture for each shot. Send to Premiere again to write it.`}}

/* Page */
function edOpen(id,where){if(!plans().some(p=>p.id===id))return;delete ED.scan[id];ED.view="detail";ED.id=id;ED.sel=-1;ED.focus=where||"head";show("edit")}
function edRender(){if($("#p-edit").hidden)return;const ok=ED.view==="detail"&&edPlans().some(p=>p.id===ED.id);if(!ok)ED.view="list";
  const fo=document.activeElement,key=fo&&fo.closest?.("#p-edit")?[...fo.attributes].find(a=>a.name.startsWith("data-ed")||a.name==="id"):null,kv=key?`[${key.name}="${CSS.escape(key.value)}"]`:"";
  if(ED.view==="detail")edDetail();else edList();
  if(kv&&document.activeElement!==fo)$("#p-edit "+kv)?.focus()}
function edFacts(P,short){const sounds=P.music.length+P.amb.length+P.sfx.length,f=P.igs.filter(g=>g.found).length;
  return short?[edClock(P.total),plural(P.A.length,"act"),P.briefs?`infographics ${f} of ${P.briefs} made`:"no infographic briefs",`${sounds} sound ideas`]
    :[`${edClock(P.narr)} narration`,`${edClock(P.total)} with act pauses`,plural(P.A.length,"act"),plural(P.words,"word"),`about ${nf(P.shots.length)} shots`,P.briefs?`infographics ${f} of ${P.briefs} made`:"no infographic briefs",`${sounds} sound ideas (${P.music.length} music, ${P.amb.length} ambience, ${P.sfx.length} SFX)`]}
function edList(){$("#el").hidden=false;$("#ed").hidden=true;const today=isoDay(new Date());
  const all=edPlans().sort((a,b)=>a.date.localeCompare(b.date)),rows=all.filter(p=>ED.pub||p.status!=="tayang"),S=Object.fromEntries(all.map(p=>[p.id,edState(p.id)]));
  all.forEach(p=>{if(S[p.id]!=="script"&&work(p.id).folder&&!ED.scan[p.id]&&!ED.scanP[p.id])edScan(p.id).then(()=>{if(ED.view==="list")edRender()})});
  const pick=all.find(p=>S[p.id]==="editing")||all.find(p=>S[p.id]==="ready"),plan=x=>edCanPlan(x.id)?edPlan(x.id):null,HP=pick&&plan(pick);
  setH($("#el-hero"),HP?`<div class="ed-hero"><div><small>${S[pick.id]==="editing"?"Continue editing":"Edit this next"}</small><b>${esc(pick.title)}</b><p>${esc([...edFacts(HP,1),"upload "+fmtShort(pick.date)].join(" · "))}</p></div><button type="button" class="btn" data-ed-hero="${esc(pick.id)}">Open edit plan</button></div>`:"");
  setH($("#el-rows"),rows.length?rows.map(p=>{const s=S[p.id],[lab,cls,next]=ED_ST[s],P=s!=="script"&&edCanPlan(p.id)?plan(p):null,w=work(p.id),b=w.briefs?.list?.length||0,fl=edFlow(p.id).length;
    const igN=b?`${P?P.igs.filter(g=>g.found).length:(w.briefs.list.filter((m,i)=>edIgFile(p.id,i,m)).length)} of ${b}`:"–",clN=fl?`${P?P.clips.filter(c=>c.found).length:edFlow(p.id).filter(c=>edClipFile(p.id,c)).length} of ${fl}`:"–";
    const ini=((w.topic||p.title||"?").trim()[0]||"?").toUpperCase(),late=s!=="pub"&&p.date<today;
    return `<tr data-ed-row="${esc(p.id)}"><td><div class="vd-name"><span class="vd-av" aria-hidden="true">${esc(ini)}</span><button type="button" class="vd-open" data-ed-open="${esc(p.id)}">${esc(p.title)}</button></div></td><td class="vd-mono">${esc(fmtShort(p.date))}${late?` <span class="vd-late">past due</span>`:""}</td><td><span class="ed-st ${cls}">${lab}</span></td><td class="vd-mono">${P?edClock(P.total):"–"}</td><td>${igN}</td><td>${clN}</td><td>${next?`<button type="button" class="btn sm${s==="ready"?"":" ghost"}" data-ed-next="${s}" data-ed-id="${esc(p.id)}"${ED.send===p.id?' aria-disabled="true"':""}>${ED.send===p.id?"Sending…":next}</button>`:"–"}</td></tr>`}).join("")
    :`<tr><td colspan="7" class="vd-none">${all.length?"Every long video is published. Switch on Show published to see them.":"No long videos yet. Start one in Make video, or add a plan in the Calendar."}</td></tr>`);
  const st=$("#s-el");if(ED.msgId&&ED.msg){st.className="status"+(ED.err?" err":"");st.textContent=(plans().find(p=>p.id===ED.msgId)?.title||"")+": "+ED.msg}else st.textContent=""}

function edTimeline(P){const E=ED.zoom==="hook"?Math.min(180,P.total):P.total,L=Math.max(1,E),pc=x=>(Math.min(Math.max(x,0),E)/L*100).toFixed(3)+"%",wd=(a,b)=>((Math.min(b,E)-Math.max(a,0))/L*100).toFixed(3)+"%";
  const vis=x=>x.t<E&&(x.end??x.t)>=0,idx=new Map(P.items.map((x,i)=>[x,i])),zoom=ED.zoom==="hook";
  const blk=(x,c,lab)=>vis(x)?`<span class="ed-blk ${c}" data-ei="${idx.get(x)}" style="left:${pc(x.t)};width:${wd(x.t,x.end??x.t+1)}" title="${esc(edClock(x.t)+" "+x.what)}">${lab?esc(x.label||""):""}</span>`:"";
  const tick=(x,c)=>vis(x)?`<span class="ed-tick ${c}" data-ei="${idx.get(x)}" style="left:${pc(x.t)}" title="${esc(edClock(x.t)+" "+x.what)}"></span>`:"";
  const lane=(name,track,html)=>`<div class="lab"><b>${name}</b><span>${track}</span></div><div class="lane">${html}</div>`,of=l=>P.items.filter(x=>x.lane===l);
  const step=zoom?30:E>900?180:120,marks=[];for(let t=0;t<=E;t+=step)marks.push(t);if(E-marks[marks.length-1]<step*.5)marks.pop();marks.push(E);
  const cuts=P.shots.filter(s=>s.start>0&&s.start<E).map(s=>`<i style="left:${pc(s.start)}"></i>`).join("");
  return `<div class="lab ed-rl" aria-hidden="true"></div><div class="ed-ruler" aria-hidden="true">${marks.map(t=>`<span style="left:${pc(t)}">${edClock(t)}</span>`).join("")}</div>`
    +lane("Narration","A1",of("act").map(x=>blk(x,"act",1)).join(""))
    +lane("Shots","V1",`<span class="ed-cuts">${cuts}</span>`+of("clip").map(x=>blk(x,"clip"+(x.found?"":" miss"),zoom)).join(""))
    +lane("Infographics","V2",of("ig").map(x=>blk(x,"ig"+(x.found?"":" miss"),zoom)).join(""))
    +lane("Text","V3",of("txt").map(x=>tick(x,"txt")).join(""))
    +lane("Sound effects","A2",of("sfx").map(x=>tick(x,"")).join(""))
    +lane("Ambience","A3",of("amb").map(x=>blk(x,"amb",1)).join(""))
    +lane("Music","A4",of("mus").map(x=>blk(x,"mus",1)).join(""))
    +lane("Markers","",of("mark").filter(x=>x.cat!=="HOOK").map(x=>x.cat==="PAUSE"?tick(x,"pause"):blk(x,"weak",1)).join(""))}
function edInfo(P){const x=P.items[ED.sel];if(!x)return `<p class="note">Click a block or a line on the timeline to see its sentence and the rule behind it.</p>`;
  const rules=String(x.why).match(/R\d+|check/g)||[];
  return `<p><b>${esc(edClock(x.t))}${x.end&&x.end-x.t>=5?"–"+esc(edClock(x.end)):""} · ${esc(x.track==="marker"?"Marker":x.track==="all"?"All tracks":x.track)}</b> · ${esc(x.what)}</p>${x.quote?`<p class="note">"${esc(edSnip(x.quote,40))}"</p>`:""}${rules.map(r=>`<p class="note"><b>${r==="check"?"Script check":r}:</b> ${esc(ED_RULES[r]||"")}</p>`).join("")}`}
function edDetail(){const id=ED.id,p=plans().find(x=>x.id===id),w=work(id),s=edState(id),[lab,cls]=ED_ST[s],today=isoDay(new Date()),R=edReady(id),can=edCanPlan(id);
  $("#el").hidden=true;$("#ed").hidden=false;$("#ed-h").textContent=p.title;setH($("#ed-pill"),`<span class="ed-st ${cls}">${lab}</span>`);
  if(can&&w.folder&&!ED.scan[id]&&!ED.scanP[id])edScan(id).then(()=>edRender());
  const msg=ED.msgId===id&&ED.msg?`<div class="status${ED.err?" err":""}" id="s-ed" role="status">${esc(ED.msg)}</div>`:`<div class="status" id="s-ed" role="status"></div>`;
  if(!can){$("#ed-sub").textContent=`Upload ${fmtShort(p.date)} · ${vdIn(daysBetween(today,p.date))}`;
    const noScript=s==="script";
    setH($("#ed-body"),`<section class="card ed-need" aria-labelledby="ed-need-h"><h3 id="ed-need-h">${noScript?"Write the script first":"Make the edit pack first"}</h3>
      <p class="sub">${noScript?"The edit plan is built from the script and its voice over. This video has no full script yet.":R.stale?"Voice or script changed since the edit pack. Times may be wrong. Make the edit pack again.":"The edit plan needs the edit pack: one MP3 per act with its subtitle timing. The long voice over from step 7 does not line up with the plan."}</p>
      <div class="chips"><button type="button" class="btn" data-ed-make="${noScript?"script":"pack"}">${noScript?"Write script":"Make edit pack"}</button></div>${msg}</section>`+edLimits());
    edFocus();return}
  const P=edPlan(id),S=ED.scan[id],lost=S&&!S.error?P.A.filter(a=>!S.narration.includes(a.file)):[],sendOk=R.ok&&!lost.length;
  $("#ed-sub").textContent=edFacts(P).join(" · ");
  const banner=!R.ok?`<div class="vd-warn" role="note"><p><b>${R.stale?"Voice or script changed since the edit pack.":"The edit pack does not match the script."}</b> Times may be wrong. Make the edit pack again.</p><div class="chips"><button type="button" class="btn ghost" data-ed-make="pack">Make edit pack</button></div></div>`
    :lost.length?`<div class="vd-warn" role="note"><p><b>${esc(lost[0].file)} is not in 02 Narration.</b> Open the video in Make video once so older files move into its folder, or make the edit pack again.</p></div>`
    :S?.error?`<div class="vd-warn" role="note"><p><b>The video folder could not be read.</b> ${esc(S.error)}</p></div>`:"";
  const sent=w.edit?.sent,done=w.edit?.done||{},steps=edSteps(P),rows=P.items.filter(x=>x.row!==false),idx=new Map(P.items.map((x,i)=>[x,i]));
  const busy=ED.send===id,track=x=>x.track==="marker"?"marker":x.track;
  const whatHtml=x=>x.lane==="ig"?esc(x.what).replace(esc(x.ok||x.miss),x.ok?`<span class="ed-ok">${esc(x.ok)}</span>`:`<span class="ed-miss">${esc(x.miss)}</span>`):esc(x.what);
  keepPaste("s-ed-ai",()=>setH($("#ed-body"),`<div class="chips ed-acts"><button type="button" class="btn" id="ed-send"${sendOk&&!busy?"":' aria-disabled="true"'}>${busy?"Sending…":sent?"Send to Premiere again":"Send to Premiere"}</button><button type="button" class="btn ghost" data-ed-folder="">Open video folder</button>${sent?`<button type="button" class="btn ghost" data-ed-folder="08 Premiere">Open 08 Premiere</button>`:""}</div>
    ${msg}${sent&&!(ED.msgId===id&&ED.msg)?`<p class="note ed-sent">Sent ${esc(vdWhen(sent.at))} as ${esc(sent.file)}. A new send makes a new file and a new sequence; your cuts in the old one stay.</p>`:""}${banner}
    <section class="card ed-card" aria-labelledby="ed-tl-h">
      <div class="vd-tbar"><h3 id="ed-tl-h">Edit timeline</h3><div class="seg" role="group" aria-label="Zoom"><button type="button" data-ed-zoom="all" aria-pressed="${ED.zoom!=="hook"}">Whole video</button><button type="button" data-ed-zoom="hook" aria-pressed="${ED.zoom==="hook"}">First 3 min</button></div></div>
      <div class="ed-tlw"><div class="ed-tl" role="img" aria-label="Timeline of ${esc(edClock(P.total))}: ${P.A.length} acts, ${P.shots.length} shots, ${P.igs.length} infographics, ${P.sfx.length} sound effects. The same items are listed in the table below.">${edTimeline(P)}</div></div>
      <div class="ed-legend" aria-hidden="true"><span><i class="act"></i>Narration</span><span><i class="clip"></i>Video clip</span><span><i class="ig"></i>Infographic made</span><span><i class="ig miss"></i>Missing</span><span><i class="sfx"></i>Sound effect</span><span><i class="amb"></i>Ambience</span><span><i class="mus"></i>Music</span><span><i class="weak"></i>Weak spot, end screen</span></div>
      <div class="ed-info" id="ed-info" aria-live="polite">${edInfo(P)}</div>
    </section>
    <section class="card ed-card" aria-labelledby="ed-what-h">
      <h3 id="ed-what-h">What goes where</h3>
      <p class="sub">The same list arrives in Premiere as markers. Times inside a sentence are estimated, so nudge sound effects by ear.</p>
      <div class="vd-tblw"><table class="ed-rows"><thead><tr><th scope="col">Time</th><th scope="col">Track</th><th scope="col">What to do</th><th scope="col">Why</th></tr></thead><tbody>${rows.map(x=>`<tr${idx.get(x)===ED.sel?' class="on"':""}><td class="vd-mono">${esc(edClock(x.t))}${x.end&&x.end-x.t>=5?"–"+esc(edClock(x.end)):""}</td><td><span class="ed-lane">${esc(track(x))}</span></td><td>${whatHtml(x)}</td><td class="ed-why">${esc(edWhy(x.why))}</td></tr>`).join("")}</tbody></table></div>
      <details class="mtable ed-rules"${ED.rules?" open":""}><summary>What the rules in Why mean</summary><ul class="ed-steps ed-rlist">${Object.entries(ED_RULES).map(([r,t])=>`<li><b>${r==="check"?"Script check":r}</b> ${esc(t)}</li>`).join("")}</ul></details>
    </section>
    <div class="ed-cols">
      <section class="card ed-card" aria-labelledby="ed-chk-h">
        <h3 id="ed-chk-h" tabindex="-1">In Premiere, in this order</h3>
        <ul class="ed-check">${steps.map(([k,h,sm])=>`<li><label><input type="checkbox" data-ed-tick="${k}"${done[k]?" checked":""}><span>${esc(h)}<small>${esc(sm)}</small></span></label></li>`).join("")}</ul>
        ${s==="edited"||s==="pub"?`<p class="note">${s==="pub"?"Published.":"Marked as edited."} Next: the upload checklist.</p><div class="chips"><button type="button" class="btn ghost" data-ed-make="upload">Upload checklist</button></div>`:`<div class="chips"><button type="button" class="btn ghost" id="ed-edited">Mark as edited</button></div>`}
      </section>
      <section class="card ed-card" aria-labelledby="ed-send-h">
        <h3 id="ed-send-h">What Send to Premiere writes</h3>
        <ul class="ed-files">
          <li><code>edit-guide.xml</code><span>A Premiere sequence: act MP3s on A1, ${plural(P.clips.filter(c=>c.found).length,"video clip")} and ${plural(P.igs.filter(g=>g.found).length,"infographic")} placed, everything else as named markers.</span></li>
          <li><code>shots.srt</code><span>One block per suggested shot, for cutting.${P.pics?" Each block names a picture.":""}</span></li>
          <li><code>sound-list.txt</code><span>Every music, ambience and sound effect idea with its time and words to search for in YouTube's Audio library.</span></li>
          <li><code>subtitles-youtube.srt</code><span>Captions for YouTube Studio, timed with the 1 s pauses.</span></li>
          <li><code>chapters.txt</code><span>Real chapter times for the description (${esc(P.A.map(a=>edClock(a.start)).join(", "))}).</span></li>
          <li><code>edit-checklist.txt</code><span>The checklist on the left, with times.</span></li>
        </ul>
        <p class="sub">All in <b>08 Premiere</b>. Nothing is overwritten: a second send saves "edit-guide (2).xml".</p>
        <h4>First import</h4>
        <ol class="ed-steps">
          <li>Open your Premiere project for this video, or make a new one.</li>
          <li><b>File › Import</b> (Ctrl+I), then choose 08 Premiere\\${esc(sent?.file||"edit-guide.xml")}. If Premiere shows an import report, close it.</li>
          <li>A new bin appears in the Project panel. <b>Double-click the sequence</b> inside it.</li>
          <li>If a <b>Link Media</b> window opens, click Locate and pick the file whose name is in the window title. Keep "Relink others automatically" ticked; usually the rest follow.</li>
          <li><b>Window › Markers</b> lists every marker. Click one to jump to it.</li>
        </ol>
        <h4>Your own sounds (optional)</h4>
        <p class="sub">Put sound files in the Sound library folder. A file whose name holds a search word, like "growl" or "cave", is placed on its track by the next send. ${S?.sounds?.length?`${plural(S.sounds.length,"file")} there now; ${P.sfx.concat(P.amb,P.music).filter(x=>x.lib).length} placed.`:"It is empty now, so sounds arrive as markers."}</p>
        <div class="chips"><button type="button" class="btn ghost" id="ed-lib">Open Sound library</button></div>
        <h4>Picture ideas (optional)</h4>
        <p class="sub">${P.pics?`Saved ${esc(vdWhen(w.edit.pics.at))}: shots.srt names a picture for each shot.`:"One AI call suggests a picture for each shot block. Without it, each block shows its narration."}</p>
        ${runW("pics")}<div class="chips"><button type="button" class="btn ghost" id="ed-pics" data-run="pics" data-base="${esc((P.pics?"Suggest shot pictures again":"Suggest shot pictures")+edPicsCost(P))}">${runTxt("pics",P.pics?"Suggest shot pictures again":"Suggest shot pictures")}${edPicsCost(P)}</button></div><div class="status" id="s-ed-ai" role="status"></div>
      </section>
    </div>`+edLimits()));
  edFocus()}
function edLimits(){return `<section class="card ed-card ed-lim" aria-labelledby="ed-lim-h"><h3 id="ed-lim-h">Honest limits</h3><ul>
  <li><b>Times come from the edit pack MP3s</b> (one per act), not the long voice over from step 7. A video needs its edit pack first, and making one for an older video uses ElevenLabs characters.</li>
  <li><b>Sound effect and label times are estimated inside a sentence,</b> so they can be about half a second off. Nudge them by ear.</li>
  <li><b>Your images are not placed for you.</b> The shot blocks show where each one goes. Text labels and sounds arrive as markers.</li>
  <li><b>Each import makes a new sequence,</b> so send before you start cutting.</li>
  <li><b>The shot, sound and music rules are habits of good documentaries, not a promise of views.</b> After 3 to 5 uploads, compare with the retention graph in YouTube Studio and adjust.</li>
  <li><b>Music and sound files are yours to pick and license.</b> The app never downloads or makes sound.</li>
  <li><b>Not tested in Premiere yet.</b> The edit guide follows the Final Cut Pro 7 XML that Premiere imports. If your first import asks to relink, relinking one file usually fixes the rest.</li></ul></section>`}
function edFocus(){if(!ED.focus)return;const f=ED.focus;ED.focus=false;(f==="check"?$("#ed-chk-h"):$("#ed-h"))?.focus();if(f==="check")$("#ed-chk-h")?.scrollIntoView({block:"start"})}

$("#el-pub").addEventListener("change",e=>{ED.pub=e.target.checked;edRender()});
$("#p-edit").addEventListener("click",async e=>{const t=e.target;let b;
  if((b=t.closest("[data-ed-hero]")))return edOpen(b.dataset.edHero);
  if((b=t.closest("[data-ed-next]"))){const id=b.dataset.edId,k=b.dataset.edNext;
    if(k==="script")return openMake(id,"script");if(k==="pack")return openMake(id,"pack");if(k==="edited")return openMake(id,"upload");
    if(k==="editing")return edOpen(id,"check");if(k==="ready"){if(b.getAttribute("aria-disabled")!=="true")edSend(id,$("#s-el"));return}}
  if((b=t.closest("[data-ed-open]")))return edOpen(b.dataset.edOpen);
  if((b=t.closest("[data-ed-row]"))&&!t.closest("button"))return edOpen(b.dataset.edRow);
  if(t.closest("#ed-back")){const id=ED.id;ED.view="list";edRender();$("#main").scrollTop=0;$(`[data-ed-open="${CSS.escape(id)}"]`)?.focus();return}
  if((b=t.closest("[data-ed-make]")))return openMake(ED.id,b.dataset.edMake);
  if((b=t.closest("[data-ed-zoom]"))){ED.zoom=b.dataset.edZoom;edRender();return}
  if((b=t.closest("[data-ei]"))){ED.sel=+b.dataset.ei;edRender();return}
  if((b=t.closest("#ed-send"))){if(b.getAttribute("aria-disabled")!=="true")edSend(ED.id,$("#s-ed"));return}
  if((b=t.closest("#ed-edited"))){b.disabled=true;await advance(ED.id,"siap");ED.msg="Marked as edited. The Dashboard and the Calendar show it as ready to upload.";ED.err=false;ED.msgId=ED.id;edRender();$("#ed-chk-h")?.focus();return}
  if((b=t.closest("#ed-pics")))return edPics(b);
  if(t.closest("#ed-lib")){const r=await pkPost("/api/edit/library",{});const st=$("#s-ed");st.className=r.error?"status err":"status";st.textContent=r.error||`Opened ${r.dir} in Explorer.`;edScan(ED.id,true).then(()=>edRender());return}
  if((b=t.closest("[data-ed-folder]"))){const id=ED.id,name=await ensureFolder(id),st=$("#s-ed"),sub=b.dataset.edFolder;if(!name){st.className="status err";st.textContent=VF[id]?.error||"The video folder could not be made.";return}
    const r=await pkPost("/api/video/open",{name,...(sub?{sub}:{})});st.className=r.error?"status err":"status";st.textContent=r.error||`Opened ${sub||"the video folder"} in Explorer.`}});
$("#p-edit").addEventListener("toggle",e=>{if(e.target.classList?.contains("ed-rules"))ED.rules=e.target.open},true);
$("#p-edit").addEventListener("change",e=>{const c=e.target.closest("[data-ed-tick]");if(!c)return;const w=work(ED.id);w.edit={...(w.edit||{}),done:{...(w.edit?.done||{}),[c.dataset.edTick]:c.checked}};saveWork()});
document.addEventListener("click",e=>{const b=e.target.closest("#vd [data-ed-open]");if(b)edOpen(b.dataset.edOpen)});

// Ideas saved by 1.x have no animal facts, so they can't be scored; leave the empty state instead.
const RENDER={ideas:d=>d?.ideas?.length&&"subject" in d.ideas[0]&&(renderIdeas(d.ideas,d.want),true),shorts:d=>d?.shorts?.length&&(renderShorts(d.shorts),true),ai:d=>d&&(renderAI(d),true)};
async function loadLast(){const j=await api("/api/last");if(!j||j.error)return;LAST=j;
  for(const [k,f] of Object.entries(RENDER)){const r=LAST[k];if(!r)continue;try{if(f(r.data)){const st=$("#s-"+k);if(st){st.className="status";st.textContent="Last result, made "+new Date(r.at).toLocaleString("en-US",{day:"numeric",month:"short",hour:"2-digit",minute:"2-digit"})+". No credit is used again."}}}catch{}}
  $("#cfg-spent").textContent=spentText();$("#cfg-ispent").textContent=imgSpentText()}
api("/api/skin?skin="+(isDark()?"batu":"terang"),{method:"POST"});
(async()=>{$("#script-words").value=Math.min(8000,Math.max(500,store.get("sw",2000)));scriptLen();skinName();setNav(navOpen());await loadConfig();await loadData();await loadLast();await vdMigrateLast().catch(()=>{});thumbFollow().catch(()=>{});show(store.get("ver2",false)?store.get("tab","today"):"today",true);store.set("ver2",true);
  if(CFG.yt_connected&&Date.now()/1000-(CFG.yt_synced||0)>6*3600)ytSync(null,null)})();
</script>
