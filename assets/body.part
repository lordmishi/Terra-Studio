<a class="skip" href="#main">Lewati ke konten</a>
<div class="shell">
  <aside class="rail">
    <h1 class="sr">Terra Studio</h1>
    <img class="logo" src="/logo.png" width="40" height="40" alt="Terra Studio">
    <nav class="tabs" role="tablist" aria-label="Menu" aria-orientation="vertical">
      <button role="tab" id="t-today" aria-selected="true" data-tab="today"><svg viewBox="0 0 14 14" aria-hidden="true"><path d="M12 9.5a1 1 0 0 1 1 1V12a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1v-1.5a1 1 0 0 1 1-1z"/><path d="M7 1a1 1 0 0 1 1 1v4.5a1 1 0 0 1-1 1H1.932a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1z"/><path d="M12.469 1a.5.5 0 0 1 .5.5v1.25a.5.5 0 0 1-.5.5H10.5a.5.5 0 0 1-.5-.5V1.5a.5.5 0 0 1 .5-.5z"/><path d="M12.469 5.25a.5.5 0 0 1 .5.5V7a.5.5 0 0 1-.5.5H10.5A.5.5 0 0 1 10 7V5.75a.5.5 0 0 1 .5-.5z"/></svg><span>Hari ini</span></button>
      <button role="tab" id="t-ideas" aria-selected="false" data-tab="ideas"><svg viewBox="0 0 14 14" aria-hidden="true"><path d="M11.5 5.031a4.5 4.5 0 1 0-6.5 4v1.5a.5.5 0 0 0 .5.5h3a.5.5 0 0 0 .5-.5v-1.5a4.48 4.48 0 0 0 2.5-4"/><path d="M5 13.5h4"/></svg><span>Ide</span></button>
      <button role="tab" id="t-make" aria-selected="false" data-tab="make"><svg viewBox="0 0 14 14" aria-hidden="true"><path d="M10 3.5v8a2 2 0 0 1-2 2H.5a2 2 0 0 0 2-2v-9a2 2 0 0 1 2-2h7.25"/><path d="M11.75.5a1.75 1.75 0 0 1 1.75 1.75V3a.5.5 0 0 1-.5.5h-3V2.25A1.75 1.75 0 0 1 11.75.5"/><path d="M6 4h1.5"/><path d="M5 7h2.5"/><path d="M5 10h2.5"/></svg><span>Buat video</span></button>
      <button role="tab" id="t-learn" aria-selected="false" data-tab="learn"><svg viewBox="0 0 14 14" aria-hidden="true"><path d="M.5 13.5h13"/><path d="m1.5 10 3.5-4 3 2.5 4.5-6.5"/><path d="M10.5 2h2v2"/></svg><span>Pelajari</span></button>
      <button role="tab" id="t-dash" aria-selected="false" data-tab="dash"><svg viewBox="0 0 14 14" aria-hidden="true"><path d="M1.5 2.5h11a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1h-11a1 1 0 0 1-1-1v-9a1 1 0 0 1 1-1zM.5 6h13M4 .5v3M10 .5v3"/></svg><span>Kalender</span></button>
      <button role="tab" id="t-growth" aria-selected="false" data-tab="growth"><svg viewBox="0 0 14 14" aria-hidden="true"><path d="m1.24 6.54 11.5-5.23"/><path d="m10.59.5 2.15.81-.8 2.15"/><path d="M13.25 13.5h-2.5v-7a.5.5 0 0 1 .5-.5h1.5a.5.5 0 0 1 .5.5z"/><path d="M8.25 13.5h-2.5V8a.5.5 0 0 1 .5-.5h1.5a.5.5 0 0 1 .5.5z"/><path d="M3.25 13.5H.75v-4a.5.5 0 0 1 .5-.5h1.5a.5.5 0 0 1 .5.5z"/></svg><span>Data &amp; cuan</span></button>
      <button role="tab" id="t-settings" aria-selected="false" data-tab="settings"><svg viewBox="0 0 14 14" aria-hidden="true"><path d="m5.23 2.25.43-1.11A1 1 0 0 1 6.59.5h.82a1 1 0 0 1 .93.64l.43 1.11 1.46.84 1.18-.18a1 1 0 0 1 1 .49l.4.7a1 1 0 0 1-.08 1.13l-.73.93v1.68l.75.93a1 1 0 0 1 .08 1.13l-.4.7a1 1 0 0 1-1 .49l-1.18-.18-1.46.84-.43 1.11a1 1 0 0 1-.93.64h-.84a1 1 0 0 1-.93-.64l-.43-1.11-1.46-.84-1.18.18a1 1 0 0 1-1-.49l-.4-.7a1 1 0 0 1 .08-1.13L2 7.84V6.16l-.75-.93a1 1 0 0 1-.08-1.13l.4-.7a1 1 0 0 1 1-.49l1.18.18zM5 7a2 2 0 1 0 4 0 2 2 0 0 0-4 0"/></svg><span>Pengaturan</span></button>
    </nav>
    <div class="rail-sp"></div>
    <button type="button" class="rail-plus" id="rail-plus" aria-label="Rencana konten baru" data-tip="Rencana baru">+</button>
    <button type="button" class="skin" id="skin-tog" aria-label="Ganti tema" data-tip="Tema: batu / lumut"><i></i></button>
    <p class="ver">v2.0.2</p>
  </aside>
  <aside class="side" aria-label="Kalender dan jadwal">
    <div class="box calw">
      <div class="calw-hd"><span class="calw-ic"><svg viewBox="0 0 14 14" aria-hidden="true"><path d="M1.5 2.5h11a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1h-11a1 1 0 0 1-1-1v-9a1 1 0 0 1 1-1zM.5 6h13M4 .5v3M10 .5v3"/></svg></span><div><h2>Kalender upload</h2><small id="mc-sub">Rencana dan video tayang</small></div><button type="button" class="ic-btn" data-goto="dash" id="mc-open" aria-label="Buka kalender bulan di Dashboard"><svg viewBox="0 0 14 14" aria-hidden="true"><path d="M4 10 10 4M5 4h5v5"/></svg></button></div>
      <div class="pills" role="group" aria-label="Jenis konten" id="mc-pills"><button type="button" aria-pressed="true" data-f="all">Semua</button><button type="button" aria-pressed="false" data-f="video">Video</button><button type="button" aria-pressed="false" data-f="short">Shorts</button><button type="button" aria-pressed="false" data-f="post">Post</button></div>
      <div class="mc" id="mc" role="group" aria-label="Kalender bulan ini, pakai tombol panah untuk pindah tanggal"></div>
      <div class="mc-ft"><button type="button" class="ic-btn" id="mc-prev" aria-label="Bulan sebelumnya">&larr;</button><b id="mc-title"></b><button type="button" class="ic-btn" id="mc-next" aria-label="Bulan berikutnya">&rarr;</button></div>
    </div>
    <div class="next" id="next-up"></div>
    <div class="box stages"><h2>Status produksi</h2><ul id="stages"></ul></div>
  </aside>
  <main class="main" id="main">
    <header class="topbar">
      <div><h2 id="page-title" class="page-title">Dashboard</h2><div class="meter" id="meter"></div></div>
      <div class="actions"><span class="ch-name" id="hdr-channel"></span><button type="button" class="btn ghost" data-goto="growth">Perbarui data Studio</button></div>
    </header>
<div class="wrap">
  <div class="banner" id="banner-key" hidden>
    <span><strong>Mode salin-tempel ke claude.ai.</strong> Supaya hasil AI langsung jadi di aplikasi tanpa biaya, pilih Gemini di Pengaturan dan tempel API key gratis dari Google.</span> <button type="button" class="btn ghost" data-goto="settings">Buka Pengaturan</button><button type="button" class="btn ghost" id="banner-close">Tutup</button>
  </div>

  <!-- TODAY: the one thing holding the channel back, from its own numbers -->
  <section id="p-today" role="tabpanel" aria-labelledby="t-today">
    <div id="td-empty" class="card" hidden>
      <span class="layer">Belum ada data video</span>
      <h3>Hari ini butuh angka channel Anda</h3>
      <p class="note">Sambungkan YouTube atau impor file Konten dari YouTube Studio. Setelah itu halaman ini menunjukkan masalah terbesar channel dan tiga langkah untuk minggu ini.</p>
      <button type="button" class="btn" data-goto="growth">Buka Data &amp; cuan</button>
    </div>
    <div id="td-full" class="stack">
      <div class="dx">
        <div>
          <span class="eyebrow">Masalah terbesar saat ini</span>
          <h2 class="disp" id="dx-h"></h2>
          <div id="dx-p"></div>
          <div class="chips"><button type="button" class="btn" id="dx-go"></button><button type="button" class="btn ghost" data-goto="learn">Lihat semua upload</button></div>
        </div>
        <div class="cmpb" id="dx-cmp"></div>
      </div>
      <div class="vitals" id="td-vitals"></div>
      <div class="td2">
        <div class="box">
          <h2>Minggu ini</h2>
          <p class="sub">Tiga langkah, dipilih dari angka Anda. Centang kalau sudah.</p>
          <ul class="moves" id="td-moves"></ul>
        </div>
        <div class="box">
          <h2>Upload terakhir, dinilai</h2>
          <p class="sub" id="td-last-sub"></p>
          <div id="td-grade"></div>
        </div>
      </div>
    </div>
    <div class="box">
      <div class="bx-hd"><div><h2>Video yang sedang dikerjakan</h2><p class="sub">Tiap video bergerak dari kiri ke kanan. Klik untuk membukanya di Buat video.</p></div><button type="button" class="btn ghost" id="td-new">+ Video baru</button></div>
      <div class="pipe" id="td-pipe"></div>
    </div>
  </section>

  <!-- LEARN: every upload graded against the channel's own best -->
  <section id="p-learn" role="tabpanel" aria-labelledby="t-learn" hidden>
    <div id="ln-empty" class="card" hidden>
      <span class="layer">Belum ada data video</span>
      <h3>Rapor muncul setelah data video masuk</h3>
      <button type="button" class="btn" data-goto="growth">Buka Data &amp; cuan</button>
    </div>
    <div id="ln-full" class="stack">
      <div class="box">
        <h2>Berapa bagian tiap video yang ditonton</h2>
        <p class="sub" id="ln-sub"></p>
        <div class="rchart" id="ln-chart"></div>
        <div class="lgd"><span><i style="background:var(--accent)"></i>20% atau lebih: dekat video terbaik</span><span><i style="background:var(--warn)"></i>Di bawah 10%: penonton pergi cepat</span><span><i style="background:var(--stone-dot)"></i>Di antaranya</span></div>
      </div>
      <div class="box">
        <h2>Rapor tiap upload</h2>
        <p class="sub">Setiap upload dibandingkan dengan 6 video terbaik Anda, dari data terakhir yang ditarik. Satu pelajaran per video untuk video berikutnya.</p>
        <div class="tblw"><table class="rc" id="ln-cards"></table></div>
      </div>
    </div>
  </section>

  <!-- CALENDAR -->
  <section id="p-dash" role="tabpanel" aria-labelledby="t-dash" hidden>
    <div class="paper">
      <div class="pp-head">
        <h2 class="disp" id="wk-title">7 hari ke depan</h2>
        <div class="seg" role="group" aria-label="Tampilan"><button type="button" aria-pressed="true" data-view="week">7 hari</button><button type="button" aria-pressed="false" data-view="month">Bulan</button></div>
        <div class="pp-nav"><button type="button" class="btn ghost" id="wk-today">Hari ini</button><button type="button" class="btn ghost icon" id="wk-prev" aria-label="Sebelumnya">&lsaquo;</button><button type="button" class="btn ghost icon" id="wk-next" aria-label="Berikutnya">&rsaquo;</button></div>
      </div>
      <div class="pp-row">
        <label class="search"><svg viewBox="0 0 14 14" aria-hidden="true"><path d="M6 11a5 5 0 1 0 0-10 5 5 0 0 0 0 10M13.5 13.5 9.6 9.6"/></svg><input id="pp-q" type="search" placeholder="Cari rencana atau video" aria-label="Cari rencana atau video"></label>
        <button type="button" class="btn" id="plan-new">+ Jadwalkan konten</button>
      </div>
      <div id="wk" class="wk"></div>
      <div id="cal-wrap" hidden>
        <div class="cal-legend"><span class="cl pub">Sudah tayang</span><span class="cl video">Rencana video</span><span class="cl short">Rencana Shorts</span><span class="cl post">Rencana post</span></div>
        <div class="cal" id="cal" role="group" aria-label="Kalender bulan"></div>
      </div>
      <p class="pp-note" id="pp-note">Klik kotak + untuk menambah rencana, klik kartu untuk mengubah status atau menambah thumbnail.</p>
    </div>
    <div class="bot">
      <div class="box vchart"><div class="bx-hd"><div><h2>Views harian</h2><p class="sub" id="vc-sub"></p></div><button type="button" class="ic-btn" data-goto="growth" aria-label="Buka Data dan cuan"><svg viewBox="0 0 14 14" aria-hidden="true"><path d="M1 13h12M3.5 10V7M7 10V3M10.5 10V5.5"/></svg></button></div><div id="vc" class="vc"><p class="loading">Memuat data…</p></div></div>
      <div class="box topv"><div class="bx-hd"><div><h2>Video teratas</h2><p class="sub">Views dan CTR, sepanjang data</p></div></div><ul id="topv"><li class="loading">Memuat data…</li></ul></div>
      <div class="box sum"><h2>Ringkasan</h2><div id="sum"><p class="loading">Memuat data…</p></div></div>
    </div>
  </section>

  <dialog id="plan-dlg" aria-labelledby="plan-dlg-title">
    <form method="dialog" id="plan-form" class="tool">
      <h2 id="plan-dlg-title">Rencana konten</h2>
      <label for="pl-title">Judul<input id="pl-title" required maxlength="140"></label>
      <div class="row2">
        <label for="pl-date">Tanggal tayang<input id="pl-date" type="date" required></label>
        <label for="pl-type">Jenis<select id="pl-type"><option value="video">Video panjang</option><option value="short">Shorts</option><option value="post">Post komunitas</option></select></label>
      </div>
      <label for="pl-status">Status<select id="pl-status"><option value="ide">Ide</option><option value="naskah">Naskah</option><option value="rekam">Rekam / voice over</option><option value="edit">Edit</option><option value="siap">Siap upload</option><option value="tayang">Sudah tayang</option></select></label>
      <label for="pl-note">Catatan<textarea id="pl-note" rows="3"></textarea></label>
      <div class="pl-thumb"><span id="pl-thumb-box"></span><div><span class="lbl">Thumbnail (opsional)</span><div class="chips"><button type="button" class="btn ghost" id="pl-thumb-pick">Pilih gambar</button><button type="button" class="btn ghost" id="pl-thumb-del" hidden>Hapus gambar</button></div><input type="file" id="pl-thumb-file" accept="image/jpeg,image/png,image/webp" hidden></div></div>
      <div class="confirm"><button class="btn" value="save" id="pl-save">Simpan</button><button class="btn ghost" value="cancel" formnovalidate>Batal</button><button class="btn ghost danger" type="button" id="pl-del">Hapus</button><button class="btn ghost" type="button" id="pl-tools">Buka di Buat video</button></div>
    </form>
  </dialog>

  <!-- IDEAS -->
  <section id="p-ideas" role="tabpanel" aria-labelledby="t-ideas" hidden>
    <div class="box" id="id-pattern-box">
      <h2>Kesamaan video terbaik Anda</h2>
      <p class="sub" id="id-pattern-sub"></p>
      <div class="pattern" id="id-pattern"></div>
      <p class="sub" id="id-pattern-note" style="margin-top:12px"></p>
    </div>
    <div class="panel">
    <form class="tool" id="f-ideas">
      <h2>Cari topik berikutnya</h2>
      <p class="hint">AI mengusulkan topik, lalu aplikasi memberi skor 0 sampai 5 menurut pola video terbaik Anda. Judul video lama dipakai supaya tidak ada ide yang berulang.</p>
      <label for="ideas-focus">Fokus tema (opsional)<input id="ideas-focus" placeholder="mis. predator mamalia Zaman Es"></label>
      <div class="row2">
        <label for="ideas-n">Jumlah ide<input id="ideas-n" type="number" min="3" max="12" value="6"></label>
        <label for="ideas-freq">Upload / bulan
          <select id="ideas-freq"><option value="2">2 video</option><option value="4" selected>4 video</option><option value="8">8 video</option></select>
        </label>
      </div>
      <label for="ideas-start">Mulai tanggal<input id="ideas-start" type="date"></label>
      <label for="ideas-avoid">Topik yang sudah dibuat<textarea id="ideas-avoid" placeholder="Terisi otomatis setelah impor data Studio"></textarea></label>
      <button class="btn" type="submit">Cari ide</button>
      <div class="status" id="s-ideas" role="status"></div>
    </form>
    <div class="out" id="o-ideas"><div class="empty">Ide akan muncul di sini, masing-masing dengan skor kecocokan dengan video terbaik Anda. Isi form di samping, lalu tekan <strong>Cari ide</strong>.</div></div>
    </div>
  </section>

  <!-- MAKE: one video, from title to upload -->
  <section id="p-make" role="tabpanel" aria-labelledby="t-make" hidden>
    <div class="box mk-head">
      <div class="mk-auto">
        <div><b id="mk-auto-h">Belum tahu mau bikin apa?</b><span id="mk-auto-p">AI memilih topik yang cocok dengan video terbaik Anda, lalu mengisi judul, teks thumbnail, dan hook. Anda tinggal mengecek.</span></div>
        <div class="chips"><button type="button" class="btn" id="mk-auto">Sarankan video berikutnya</button><button type="button" class="btn ghost" id="mk-auto-new" hidden>Topik lain</button></div>
      </div>
      <div class="status" id="s-auto" role="status"></div>
      <div class="mk-pick">
        <label for="mk-pick">Video<select id="mk-pick"></select></label>
        <label for="mk-topic">Topik atau nama hewan<input id="mk-topic" placeholder="mis. Pachycrocuta" maxlength="140"></label>
      </div>
      <div class="mk-stages" role="tablist" aria-label="Tahap video" id="mk-stages">
        <button type="button" role="tab" id="ms-pkg" aria-controls="mk-pkg" aria-selected="true" data-stage="pkg">1. Paket</button>
        <button type="button" role="tab" id="ms-hook" aria-controls="mk-hook-st" aria-selected="false" data-stage="hook" tabindex="-1">2. Hook</button>
        <button type="button" role="tab" id="ms-script" aria-controls="mk-script" aria-selected="false" data-stage="script" tabindex="-1">3. Naskah &amp; suara</button>
        <button type="button" role="tab" id="ms-seo" aria-controls="mk-seo" aria-selected="false" data-stage="seo" tabindex="-1">4. Terbit</button>
      </div>
    </div>

    <div id="mk-pkg" role="tabpanel" aria-labelledby="ms-pkg" class="stack">
      <div class="td2">
        <div class="box">
          <h2>Judul dulu, sebelum menulis</h2>
          <p class="sub">Kalau tidak ada judul yang bikin penasaran, ganti topik. Pilih satu judul; pilihan ini dipakai di thumbnail, hook, dan SEO.</p>
          <label for="mk-titles" style="margin-top:12px">Calon judul, satu per baris<textarea id="mk-titles" rows="4" placeholder="The 250 lb Hyena That Ate Our Ancestors"></textarea></label>
          <div class="tlist" id="mk-tlist" role="radiogroup" aria-label="Judul yang dipakai"></div>
          <p class="sub" style="margin-top:10px">Cek: <b>≤60</b> muat di layar HP · <b>Ukuran</b> angka yang bisa dibayangkan · <b>Ancaman</b> bahaya bagi manusia atau saingan · <b>Nama</b> nama hewan, untuk pencarian.</p>
          <div class="chips" style="margin-top:12px"><button type="button" class="btn ghost" id="mk-titles-ai">Minta 5 judul dari AI</button></div>
          <div class="status" id="s-titles" role="status"></div>
        </div>
        <div class="box">
          <h2>Teks thumbnail</h2>
          <p class="sub">Maksimal 4 kata. Satu hewan, satu ancaman, kontras besar. Teks ini melengkapi judul, jangan mengulangnya.</p>
          <label for="mk-thumbtext" style="margin-top:12px">Teks di thumbnail<input id="mk-thumbtext" maxlength="40" placeholder="ATE OUR ANCESTORS"></label>
          <div class="mk-thumb" id="mk-thumbprev" aria-hidden="true"><span></span></div>
          <p class="note" id="mk-thumbnote"></p>
        </div>
      </div>
      <div class="panel" id="mk-thumbtool">
    <form class="tool" id="f-thumb">
      <h2>Konsep thumbnail</h2>
      <p class="hint">Tiga konsep berbeda: teks maksimal 4 kata, prompt gambar siap pakai untuk Google Flow, komposisi, dan alasan orang akan mengklik.</p>
      <label for="thumb-topic">Topik video<input id="thumb-topic" required></label>
      <label for="thumb-title">Judul yang dipakai (opsional)<input id="thumb-title"></label>
      <label for="thumb-style">Gaya visual
        <select id="thumb-style"><option>Photoreal cinematic</option><option>Painted illustration</option><option>Dark documentary, high contrast</option><option>Bold minimal graphic</option></select>
      </label>
      <button class="btn" type="submit">Buat konsep</button>
      <div class="status" id="s-thumb" role="status"></div>
    </form>
    <div class="out" id="o-thumb"><div class="empty">Tiga konsep thumbnail akan muncul di sini. Prompt gambar bisa disalin ke Google Flow.</div></div>
      </div>
    </div>

    <div id="mk-hook-st" role="tabpanel" aria-labelledby="ms-hook" hidden>
      <div class="td2">
        <div class="box">
          <h2>Hook coach: 60 detik pertama</h2>
          <p class="sub">Di sinilah penonton Anda pergi. Video terbaik Anda langsung membuka dengan hewannya dan bahayanya. Tulis pembukaan di sini; cek di samping ikut berubah saat Anda mengetik.</p>
          <label for="mk-hook" style="margin-top:12px">Pembukaan, dalam bahasa video<textarea id="mk-hook" rows="9" placeholder="Two million years ago, a hyena bigger than any alive today ruled the caves of what is now China…"></textarea></label>
          <p class="note" id="mk-hook-len"></p>
          <div class="chips"><button type="button" class="btn" id="mk-hook-ai">Perbaiki dengan AI</button><button type="button" class="btn ghost" data-stage-go="script">Lanjut ke naskah</button></div>
          <div class="status" id="s-hook" role="status"></div>
          <div class="out" id="o-hook"></div>
        </div>
        <div class="box">
          <h2>Cek hook</h2>
          <p class="sub">Aturan dari video Anda yang ditinggal penonton di menit pertama.</p>
          <ul class="rules" id="mk-rules"></ul>
        </div>
      </div>
    </div>

    <div id="mk-script" role="tabpanel" aria-labelledby="ms-script" hidden>
    <div class="panel">
    <form class="tool" id="f-script">
      <h2>Naskah lengkap</h2>
      <p class="hint">Satu klik: kerangka per babak, narasi penuh dengan hook Anda sebagai pembuka, lalu voice over ElevenLabs. Semua kolom sudah terisi; langsung tekan tombolnya.</p>
      <label for="script-topic">Topik video<input id="script-topic" required></label>
      <label for="script-angle">Sudut cerita (opsional)<textarea id="script-angle" placeholder="Kosongkan, AI memilih yang paling kuat"></textarea></label>
      <div class="row2">
        <label for="script-words">Target kata<input id="script-words" type="number" min="500" max="8000" step="100" value="1800"></label>
        <label for="script-acts">Jumlah babak<input id="script-acts" type="number" min="3" max="7" value="5"></label>
      </div>
      <label for="script-tone">Nada
        <select id="script-tone"><option>Cinematic, awe and mystery</option><option>Investigative, evidence-led</option><option>Survival drama</option><option>Calm, sleep-friendly narration</option></select>
      </label>
      <label class="cbx" for="script-auto"><input type="checkbox" id="script-auto" checked> Langsung tulis narasi penuh dan buat voice over</label>
      <button class="btn" type="submit">Buat naskah lengkap</button>
      <div class="status" id="s-script" role="status"></div>
    </form>
    <div class="out" id="o-script"><div class="empty">Kerangka naskah akan muncul di sini, lengkap dengan proporsi kata per babak dan daftar fakta yang wajib dicek ulang. Hook dari tahap 2 dipakai sebagai cold open.</div></div>
    </div>
    </div>

    <div id="mk-seo" role="tabpanel" aria-labelledby="ms-seo" hidden class="stack">
    <div class="panel">
    <form class="tool" id="f-seo">
      <h2>Paket SEO</h2>
      <p class="hint">Kata kunci, 5 judul, deskripsi dengan chapter, hashtag, tag, komentar sematan, dan postingan Komunitas untuk hari tayang.</p>
      <label for="seo-topic">Topik video<input id="seo-topic" required></label>
      <label for="seo-facts">Fakta kunci / kerangka (opsional)<textarea id="seo-facts"></textarea></label>
      <label for="seo-mins">Durasi video (menit)<input id="seo-mins" type="number" min="1" max="180" value="12"></label>
      <button class="btn" type="submit">Buat paket SEO</button>
      <div class="status" id="s-seo" role="status"></div>
    </form>
    <div class="out" id="o-seo"><div class="empty">Paket SEO akan muncul di sini. Setiap bagian punya tombol Salin untuk ditempel ke YouTube Studio.</div></div>
    </div>
      <div class="box">
        <h2>Checklist sebelum upload</h2>
        <p class="sub">Tersimpan per video. Aplikasi tidak mengupload apa pun; Anda tetap upload sendiri di YouTube Studio.</p>
        <ul class="check" id="mk-pub" style="margin-top:10px"></ul>
        <div class="chips" style="margin-top:12px"><button type="button" class="btn ghost" id="mk-done">Tandai sudah tayang</button></div>
        <div class="status" id="s-done" role="status"></div>
      </div>
    </div>
  </section>

  <!-- GROWTH -->
  <section id="p-growth" role="tabpanel" aria-labelledby="t-growth" hidden>
    <div id="g-empty" class="card" hidden>
      <span class="layer">Belum ada data</span>
      <h3>Impor data YouTube Studio Anda</h3>
      <ol class="steps">
        <li>Buka YouTube Studio, lalu Analitik, lalu <strong>Mode lanjutan</strong> (Advanced mode).</li>
        <li>Pilih rentang waktu, misalnya Sepanjang waktu.</li>
        <li>Klik ikon unduh di kanan atas, pilih <strong>Nilai yang dipisahkan koma (.csv)</strong>. Anda mendapat file .zip.</li>
        <li>Klik tombol di bawah dan pilih file .zip itu. Bisa diulang untuk tab Sumber traffic dan Geografi.</li>
      </ol>
      <button type="button" class="btn" data-import>Impor file .zip dari Studio</button>
      <div class="status" id="s-import-empty" role="status"></div>
    </div>

    <div id="g-full" hidden>
      <div class="card">
        <div class="out-head"><span class="layer" id="g-range">Data YouTube Studio</span><span class="chips"><button type="button" class="btn ghost" data-ytsync hidden>Tarik dari YouTube</button><button type="button" class="btn ghost" data-import>Impor data baru</button></span></div>
        <h3>Rapor channel</h3>
        <div class="kpis" id="g-kpis"></div>
        <p style="margin:14px 0 0;font-weight:700">Views per bulan: kapan channel naik, kapan turun?</p>
        <div class="chart-wrap" id="g-chart-wrap"><svg id="g-chart" role="img" aria-label="Grafik batang views per bulan" style="width:100%;min-width:560px;height:240px;display:block"></svg><div class="tip" id="g-tip" hidden></div></div>
        <p class="note" id="g-chart-note">Arahkan kursor atau fokus pada batang untuk angka per bulan.</p>
        <details class="mtable"><summary>Lihat angka per bulan dalam tabel</summary><div style="overflow-x:auto"><table id="g-mtable"></table></div></details>
        <div class="status" id="s-import" role="status"></div>
      </div>

      <div class="grid2" style="margin-top:16px">
        <div class="card">
          <span class="layer">Diagnosis otomatis</span>
          <h3>Video terbaik dibanding video terbaru</h3>
          <div style="overflow-x:auto"><table class="cmp" id="g-cmp"></table></div>
          <ul class="diag" id="g-diag"></ul>
          <button type="button" class="btn" id="g-ai-btn">Analisis lebih dalam dengan AI</button>
          <div class="status" id="s-ai" role="status"></div>
          <div id="g-ai" class="out" style="margin-top:12px"></div>
        </div>
        <div class="card">
          <span class="layer">Perkiraan, bukan janji</span>
          <h3>Simulasi pendapatan iklan</h3>
          <div class="row2" style="margin:10px 0">
            <label for="g-views">Views / bulan<input id="g-views" type="number" min="0" step="1000" value="10000"></label>
            <label for="g-rpm"><span>RPM (<span class="cur">Rp</span> per 1.000 views)</span><input id="g-rpm" type="number" min="0" step="100" value="0"></label>
          </div>
          <div class="row2">
            <label for="g-members">Member aktif<input id="g-members" type="number" min="0" value="0"></label>
            <label for="g-mprice"><span>Harga member (<span class="cur">Rp</span>)</span><input id="g-mprice" type="number" min="0" step="100" value="0"></label>
          </div>
          <div id="g-income" style="margin-top:12px"></div>
          <div class="chips" style="margin-top:10px" id="g-presets"></div>
          <p class="note" id="g-rpm-note"></p>
        </div>
      </div>

      <div class="grid2" style="margin-top:16px" id="g-extra"></div>

      <div class="card" style="margin-top:16px">
        <span class="layer">Semua video panjang, klik judul kolom untuk mengurutkan</span>
        <h3>Performa per video</h3>
        <div style="overflow-x:auto"><table class="vt" id="g-table"></table></div>
      </div>
    </div>

    <div class="grid2" style="margin-top:16px">
      <div class="card">
        <span class="layer">Tersimpan di komputer ini</span>
        <h3>Checklist pertumbuhan</h3>
        <ul class="check" id="g-check"></ul>
      </div>
      <form class="tool" id="f-shorts">
        <h2>Shorts dari video panjang</h2>
        <p class="hint">Tiap video panjang bisa jadi 3 sampai 5 Shorts yang mengarahkan penonton balik ke video utuh.</p>
        <label for="shorts-topic">Video sumber<input id="shorts-topic" required></label>
        <label for="shorts-facts">Momen / fakta paling menarik (opsional)<textarea id="shorts-facts"></textarea></label>
        <button class="btn" type="submit">Buat 5 ide Shorts</button>
        <div class="status" id="s-shorts" role="status"></div>
        <div class="out" id="o-shorts"></div>
      </form>
    </div>
  </section>

  <!-- SETTINGS -->
  <section id="p-settings" role="tabpanel" aria-labelledby="t-settings" hidden>
    <div class="grid2">
      <form class="tool" id="f-key">
        <h2>Koneksi AI</h2>
        <label for="cfg-provider">Cara memakai AI
          <select id="cfg-provider">
            <option value="manual">Salin-tempel ke claude.ai (pakai langganan, tanpa biaya)</option>
            <option value="gemini">Gemini otomatis (kuota gratis dari Google)</option>
            <option value="claude">Claude otomatis (API berbayar, hasil terbaik)</option>
          </select>
        </label>
        <p class="hint" id="prov-hint"></p>
        <div id="grp-gemini" class="grp">
          <ol class="steps"><li>Buka <a href="https://aistudio.google.com/apikey" target="_blank" rel="noopener">aistudio.google.com/apikey</a> dan masuk dengan akun Google.</li><li>Klik <strong>Create API key</strong>, lalu salin kuncinya.</li><li>Tempel di bawah, klik Simpan, lalu Uji koneksi.</li></ol>
          <label for="cfg-gkey">API key Gemini<input id="cfg-gkey" type="password" autocomplete="off" placeholder="AIza..."></label>
          <p class="note" id="cfg-gkey-hint"></p>
          <label for="cfg-gmodel">Model Gemini<select id="cfg-gmodel"><option value="">Otomatis: Gemini Flash terbaru</option></select></label>
          <div class="chips"><button class="btn ghost" type="button" id="cfg-gmodels">Muat daftar model</button><button class="btn ghost" type="button" id="cfg-gclear">Hapus kunci Gemini</button></div>
          <p class="note">Di kuota gratis, Google bisa memakai isi permintaan untuk meningkatkan modelnya, dan ada batas jumlah permintaan per menit dan per hari.</p>
        </div>
        <div id="grp-claude" class="grp">
          <label for="cfg-key">API key Claude<input id="cfg-key" type="password" autocomplete="off" placeholder="sk-ant-..."></label>
          <p class="note" id="cfg-key-hint"></p>
          <label for="cfg-model">Model
            <select id="cfg-model">
              <option value="claude-sonnet-5-5">Claude Sonnet 5.5: disarankan, seimbang (sekitar Rp500 sampai 1.500 per generate)</option>
              <option value="claude-opus-5-5">Claude Opus 5.5: hasil terbaik (sekitar Rp1.000 sampai 3.000)</option>
              <option value="claude-haiku-5-5">Claude Haiku 5.5: paling hemat (di bawah Rp100)</option>
            </select>
          </label>
          <label for="cfg-effort">Kedalaman berpikir
            <select id="cfg-effort"><option value="low">Rendah (cepat, murah)</option><option value="medium" selected>Sedang</option><option value="high">Tinggi (lebih teliti, lebih mahal)</option></select>
          </label>
          <p class="note">Buat kunci di <a href="https://platform.claude.com/settings/keys" target="_blank" rel="noopener">platform.claude.com</a> dan isi saldo (terpisah dari langganan claude.ai). Perkiraan biaya muncul setelah tiap generate.</p>
          <p class="note" id="cfg-spent"></p>
          <div class="chips"><button class="btn ghost" type="button" id="cfg-clear">Hapus kunci Claude</button></div>
        </div>
        <div class="chips"><button class="btn" type="submit">Simpan</button><button class="btn ghost" type="button" id="cfg-test">Uji koneksi</button></div>
        <div class="status" id="s-key" role="status"></div>
      </form>

      <form class="tool" id="f-yt">
        <h2>YouTube Studio</h2>
        <p class="hint" id="yt-state">Sambungkan channel supaya angka di dashboard dan Data &amp; cuan diperbarui otomatis, tanpa ekspor manual.</p>
        <div id="yt-on" class="grp" hidden>
          <p style="margin:0"><strong id="yt-name"></strong></p>
          <p class="note" id="yt-last" style="margin:0"></p>
          <div class="chips"><button class="btn" type="button" id="yt-sync">Tarik data sekarang</button><button class="btn ghost" type="button" id="yt-off">Putuskan</button></div>
        </div>
        <details id="yt-setup">
          <summary>Langkah sekali saja di Google Cloud (sekitar 15 menit, gratis)</summary>
          <ol class="steps">
            <li>Buka <a href="https://console.cloud.google.com/projectcreate" target="_blank" rel="noopener">console.cloud.google.com</a> dengan akun Google pemilik channel. Buat project baru, misalnya <strong>Terra Studio</strong>.</li>
            <li>Di <a href="https://console.cloud.google.com/apis/library" target="_blank" rel="noopener">API Library</a>, cari lalu klik <strong>Enable</strong> untuk <strong>YouTube Data API v3</strong> dan <strong>YouTube Analytics API</strong>.</li>
            <li>Buka <a href="https://console.cloud.google.com/auth/overview" target="_blank" rel="noopener">Google Auth Platform</a>, klik Get started. Nama aplikasi: Terra Studio, pilih <strong>External</strong>, isi email Anda.</li>
            <li>Di menu <strong>Audience</strong>, klik <strong>Publish app</strong> supaya izinnya tidak kedaluwarsa tiap 7 hari.</li>
            <li>Di menu <strong>Clients</strong>, klik Create client, pilih jenis <strong>Desktop app</strong>. Salin Client ID dan Client secret ke bawah.</li>
          </ol>
        </details>
        <label for="yt-id">Client ID<input id="yt-id" autocomplete="off" placeholder="....apps.googleusercontent.com"></label>
        <label for="yt-secret">Client secret<input id="yt-secret" type="password" autocomplete="off" placeholder="GOCSPX-..."></label>
        <p class="note" id="yt-secret-hint"></p>
        <div class="chips"><button class="btn" type="submit" id="yt-connect">Simpan dan hubungkan YouTube</button></div>
        <p class="note">Google akan menampilkan "Google hasn't verified this app". Itu wajar karena aplikasinya milik Anda sendiri: klik Continue. Impressions dan CTR tidak tersedia lewat sambungan ini, jadi angka itu tetap diambil dari ekspor Studio terakhir.</p>
        <div class="status" id="s-yt" role="status"></div>
      </form>

      <form class="tool" id="f-voice">
        <h2>Suara (ElevenLabs)</h2>
        <p class="hint">Mengubah naskah narasi penuh jadi file MP3 voice over. Memakai kuota karakter dari langganan ElevenLabs Anda, tanpa biaya tambahan.</p>
        <ol class="steps"><li>Buka <a href="https://elevenlabs.io/app/settings/api-keys" target="_blank" rel="noopener">elevenlabs.io/app/settings/api-keys</a>.</li><li>Klik <strong>Create API key</strong>. Izinkan Text to Speech, Voices, Models dan User (baca).</li><li>Tempel di bawah, lalu klik Muat suara.</li></ol>
        <label for="cfg-ekey">API key ElevenLabs<input id="cfg-ekey" type="password" autocomplete="off" placeholder="sk_..."></label>
        <p class="note" id="cfg-ekey-hint"></p>
        <div class="chips"><button class="btn ghost" type="button" id="cfg-eload">Muat suara</button></div>
        <div id="eleven-quota" class="note"></div>
        <label for="cfg-evoice">Suara narator<select id="cfg-evoice"><option value="">Klik Muat suara dulu</option></select></label>
        <div id="cfg-epreview"></div>
        <label for="cfg-emodel">Model suara<select id="cfg-emodel"><option value="">Otomatis: Multilingual v2 (paling natural)</option></select></label>
        <div class="chips"><button class="btn" type="submit">Simpan</button><button class="btn ghost" type="button" id="cfg-eclear">Hapus kunci ElevenLabs</button></div>
        <p class="note" id="cfg-adir"></p>
        <div class="status" id="s-voice" role="status"></div>
      </form>

      <form class="tool" id="f-profile">
        <h2>Profil channel</h2>
        <p class="hint">Semua generator membaca profil ini. Makin spesifik, makin pas hasilnya.</p>
        <label for="pf-name">Nama channel<input id="pf-name"></label>
        <div class="row2">
          <label for="pf-lang">Bahasa konten<input id="pf-lang" value="English"></label>
          <label for="pf-length">Durasi video biasa<input id="pf-length" placeholder="mis. 8 sampai 14 menit"></label>
        </div>
        <label for="pf-niche">Niche dan topik<textarea id="pf-niche" placeholder="mis. dokumenter prasejarah: megafauna Zaman Es, dinosaurus, laut purba"></textarea></label>
        <label for="pf-audience">Penonton<textarea id="pf-audience" placeholder="mis. 88% pria, mayoritas 45 tahun ke atas, 39% dari AS"></textarea></label>
        <label for="pf-wins">Yang terbukti berhasil<textarea id="pf-wins" placeholder="Judul video terlaris dan polanya. Terisi otomatis dari data Studio kalau dikosongkan."></textarea></label>
        <label for="pf-money">Membership, merch, sponsor<textarea id="pf-money" placeholder="mis. membership Field Crew dan Lead Explorers, merch koleksi Bog Titan"></textarea></label>
        <label for="pf-style">Gaya narasi<input id="pf-style" placeholder="mis. sinematik, tenang, berwibawa"></label>
        <div class="chips"><button class="btn" type="submit">Simpan profil</button><button class="btn ghost" type="button" id="pf-export">Salin profil (JSON)</button><button class="btn ghost" type="button" id="pf-import">Tempel profil (JSON)</button></div>
        <textarea id="pf-json" hidden aria-label="Profil dalam format JSON"></textarea>
        <div class="status" id="s-profile" role="status"></div>
      </form>
    </div>
    <div class="card" style="margin-top:16px">
      <span class="layer">Aplikasi</span>
      <h3>Data dan aplikasi</h3>
      <p class="note">Semua pengaturan, data Studio, rencana kalender, dan hasil AI disimpan hanya di komputer ini, di folder <code id="cfg-dir"></code>. API key disimpan terenkripsi dengan pengaman Windows. Menutup jendela Terra Studio berarti menutup aplikasinya. Versi 2.0.2.</p>
      <h3 style="margin-top:14px">Backup</h3>
      <p class="note">Simpan file backup (profil, data Studio, kalender, hasil AI) ke folder Downloads, lalu salin ke flashdisk atau Google Drive. API key dan gambar thumbnail rencana tidak ikut. Pulihkan di komputer baru atau setelah instal ulang Windows.</p>
      <div class="chips"><button type="button" class="btn ghost" id="backup-save">Simpan backup</button><button type="button" class="btn ghost" id="backup-load">Pulihkan dari backup</button></div>
      <input type="file" id="backup-file" accept=".json,application/json" hidden>
      <div class="confirm" id="backup-confirm" hidden><span id="backup-confirm-text"></span> <button type="button" class="btn ghost" id="backup-yes">Ya, pulihkan</button> <button type="button" class="btn ghost" id="backup-no">Batal</button></div>
      <div class="chips"><button type="button" class="btn ghost" data-import>Impor data Studio (.zip/.csv)</button><button type="button" class="btn ghost" id="data-clear">Hapus data Studio</button><button type="button" class="btn ghost" id="app-quit">Tutup aplikasi</button></div>
      <div class="confirm" id="data-clear-confirm" hidden>Hapus semua data Studio yang sudah diimpor? <button type="button" class="btn ghost" id="data-clear-yes">Ya, hapus</button> <button type="button" class="btn ghost" id="data-clear-no">Batal</button></div>
      <div class="status" id="s-app" role="status"></div>
    </div>
  </section>

  <input type="file" id="file-import" accept=".zip,.csv" multiple hidden>
  <footer>Generator memakai Claude dari Anthropic, lewat langganan claude.ai atau API key Anda.</footer>
</div>
  </main>
</div>

<script>
const $=s=>document.querySelector(s);
const esc=s=>String(s??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
const store={get(k,d){try{const v=localStorage.getItem("ts-"+k);return v?JSON.parse(v):d}catch{return d}},set(k,v){try{localStorage.setItem("ts-"+k,JSON.stringify(v))}catch{}}};
const api=async(path,opts={})=>{opts.headers={...(opts.headers||{}),"X-Terra":"1"};let r;try{r=await fetch(path,opts)}catch{return{error:"Aplikasi Terra Studio tidak berjalan. Buka lagi dari ikonnya."}}let j={};try{j=await r.json()}catch{}if(!r.ok&&!j.error)j.error="Aplikasi tidak merespons ("+r.status+").";return j};
let CFG={profile:{}},YT=null;

/* heartbeat: the app exits a while after this window closes */
const beat=()=>fetch("/api/heartbeat",{method:"POST",headers:{"X-Terra":"1"}}).catch(()=>{});setInterval(beat,15000);beat();

/* tabs */
const tabs=[...document.querySelectorAll("nav.tabs button")];
// The first show() skips scrollIntoView: Chromium moves the Tab starting point there, past the skip link.
// 1.x had separate Script, SEO and Thumbnail pages; they now live as stages of Make.
const OLD_TAB={script:"script",seo:"seo",thumb:"pkg"};
function show(name,first){if(OLD_TAB[name]){mkStage(OLD_TAB[name]);name="make"}if(!tabs.some(b=>b.dataset.tab===name))name="today";tabs.forEach(b=>{const on=b.dataset.tab===name;b.setAttribute("aria-selected",on);if(on){if(!first)b.scrollIntoView({block:"nearest",inline:"nearest"});$("#page-title").textContent=b.textContent.trim()}$("#p-"+b.dataset.tab).hidden=!on});
  $(".shell").dataset.tab=name;store.set("tab",name);$("#main").scrollTop=0;
  if(name==="dash")renderDash();if(name==="today")renderToday();if(name==="learn")renderLearn();if(name==="ideas")renderPattern();if(name==="make")renderMake();if(name==="growth")requestAnimationFrame(()=>{if(YT)chart()})}
tabs.forEach(b=>b.addEventListener("click",()=>show(b.dataset.tab)));
document.addEventListener("click",e=>{const g=e.target.closest("[data-goto]");if(g)show(g.dataset.goto)});

/* prompt context from the profile */
function channelContext(){
  const p=CFG.profile||{},lines=[];
  lines.push(`You are helping the YouTube channel "${p.name||"(unnamed channel)"}".`);
  if(p.niche)lines.push("Niche and topics: "+p.niche);
  lines.push("Content language: "+(p.lang||"English")+". Write all video-facing text (titles, scripts, descriptions, tags, prompts) in that language.");
  if(p.length)lines.push("Typical video length: "+p.length+".");
  if(p.audience)lines.push("Audience: "+p.audience);
  const wins=p.wins||autoWins();if(wins)lines.push("What has worked on this channel: "+wins);
  if(p.money)lines.push("Monetization: "+p.money);
  if(p.style)lines.push("Narration style: "+p.style);
  lines.push("Keep facts accurate; flag anything uncertain instead of inventing it.");
  lines.push("Writing rules: no em dashes or en dashes (use commas, periods, colons or parentheses); no hype words (unlock, delve, journey, testament, revolutionary, seamless, mind-blowing, game-changer); no \"it's not just X, it's Y\" constructions; no runs of short dramatic fragments; no forced lists of three; no emojis; no invented numbers, dates, names or quotes.");
  lines.push("Fields marked as Indonesian must be written in Indonesian.");
  return lines.join("\n");
}
function autoWins(){if(!YT||!YT.videos)return "";const top=longForm().sort((a,b)=>b.v-a.v).slice(0,6);if(!top.length)return "";return "Top videos by views: "+top.map(v=>`"${v.t}" (${v.v} views, CTR ${v.ctr}%)`).join("; ")+"."}

/* Claude via the local app */
/* rough cost: USD per million tokens (input, output), shown in rupiah at a fixed rate */
const PRICE={"claude-opus-5-5":[4,20],"claude-sonnet-5-5":[2,10],"claude-haiku-5-5":[0.1,0.5]},KURS=16500;
function costRp(model,u,provider){if(provider==="gemini")return 0;const k=Object.keys(PRICE).find(m=>(model||"").startsWith(m));if(!u)return 0;const [i,o]=k?PRICE[k]:[5,25];return (u.input_tokens*i+u.output_tokens*o)/1e6*KURS}
let LAST={};
async function remember(key,data){LAST[key]={at:Date.now(),data};await api("/api/last",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({key,value:LAST[key]})})}
function spentText(){const s=LAST._spent?.data;const m=new Date().toISOString().slice(0,7);return s&&s.month===m?`Perkiraan biaya AI bulan ini: Rp${nf(Math.round(s.rp))} dari ${s.n} kali generate.`:"Belum ada biaya AI bulan ini."}
async function addSpent(rp){const m=new Date().toISOString().slice(0,7);let s=LAST._spent?.data;if(!s||s.month!==m)s={month:m,rp:0,n:0};s.rp+=rp;s.n+=1;await remember("_spent",s);const el=$("#cfg-spent");if(el)el.textContent=spentText()}
/* Without an API key, the prompt is copied to claude.ai (the user's own
   subscription) and the reply is pasted back. */
function manualAsk(statusEl,prompt){
  const old=statusEl.nextElementSibling;if(old&&old.classList.contains("manual"))old.remove();
  const box=document.createElement("div");box.className="card manual";const id="mp"+Math.random().toString(36).slice(2,8);
  box.innerHTML=`<span class="layer">Pakai langganan claude.ai</span>
  <ol class="steps"><li>Salin perintah di bawah.</li><li>Buka <a href="https://claude.ai/new" target="_blank" rel="noopener">claude.ai</a>, mulai chat baru, tempel, lalu kirim.</li><li>Salin seluruh jawaban Claude, tempel di kotak paling bawah, lalu klik <strong>Pakai jawaban</strong>.</li></ol>
  <div class="copybox" style="margin-top:52px"><button type="button" class="btn ghost" data-copy="${id}" data-label="Salin perintah">Salin perintah</button><pre id="${id}" style="max-height:160px">${esc(prompt)}</pre></div>
  <label style="margin-top:12px">Jawaban dari claude.ai<textarea rows="5" placeholder="Tempel jawaban di sini"></textarea></label>
  <div class="confirm"><button type="button" class="btn" data-act="use">Pakai jawaban</button><button type="button" class="btn ghost" data-act="cancel">Batal</button></div>
  <div class="status" role="status"></div>`;
  statusEl.after(box);statusEl.className="status";statusEl.textContent="Menunggu jawaban dari claude.ai.";
  return new Promise(res=>{
    box.querySelector('[data-act="cancel"]').onclick=()=>{box.remove();statusEl.textContent="";res(null)};
    box.querySelector('[data-act="use"]').onclick=()=>{const d=parseJSON(box.querySelector("textarea").value);const st=box.querySelector(".status");
      if(!d){st.className="status err";st.textContent="Jawaban tidak terbaca. Pastikan seluruh jawaban Claude tersalin, dari tanda { pertama sampai } terakhir.";return}
      box.remove();res(d)};
  })}
async function ask(statusEl,btn,prompt,key){
  if(!CFG.provider){const full=channelContext()+"\n\n"+prompt+"\n\nReply directly in this chat (not as an artifact or file) with ONLY valid JSON, no markdown fences, no text before or after.";
    const data=await manualAsk(statusEl,full);
    if(data){statusEl.className="status";statusEl.textContent="Selesai, "+new Date().toLocaleTimeString("id-ID",{hour:"2-digit",minute:"2-digit"})+", lewat claude.ai, hasil tersimpan";if(key)remember(key,data).catch(()=>{})}
    return data}
  statusEl.className="status";statusEl.textContent="AI sedang menulis… (biasanya 20 sampai 90 detik)";btn.disabled=true;
  try{
    const j=await api("/api/generate",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({prompt:channelContext()+"\n\n"+prompt+"\n\nReturn ONLY valid JSON, no markdown fences, no text before or after."})});
    const rp=costRp(j.model,j.usage,j.provider);if(rp)addSpent(rp).catch(()=>{});
    if(j.error)throw j;
    const data=parseJSON(j.text);
    if(!data)throw{error:"Jawaban Claude tidak bisa dibaca. Tekan tombolnya sekali lagi."};
    statusEl.textContent="Selesai, "+new Date().toLocaleTimeString("id-ID",{hour:"2-digit",minute:"2-digit"})+(j.provider==="gemini"?", lewat Gemini":rp?`, biaya sekitar Rp${nf(Math.max(1,Math.round(rp)))}`:"")+", hasil tersimpan";
    if(key)remember(key,data).catch(()=>{});
    return data;
  }catch(e){statusEl.className="status err";statusEl.textContent=e.error||("Gagal: "+(e.message||"coba lagi."));return null}
  finally{btn.disabled=false}
}
function parseJSON(t){if(!t)return null;try{return JSON.parse(t)}catch{}const a=t.indexOf("{"),b=t.lastIndexOf("}");if(a>=0&&b>a){try{return JSON.parse(t.slice(a,b+1))}catch{}}return null}

function copyBox(label,text){const id="c"+Math.random().toString(36).slice(2,8);return `<div class="card"><span class="layer">${esc(label)}</span><div class="copybox" style="margin-top:52px"><button type="button" class="btn ghost" data-copy="${id}">Salin</button><pre id="${id}">${esc(text)}</pre></div></div>`}
document.addEventListener("click",e=>{const b=e.target.closest("[data-copy]");if(!b)return;const pre=document.getElementById(b.dataset.copy);const txt=pre.textContent;
  const done=()=>{b.textContent="Tersalin";setTimeout(()=>b.textContent=b.dataset.label||"Salin",1500)};
  const sel=()=>{const r=document.createRange();r.selectNodeContents(pre);const s=getSelection();s.removeAllRanges();s.addRange(r);try{document.execCommand("copy");done()}catch{b.textContent="Tekan Ctrl+C"}};
  if(navigator.clipboard)navigator.clipboard.writeText(txt).then(done).catch(sel);else sel()});
const head=t=>`<div class="out-head"><span class="layer">${esc(t)}</span></div>`;
const val=id=>$(id).value.trim();

/* Ideas */
$("#ideas-start").value=new Date().toISOString().slice(0,10);
function schedule(n,perMonth,startISO){const gap=Math.round(30/perMonth),d=new Date(startISO+"T12:00:00"),out=[];for(let i=0;i<n;i++){const x=new Date(d);x.setDate(d.getDate()+i*gap);out.push(x)}return out}
const fmtDate=d=>d.toLocaleDateString("id-ID",{weekday:"short",day:"numeric",month:"short",year:"numeric"});
function renderIdeas(list){
  const dates=schedule(list.length,+$("#ideas-freq").value,$("#ideas-start").value||new Date().toISOString().slice(0,10));
  const plan=list.map((x,i)=>`${dates[i].toISOString().slice(0,10)}  ${x.title}`).join("\n");
  const scored=list.map((x,i)=>({...x,date:isoDay(dates[i]),...fitOf(x)})).sort((a,b)=>b.score-a.score);
  $("#o-ideas").innerHTML=head("Topik berikutnya, diurutkan menurut skor")+`<div class="idea-list">${scored.map(x=>`<article class="idea2"><div class="fit" style="--p:${x.score*20}" role="img" aria-label="Skor ${x.score} dari 5"><span>${x.score}</span></div><div style="min-width:0"><h3>${esc(x.title)}</h3><div class="tags">${x.tags.map(([ok,t])=>`<span class="tag ${ok?"y":"n"}">${ok?"✓ ":""}${esc(t)}</span>`).join("")}</div><p class="note" style="margin:8px 0 0"><strong>Hook:</strong> ${esc(x.hook)}</p><p class="note" style="margin:4px 0 0">${esc(x.why)}</p></div><div class="idea-act"><button type="button" class="btn${x.score<3?" ghost":""}" data-start="${esc(x.title)}" data-topic="${esc(x.subject||"")}" data-date="${x.date}">Mulai video</button><button type="button" class="btn ghost" data-plan="${esc(x.title)}" data-date="${x.date}">Ke kalender, ${esc(fmtShort(x.date))}</button></div></article>`).join("")}</div><div class="chips"><button type="button" class="btn ghost" id="plan-all">Masukkan semua ke kalender</button></div>`+copyBox("Jadwal (salin ke catatan atau kalender)",plan);
}
const fmtShort=iso=>new Date(iso+"T12:00:00").toLocaleDateString("id-ID",{day:"numeric",month:"short"});
// Score an idea against the winners' pattern. The AI only says what the animal is; the app checks the channel history itself.
function fitOf(x){const subj=String(x.subject||"").trim(),key=subj.split(/[\s,(]+/).find(w=>w.length>=4)||"";
  const prev=key?longForm().filter(v=>(v.t||"").toLowerCase().includes(key.toLowerCase())).sort((a,b)=>(b.d||"").localeCompare(a.d||""))[0]:null;
  const tags=[[!!x.mammal,"Mamalia"],[!!x.predator,"Predator"],[!!x.threat,"Ancaman bagi manusia"],[!!x.size,"Klaim ukuran"],[!prev,prev?`Sudah dibuat ${fmtShort(prev.d)}, ${f1(share(prev))}% ditonton`:"Belum pernah dibuat"]];
  return {tags,score:tags.filter(t=>t[0]).length}}
document.addEventListener("click",async e=>{const b=e.target.closest("[data-start]");if(!b)return;
  let p=plans().find(x=>x.title===b.dataset.start);
  if(!p){p={id:Date.now().toString(36)+Math.random().toString(36).slice(2,6),title:b.dataset.start,date:b.dataset.date||isoDay(new Date()),type:"video",status:"ide",note:""};await savePlans([...plans(),p])}
  if(b.dataset.topic){work(p.id).topic=b.dataset.topic;saveWork()}
  openMake(p.id,"pkg")});
$("#f-ideas").addEventListener("submit",async e=>{e.preventDefault();const n=Math.min(12,Math.max(3,+$("#ideas-n").value||6));
  const data=await ask($("#s-ideas"),e.submitter||$("#f-ideas .btn"),`Suggest ${n} new video ideas for this channel.${val("#ideas-focus")?" Focus: "+val("#ideas-focus")+".":""} Do not repeat or closely overlap these existing videos: ${val("#ideas-avoid")||"none listed"}.
Base the choices on what has worked for this channel: ${patternText()||"giant prehistoric mammals, predators, framed as a threat to humans or rivals"}. Titles under 60 characters, clickable but honest, naming the animal.
For each idea also answer honestly about the main animal: "subject" its usual name, "mammal" true if it is a mammal, "predator" true if it hunted or scavenged large prey, "threat" true if the video frames it as a danger to humans or our ancestors (only when the evidence supports it), "size" true if the title states a size, weight or record.
JSON shape: {"ideas":[{"title":"","subject":"","mammal":true,"predator":true,"threat":true,"size":true,"hook":"one-sentence cold-open hook","why":"why it can perform for this channel (Indonesian, one sentence)"}]}`,"ideas");
  if(data?.ideas?.length)renderIdeas(data.ideas)});

/* Script outline */
const ACT_COLORS=["var(--accent)","var(--moss)","var(--muted)","var(--warn)","var(--ink)","var(--field)","var(--accent)"];
const ROMAN=["I","II","III","IV","V","VI","VII"];
let lastOutline=null;
function renderScript(s){lastOutline=s;const acts=s.acts||[],total=acts.reduce((a,x)=>a+(+x.words||0),0)||1;
  $("#o-script").innerHTML=head("Kerangka: "+(s.title||""))+`<div class="card"><span class="layer">Cold open</span><p style="font-size:19px">${esc(s.cold_open)}</p>
  <div class="strata" aria-label="Proporsi kata per babak">${acts.map((a,i)=>`<span style="width:${((+a.words||0)/total*100).toFixed(1)}%;background:${ACT_COLORS[i%7]}" title="Babak ${i+1}: ${esc(a.words)} kata"></span>`).join("")}</div>
  ${acts.map((a,i)=>`<div class="act"><div class="num">${ROMAN[i]||i+1}<small>${esc(a.words)} kata</small></div><div style="min-width:0"><h3>${esc(a.name)}</h3><ul>${(a.beats||[]).map(b=>`<li>${esc(b)}</li>`).join("")}</ul>${a.open_loop?`<p class="note"><strong>Open loop:</strong> ${esc(a.open_loop)}</p>`:""}${a.cta?`<p class="note"><strong>CTA:</strong> ${esc(a.cta)}</p>`:""}</div></div>`).join("")}</div>
  ${(s.visuals?.length)?`<div class="card"><span class="layer">Daftar visual / B-roll</span><div class="chips" style="margin-top:8px">${s.visuals.map(v=>`<span class="chip">${esc(v)}</span>`).join("")}</div></div>`:""}
  ${acts.some(a=>a.flow_prompts?.length)?copyBox("Prompt video untuk Google Flow (satu per klip 8 detik)",acts.map((a,i)=>(a.flow_prompts||[]).map((f,j)=>`[Babak ${i+1}.${j+1}] ${f}${s.flow_style?" Style: "+s.flow_style:""}`).join("\n\n")).filter(Boolean).join("\n\n"))+`<p class="note">Tempel satu prompt per klip di Flow. Gaya visual sudah disisipkan di tiap prompt supaya antar klip tetap konsisten.</p>`:""}
  ${(s.fact_check?.length)?`<div class="card"><span class="layer">Wajib dicek ulang sebelum rekaman</span><ul>${s.fact_check.map(v=>`<li>${esc(v)}</li>`).join("")}</ul></div>`:""}
  <div class="card"><span class="layer">Langkah berikutnya</span><h3>Naskah narasi penuh</h3><p class="note">Ubah kerangka ini jadi naskah siap dibacakan (voice over), sesuai target kata. Bisa ditempel ke Bang Story atau dibaca sendiri.</p><button type="button" class="btn" id="script-full-btn">Tulis naskah narasi penuh</button><div class="status" id="s-scriptfull" role="status"></div></div>
  <div id="o-scriptfull" class="out"></div>`}
function renderScriptFull(f){const parts=f.narration||[],all=parts.map(p=>p.text).join("\n\n"),words=all.split(/\s+/).filter(Boolean).length,mins=(words/140).toLocaleString("id-ID",{maximumFractionDigits:1});
  $("#o-scriptfull").innerHTML=copyBox(`Naskah narasi penuh, ${nf(words)} kata, sekitar ${mins} menit dibaca`,parts.map((p,i)=>`[${p.act||"Babak "+(i+1)}]\n${p.text}`).join("\n\n"))+(f.title?`<p class="note">Untuk kerangka: ${esc(f.title)}</p>`:"")+voCard(f);const v=LAST.vo?.data;if(v&&v.title===(f.title||"voice over"))renderVo(v)}
let lastNarr=null;
function voCard(f){lastNarr=f;const chars=(f.narration||[]).reduce((n,p)=>n+(p.text||"").length,0);
  if(!CFG.has_eleven)return `<div class="card"><span class="layer">Voice over</span><h3>Jadikan suara dengan ElevenLabs</h3><p class="note">Isi API key ElevenLabs di Pengaturan, bagian Suara, supaya naskah ini bisa langsung jadi MP3 dari aplikasi.</p><button type="button" class="btn ghost" data-goto="settings">Buka Pengaturan</button></div>`;
  return `<div class="card"><span class="layer">Voice over</span><h3>Jadikan suara dengan ElevenLabs</h3>
  <label for="vo-voice">Suara<select id="vo-voice">${CFG.eleven_voice?`<option value="${esc(CFG.eleven_voice)}">${esc(CFG.eleven_voice_name||CFG.eleven_voice)}</option>`:`<option value="">Pilih suara di Pengaturan dulu</option>`}</select></label>
  <p class="note">Naskah ini sekitar ${nf(chars)} karakter, jadi memakai sekitar ${nf(chars)} karakter dari kuota ElevenLabs Anda. Naskah panjang dipecah per bagian lalu disambung jadi satu file.</p>
  <button type="button" class="btn" id="vo-btn">Buat voice over (${nf(chars)} karakter)</button><div class="status" id="s-vo" role="status"></div><div id="o-vo"></div></div>`}
function renderVo(j){$("#o-vo").innerHTML=`<audio controls preload="metadata" src="/api/audio/${encodeURIComponent(j.file)}" style="width:100%;margin-top:12px"></audio><p class="note">Tersimpan di ${esc(j.path)}</p><div class="chips"><button type="button" class="btn ghost" id="vo-open">Buka folder</button><a class="btn ghost" href="/api/audio/${encodeURIComponent(j.file)}" download="${esc(j.file)}">Unduh MP3</a></div>`}
document.addEventListener("click",async e=>{
  if(e.target.closest("#vo-open")){api("/api/open-folder",{method:"POST",headers:{"Content-Type":"application/json"},body:"{}"});return}
  const b=e.target.closest("#vo-btn");if(b&&lastNarr)makeVoice(b)});
async function makeVoice(b){const st=$("#s-vo"),voice=$("#vo-voice").value;
  if(!voice){st.className="status err";st.textContent="Pilih suara dulu di Pengaturan, bagian Suara.";return null}
  b.disabled=true;st.className="status";st.textContent="Membuat suara… naskah 1.800 kata biasanya butuh 1 sampai 3 menit. Jangan tutup aplikasi.";
  const j=await api("/api/eleven/tts",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({title:lastNarr.title||"voice over",parts:lastNarr.narration.map(p=>p.text),voice})});b.disabled=false;
  if(j.error){st.className="status err";st.textContent=j.error;return null}
  st.textContent=`Selesai: ${nf(j.chars)} karakter, ${j.chunks} bagian, ${(j.bytes/1048576).toLocaleString("id-ID",{maximumFractionDigits:1})} MB.`;j.title=lastNarr.title||"voice over";renderVo(j);remember("vo",j).catch(()=>{});return j}
document.addEventListener("click",e=>{const b=e.target.closest("#script-full-btn");if(b&&lastOutline)writeFull(b)});
async function writeFull(b){
  const w=+$("#script-words").value||1800;
  const data=await ask($("#s-scriptfull"),b,`Write the complete voice-over narration for this documentary, following the outline below act by act. About ${w} words in total; keep each act close to its planned word count. Spoken style: short clear sentences, vivid but accurate, no stage directions, no headings inside the text, no bracketed notes. Open with the cold open. Keep open loops and the soft CTAs where the outline puts them. Mark anything uncertain by phrasing it carefully ("scientists think", "the fossils suggest") rather than inventing facts.
Outline JSON: ${JSON.stringify({title:lastOutline.title,cold_open:lastOutline.cold_open,acts:(lastOutline.acts||[]).map(a=>({name:a.name,words:a.words,beats:a.beats,open_loop:a.open_loop,cta:a.cta}))})}
JSON shape: {"title":"","narration":[{"act":"act name","text":"narration paragraphs for this act"}]}`,"scriptfull");
  if(data?.narration?.length){renderScriptFull(data);return data}return null}
$("#f-script").addEventListener("submit",async e=>{e.preventDefault();const w=+$("#script-words").value||1800,n=Math.min(7,Math.max(3,+$("#script-acts").value||5));
  const data=await ask($("#s-script"),e.submitter||$("#f-script .btn"),`Build a detailed ${n}-act outline for a documentary script. Topic: ${val("#script-topic")}. Central question: ${val("#script-angle")||"choose the strongest one"}. Tone: ${$("#script-tone").value}. Target length: about ${w} words total (act word counts must add up to about ${w}).
${hookForScript()}Include a vivid 2-3 sentence cold open that pays off within the first 30 seconds, 3-5 beats per act, open loops across act breaks for retention, at most two soft CTAs (membership or merch from the profile) placed where they don't break the story, a visual/B-roll list, and facts to double-check.
Also write a "flow_style" line (one sentence, English) fixing one consistent visual style, lighting and camera look for the whole video, and for every act 2-4 "flow_prompts": English text-to-video prompts for Google Flow (Veo), each describing one 8-second shot (subject, action, setting, camera movement, lighting), self-contained (repeat key subject details, no references like "same as before"), scientifically accurate anatomy, no on-screen text, 16:9.
JSON shape: {"title":"","cold_open":"","flow_style":"","acts":[{"name":"","words":0,"beats":[""],"open_loop":"","cta":"","flow_prompts":[""]}],"visuals":[""],"fact_check":[""]}. Exactly ${n} acts. Use "" for open_loop or cta when not needed.`,"script");
  if(!data?.acts?.length)return;renderScript(data);
  // One click runs the whole chain: outline, full narration, then the ElevenLabs voice when a voice is set up.
  if(!$("#script-auto").checked)return;const st=$("#s-script");
  st.textContent="Langkah 2 dari 3: menulis narasi penuh…";$("#s-scriptfull").scrollIntoView({block:"center"});
  const full=await writeFull($("#script-full-btn"));if(!full){st.textContent="Kerangka jadi. Narasi penuh gagal, tekan tombolnya di bawah untuk mencoba lagi.";return}
  if(!(CFG.has_eleven&&CFG.eleven_voice&&$("#vo-btn"))){st.textContent="Kerangka dan narasi penuh jadi. Voice over dilewati: isi ElevenLabs di Pengaturan dulu.";return}
  st.textContent="Langkah 3 dari 3: membuat voice over…";$("#s-vo").scrollIntoView({block:"center"});
  const vo=await makeVoice($("#vo-btn"));st.textContent=vo?"Selesai: kerangka, narasi penuh, dan voice over MP3 sudah jadi. Prompt klip Flow ada di bawah kerangka.":"Kerangka dan narasi penuh jadi. Voice over gagal, lihat pesan di bawah."});

/* SEO pack */
function renderSEO(s){const tags=(s.tags||[]).join(", ");
  $("#o-seo").innerHTML=head("Paket SEO")+(s.keywords?`<div class="card"><span class="layer">Kata kunci</span><p><strong>Utama:</strong> ${esc(s.keywords.primary)}</p><p><strong>Pendukung:</strong> ${esc((s.keywords.secondary||[]).join(", "))}</p><p class="note">Masukkan kata kunci utama ke judul, kalimat pertama deskripsi, dan ucapkan di 30 detik pertama narasi (YouTube membaca transkrip).</p></div>`:"")
  +`<div class="card"><span class="layer">Pilihan judul</span><ol class="titles">${(s.titles||[]).map(t=>`<li>${esc(t.text)}<span class="len">${String(t.text||"").length} kar, ${esc(t.angle||"")}</span></li>`).join("")}</ol><p class="note">Usahakan di bawah 60 karakter agar tidak terpotong di HP. Uji 2 sampai 3 judul dengan fitur Test &amp; Compare di YouTube Studio.</p></div>`
  +copyBox("Deskripsi (dengan chapter)",s.description||"")+copyBox("Hashtag",(s.hashtags||[]).join(" "))+copyBox(`Tag (${tags.length}/500 karakter)`,tags)+copyBox("Komentar sematan",s.pinned_comment||"")+(s.community_post?copyBox("Postingan Komunitas YouTube (hari tayang)",s.community_post):"")}
$("#f-seo").addEventListener("submit",async e=>{e.preventDefault();
  const data=await ask($("#s-seo"),e.submitter||$("#f-seo .btn"),`Create a YouTube SEO pack. Topic: ${val("#seo-topic")}. Key facts or outline: ${val("#seo-facts")||"none given"}. Video length: ${$("#seo-mins").value} minutes.
First pick ONE primary search keyword (what a viewer would actually type) and 2-3 secondary keywords. Give 5 title options (each under 60 characters, honest, varied angles, at least 3 containing the primary keyword or the subject's common name; "angle" is a 1-2 word Indonesian label). A description: strong first 2 lines (shown in search) with the primary keyword in the first sentence, 1 short paragraph, a CHAPTERS list with plausible timestamps spread over the length starting at 00:00, placeholders [membership link] and [merch link], then 3 hashtags at the end. 3 hashtags. 10-15 tags, total under 450 characters, mixing broad and long-tail phrases. A pinned comment that asks a question to spark replies. A YouTube Community post for release day (under 600 characters, one surprising fact, then a 3-4 option poll written as a list).
JSON shape: {"keywords":{"primary":"","secondary":[""]},"titles":[{"text":"","angle":""}],"description":"","hashtags":[""],"tags":[""],"pinned_comment":"","community_post":""}`,"seo");
  if(data?.titles)renderSEO(data)});

/* Thumbnail */
function renderThumb(list){$("#o-thumb").innerHTML=head("Konsep thumbnail")+`<div class="thumbs">${list.map((c,i)=>{const id="tp"+i+Math.random().toString(36).slice(2,6);return `<article class="card"><div class="thumb-text">${esc(c.text)}</div><h3 style="margin-top:12px">${esc(c.name)}</h3><p><strong>Komposisi:</strong> ${esc(c.composition)}</p><p class="note"><strong>Kenapa diklik:</strong> ${esc(c.why)}</p><div class="copybox" style="margin-top:52px"><button type="button" class="btn ghost" data-copy="${id}" data-label="Salin untuk Flow">Salin untuk Flow</button><pre id="${id}">${esc(c.prompt)}</pre></div></article>`}).join("")}</div><p class="note">Aturan cepat: maksimal 4 kata, satu subjek besar, kontras tinggi, tetap terbaca di ukuran kecil HP. Teks thumbnail melengkapi judul, jangan mengulangnya.</p>`}
$("#f-thumb").addEventListener("submit",async e=>{e.preventDefault();
  const data=await ask($("#s-thumb"),e.submitter||$("#f-thumb .btn"),`Create 3 distinct YouTube thumbnail concepts. Topic: ${val("#thumb-topic")}. Video title: ${val("#thumb-title")||"not decided"}. Visual style: ${$("#thumb-style").value}.
Each concept: "name" short Indonesian label, "text" overlay of max 4 words, uppercase, that complements (not repeats) the title, "composition" one sentence, "why" one sentence in Indonesian on why it gets clicks, "prompt" a detailed text-to-image prompt in English for Google Flow / Imagen (16:9, leave empty space for the overlay text, do not render any text in the image, accurate anatomy and details).
JSON shape: {"concepts":[{"name":"","text":"","composition":"","why":"","prompt":""}]}`,"thumb");
  if(data?.concepts?.length)renderThumb(data.concepts)});

/* Shorts */
function renderShorts(list){$("#o-shorts").innerHTML=head("Ide Shorts")+list.map(s=>`<div class="card"><h3>${esc(s.title)}</h3><p><strong>Detik 0 sampai 2:</strong> ${esc(s.hook)}</p><p class="note">${esc(s.outline)}</p><div class="meta"><span>${esc(s.length)}</span><span>CTA: ${esc(s.cta)}</span></div></div>`).join("")}
$("#f-shorts").addEventListener("submit",async e=>{e.preventDefault();
  const data=await ask($("#s-shorts"),e.submitter||$("#f-shorts .btn"),`Turn this long video into 5 YouTube Shorts ideas (vertical, under 60 seconds) that send viewers to the full video. Source video: ${val("#shorts-topic")}. Best moments: ${val("#shorts-facts")||"pick the most surprising"}.
Each: "title" (under 50 characters), "hook" what happens in the first 2 seconds (visual + line), "outline" one sentence, "length" in Indonesian like "40 detik", "cta" short.
JSON shape: {"shorts":[{"title":"","hook":"","outline":"","length":"","cta":""}]}`,"shorts");
  if(data?.shorts?.length)renderShorts(data.shorts)});

/* Data and growth */
const nf=n=>Math.round(n||0).toLocaleString("id-ID");
const f1=n=>(n||0).toLocaleString("id-ID",{maximumFractionDigits:1});
const cur=()=>(YT&&YT.currency)||"IDR";
const moneyShort=n=>cur()==="IDR"&&Math.abs(n)>=1e6?"Rp"+(n/1e6).toLocaleString("id-ID",{maximumFractionDigits:1})+" jt":money(n);
const money=n=>{const c=cur();return c==="IDR"?"Rp"+nf(n):c==="USD"?"$"+nf(n):nf(n)+" "+c};
const longForm=()=>(YT&&YT.videos||[]).filter(v=>v.dur>=120);
const BN=["Jan","Feb","Mar","Apr","Mei","Jun","Jul","Agu","Sep","Okt","Nov","Des"];
function monthly(){const m=new Map();(YT.daily||[]).forEach(([d,v])=>{const k=d.slice(0,7);m.set(k,(m.get(k)||0)+v)});return [...m.entries()].sort()}
function lastDays(n,offset=0){const d=YT.daily||[];return d.slice(Math.max(0,d.length-n-offset),d.length-offset).reduce((a,x)=>a+x[1],0)}
let MONTHS=[];
const mLabel=(m,i)=>BN[+m.slice(5,7)-1]+" "+m.slice(0,4)+(i===MONTHS.length-1&&YT.partialLast?" (belum penuh)":"");

function renderGrowth(){
  const has=YT&&(YT.videos?.length||YT.daily?.length);
  $("#g-empty").hidden=!!has;$("#g-full").hidden=!has;
  if(!has){$("#meter").innerHTML="";return}
  MONTHS=monthly();
  const t=YT.totals||{};
  $("#g-range").textContent="Data YouTube Studio"+(YT.range?", "+YT.range:"")+(YT.imported_at?", diimpor "+new Date(YT.imported_at).toLocaleDateString("id-ID"):"");
  const k=[];if(t.views!=null)k.push([nf(t.views),"total views"]);if(t.hours!=null)k.push([nf(t.hours),"jam tonton"]);if(t.subs!=null)k.push([(t.subs>=0?"+":"")+nf(t.subs),"subscriber bersih"]);if(t.revenue!=null)k.push([money(t.revenue),"estimasi pendapatan"]);if(YT.daily?.length)k.push([nf(lastDays(30)),"views 30 hari terakhir"]);
  $("#g-kpis").innerHTML=k.map(([b,l])=>`<div><b>${b}</b><span>${l}</span></div>`).join("");
  if(YT.daily?.length>=60){const a=lastDays(30),b=lastDays(30,30),pct=b?Math.round((a/b-1)*100):0;$("#meter").innerHTML=`<span class="layer">Views 30 hari terakhir</span><b>${nf(a)}</b> <span class="${a<b?"no":"ok"}">${a<b?"turun":"naik"} ${Math.abs(pct)}%</span> dibanding 30 hari sebelumnya`}
  if(!(YT.daily?.length>=60))$("#meter").innerHTML="";
  if(MONTHS.length){chart();$("#g-mtable").innerHTML=`<tr><th>Bulan</th><th>Views</th></tr>`+MONTHS.map(([m,v],i)=>`<tr><td>${mLabel(m,i)}</td><td>${nf(v)}</td></tr>`).join("")}
  $("#g-chart-wrap").hidden=!MONTHS.length;
  diagnose();table();extras();incomeSetup();
  const titles=(YT.videos||[]).filter(v=>v.dur>=120).map(v=>v.t);if(titles.length&&!$("#ideas-avoid").value)$("#ideas-avoid").value=titles.join("; ");
}

function chart(){
  const svg=$("#g-chart");if(!svg||!MONTHS.length)return;const W=Math.max(560,svg.clientWidth||560),H=240,pl=48,pb=26,pt=26,data=MONTHS;
  const peak=Math.max(...data.map(d=>d[1]),1),step=niceStep(peak/4),max=step*4,bw=(W-pl-8)/data.length,y=v=>pt+(H-pt-pb)*(1-v/max),base=H-pb,mono='font-family="Familjen Grotesk,system-ui,sans-serif"';
  let g="";for(let t=0;t<=max;t+=step)g+=`<line x1="${pl}" x2="${W-4}" y1="${y(t)}" y2="${y(t)}" stroke="var(--line)"/><text x="${pl-6}" y="${y(t)+4}" text-anchor="end" font-size="11" fill="var(--muted)" ${mono}>${short(t)}</text>`;
  const peakI=data.reduce((b,d,i)=>d[1]>data[b][1]?i:b,0),lastFull=YT.partialLast?data.length-2:data.length-1;
  data.forEach(([m,v],i)=>{const w=Math.max(2,bw-2),x=pl+i*bw+1,top=y(v),r=Math.min(4,w/2,base-top);
    const d=base-top<1?"":`M${x},${base}V${top+r}Q${x},${top} ${x+r},${top}H${x+w-r}Q${x+w},${top} ${x+w},${top+r}V${base}Z`;
    g+=`<path d="${d}" fill="var(--accent)"/><rect class="hit" data-i="${i}" x="${pl+i*bw}" y="${pt}" width="${bw}" height="${base-pt}" fill="transparent" tabindex="0" aria-label="${mLabel(m,i)}: ${nf(v)} views"/>`;
    const mo=+m.slice(5,7);if(mo===1||i===0)g+=`<text x="${x}" y="${H-8}" font-size="11" fill="var(--muted)" ${mono}>${BN[mo-1]} ${m.slice(2,4)}</text>`;else if(data.length<=36&&mo%3===1&&i>2)g+=`<text x="${x}" y="${H-8}" font-size="11" fill="var(--muted)" ${mono}>${BN[mo-1]}</text>`;
    if(i===peakI)g+=`<text x="${Math.min(Math.max(x+w/2,pl+30),W-40)}" y="${top-8}" text-anchor="middle" font-size="12" font-weight="500" fill="var(--ink)" ${mono}>${nf(v)}</text>`;
    if(i===lastFull&&i!==peakI)g+=`<text x="${x+w}" y="${top-8}" text-anchor="end" font-size="12" font-weight="500" fill="var(--ink)" ${mono}>${BN[mo-1]}: ${nf(v)}</text>`});
  svg.setAttribute("viewBox",`0 0 ${W} ${H}`);svg.innerHTML=g;
}
function niceStep(x){const p=Math.pow(10,Math.floor(Math.log10(Math.max(x,1)))),n=x/p;return (n<=1?1:n<=2?2:n<=2.5?2.5:n<=5?5:10)*p}
function short(n){return n>=1e6?f1(n/1e6)+"jt":n>=1e3?f1(n/1e3)+"rb":String(n)}
addEventListener("resize",()=>{if(YT&&!$("#p-growth").hidden)chart()});
(function hover(){const wrap=$("#g-chart-wrap"),tip=$("#g-tip");
  const showTip=el=>{const i=+el.dataset.i,[m,v]=MONTHS[i],r=el.getBoundingClientRect(),wr=wrap.getBoundingClientRect();tip.textContent=`${mLabel(m,i)}: ${nf(v)} views`;tip.hidden=false;let left=r.left-wr.left+wrap.scrollLeft+r.width/2;left=Math.max(90,Math.min(left,wrap.scrollWidth-90));tip.style.left=left+"px";tip.style.top=(r.top-wr.top+60)+"px"};
  wrap.addEventListener("pointerover",e=>{const h=e.target.closest(".hit");if(h)showTip(h)});wrap.addEventListener("pointerleave",()=>tip.hidden=true);
  wrap.addEventListener("focusin",e=>{const h=e.target.closest(".hit");if(h)showTip(h)});wrap.addEventListener("focusout",()=>tip.hidden=true)})();

function stats(g){const v=g.reduce((a,x)=>a+x.v,0),h=g.reduce((a,x)=>a+x.h,0),imp=g.reduce((a,x)=>a+x.imp,0),cl=g.reduce((a,x)=>a+x.imp*x.ctr/100,0);return{n:g.length,avg:g.length?v/g.length:0,ctr:imp?cl/imp*100:0,avd:v?h*60/v:0}}
function diagnose(){
  const lf=longForm(),ul=$("#g-diag"),tb=$("#g-cmp");if(lf.length<4){tb.innerHTML="";ul.innerHTML="<li>Butuh data minimal 4 video panjang untuk perbandingan. Impor file Konten dari Studio.</li>";return}
  const dates=lf.map(v=>v.d).filter(Boolean).sort(),latest=dates[dates.length-1]||"";
  const cut=latest?new Date(new Date(latest+"T12:00:00").getTime()-90*864e5).toISOString().slice(0,10):"";
  const top=[...lf].sort((a,b)=>b.v-a.v).slice(0,6),recent=lf.filter(v=>v.d&&v.d>cut&&!top.includes(v));
  const a=stats(top),b=stats(recent.length?recent:lf.slice(-6));
  tb.innerHTML=`<tr><th></th><th>6 video terbaik</th><th>${recent.length||6} video 90 hari terakhir</th></tr>
  <tr><td>Rata-rata views</td><td>${nf(a.avg)}</td><td class="${b.avg<a.avg/3?"flag":""}">${nf(b.avg)}</td></tr>
  <tr><td>CTR thumbnail</td><td>${f1(a.ctr)}%</td><td class="${b.ctr<a.ctr*0.75?"flag":""}">${f1(b.ctr)}%</td></tr>
  <tr><td>Rata-rata durasi tonton</td><td>${f1(a.avd)} mnt</td><td class="${b.avd<a.avd*0.75?"flag":""}">${f1(b.avd)} mnt</td></tr>`;
  const li=[];
  if(b.ctr<a.ctr*0.75)li.push(`<strong>CTR turun dari ${f1(a.ctr)}% ke ${f1(b.ctr)}%.</strong> Video ditampilkan tapi jarang diklik. Perbaiki judul dan thumbnail dulu, pakai alat Paket SEO dan Thumbnail.`);
  else li.push(`CTR video terbaru (${f1(b.ctr)}%) masih sebanding dengan video terbaik (${f1(a.ctr)}%).`);
  if(b.avd<a.avd*0.75)li.push(`<strong>Durasi tonton turun dari ${f1(a.avd)} ke ${f1(b.avd)} menit.</strong> Penonton pergi lebih cepat. Cek grafik retensi di Studio dan perkuat cold open di alat Kerangka naskah.`);
  li.push(`<strong>Video terlaris:</strong> ${top.slice(0,3).map(v=>esc(v.t)).join("; ")}. Cari pola topik dan sudut judul yang sama untuk ide berikutnya.`);
  const totalRev=lf.reduce((s,v)=>s+(v.rev||0),0);if(totalRev>0){const top3=[...lf].sort((x,y)=>(y.rev||0)-(x.rev||0)).slice(0,3).reduce((s,v)=>s+(v.rev||0),0);li.push(`${Math.round(top3/totalRev*100)}% pendapatan video panjang datang dari 3 video saja.`)}
  const sh=(YT.videos||[]).filter(v=>v.dur<120);if(sh.length){const sv=sh.reduce((s,v)=>s+v.v,0),ss=sh.reduce((s,v)=>s+v.s,0);li.push(`${sh.length} Shorts menghasilkan ${nf(sv)} views dan ${nf(ss)} subscriber.${sv/sh.length<1000?" Shorts belum bekerja; buat dari momen terkuat video panjang.":""}`)}
  ul.innerHTML=li.map(x=>`<li>${x}</li>`).join("");
}
$("#g-ai-btn").addEventListener("click",async e=>{
  const lf=longForm(),top=[...lf].sort((a,b)=>b.v-a.v).slice(0,12),rec=[...lf].sort((a,b)=>(b.d||"").localeCompare(a.d||"")).slice(0,12);
  const row=v=>`${v.d} | ${v.t} | ${Math.round(v.dur/60)} min | ${v.v} views | CTR ${v.ctr}% | avg view ${(v.v?v.h*60/v.v:0).toFixed(1)} min | ${v.s} subs | revenue ${Math.round(v.rev||0)} ${cur()}`;
  const extra=[YT.traffic?.length?"Traffic sources: "+YT.traffic.slice(0,8).map(r=>`${r.name} ${r.views} views CTR ${r.ctr??"n/a"}%`).join("; "):"",YT.geo?.length?"Geography: "+YT.geo.slice(0,8).map(r=>`${r.name} ${r.views} views revenue ${Math.round(r.rev||0)}`).join("; "):""].filter(Boolean).join("\n");
  const data=await ask($("#s-ai"),e.currentTarget,`Analyse this channel's YouTube Studio data like an experienced YouTube strategist. Explain what drove the best period, why recent videos underperform (if they do), and give a concrete plan for the next 4 uploads.
Monthly views: ${MONTHS.map(([m,v])=>m+" "+v).join(", ")}
Top videos (date | title | length | views | CTR | avg view duration | subs | revenue):
${top.map(row).join("\n")}
Most recent videos:
${rec.map(row).join("\n")}
${extra}
Write everything in Indonesian, plain and direct, citing the numbers above. JSON shape: {"summary":"2-3 sentences","findings":[{"title":"","detail":""}],"plan":[{"title":"","detail":""}]}`,"ai");
  if(data)renderAI(data)
});
function renderAI(data){$("#g-ai").innerHTML=`<div class="card"><p>${esc(data.summary)}</p>${(data.findings||[]).length?`<h3>Temuan</h3><ul class="diag">${data.findings.map(f=>`<li><strong>${esc(f.title)}.</strong> ${esc(f.detail)}</li>`).join("")}</ul>`:""}${(data.plan||[]).length?`<h3>Rencana 4 upload berikutnya</h3><ol class="diag">${data.plan.map(f=>`<li><strong>${esc(f.title)}.</strong> ${esc(f.detail)}</li>`).join("")}</ol>`:""}</div>`}

let sortKey="v",sortDir=-1;
const COLS=[["t","Judul"],["d","Terbit"],["v","Views"],["ctr","CTR %"],["avd","Tonton (mnt)"],["s","Subs"],["rev","Pendapatan"]];
function table(){const rows=longForm().map(x=>({...x,avd:x.v?x.h*60/x.v:0})).sort((a,b)=>(a[sortKey]>b[sortKey]?1:a[sortKey]<b[sortKey]?-1:0)*sortDir);
  const lf=longForm(),ctrs=lf.map(v=>v.ctr).sort((a,b)=>a-b),med=ctrs[Math.floor(ctrs.length/2)]||0;
  $("#g-table").innerHTML=`<tr>${COLS.map(([k,l])=>`<th data-k="${k}" tabindex="0" aria-sort="${k===sortKey?(sortDir>0?"ascending":"descending"):"none"}">${l}${k===sortKey?(sortDir>0?" ▲":" ▼"):""}</th>`).join("")}</tr>`+
  rows.map(x=>`<tr><td>${esc(x.t)}</td><td>${x.d?new Date(x.d+"T12:00:00").toLocaleDateString("id-ID",{day:"numeric",month:"short",year:"2-digit"}):""}</td><td>${nf(x.v)}</td><td class="${x.ctr>=med*1.25?"good":x.ctr<med*0.75?"flag":""}">${f1(x.ctr)}</td><td>${f1(x.avd)}</td><td>${nf(x.s)}</td><td>${money(x.rev)}</td></tr>`).join("")}
$("#g-table").addEventListener("click",e=>{const th=e.target.closest("th");if(!th)return;const k=th.dataset.k;if(k===sortKey)sortDir*=-1;else{sortKey=k;sortDir=k==="t"?1:-1}table();$(`#g-table th[data-k="${k}"]`)?.focus()});
$("#g-table").addEventListener("keydown",e=>{if((e.key==="Enter"||e.key===" ")&&e.target.matches("th")){e.preventDefault();e.target.click()}});

function extras(){const out=[];
  if(YT.traffic?.length){const tot=YT.traffic.reduce((s,r)=>s+r.views,0)||1;out.push(`<div class="card"><span class="layer">Sumber traffic</span><h3>Dari mana penonton datang</h3><div style="overflow-x:auto"><table><tr><th>Sumber</th><th>Views</th><th>CTR</th></tr>${YT.traffic.slice(0,8).map(r=>`<tr><td>${esc(r.name)}</td><td>${f1(r.views/tot*100)}%</td><td>${r.ctr!=null?f1(r.ctr)+"%":"tidak ada"}</td></tr>`).join("")}</table></div><p class="note">Browse features = beranda YouTube. Beranda hanya menaruh video yang CTR dan durasi tontonnya bagus.</p></div>`)}
  if(YT.geo?.length){out.push(`<div class="card"><span class="layer">Pendapatan per 1.000 views menurut negara</span><h3>Penonton mana yang paling bernilai</h3><div style="overflow-x:auto"><table><tr><th>Negara</th><th>Views</th><th>${cur()} / 1.000</th></tr>${YT.geo.slice(0,10).map(r=>{const rpm=r.views?(r.rev||0)/r.views*1000:0;return `<tr><td>${esc(r.name)}</td><td>${nf(r.views)}</td><td>${money(rpm)}</td></tr>`}).join("")}</table></div></div>`)}
  if(YT.age?.rows?.length){out.push(`<div class="card"><span class="layer">Umur dan gender</span><h3>Siapa penontonnya</h3><div style="overflow-x:auto"><table><tr>${YT.age.headers.map(h=>`<th>${esc(h)}</th>`).join("")}</tr>${YT.age.rows.slice(0,20).map(r=>`<tr>${r.map(c=>`<td>${esc(c)}</td>`).join("")}</tr>`).join("")}</table></div></div>`)}
  $("#g-extra").innerHTML=out.join("");$("#g-extra").hidden=!out.length}

function incomeSetup(){
  document.querySelectorAll(".cur").forEach(s=>s.textContent=cur()==="IDR"?"Rp":cur());
  const paid=longForm().filter(v=>v.rev>0&&v.v>500),rpms=paid.map(v=>v.rev/v.v*1000).sort((a,b)=>a-b);
  const saved=store.get("sim",null);
  if(saved){$("#g-views").value=saved.views;$("#g-rpm").value=saved.rpm;$("#g-members").value=saved.m;$("#g-mprice").value=saved.mp}
  else if(rpms.length){$("#g-rpm").value=Math.round(rpms[Math.floor(rpms.length/2)]);$("#g-views").value=Math.round(lastDays(30)/1000)*1000||1000}
  $("#g-rpm-note").textContent=rpms.length?`RPM video Anda yang menghasilkan berkisar ${money(rpms[0])} sampai ${money(rpms[rpms.length-1])} per 1.000 views (nilai tengah ${money(rpms[Math.floor(rpms.length/2)])}). Isi jumlah member asli dari Studio.`:"Isi RPM dari tab Pendapatan di YouTube Studio.";
  const ms=MONTHS.map(m=>m[1]),best=ms.length?Math.max(...ms):0;
  $("#g-presets").innerHTML=[["Sekarang (30 hari)",Math.round(lastDays(30))],["Bulan terbaik",best]].filter(p=>p[1]>0).map(([l,v])=>`<button type="button" class="btn ghost" data-views="${v}">${l}: ${nf(v)}</button>`).join("");
  income();
}
function income(){const n=id=>Math.max(0,+$(id).value||0);const ads=n("#g-views")/1000*n("#g-rpm"),mem=n("#g-members")*n("#g-mprice")*0.7;
  $("#g-income").innerHTML=`<div class="big">${money(ads+mem)}<span style="font-size:16px;font-family:var(--f-body)"> / bulan</span></div><div class="meta" style="margin-top:6px"><span>Iklan: ${money(ads)}</span><span>Membership setelah potongan YouTube 30%: ${money(mem)}</span><span>Belum termasuk merch dan sponsor</span></div>`;
  store.set("sim",{views:n("#g-views"),rpm:n("#g-rpm"),m:n("#g-members"),mp:n("#g-mprice")})}
$("#g-presets").addEventListener("click",e=>{const b=e.target.closest("[data-views]");if(b){$("#g-views").value=b.dataset.views;income()}});
["#g-views","#g-rpm","#g-members","#g-mprice"].forEach(id=>$(id).addEventListener("input",income));

const CHECK=[["Cek grafik retensi 3 video terakhir","Catat detik di mana penonton paling banyak pergi, lalu perbaiki pembuka video berikutnya."],["Upload di hari dan jam yang sama","Pakai kalender di alat Ide. Cocokkan dengan grafik jam aktif penonton di Studio."],["Buat 3 sampai 5 Shorts dari tiap video panjang","Tautkan ke video utuh lewat fitur Related video."],["Uji judul atau thumbnail dengan Test & Compare","Ganti thumbnail yang CTR-nya rendah setelah 48 jam."],["Buat playlist seri","Menambah jam tonton per sesi."],["Pasang end screen ke video berikutnya di seri","Mendorong penonton lanjut menonton."],["Sebut membership sekali, di momen yang pas","Jelaskan apa yang didapat member."],["Siapkan media kit sederhana untuk sponsor","Mulai menghubungi sponsor setelah views rata-rata stabil."],["Balas dan sematkan komentar di 24 jam pertama","Komentar awal memberi sinyal interaksi."],["Cek sumber tiap fakta besar","Kepercayaan penonton adalah aset jangka panjang."]];
const done=store.get("check",{});
$("#g-check").innerHTML=CHECK.map(([t,s],i)=>`<li><input type="checkbox" id="ck${i}" ${done[i]?"checked":""}><label for="ck${i}" style="display:block;font-weight:500">${esc(t)}<small>${esc(s)}</small></label></li>`).join("");
$("#g-check").addEventListener("change",e=>{done[e.target.id.slice(2)]=e.target.checked;store.set("check",done)});

/* import */
let importStatus=null;
document.addEventListener("click",e=>{const b=e.target.closest("[data-import]");if(!b)return;importStatus=b.closest("#g-empty")?$("#s-import-empty"):b.closest("#p-settings")?$("#s-app"):$("#s-import");$("#file-import").click()});
$("#file-import").addEventListener("change",async e=>{const files=[...e.target.files];e.target.value="";if(!files.length)return;const st=importStatus||$("#s-import");st.className="status";st.textContent="Mengimpor…";
  const msgs=[];for(const f of files){const j=await api("/api/import",{method:"POST",headers:{"X-Filename":encodeURIComponent(f.name)},body:await f.arrayBuffer()});if(j.error){st.className="status err";st.textContent=f.name+": "+j.error;return}msgs.push(...(j.found||[]))}
  st.textContent=msgs.length?"Terimpor: "+msgs.join(", ")+".":"Tidak ada tabel yang dikenali di file itu. Pastikan file berasal dari Export Studio mode lanjutan.";await loadData()});

/* settings */
const PROFILE_FIELDS=[["name","#pf-name"],["lang","#pf-lang"],["length","#pf-length"],["niche","#pf-niche"],["audience","#pf-audience"],["wins","#pf-wins"],["money","#pf-money"],["style","#pf-style"]];
async function loadConfig(){CFG=await api("/api/config");if(CFG.error){CFG={profile:{}};return}
  $("#cfg-model").value=CFG.model||"claude-sonnet-5-5";$("#cfg-effort").value=CFG.effort||"medium";
  $("#cfg-key-hint").textContent=CFG.has_key?"Tersimpan: kunci berakhiran "+CFG.key_hint+". Kosongkan kolom untuk tetap memakai kunci ini.":"Belum ada kunci Claude tersimpan.";
  $("#banner-key").hidden=!!CFG.provider||store.get("banner-off",false);
  $("#cfg-provider").value=CFG.provider_choice&&CFG.provider_choice!==""?CFG.provider_choice:(CFG.provider||"manual");showProv();
  $("#cfg-gkey-hint").textContent=CFG.has_gemini?"Tersimpan: kunci berakhiran "+CFG.gemini_hint+". Kosongkan kolom untuk tetap memakai kunci ini.":"Belum ada kunci Gemini tersimpan.";
  if(CFG.gemini_model&&![...$("#cfg-gmodel").options].some(o=>o.value===CFG.gemini_model))$("#cfg-gmodel").insertAdjacentHTML("beforeend",`<option value="${esc(CFG.gemini_model)}">${esc(CFG.gemini_model)}</option>`);$("#cfg-gmodel").value=CFG.gemini_model||"";$("#cfg-dir").textContent=CFG.dir||"";voiceFields();ytFields();if(lastNarr&&$("#o-scriptfull"))renderScriptFull(lastNarr);
  const p=CFG.profile||{};PROFILE_FIELDS.forEach(([k,id])=>{if(p[k]!=null)$(id).value=p[k]});
  $("#hdr-channel").textContent=p.name||""}
function readProfile(){const p={};PROFILE_FIELDS.forEach(([k,id])=>p[k]=$(id).value.trim());return p}
async function saveConfig(extra,st){const body={model:$("#cfg-model").value,effort:$("#cfg-effort").value,profile:readProfile(),...extra};const j=await api("/api/config",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(body)});
  if(j.error){st.className="status err";st.textContent=j.error;return false}st.className="status";st.textContent="Tersimpan.";await loadConfig();return true}
const PROV_HINT={manual:"Tiap tombol AI menyiapkan perintah untuk disalin ke claude.ai. Gratis karena memakai langganan Anda, tapi perlu salin-tempel.",gemini:"Hasil langsung muncul di aplikasi. Pakai API key gratis dari Google AI Studio.",claude:"Hasil langsung muncul di aplikasi dengan kualitas terbaik. Ditagih Anthropic per pemakaian, terpisah dari langganan claude.ai."};
function showProv(){const v=$("#cfg-provider").value;$("#prov-hint").textContent=PROV_HINT[v]||"";$("#grp-gemini").hidden=v!=="gemini";$("#grp-claude").hidden=v!=="claude"}
$("#cfg-provider").addEventListener("change",showProv);
function keyFields(st){const k=$("#cfg-key").value.trim(),g=$("#cfg-gkey").value.trim(),x={provider:$("#cfg-provider").value,gemini_model:$("#cfg-gmodel").value};
  if(k){if(!k.startsWith("sk-ant-")){st.className="status err";st.textContent="API key Claude diawali sk-ant-. Periksa lagi kunci yang ditempel.";return null}x.api_key=k}
  if(g){if(!/^[A-Za-z0-9_\-]{20,}$/.test(g)){st.className="status err";st.textContent="API key Gemini tidak terlihat benar. Salin ulang dari AI Studio.";return null}x.gemini_key=g}
  return x}
$("#f-key").addEventListener("submit",async e=>{e.preventDefault();const st=$("#s-key"),x=keyFields(st);if(!x)return;
  if(x.provider==="gemini"&&!x.gemini_key&&!CFG.has_gemini){st.className="status err";st.textContent="Tempel dulu API key Gemini.";return}
  if(x.provider==="claude"&&!x.api_key&&!CFG.has_key){st.className="status err";st.textContent="Tempel dulu API key Claude.";return}
  if(await saveConfig(x,st)){$("#cfg-key").value="";$("#cfg-gkey").value=""}});
$("#cfg-test").addEventListener("click",async e=>{const st=$("#s-key"),btn=e.currentTarget,x=keyFields(st);if(!x)return;if(!await saveConfig(x,st))return;$("#cfg-key").value="";$("#cfg-gkey").value="";
  if(!CFG.provider){st.className="status";st.textContent="Mode salin-tempel aktif. Tidak ada koneksi yang perlu diuji.";return}
  st.className="status";st.textContent="Menguji…";btn.disabled=true;
  const j=await api("/api/generate",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({prompt:"Reply with exactly: OK",test:true})});btn.disabled=false;
  const rp=costRp(j.model,j.usage,j.provider);if(rp)addSpent(rp).catch(()=>{});
  if(j.error){st.className="status err";st.textContent=j.error}else{st.className="status";st.textContent="Berhasil terhubung ke "+(j.model||"AI")+"."}});
$("#cfg-gmodels").addEventListener("click",async e=>{const st=$("#s-key"),g=$("#cfg-gkey").value.trim();st.className="status";st.textContent="Memuat daftar model…";
  const j=await api("/api/gemini-models",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({key:g})});
  if(j.error){st.className="status err";st.textContent=j.error;return}fillGModels(j.models||[],j.default);st.textContent=`${(j.models||[]).length} model tersedia. Pilihan otomatis: ${j.default||"-"}.`});
function fillGModels(list,def){const sel=$("#cfg-gmodel"),cur=sel.value||CFG.gemini_model||"";sel.innerHTML=`<option value="">Otomatis: ${esc(def||"Gemini Flash terbaru")}</option>`+list.map(m=>`<option value="${esc(m)}">${esc(m)}</option>`).join("");sel.value=list.includes(cur)?cur:""}
$("#cfg-gclear").addEventListener("click",async()=>{if(await saveConfig({clear_gemini:true,provider:$("#cfg-provider").value==="gemini"?"manual":$("#cfg-provider").value},$("#s-key")))$("#s-key").textContent="Kunci Gemini dihapus."});
$("#cfg-clear").addEventListener("click",async()=>{if(await saveConfig({clear_key:true,provider:$("#cfg-provider").value==="claude"?"manual":$("#cfg-provider").value},$("#s-key")))$("#s-key").textContent="Kunci Claude dihapus."});
/* ElevenLabs */
let EVOICES=[];
function voiceFields(){$("#cfg-ekey-hint").textContent=CFG.has_eleven?"Tersimpan: kunci berakhiran "+CFG.eleven_hint+". Kosongkan kolom untuk tetap memakai kunci ini.":"Belum ada kunci ElevenLabs tersimpan.";
  const vs=$("#cfg-evoice");if(CFG.eleven_voice&&![...vs.options].some(o=>o.value===CFG.eleven_voice))vs.innerHTML=`<option value="${esc(CFG.eleven_voice)}">${esc(CFG.eleven_voice_name||CFG.eleven_voice)}</option>`;vs.value=CFG.eleven_voice||"";
  const ms=$("#cfg-emodel");if(CFG.eleven_model&&![...ms.options].some(o=>o.value===CFG.eleven_model))ms.insertAdjacentHTML("beforeend",`<option value="${esc(CFG.eleven_model)}">${esc(CFG.eleven_model)}</option>`);ms.value=CFG.eleven_model||"";
  $("#cfg-adir").textContent=CFG.audio_dir?"File MP3 disimpan di "+CFG.audio_dir:"";showPreview()}
function showPreview(){const v=EVOICES.find(x=>x.id===$("#cfg-evoice").value);$("#cfg-epreview").innerHTML=v?.preview?`<p class="note">${esc(v.desc||"")}</p><audio controls preload="none" src="${esc(v.preview)}" style="width:100%"></audio>`:""}
$("#cfg-evoice").addEventListener("change",showPreview);
$("#cfg-eload").addEventListener("click",async e=>{const st=$("#s-voice"),k=$("#cfg-ekey").value.trim(),b=e.currentTarget;
  if(!k&&!CFG.has_eleven){st.className="status err";st.textContent="Tempel dulu API key ElevenLabs.";return}
  st.className="status";st.textContent="Memuat suara dan kuota…";b.disabled=true;
  const j=await api("/api/eleven/info",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({key:k})});b.disabled=false;
  if(j.error){st.className="status err";st.textContent=j.error;return}
  EVOICES=j.voices||[];const cur=$("#cfg-evoice").value||CFG.eleven_voice;
  $("#cfg-evoice").innerHTML=`<option value="">Pilih suara</option>`+EVOICES.map(v=>`<option value="${esc(v.id)}">${esc(v.name)}${v.desc?", "+esc(v.desc):""}</option>`).join("");$("#cfg-evoice").value=EVOICES.some(v=>v.id===cur)?cur:"";
  const mc=$("#cfg-emodel").value||CFG.eleven_model;$("#cfg-emodel").innerHTML=`<option value="">Otomatis: Multilingual v2 (paling natural)</option>`+(j.models||[]).map(m=>`<option value="${esc(m.id)}">${esc(m.name)}</option>`).join("");$("#cfg-emodel").value=(j.models||[]).some(m=>m.id===mc)?mc:"";
  const reset=j.reset?new Date(j.reset*1000).toLocaleDateString("id-ID",{day:"numeric",month:"long"}):"";
  $("#eleven-quota").innerHTML=`<div class="qbar" role="img" aria-label="Kuota terpakai ${nf(j.used)} dari ${nf(j.limit)} karakter"><span style="width:${j.limit?Math.min(100,j.used/j.limit*100).toFixed(1):0}%"></span></div>Paket ${esc(j.tier||"-")}: sisa <strong>${nf(j.left)}</strong> dari ${nf(j.limit)} karakter${reset?", diisi ulang "+reset:""}. Satu video 1.800 kata sekitar 11.000 karakter.`;
  st.textContent=`${EVOICES.length} suara dimuat. Pilih satu, dengarkan contohnya, lalu Simpan.`;showPreview()});
$("#f-voice").addEventListener("submit",async e=>{e.preventDefault();const st=$("#s-voice"),k=$("#cfg-ekey").value.trim(),sel=$("#cfg-evoice");
  if(!k&&!CFG.has_eleven){st.className="status err";st.textContent="Tempel dulu API key ElevenLabs.";return}
  const x={eleven_model:$("#cfg-emodel").value};if(k)x.eleven_key=k;if(sel.value){x.eleven_voice=sel.value;x.eleven_voice_name=EVOICES.find(v=>v.id===sel.value)?.name||sel.selectedOptions[0]?.textContent||""}
  if(await saveConfig(x,st)){$("#cfg-ekey").value="";st.textContent=CFG.eleven_voice?"Tersimpan. Tombol voice over muncul di bawah naskah narasi penuh.":"Kunci tersimpan. Klik Muat suara lalu pilih narator."}});
$("#cfg-eclear").addEventListener("click",async()=>{if(await saveConfig({clear_eleven:true},$("#s-voice")))$("#s-voice").textContent="Kunci ElevenLabs dihapus."});
/* YouTube Studio */
function ytFields(){const on=!!CFG.yt_connected;$("#yt-on").hidden=!on;$("#yt-setup").open=!CFG.yt_client_id;
  $("#yt-name").textContent=on?(CFG.yt_channel?"Terhubung: "+CFG.yt_channel:"Terhubung"):"";
  $("#yt-last").textContent=CFG.yt_synced?"Terakhir ditarik "+new Date(CFG.yt_synced*1000).toLocaleString("id-ID",{day:"numeric",month:"short",hour:"2-digit",minute:"2-digit"})+". Data ditarik otomatis tiap aplikasi dibuka.":"Belum pernah ditarik.";
  $("#yt-connect").textContent=on?"Hubungkan ulang":"Simpan dan hubungkan YouTube";
  if(!$("#yt-id").value)$("#yt-id").value=CFG.yt_client_id||"";
  $("#yt-secret-hint").textContent=CFG.has_yt_secret?"Client secret tersimpan. Kosongkan kolom untuk tetap memakainya.":"";
  document.querySelectorAll("[data-ytsync]").forEach(b=>b.hidden=!on)}
async function ytSync(st,btn){if(btn)btn.disabled=true;if(st){st.className="status";st.textContent="Menarik data dari YouTube…"}
  const j=await api("/api/yt/sync",{method:"POST",headers:{"Content-Type":"application/json"},body:"{}"});if(btn)btn.disabled=false;
  if(j.error){if(st){st.className="status err";st.textContent=j.error}return false}
  if(st)st.textContent=`Selesai: ${nf(j.videos)} video, ${nf(j.days)} hari data (${j.range}).${j.revenue?"":" Pendapatan tidak ikut karena akun ini tidak memberi akses data pendapatan."}`;
  await loadConfig();await loadData();return true}
$("#f-yt").addEventListener("submit",async e=>{e.preventDefault();const st=$("#s-yt"),id=$("#yt-id").value.trim(),sec=$("#yt-secret").value.trim();
  if(!/\.apps\.googleusercontent\.com$/.test(id)){st.className="status err";st.textContent="Client ID diakhiri .apps.googleusercontent.com. Salin ulang dari Google Cloud.";return}
  if(!sec&&!CFG.has_yt_secret){st.className="status err";st.textContent="Tempel juga Client secret.";return}
  const x={yt_client_id:id};if(sec)x.yt_secret=sec;if(!await saveConfig(x,st))return;$("#yt-secret").value="";
  const j=await api("/api/yt/connect",{method:"POST",headers:{"Content-Type":"application/json"},body:"{}"});
  if(j.error){st.className="status err";st.textContent=j.error;return}
  st.className="status";st.innerHTML=`Halaman login Google terbuka di browser. Pilih akun pemilik channel dan izinkan, lalu kembali ke sini. Kalau tidak terbuka, <a href="${esc(j.url)}" target="_blank" rel="noopener">klik di sini</a>.`;
  const t0=Date.now(),iv=setInterval(async()=>{await loadConfig();if(CFG.yt_connected){clearInterval(iv);st.textContent="YouTube terhubung. Menarik data…";ytSync(st)}else if(Date.now()-t0>300000)clearInterval(iv)},3000)});
$("#yt-sync").addEventListener("click",e=>ytSync($("#s-yt"),e.currentTarget));
$("#yt-off").addEventListener("click",async()=>{if(await saveConfig({clear_yt:true},$("#s-yt")))$("#s-yt").textContent="Sambungan YouTube diputus. Data yang sudah ditarik tetap ada."});
document.addEventListener("click",e=>{const b=e.target.closest("[data-ytsync]");if(b)ytSync($("#s-import")||null,b)});
$("#f-profile").addEventListener("submit",async e=>{e.preventDefault();await saveConfig({},$("#s-profile"))});
$("#pf-export").addEventListener("click",async e=>{const t=JSON.stringify(readProfile(),null,2),b=e.currentTarget;$("#pf-json").hidden=false;$("#pf-json").value=t;try{await navigator.clipboard.writeText(t);b.textContent="Tersalin"}catch{$("#pf-json").select();b.textContent="Tekan Ctrl+C"}});
$("#pf-import").addEventListener("click",()=>{const ta=$("#pf-json");if(ta.hidden){ta.hidden=false;ta.value="";ta.placeholder="Tempel profil JSON di sini, lalu klik Tempel profil lagi";ta.focus();return}
  let p;try{p=JSON.parse(ta.value)}catch{$("#s-profile").className="status err";$("#s-profile").textContent="Teks itu bukan JSON profil yang valid.";return}
  PROFILE_FIELDS.forEach(([k,id])=>{if(p[k]!=null)$(id).value=p[k]});ta.hidden=true;saveConfig({},$("#s-profile"))});
$("#backup-save").addEventListener("click",async()=>{const st=$("#s-app");const j=await api("/api/backup");if(j.error){st.className="status err";st.textContent=j.error;return}
  const name=`terra-studio-backup-${isoDay(new Date())}.json`,url=URL.createObjectURL(new Blob([JSON.stringify(j)],{type:"application/json"})),a=document.createElement("a");a.href=url;a.download=name;document.body.append(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(url),2000);
  st.className="status";st.textContent=`Backup disimpan sebagai ${name} di folder Downloads.`});
let pendingBackup=null;
$("#backup-load").addEventListener("click",()=>$("#backup-file").click());
$("#backup-file").addEventListener("change",async e=>{const f=e.target.files[0];e.target.value="";if(!f)return;const st=$("#s-app");let j;try{j=JSON.parse(await f.text())}catch{st.className="status err";st.textContent="File itu bukan backup Terra Studio.";return}
  if(j.app!=="terra-studio"){st.className="status err";st.textContent="File itu bukan backup Terra Studio.";return}
  pendingBackup=j;$("#backup-confirm-text").textContent=`Ganti data sekarang dengan backup tanggal ${new Date(j.created*1000).toLocaleDateString("id-ID",{day:"numeric",month:"long",year:"numeric"})}?`;$("#backup-confirm").hidden=false});
$("#backup-no").addEventListener("click",()=>{pendingBackup=null;$("#backup-confirm").hidden=true});
$("#backup-yes").addEventListener("click",async()=>{if(!pendingBackup)return;const st=$("#s-app");const j=await api("/api/restore",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(pendingBackup)});pendingBackup=null;$("#backup-confirm").hidden=true;
  if(j.error){st.className="status err";st.textContent=j.error;return}st.className="status";st.textContent="Backup dipulihkan.";await loadConfig();await loadData();await loadLast();renderDash()});
$("#data-clear").addEventListener("click",()=>$("#data-clear-confirm").hidden=false);
$("#data-clear-no").addEventListener("click",()=>$("#data-clear-confirm").hidden=true);
$("#data-clear-yes").addEventListener("click",async()=>{await api("/api/data",{method:"DELETE"});$("#data-clear-confirm").hidden=true;$("#s-app").className="status";$("#s-app").textContent="Data Studio dihapus.";await loadData()});
$("#app-quit").addEventListener("click",async()=>{await fetch("/api/quit",{method:"POST",headers:{"X-Terra":"1"}}).catch(()=>{});document.body.innerHTML='<div class="wrap"><h1>Terra Studio sudah ditutup.</h1><p class="sub">Jendela ini boleh ditutup.</p></div>'});

async function loadData(){const j=await api("/api/data");YT=(j&&!j.error&&(j.videos||j.daily))?j:null;
  if(YT&&YT.daily?.length){const ld=new Date(YT.daily[YT.daily.length-1][0]+"T12:00:00"),dim=new Date(ld.getFullYear(),ld.getMonth()+1,0).getDate();YT.partialLast=ld.getDate()<dim}
  renderGrowth();renderDash();renderToday();renderLearn();renderPattern()}
/* Dashboard and calendar */
const TYPE_LABEL={video:"Video",short:"Shorts",post:"Post"},STATUS_LABEL={ide:"Ide",naskah:"Naskah",rekam:"Rekam",edit:"Edit",siap:"Siap upload",tayang:"Sudah tayang"};
const plans=()=>LAST.plans?.data||[];
async function savePlans(list){list.sort((a,b)=>a.date.localeCompare(b.date));await remember("plans",list);renderDash();renderPipe();if(!$("#p-make").hidden)renderMake()}
const isoDay=d=>`${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,"0")}-${String(d.getDate()).padStart(2,"0")}`;
let calMonth=(()=>{const d=new Date();return new Date(d.getFullYear(),d.getMonth(),1)})();
let mcMonth=new Date(calMonth),weekStart=(()=>{const d=new Date();d.setHours(12,0,0,0);return d})();
let view="week",typeF="all",query="",mcFocus=null;
const STAGES=["ide","naskah","rekam","edit","siap","tayang"];
const DOW=["Min","Sen","Sel","Rab","Kam","Jum","Sab"];
const addDays=(d,n)=>{const x=new Date(d);x.setDate(x.getDate()+n);return x};
const match=p=>(typeF==="all"||p.type===typeF)&&(!query||(p.title||"").toLowerCase().includes(query));
const pubs=()=>(YT?.videos||[]).filter(v=>v.d&&(typeF==="all"||(typeF==="short"?v.dur<120:typeF==="video"&&v.dur>=120))&&(!query||(v.t||"").toLowerCase().includes(query)));
const thumbUrl=p=>p.thumb?`/api/thumb/${encodeURIComponent(p.id)}?v=${encodeURIComponent(p.thumb)}`:"";
function cardHTML(p){const st=STAGES.indexOf(p.status),pct=Math.round((Math.max(st,0)+1)/STAGES.length*100),cls=p.status==="ide"?"ide":p.type;
  return `<button type="button" class="k ${esc(cls)}${p.status==="tayang"?" tayang":""}" data-plan-id="${esc(p.id)}">${p.thumb?`<img src="${thumbUrl(p)}" alt="">`:""}<span class="in"><span class="lb">${p.status==="ide"?"Ide, ":""}${TYPE_LABEL[p.type]||""}</span><span class="tt">${esc(p.title)}</span><span class="pg" role="img" aria-label="Status ${esc(STATUS_LABEL[p.status]||"")}"><i style="width:${pct}%"></i></span><span class="ft">${esc(STATUS_LABEL[p.status]||"")}</span></span></button>`}
function renderWeek(){const today=isoDay(new Date()),end=addDays(weekStart,6);
  $("#wk-title").textContent=weekStart.getMonth()===end.getMonth()?`${weekStart.getDate()} sampai ${end.getDate()} ${BN[end.getMonth()]} ${end.getFullYear()}`:`${weekStart.getDate()} ${BN[weekStart.getMonth()]} sampai ${end.getDate()} ${BN[end.getMonth()]}`;
  let h="";for(let i=0;i<7;i++){const d=addDays(weekStart,i),iso=isoDay(d);
    const items=plans().filter(p=>p.date===iso&&match(p)).map(cardHTML).join("")+pubs().filter(v=>v.d===iso).map(v=>`<div class="k pub"><span class="in"><span class="lb">Tayang, ${v.dur<120?"Shorts":"video panjang"}</span><span class="tt">${esc(v.t)}</span><span class="ft">${nf(v.v)} views</span></span></div>`).join("");
    h+=`<div class="day${iso===today?" today":""}"><div class="dh"><b>${d.getDate()}</b>${DOW[d.getDay()]}</div>${items}<button type="button" class="add" data-new="${iso}" aria-label="Tambah rencana ${d.getDate()} ${BN[d.getMonth()]}">+ Tambah</button></div>`}
  $("#wk").innerHTML=h}
function renderCal(){const y=calMonth.getFullYear(),m=calMonth.getMonth(),first=new Date(y,m,1),days=new Date(y,m+1,0).getDate(),lead=(first.getDay()+6)%7,today=isoDay(new Date());
  const title=first.toLocaleDateString("id-ID",{month:"long",year:"numeric"});if(view==="month")$("#wk-title").textContent=title;
  const byDay={};const add=(d,html)=>{(byDay[d]=byDay[d]||[]).push(html)};const pre=`${y}-${String(m+1).padStart(2,"0")}`;
  pubs().forEach(v=>{if(v.d.startsWith(pre))add(v.d,`<span class="ev pub" title="${esc(v.t)}, ${nf(v.v)} views"><i>${v.dur<120?"Shorts":"Tayang"}</i>${esc(v.t)}</span>`)});
  plans().filter(match).forEach(p=>add(p.date,`<button type="button" class="ev ${esc(p.type)}${p.status==="tayang"?" done":""}" data-plan-id="${esc(p.id)}" title="${esc(p.title)}, ${STATUS_LABEL[p.status]||""}"><i>${STATUS_LABEL[p.status]||""}</i>${esc(p.title)}</button>`));
  const head=["Sen","Sel","Rab","Kam","Jum","Sab","Min"].map(d=>`<div class="cal-dow" aria-hidden="true">${d}</div>`).join("");
  let cells="";for(let i=0;i<lead;i++)cells+=`<div class="cal-day off" aria-hidden="true"></div>`;
  for(let d=1;d<=days;d++){const iso=`${pre}-${String(d).padStart(2,"0")}`;
    cells+=`<div class="cal-day${iso===today?" today":""}"><button type="button" class="cal-num" data-new="${iso}" aria-label="Tambah rencana ${d} ${title}">${d}</button>${(byDay[iso]||[]).join("")}</div>`}
  const tail=(7-(lead+days)%7)%7;for(let i=0;i<tail;i++)cells+=`<div class="cal-day off" aria-hidden="true"></div>`;
  $("#cal").innerHTML=head+cells}
function renderMini(){const y=mcMonth.getFullYear(),m=mcMonth.getMonth(),days=new Date(y,m+1,0).getDate(),lead=(new Date(y,m,1).getDay()+6)%7,today=isoDay(new Date()),pre=`${y}-${String(m+1).padStart(2,"0")}`;
  $("#mc-title").textContent=new Date(y,m,1).toLocaleDateString("id-ID",{month:"long",year:"numeric"});
  const kind={},pub={};plans().filter(match).forEach(p=>{if(p.date.startsWith(pre)&&!kind[p.date])kind[p.date]=p.type});pubs().forEach(v=>{if(v.d.startsWith(pre))pub[v.d]=1});
  // One tab stop for the whole month; arrow keys move between days.
  const stop=mcFocus&&mcFocus.startsWith(pre)?mcFocus:today.startsWith(pre)?today:pre+"-01";
  let h=["S","S","R","K","J","S","M"].map(d=>`<span class="dow" aria-hidden="true">${d}</span>`).join("");for(let i=0;i<lead;i++)h+=`<span class="d e" aria-hidden="true"></span>`;
  for(let d=1;d<=days;d++){const iso=`${pre}-${String(d).padStart(2,"0")}`,k=kind[iso];
    h+=`<button type="button" tabindex="${iso===stop?0:-1}" class="d${k?" "+k:""}${pub[iso]?" pub":""}${iso===today?" today":""}" data-day="${iso}" aria-label="${d} ${$("#mc-title").textContent}${k?", ada rencana "+(TYPE_LABEL[k]||""):""}${pub[iso]?", ada video tayang":""}">${d}</button>`}
  $("#mc").innerHTML=h;
  const n=plans().filter(p=>p.date.startsWith(pre)&&p.status!=="tayang").length;$("#mc-sub").textContent=n?`${n} rencana bulan ini`:"Belum ada rencana bulan ini"}
function renderNext(){const today=isoDay(new Date()),p=plans().filter(x=>x.date>=today&&x.status!=="tayang")[0],el=$("#next-up");
  if(!p){el.className="next noimg";el.innerHTML=`<div class="top"><span>Upload berikutnya</span></div><h3>Belum ada jadwal</h3><p>Buat rencana video supaya jadwal upload kelihatan di sini.</p><div class="row"><button type="button" class="p" data-act="new">Buat rencana</button></div>`;return}
  const d=new Date(p.date+"T12:00:00"),days=Math.round((d-new Date(today+"T12:00:00"))/864e5),when=days===0?"Hari ini":days===1?"Besok":`${days} hari lagi`;
  el.className="next"+(p.thumb?"":" noimg");
  el.innerHTML=`<div class="top"><span>${d.toLocaleDateString("id-ID",{weekday:"long",day:"numeric",month:"short"})}</span><span class="badge">${when}</span></div><h3>${esc(p.title)}</h3><div class="row"><button type="button" class="p" data-act="tools" data-id="${esc(p.id)}">Kerjakan</button><button type="button" class="s" data-plan-id="${esc(p.id)}">Ubah</button></div>${p.thumb?`<img class="stk" src="${thumbUrl(p)}" alt="">`:""}`}
function renderStages(){const today=isoDay(new Date()),list=plans().filter(p=>p.date>=today&&p.status!=="tayang");const C={ide:"var(--accent)",naskah:"var(--bone)",rekam:"var(--stone)",edit:"var(--rust)",siap:"var(--ok)"};
  $("#stages").innerHTML=STAGES.slice(0,5).map(s=>`<li style="--c:${C[s]}"><i></i>${STATUS_LABEL[s]}<b>${list.filter(p=>p.status===s).length}</b></li>`).join("")}
function renderViews(){const el=$("#vc"),d=YT?.daily||[];
  if(d.length<14){$("#vc-sub").textContent="";el.innerHTML=`<p class="empty-s" style="grid-column:1/-1">Grafik muncul setelah data Studio diimpor atau YouTube tersambung.</p>`;return}
  const cur=d.slice(-7),prev=d.slice(-14,-7),sum=cur.reduce((a,x)=>a+x[1],0),psum=prev.reduce((a,x)=>a+x[1],0),top=niceStep(Math.max(...cur.map(x=>x[1]),...prev.map(x=>x[1]),1)/4)*4;
  $("#vc-sub").innerHTML=`7 hari terakhir: <b>${nf(sum)}</b> views, minggu sebelumnya ${nf(psum)}`;
  const best=cur.reduce((b,x,i)=>x[1]>cur[b][1]?i:b,0);
  el.innerHTML=`<div class="ax" aria-hidden="true">${[4,3,2,1,0].map(i=>`<span>${short(top*i/4)}</span>`).join("")}</div><div class="bars">${cur.map((x,i)=>{const dt=new Date(x[0]+"T12:00:00");return `<button type="button" class="b${i===best?" on":""}" data-i="${i}" aria-label="${DOW[dt.getDay()]} ${dt.getDate()} ${BN[dt.getMonth()]}: ${nf(x[1])} views, minggu sebelumnya ${nf(prev[i][1])}"><span class="g" style="height:${prev[i][1]/top*100}%"></span><span class="f" style="height:${x[1]/top*100}%"></span><span class="lbl">${DOW[dt.getDay()]}</span></button>`}).join("")}<div class="tp" id="vc-tp" aria-hidden="true"></div></div>`;
  const tip=i=>{const x=cur[i],dt=new Date(x[0]+"T12:00:00"),b=el.querySelector(`.b[data-i="${i}"]`),tp=$("#vc-tp");el.querySelectorAll(".b").forEach(z=>z.classList.toggle("on",z===b));
    tp.innerHTML=`<p><b>${DOW[dt.getDay()]} ${dt.getDate()} ${BN[dt.getMonth()]}</b></p><p><i class="sq a"></i>Minggu ini<span>${nf(x[1])}</span></p><p><i class="sq c"></i>Minggu sebelumnya<span>${nf(prev[i][1])}</span></p>`;
    const bars=el.querySelector(".bars"),bw=bars.clientWidth,left=b.offsetLeft+b.offsetWidth+8,h=bars.clientHeight-24;tp.style.left=(left+172>bw?b.offsetLeft-180:left)+"px";tp.style.top=Math.max(0,h-h*x[1]/top-10)+"px"};
  el.querySelectorAll(".b").forEach(b=>{const f=()=>tip(+b.dataset.i);b.addEventListener("mouseenter",f);b.addEventListener("focus",f)});
  el.querySelector(".bars").addEventListener("mouseleave",()=>tip(best));requestAnimationFrame(()=>tip(best))}
function renderTop(){const list=longForm().sort((a,b)=>b.v-a.v).slice(0,4);
  $("#topv").innerHTML=list.length?list.map(v=>`<li><span class="pl" aria-hidden="true"><svg viewBox="0 0 14 14"><path d="M4 2.5v9l7.5-4.5z"/></svg></span><span class="t" title="${esc(v.t)}">${esc(v.t)}</span><span class="v">${nf(v.v)}</span>${v.ctr?`<span class="c">${(+v.ctr).toLocaleString("id-ID",{maximumFractionDigits:1})}%</span>`:""}</li>`).join(""):`<li class="empty-s">Belum ada data video.</li>`}
function renderSum(){const t=YT?.totals||{},has=YT?.daily?.length>=60;let pct="";
  if(has){const a=lastDays(30),b=lastDays(30,30);if(b){const p=Math.round((a/b-1)*100);pct=`<em class="${p<0?"dn":"upc"}">${p>0?"+":""}${p}%</em>`}}
  const today=isoDay(new Date()),up=plans().filter(p=>p.date>=today&&p.status!=="tayang").length;
  $("#sum").innerHTML=`<div class="st"><span>Views 30 hari</span><b>${YT?.daily?.length?nf(lastDays(30)):"-"}${pct}</b></div><div class="st"><span>Subscriber bersih</span><b>${t.subs!=null?(t.subs>=0?"+":"")+nf(t.subs):"-"}</b></div><div class="st"><span>Estimasi pendapatan</span><b>${t.revenue!=null?moneyShort(t.revenue):"-"}</b></div><div class="st"><span>Rencana terjadwal</span><b>${nf(up)}</b></div>`}
function renderBoard(){$("#wk").hidden=view!=="week";$("#cal-wrap").hidden=view!=="month";if(view==="week")renderWeek();else renderCal()}
function renderDash(){if(!$("#wk"))return;renderBoard();renderMini();renderNext();renderStages();renderViews();renderTop();renderSum()}
let editing=null,pendingThumb=undefined;
function openPlan(p){editing=p.id?p:null;pendingThumb=undefined;$("#plan-dlg-title").textContent=editing?"Ubah rencana":"Rencana baru";$("#pl-title").value=p.title||"";$("#pl-date").value=p.date||isoDay(new Date());$("#pl-type").value=p.type||"video";$("#pl-status").value=p.status||"ide";$("#pl-note").value=p.note||"";$("#pl-del").hidden=!editing;$("#pl-tools").hidden=!editing;
  setThumbPreview(p.thumb?thumbUrl(p):"");$("#plan-dlg").showModal();$("#pl-title").focus()}
function setThumbPreview(src){$("#pl-thumb-box").innerHTML=src?`<img src="${esc(src)}" alt="">`:"";$("#pl-thumb-del").hidden=!src}
$("#pl-thumb-pick").addEventListener("click",()=>$("#pl-thumb-file").click());
$("#pl-thumb-file").addEventListener("change",e=>{const f=e.target.files[0];e.target.value="";if(!f)return;if(f.size>8*1024*1024){alert("Gambar terlalu besar, maksimal 8 MB.");return}pendingThumb=f;setThumbPreview(URL.createObjectURL(f))});
$("#pl-thumb-del").addEventListener("click",()=>{pendingThumb=null;setThumbPreview("")});
$("#plan-form").addEventListener("submit",async e=>{if(e.submitter?.value!=="save")return;const list=plans().filter(x=>!editing||x.id!==editing.id);
  const id=editing?.id||Date.now().toString(36)+Math.random().toString(36).slice(2,6);let thumb=editing?.thumb||"";
  if(pendingThumb){const r=await api("/api/thumb?id="+encodeURIComponent(id),{method:"POST",headers:{"Content-Type":pendingThumb.type||"application/octet-stream"},body:pendingThumb});if(r.ok)thumb=String(Date.now());else alert(r.error||"Thumbnail gagal disimpan.")}
  else if(pendingThumb===null&&thumb){await api("/api/thumb?id="+encodeURIComponent(id),{method:"DELETE"});thumb=""}
  list.push({id,title:$("#pl-title").value.trim(),date:$("#pl-date").value,type:$("#pl-type").value,status:$("#pl-status").value,note:$("#pl-note").value.trim(),...(thumb?{thumb}:{})});
  const d=new Date($("#pl-date").value+"T12:00:00");calMonth=new Date(d.getFullYear(),d.getMonth(),1);mcMonth=new Date(calMonth);await savePlans(list)});
$("#pl-del").addEventListener("click",async()=>{if(!editing)return;$("#plan-dlg").close();if(editing.thumb)await api("/api/thumb?id="+encodeURIComponent(editing.id),{method:"DELETE"});await savePlans(plans().filter(x=>x.id!==editing.id))});
$("#pl-tools").addEventListener("click",()=>{$("#plan-dlg").close();if(editing)openMake(editing.id)});
$("#banner-close").addEventListener("click",()=>{store.set("banner-off",true);$("#banner-key").hidden=true});
$("#plan-new").addEventListener("click",()=>openPlan({}));$("#rail-plus").addEventListener("click",()=>openPlan({}));
$("#skin-tog").addEventListener("click",()=>{const k=document.documentElement.dataset.skin==="lumut"?"batu":"lumut";document.documentElement.dataset.skin=k;store.set("skin",k);if(YT&&!$("#p-growth").hidden)chart()});
document.querySelectorAll(".seg button").forEach(b=>b.addEventListener("click",()=>{view=b.dataset.view;document.querySelectorAll(".seg button").forEach(x=>x.setAttribute("aria-pressed",x===b));renderBoard()}));
const shift=n=>{if(view==="week")weekStart=addDays(weekStart,7*n);else calMonth=new Date(calMonth.getFullYear(),calMonth.getMonth()+n,1);renderBoard()};
$("#wk-prev").addEventListener("click",()=>shift(-1));$("#wk-next").addEventListener("click",()=>shift(1));
$("#wk-today").addEventListener("click",()=>{const d=new Date();d.setHours(12,0,0,0);weekStart=d;calMonth=new Date(d.getFullYear(),d.getMonth(),1);renderBoard()});
$("#pp-q").addEventListener("input",e=>{query=e.target.value.trim().toLowerCase();renderBoard();renderMini()});
document.querySelectorAll("#mc-pills button").forEach(b=>b.addEventListener("click",()=>{typeF=b.dataset.f;document.querySelectorAll("#mc-pills button").forEach(x=>x.setAttribute("aria-pressed",x===b));renderMini();renderBoard()}));
$("#mc-prev").addEventListener("click",()=>{mcMonth=new Date(mcMonth.getFullYear(),mcMonth.getMonth()-1,1);renderMini()});
$("#mc-next").addEventListener("click",()=>{mcMonth=new Date(mcMonth.getFullYear(),mcMonth.getMonth()+1,1);renderMini()});
$("#mc").addEventListener("keydown",e=>{const b=e.target.closest("[data-day]"),step={ArrowLeft:-1,ArrowRight:1,ArrowUp:-7,ArrowDown:7}[e.key];if(!b||step==null)return;e.preventDefault();
  const d=addDays(new Date(b.dataset.day+"T12:00:00"),step);mcFocus=isoDay(d);mcMonth=new Date(d.getFullYear(),d.getMonth(),1);renderMini();$(`#mc [data-day="${mcFocus}"]`).focus()});
document.addEventListener("click",async e=>{
  const day=e.target.closest("[data-day]");if(day){const d=new Date(day.dataset.day+"T12:00:00");weekStart=d;mcFocus=day.dataset.day;calMonth=new Date(d.getFullYear(),d.getMonth(),1);view="week";document.querySelectorAll(".seg button").forEach(x=>x.setAttribute("aria-pressed",x.dataset.view==="week"));show("dash");return}
  const act=e.target.closest("[data-act]");if(act){if(act.dataset.act==="new")return openPlan({});const p=plans().find(x=>x.id===act.dataset.id);if(p)openMake(p.id);return}
  const n=e.target.closest("[data-new]");if(n)return openPlan({date:n.dataset.new});
  const pi=e.target.closest("[data-plan-id]");if(pi){const p=plans().find(x=>x.id===pi.dataset.planId);if(p)openPlan(p);return}
  const pl=e.target.closest("[data-plan]");if(pl){await savePlans([...plans(),{id:Date.now().toString(36)+Math.random().toString(36).slice(2,6),title:pl.dataset.plan,date:pl.dataset.date,type:"video",status:"ide",note:""}]);pl.textContent="Masuk kalender";pl.disabled=true;return}
  if(e.target.closest("#plan-all")){const btns=[...document.querySelectorAll("#o-ideas [data-plan]:not([disabled])")];const add=btns.map((b,i)=>({id:Date.now().toString(36)+i+Math.random().toString(36).slice(2,5),title:b.dataset.plan,date:b.dataset.date,type:"video",status:"ide",note:""}));btns.forEach(b=>{b.textContent="Masuk kalender";b.disabled=true});if(add.length)await savePlans([...plans(),...add]);e.target.textContent=add.length?`${add.length} ide masuk kalender`:"Semua sudah di kalender"}
});

/* 2.0 growth loop: Today, Learn, Ideas pattern and the Make workspace.
   Everything here is plain rules on the channel's own numbers; only the buttons that say "AI" call a model. */
const med=a=>{const b=a.filter(x=>x!=null&&!isNaN(x)).sort((x,y)=>x-y),m=b.length>>1;return b.length?(b.length%2?b[m]:(b[m-1]+b[m])/2):null};
const share=v=>v&&v.v&&v.dur?Math.min(100,v.h*3600/v.v/v.dur*100):null;
const avdMin=v=>v&&v.v?v.h*60/v.v:null;
const ctrOf=v=>v&&v.ctr>0?+v.ctr:null,impOf=v=>v&&v.imp>0?+v.imp:null;
const uploads=()=>longForm().filter(v=>v.d&&v.v>0).sort((a,b)=>a.d.localeCompare(b.d));
const winners=()=>[...longForm()].sort((a,b)=>b.v-a.v).slice(0,6);
const range=(a,fmt)=>{const b=a.filter(x=>x!=null);if(!b.length)return "-";const lo=Math.min(...b),hi=Math.max(...b);return fmt(lo)===fmt(hi)?fmt(lo):fmt(lo)+" sampai "+fmt(hi)};
const THREAT=/hunt|killer|kill|butcher|predator|\bate\b|eats?\b|eating|devour|terror|deadl|monster|crush|apex|nightmare|fear|slaughter|ripper|stalk|prey|bite|jaw|savage|beast|menace|danger|attack|blood/i;
// In spoken openings, putting people in the scene also counts as the danger.
const HOOK_DANGER=new RegExp(THREAT.source+"|ancestors|humans|our species|people",'i');
const SIZE=/\d|giant|biggest|largest|huge|colossal|massive|\bton|\blbs?\b|pound|feet|foot|meter|metre|tall|titan|mega|heaviest|strongest/i;
const dataEnd=()=>YT?.daily?.length?YT.daily[YT.daily.length-1][0]:isoDay(new Date());
const daysBetween=(a,b)=>Math.round((new Date(b+"T12:00:00")-new Date(a+"T12:00:00"))/864e5);
const pctTxt=x=>x==null?"-":f1(x)+"%";
function usShare(){const g=YT?.geo||[];const tv=g.reduce((s,r)=>s+(+r.views||0),0),tr=g.reduce((s,r)=>s+(+r.rev||0),0),us=g.find(r=>/united states|amerika serikat|^us$/i.test(r.name||""));
  return us&&tv?{views:Math.round(us.views/tv*100),rev:tr?Math.round((us.rev||0)/tr*100):null}:null}
function channelNumbers(){const up=uploads(),W=winners(),R=up.slice(-5);
  const n={up,W,R,wS:med(W.map(share)),rS:med(R.map(share)),wC:med(W.map(ctrOf)),rC:med(R.map(ctrOf)),wI:med(W.map(impOf)),rI:med(R.map(impOf))};
  n.ret=n.wS&&n.rS!=null&&n.rS<n.wS*0.6;n.ctr=n.wC&&n.rC!=null&&n.rC<n.wC*0.75;n.reach=n.wI&&n.rI!=null&&n.rI<n.wI*0.2;
  n.lever=n.ret?"ret":n.ctr?"ctr":n.reach?"reach":"ok";return n}
function lessonFor(v,n){const s=share(v),c=ctrOf(v),i=impOf(v);
  const best=[...n.W].sort((a,b)=>(share(b)||0)-(share(a)||0))[0];
  if(s!=null&&s<10)return `Hanya ${f1(s)}% ditonton, penonton pergi di awal. Bandingkan menit pertamanya dengan "${best?best.t:"video terbaik"}".`;
  if(c&&n.wC&&c<n.wC*0.6)return `CTR ${f1(c)}%, jauh di bawah video terbaik (${f1(n.wC)}%). Judul atau thumbnail kurang memancing klik.`;
  if(i&&n.wI&&i<n.wI*0.05&&s>=20)return `Penonton bertahan (${f1(s)}%), tapi YouTube hanya menampilkannya ${nf(i)} kali. Topik dan paket yang lebih kuat membuka jangkauan.`;
  if(s>=20)return `Dekat video terbaik (${f1(s)}% ditonton). Ulangi cara membuka video ini.`;
  return s==null?"Durasi video belum ada di data.":`${f1(s)}% ditonton, di bawah video terbaik (${f1(n.wS)}%). Masuk ke inti cerita lebih cepat.`}

function spark(vals,lo,hi,color){const v=vals.filter(x=>x!=null);if(v.length<2)return "";const w=300,h=46,n=v.length,x=i=>4+i*(w-8)/(n-1),y=t=>h-4-(Math.min(hi,Math.max(lo,t))-lo)/((hi-lo)||1)*(h-8);
  const d=v.map((t,i)=>`${i?"L":"M"}${x(i).toFixed(1)} ${y(t).toFixed(1)}`).join("");
  return `<svg class="spk" viewBox="0 0 ${w} ${h}" preserveAspectRatio="none" aria-hidden="true"><path d="${d}L${x(n-1)} ${h}L${x(0)} ${h}Z" fill="${color}" fill-opacity=".14" stroke="none"/><path d="${d}" fill="none" stroke="${color}" stroke-width="2" vector-effect="non-scaling-stroke"/></svg>`}

function renderToday(){if(!$("#td-full"))return;const has=uploads().length>=6;$("#td-empty").hidden=has;$("#td-full").hidden=!has;renderPipe();if(!has)return;
  const n=channelNumbers(),{W,R,up}=n,last8=up.slice(-8),low=last8.filter(v=>share(v)!=null&&share(v)<10).length;
  const go=(label,fn)=>{const b=$("#dx-go");b.textContent=label;b.onclick=fn};
  const reachTxt=n.reach?` Jangkauan juga turun: dari sekitar ${nf(n.wI)} tayangan thumbnail per video terbaik ke ${nf(n.rI)} per upload terakhir.`:"";
  if(n.lever==="ret"){$("#dx-h").textContent="Penonton pergi di menit pertama.";
    $("#dx-p").innerHTML=`<p>Dari ${last8.length} upload terakhir, ${low} ditonton kurang dari 10% durasinya. Video terbaik Anda ditonton ${range(W.map(share),x=>f1(x))}%.${reachTxt} YouTube cenderung memperluas jangkauan video yang membuat penonton bertahan, jadi ini yang diperbaiki dulu.</p><p><b>Perbaiki dulu:</b> 60 detik pertama setiap naskah. Thumbnail yang lebih bagus tidak banyak membantu sebelum penonton bertahan.</p>`;
    go("Buka hook coach",()=>openMake(null,"hook"))}
  else if(n.lever==="ctr"){$("#dx-h").textContent="Video ditampilkan, tapi jarang diklik.";
    $("#dx-p").innerHTML=`<p>CTR 5 upload terakhir ${pctTxt(n.rC)}, video terbaik ${range(W.map(ctrOf),x=>f1(x))}%. Penonton yang mengklik masih bertahan (${pctTxt(n.rS)} ditonton), jadi masalahnya di judul dan thumbnail.</p><p><b>Perbaiki dulu:</b> paket video. Pilih judul dan thumbnail sebelum menulis naskah.</p>`;
    go("Buka paket video",()=>openMake(null,"pkg"))}
  else if(n.lever==="reach"){$("#dx-h").textContent="YouTube jarang menampilkan video baru Anda.";
    $("#dx-p").innerHTML=`<p>Tayangan thumbnail per upload turun dari sekitar ${nf(n.wI)} ke ${nf(n.rI)}, padahal penonton yang datang masih bertahan dan mengklik. Topik yang lebih dekat dengan video terbaik Anda adalah cara tercepat membuka jangkauan lagi.</p>`;
    go("Cari topik berikutnya",()=>show("ideas"))}
  else{$("#dx-h").textContent="Upload terakhir sejalan dengan video terbaik.";
    $("#dx-p").innerHTML=`<p>Bagian yang ditonton (${pctTxt(n.rS)}) dan CTR (${pctTxt(n.rC)}) 5 upload terakhir tidak jauh dari video terbaik Anda. Jaga jadwal dan terus pilih topik yang cocok dengan pola.</p>`;
    go("Cari topik berikutnya",()=>show("ideas"))}
  const sc=Math.max(40,(Math.max(n.wS||0,n.rS||0))*1.2),bar=(lbl,val,txt,w,cls)=>`<div><div class="lbl"><span>${lbl}</span><b>${val}</b></div><div class="track"><div class="fill ${cls}" style="width:${Math.max(w,3)}%">${txt}</div></div></div>`;
  let cmp=bar("Bagian yang ditonton, 6 video terbaik",pctTxt(n.wS),`rata-rata ${f1(med(W.map(avdMin)))} mnt`,n.wS/sc*100,"win")+bar("Bagian yang ditonton, 5 upload terakhir",pctTxt(n.rS),n.rS/sc*100>18?`${f1(med(R.map(avdMin)))} mnt`:"",n.rS/sc*100,"now");
  if(n.wI&&n.rI)cmp+=bar("Tayangan thumbnail per video terbaik",nf(n.wI),"",100,"win")+bar("Tayangan thumbnail per upload terakhir",nf(n.rI),"",n.rI/n.wI*100,"now");
  else if(n.wC&&n.rC)cmp+=bar("CTR, 6 video terbaik",pctTxt(n.wC),"",n.wC/8*100,"win")+bar("CTR, 5 upload terakhir",pctTxt(n.rC),"",n.rC/8*100,"now");
  $("#dx-cmp").innerHTML=cmp+`<small>Nilai tengah (median), tiap pasang batang memakai skala yang sama.</small>`;
  const l12=up.slice(-12),vit=[
    ["Bagian yang ditonton",pctTxt(n.rS),`terbaik ${pctTxt(n.wS)}`,spark(l12.map(share),0,40,n.ret?"var(--warn)":"var(--ok)"),n.ret?["bad","Perbaiki dulu"]:["good","Aman"]],
    ["CTR thumbnail",n.rC==null?"-":f1(n.rC)+"%",n.wC?`terbaik ${f1(n.wC)}%`:"",spark(l12.map(ctrOf),0,8,n.ctr?"var(--warn)":"var(--ok)"),n.ctr?["bad",n.ret?"Perbaiki kedua":"Perbaiki dulu"]:["good","Aman"]],
    ["Views per upload",nf(med(R.map(v=>v.v))),`terbaik ${nf(med(W.map(v=>v.v)))}`,spark(l12.map(v=>Math.log10(Math.max(v.v,1))),1,5.5,"var(--muted)"),["","Ikut dua di atas"]]];
  $("#td-vitals").innerHTML=vit.map(([k,v,c,s,[cls,tag]])=>`<div class="box vital"><div class="vhd"><span class="k">${k}, 5 upload terakhir</span><span class="pill ${cls}">${tag}</span></div><div class="v">${v}<em>${c}</em></div>${s}<div class="foot"><span>12 upload lalu</span><span>terbaru</span></div></div>`).join("");
  renderMoves(n);renderGrade(n)}

const weekKey=()=>{const d=new Date();d.setDate(d.getDate()-((d.getDay()+6)%7));return isoDay(d)};
function renderMoves(n){const us=usShare(),soon=plans().some(p=>p.status!=="tayang"&&p.date>=isoDay(new Date())&&daysBetween(isoDay(new Date()),p.date)<=7);
  const M={ret:{t:"Tulis ulang 60 detik pertama video berikutnya",d:"Buka langsung dengan hewannya dan bahayanya. Tanpa intro channel, tanpa pemanasan \"jutaan tahun lalu\". Hook coach mengeceknya.",tag:"retensi",bad:1,go:()=>openMake(null,"hook")},
    ctr:{t:"Siapkan 3 judul dan 2 thumbnail sebelum upload",d:`CTR 5 upload terakhir ${pctTxt(n.rC)}, video terbaik ${pctTxt(n.wC)}. Uji thumbnail dengan Test & Compare di YouTube Studio.`,tag:"klik",bad:1,go:()=>openMake(null,"pkg")},
    topic:{t:"Pilih topik berikutnya dari Ide",d:`Video terbaik Anda: ${n.W.slice(0,2).map(v=>`"${v.t}"`).join(" dan ")}. Pilih topik dengan skor 4 atau 5.`,tag:"topik",go:()=>show("ideas")},
    time:us?{t:"Terbitkan jam 07:00 WIB",d:`Itu malam hari di Amerika. Penonton AS membawa ${us.views}% views${us.rev!=null?` dan ${us.rev}% pendapatan`:""} Anda.`,tag:"waktu"}:null,
    plan:soon?null:{t:"Jadwalkan upload berikutnya",d:"Belum ada video di kalender untuk 7 hari ke depan. Upload rutin membantu penonton kembali.",tag:"jadwal",go:()=>openPlan({})}};
  const order=[n.ret&&"ret",n.ctr&&"ctr","topic","time","plan","ctr"].filter((k,i,a)=>k&&M[k]&&a.indexOf(k)===i).slice(0,3);
  const st=LAST.week?.data?.wk===weekKey()?LAST.week.data.done:[];
  $("#td-moves").innerHTML=order.map((k,i)=>{const m=M[k],on=st.includes(k);return `<li class="${on?"done":""}"><input type="checkbox" id="mv-${k}" data-move="${k}" ${on?"checked":""}><div><label for="mv-${k}" class="mv-t">${esc(m.t)}</label><span>${esc(m.d)}</span>${m.go?`<button type="button" class="linkish" data-move-go="${k}">Kerjakan</button>`:""}</div><span class="pill ${m.bad?"bad":""}">${m.tag}</span></li>`}).join("");
  $("#td-moves").onclick=e=>{const g=e.target.closest("[data-move-go]");if(g)M[g.dataset.moveGo].go()};
  $("#td-moves").onchange=e=>{const c=e.target.closest("[data-move]");if(!c)return;let done=LAST.week?.data?.wk===weekKey()?[...LAST.week.data.done]:[];done=c.checked?[...new Set([...done,c.dataset.move])]:done.filter(x=>x!==c.dataset.move);c.closest("li").classList.toggle("done",c.checked);remember("week",{wk:weekKey(),done}).catch(()=>{})}}
function renderGrade(n){const up=n.up,L=up[up.length-1],prev=up.slice(-11,-1),age=daysBetween(L.d,dataEnd());
  $("#td-last-sub").textContent=`${L.t} · ${fmtShort(L.d)}${age<7?`, baru ${Math.max(age,0)} hari: angka masih bergerak`:""}`;
  const rows=[["Bagian yang ditonton",share(L),med(prev.map(share)),pctTxt],["CTR",ctrOf(L),med(prev.map(ctrOf)),pctTxt],["Tayangan thumbnail",impOf(L),med(prev.map(impOf)),nf],["Views",L.v,med(prev.map(v=>v.v)),nf]].filter(r=>r[1]!=null&&r[2]!=null);
  $("#td-grade").innerHTML=`<div class="grade">${rows.map(([k,v,m,f])=>{const ok=v>=m;return `<div class="gr"><span>${k}</span><span class="num"><b>${f(v)}</b> <span class="muted">vs ${f(m)} biasanya</span></span><span class="pill ${ok?"good":"bad"}">${ok?"di atas biasa":"di bawah biasa"}</span></div>`}).join("")}</div><p class="sub" style="margin-top:12px"><b>Pelajaran:</b> ${esc(lessonFor(L,n))}</p>`}

const PIPE=[["ide","Ide"],["naskah","Naskah"],["rekam","Suara"],["edit","Edit"],["siap","Siap upload"]];
function renderPipe(){const el=$("#td-pipe");if(!el)return;const today=isoDay(new Date()),list=plans().filter(p=>p.type!=="post"&&p.status!=="tayang"),next=list.filter(p=>p.date>=today)[0];
  el.innerHTML=PIPE.map(([s,l])=>{const items=list.filter(p=>p.status===s);return `<div class="st"><h3>${l} <b>${items.length}</b></h3>${items.map(p=>`<button type="button" class="pcard${p===next?" hot":""}" data-make="${esc(p.id)}"><b>${esc(p.title)}</b><small>${p.type==="short"?"Shorts, ":""}${fmtShort(p.date)}${p.date<today?", lewat jadwal":""}</small></button>`).join("")||`<span class="pempty">Kosong</span>`}</div>`}).join("")}
document.addEventListener("click",e=>{const b=e.target.closest("[data-make]");if(b)openMake(b.dataset.make)});
$("#td-new").addEventListener("click",()=>{store.set("mk","");const w=work("");w.topic="";w.titles=[];w.thumb="";w.hook="";w.pick="";saveWork();store.set("mkst","pkg");show("make")});

function renderLearn(){if(!$("#ln-full"))return;const up=uploads(),has=up.length>=6;$("#ln-empty").hidden=has;$("#ln-full").hidden=!has;if(!has)return;
  const n=channelNumbers(),V=up.slice(-48).filter(v=>share(v)!=null),W=900,H=260,pl=34,pr=8,pt=12,pb=28,bw=(W-pl-pr)/V.length,top=Math.max(40,Math.ceil(Math.max(...V.map(share))/10)*10),y=t=>pt+(1-t/top)*(H-pt-pb);
  $("#ln-sub").textContent=`Rata-rata bagian video yang ditonton, per upload sejak ${fmtShort(V[0].d)} ${V[0].d.slice(0,4)}. Garis putus-putus adalah 6 video terbaik Anda (${pctTxt(n.wS)}). Arahkan kursor atau fokus pada batang untuk judulnya.`;
  let s=`<svg viewBox="0 0 ${W} ${H}" role="img" aria-label="Bagian tiap video yang ditonton, ${V.length} upload">`;
  for(let t=0;t<=top;t+=10)s+=`<line x1="${pl}" x2="${W-pr}" y1="${y(t)}" y2="${y(t)}" stroke="var(--line)"/><text x="${pl-6}" y="${y(t)+4}" text-anchor="end" font-size="11" fill="var(--muted)" stroke="none">${t}%</text>`;
  let lastLbl=-9;V.forEach((v,i)=>{const p=share(v),c=p>=20?"var(--accent)":p<10?"var(--warn)":"var(--stone-dot)";
    s+=`<rect x="${pl+i*bw+1}" y="${y(p)}" width="${Math.max(bw-2,2)}" height="${y(0)-y(p)}" rx="3" fill="${c}" stroke="none"/><rect class="hit" data-i="${i}" x="${pl+i*bw}" y="${pt}" width="${bw}" height="${H-pt-pb}" fill="transparent" stroke="none" tabindex="0" aria-label="${esc(v.t)}: ${f1(p)}% ditonton"/>`;
    if(i-lastLbl>=7&&(i===0||v.d.slice(0,7)!==V[i-1].d.slice(0,7))){lastLbl=i;s+=`<text x="${pl+i*bw}" y="${H-8}" font-size="11" fill="var(--muted)" stroke="none">${BN[+v.d.slice(5,7)-1]} ${v.d.slice(2,4)}</text>`}});
  if(n.wS)s+=`<line x1="${pl}" x2="${W-pr}" y1="${y(n.wS)}" y2="${y(n.wS)}" stroke="var(--ink)" stroke-dasharray="4 4" stroke-width="1.2"/><text x="${W-pr}" y="${y(n.wS)-6}" text-anchor="end" font-size="11.5" fill="var(--ink)" stroke="none">terbaik ${f1(n.wS)}%</text>`;
  const ch=$("#ln-chart");ch.innerHTML=s+`</svg><div class="ctip" hidden></div>`;const tip=ch.querySelector(".ctip");
  const showTip=el=>{const v=V[+el.dataset.i],box=ch.getBoundingClientRect(),b=el.getBoundingClientRect();tip.innerHTML=`<b>${esc(v.t)}</b>${fmtShort(v.d)} ${v.d.slice(0,4)} · ${f1(share(v))}% ditonton (${f1(avdMin(v))} mnt) · ${nf(v.v)} views`;tip.hidden=false;tip.style.left=Math.min(Math.max(b.left-box.left-110,0),Math.max(box.width-250,0))+"px"};
  ch.onmouseover=e=>{if(e.target.classList?.contains("hit"))showTip(e.target)};ch.onfocusin=e=>{if(e.target.classList?.contains("hit"))showTip(e.target)};ch.onmouseleave=()=>tip.hidden=true;ch.onfocusout=()=>tip.hidden=true;
  $("#ln-cards").innerHTML=`<tr><th>Upload</th><th>Ditonton</th><th>CTR</th><th>Tayangan</th><th>Views</th><th>Nilai</th><th>Pelajaran</th></tr>`+up.slice(-8).reverse().map(v=>{const p=share(v),cls=p>=20?"good":p<10?"bad":"";return `<tr><td><b>${esc(v.t)}</b><br><span class="muted">${fmtShort(v.d)} ${v.d.slice(0,4)}</span></td><td>${pctTxt(p)}</td><td>${pctTxt(ctrOf(v))}</td><td>${impOf(v)?nf(v.imp):"-"}</td><td>${nf(v.v)}</td><td><span class="pill ${cls}">${p>=20?"dekat terbaik":p<10?"pergi cepat":"di bawah terbaik"}</span></td><td>${esc(lessonFor(v,n))}</td></tr>`}).join("")}

function renderPattern(){const box=$("#id-pattern-box");if(!box)return;const W=winners(),up=uploads();box.hidden=up.length<6;if(box.hidden)return;
  const thr=W.filter(v=>THREAT.test(v.t)).length,n=channelNumbers();
  $("#id-pattern-sub").textContent=`Dari 6 video dengan views terbanyak (${nf(Math.min(...W.map(v=>v.v)))} views ke atas): ${W.map(v=>`"${v.t}"`).join("; ")}.`;
  $("#id-pattern").innerHTML=[[`${thr} dari 6`,"judulnya menyebut pemangsa atau ancaman"],[range(W.map(ctrOf),x=>f1(x))+"%","CTR thumbnail"],[range(W.map(v=>v.dur/60),x=>Math.round(x))+" mnt","durasi video"],[range(W.map(share),x=>Math.round(x))+"%","bagian yang ditonton"]].map(([b,s])=>`<div><b>${b}</b><span>${s}</span></div>`).join("");
  const miss=up.filter(v=>!W.includes(v)&&THREAT.test(v.t)&&share(v)!=null&&share(v)<10).pop();
  $("#id-pattern-note").textContent=miss?`Topik saja tidak cukup: "${miss.t}" (${fmtShort(miss.d)}) cocok dengan polanya tapi hanya ${f1(share(miss))}% ditonton. Karena itu setiap ide tetap lewat hook coach.`:"Skor ide di bawah memakai pola ini. Topik dengan skor 4 atau 5 paling dekat dengan video terbaik Anda."}
function patternText(){const W=winners();if(W.length<6)return "";const thr=W.filter(v=>THREAT.test(v.t)).length;
  return `${thr} of the 6 most-viewed videos frame the animal as a predator or a threat in the title (${W.map(v=>`"${v.t}"`).join("; ")}); they run ${range(W.map(v=>v.dur/60),x=>Math.round(x))} minutes`}

/* Make: one video from package to upload. Per-video work is saved under LAST.work, keyed by plan id. */
let WORK=null,workTimer=0;
const work=id=>{WORK=WORK||LAST.work?.data||{};const k=id||"free";return WORK[k]=WORK[k]||{}};
const saveWork=()=>{clearTimeout(workTimer);workTimer=setTimeout(()=>remember("work",WORK).catch(()=>{}),600)};
const mkId=()=>{const id=store.get("mk","");return plans().some(p=>p.id===id)?id:""};
const mkPlan=()=>plans().find(p=>p.id===mkId());
const mkW=()=>work(mkId());
const topicKey=()=>{const t=(mkW().topic||"").trim();return (t.split(/[\s,:(]+/).find(w=>w.length>=4)||t).toLowerCase()};
function openMake(id,stage){if(id)store.set("mk",id);else if(!mkId()){const next=plans().filter(p=>p.type!=="post"&&p.status!=="tayang")[0];if(next)store.set("mk",next.id)}if(stage)mkStage(stage);show("make")}
function mkStage(s){const tabsEl=[...document.querySelectorAll("#mk-stages [role=tab]")];tabsEl.forEach(b=>{const on=b.dataset.stage===s;b.setAttribute("aria-selected",on);b.tabIndex=on?0:-1;document.getElementById(b.getAttribute("aria-controls")).hidden=!on});store.set("mkst",s)}
$("#mk-stages").addEventListener("click",e=>{const b=e.target.closest("[data-stage]");if(b)mkStage(b.dataset.stage)});
$("#mk-stages").addEventListener("keydown",e=>{const t=[...e.currentTarget.querySelectorAll("[role=tab]")],i=t.indexOf(e.target),d={ArrowRight:1,ArrowLeft:-1}[e.key];if(i<0||!d)return;e.preventDefault();const n=t[(i+d+t.length)%t.length];mkStage(n.dataset.stage);n.focus()});
document.addEventListener("click",e=>{const b=e.target.closest("[data-stage-go]");if(b){mkStage(b.dataset.stageGo);$("#main").scrollTop=0}});
function renderMake(){const list=plans().filter(p=>p.type!=="post"&&(p.status!=="tayang"||p.id===mkId())),id=mkId(),p=mkPlan(),w=mkW();
  $("#mk-pick").innerHTML=list.map(x=>`<option value="${esc(x.id)}">${esc(x.title)} · ${fmtShort(x.date)}</option>`).join("")+`<option value="">Tanpa rencana, topik bebas</option>`;$("#mk-pick").value=id;
  if(!w.topic&&p)w.topic=p.title.split(/[:,]/)[0].trim();
  $("#mk-topic").value=w.topic||"";$("#mk-titles").value=(w.titles||(p?[p.title]:[])).join("\n");$("#mk-thumbtext").value=w.thumb||"";$("#mk-hook").value=w.hook||"";
  const t=w.pick||p?.title||w.topic||"";["#script-topic","#seo-topic","#thumb-topic","#shorts-topic"].forEach(s=>{if(t)$(s).value=t});if(w.pick)$("#thumb-title").value=w.pick;
  $("#mk-done").hidden=!p;$("#s-done").textContent=p?.status==="tayang"?"Video ini sudah ditandai tayang.":"";
  renderAuto();mkStage(store.get("mkst","pkg"));renderTitles();renderThumbPrev();renderRules();renderPub()}
function renderAuto(){const w=mkW(),has=!!(w.topic||"").trim(),full=has&&w.titles?.length>1&&w.thumb&&w.hook;
  $("#mk-auto-h").textContent=!has?"Belum tahu mau bikin apa?":full?"Sudah terisi. Cek, lalu lanjut ke naskah.":`Topik: ${w.topic}`;
  $("#mk-auto-p").textContent=!has?"AI memilih topik yang cocok dengan video terbaik Anda, lalu mengisi judul, teks thumbnail, dan hook. Anda tinggal mengecek.":full?"Mau versi lain? Klik lagi untuk judul, thumbnail, dan hook baru, atau minta topik lain.":"AI mengisi 5 judul, teks thumbnail, dan hook untuk topik ini. Anda tinggal mengecek.";
  $("#mk-auto").textContent=!has?"Sarankan video berikutnya":full?"Isi ulang":"Isi judul, thumbnail & hook";$("#mk-auto-new").hidden=!has}
// One AI call fills the whole package, so Sigit can start from a suggestion instead of a blank page.
async function autoFill(btn,newTopic){const w=mkW(),topic=newTopic?"":(w.topic||"").trim(),st=$("#s-auto");
  const done=[...longForm().map(v=>v.t),...plans().map(p=>p.title)].slice(-80).join("; ");
  const d=await ask(st,btn,`${topic?`Plan the package for a documentary about: ${topic}.`:`Pick the single best next documentary topic for this channel and plan its package. Do not repeat or closely overlap: ${done||"none"}.`}
What works on this channel: ${patternText()||"giant prehistoric mammal predators framed as a threat to humans"}. Viewers of recent videos left in the first minute, so the opening matters most.
Return: "subject" the animal's usual name; "mammal","predator","threat","size" honest true/false about the animal and the angle; "why" one Indonesian sentence on why this topic fits the channel; "titles" 5 title options, best first, each under 60 characters, naming the animal, with a size or number people can picture and a threat or rivalry angle where the evidence supports it; "thumb" thumbnail text of at most 4 words, uppercase, adding information the best title does not repeat; "hook" the first 60 seconds of narration (120-160 words, English): name the animal in the first sentence, state the danger before 15 seconds, say the thumbnail words before 15 seconds, promise a specific payoff at the end, no channel intro, no "subscribe", accurate facts with uncertain claims phrased carefully.
JSON shape: {"subject":"","mammal":true,"predator":true,"threat":true,"size":true,"why":"","titles":[""],"thumb":"","hook":""}`,null);
  if(!d?.titles?.length)return;
  let id=mkId();
  if(!id||newTopic){const last=plans().map(p=>p.date).sort().pop(),base=last&&last>isoDay(new Date())?last:isoDay(new Date()),date=isoDay(addDays(new Date(base+"T12:00:00"),7));
    id=Date.now().toString(36)+Math.random().toString(36).slice(2,6);await savePlans([...plans(),{id,title:d.titles[0],date,type:"video",status:"ide",note:d.why||""}]);store.set("mk",id)}
  const x=work(id);Object.assign(x,{topic:d.subject||topic,titles:d.titles,pick:d.titles[0],thumb:d.thumb||"",hook:d.hook||""});saveWork();
  const f=fitOf(d);store.set("mkst","pkg");renderMake();
  st.className="status";st.textContent=`${d.subject||topic}: skor ${f.score} dari 5. ${d.why||""} Judul pertama sudah dipilih; ganti kalau ada yang lebih Anda suka.`}
$("#mk-auto").addEventListener("click",e=>autoFill(e.currentTarget,false));
$("#mk-auto-new").addEventListener("click",e=>autoFill(e.currentTarget,true));
$("#mk-pick").addEventListener("change",e=>{store.set("mk",e.target.value);renderMake()});
$("#mk-topic").addEventListener("input",e=>{mkW().topic=e.target.value;saveWork();renderTitles();renderRules();renderAuto()});
$("#mk-titles").addEventListener("input",e=>{mkW().titles=e.target.value.split("\n");saveWork();renderTitles()});
$("#mk-thumbtext").addEventListener("input",e=>{mkW().thumb=e.target.value;saveWork();renderThumbPrev();renderRules()});
$("#mk-hook").addEventListener("input",e=>{mkW().hook=e.target.value;saveWork();renderRules()});
function titleChecks(t){const k=topicKey();return [[t.length<=60,"≤60"],[SIZE.test(t),"Ukuran"],[THREAT.test(t),"Ancaman"],[!!k&&t.toLowerCase().includes(k),"Nama"]]}
function renderTitles(){const w=mkW(),list=(w.titles||[]).map(s=>s.trim()).filter(Boolean);
  $("#mk-tlist").innerHTML=list.map((t,i)=>{const c=titleChecks(t);return `<label class="trow"><input type="radio" name="mk-pick-title" value="${i}" ${w.pick===t?"checked":""}><span class="t">${esc(t)}<small>${t.length} karakter</small></span><span class="checks">${c.map(([ok,k])=>`<i class="${ok?"y":""}">${k}<span class="sr">${ok?" lolos":" belum"}</span></i>`).join("")}</span></label>`}).join("");
  $("#mk-tlist").onchange=e=>{w.pick=list[+e.target.value];saveWork();$("#thumb-title").value=w.pick;["#script-topic","#seo-topic","#thumb-topic","#shorts-topic"].forEach(s=>$(s).value=w.pick);renderThumbPrev()}}
function renderThumbPrev(){const w=mkW(),t=(w.thumb||"").trim(),words=t.split(/\s+/).filter(Boolean),pick=(w.pick||"").toLowerCase();
  $("#mk-thumbprev span").textContent=t||"Teks thumbnail";$("#mk-thumbprev").classList.toggle("ph",!t);
  const rep=words.filter(x=>x.length>3&&pick.includes(x.toLowerCase()));
  $("#mk-thumbnote").textContent=!t?"Ketik teks untuk melihat contohnya.":words.length>4?`${words.length} kata, terlalu banyak untuk layar HP. Potong jadi 4 kata atau kurang.`:rep.length?`Kata "${rep.join(", ")}" sudah ada di judul. Thumbnail lebih kuat kalau menambah informasi baru.`:`${words.length} kata, pas.`}
function renderRules(){const w=mkW(),txt=(w.hook||"").trim(),words=txt.split(/\s+/).filter(Boolean),f25=words.slice(0,25).join(" ").toLowerCase(),f35=words.slice(0,35).join(" "),k=topicKey();
  const thumbW=(w.thumb||"").toLowerCase().split(/\s+/).filter(x=>x.length>=3&&!["the","and","our","for","with","that","this","yang","dan"].includes(x));
  const R=!txt?[[null,"Tulis pembukaan di kotak sebelah. Cek muncul saat Anda mengetik."]]:[
    [k?f25.includes(k):null,k?"Nama hewan disebut di 10 detik pertama":"Nama hewan di 10 detik pertama: isi topik di atas dulu"],
    [HOOK_DANGER.test(f35),"Bahaya atau ancaman disebut sebelum 0:15"],
    [/by the end|at the end|you'll see|you will see|stay with|before this video ends|the answer|what (really )?happened|di akhir/i.test(txt),"Ada janji di akhir, supaya penonton bertahan"],
    [!/subscribe|welcome (back )?to|this channel|hello everyone|hi everyone|hey guys|hey everyone/i.test(txt),"Tanpa intro channel atau ajakan subscribe"],
    [thumbW.length?thumbW.some(x=>f35.toLowerCase().includes(x)):null,thumbW.length?`Kata di thumbnail ("${w.thumb.trim()}") diucapkan sebelum 0:15`:"Kata thumbnail diucapkan sebelum 0:15: isi teks thumbnail di tahap Paket dulu"],
    [words.length>=110&&words.length<=170,`Panjang pas untuk 60 detik (110 sampai 170 kata, sekarang ${words.length})`]];
  $("#mk-rules").innerHTML=R.map(([ok,t])=>`<li><span class="${ok===true?"y":ok===false?"n":"u"}" aria-hidden="true">${ok===true?"✓":ok===false?"✗":"–"}</span><span>${esc(t)}<span class="sr">${ok===true?", lolos":ok===false?", belum":""}</span></span></li>`).join("");
  $("#mk-hook-len").textContent=words.length?`${words.length} kata, sekitar ${Math.round(words.length/140*60)} detik dibacakan (140 kata per menit).`:""}
function hookForScript(){const w=mkW(),h=(w.hook||"").trim();let s="";if(w.pick)s+=`Video title: ${w.pick}. `;if(w.thumb)s+=`Thumbnail text: ${w.thumb}. `;if(h.split(/\s+/).length>=20)s+=`Use this exact opening, word for word, as the cold open and first part of act 1: """${h}"""\n`;return s}
$("#mk-titles-ai").addEventListener("click",async e=>{const w=mkW(),topic=w.topic||mkPlan()?.title||"";const st=$("#s-titles");if(!topic){st.className="status err";st.textContent="Isi topik dulu.";return}
  const d=await ask(st,e.currentTarget,`Write 5 YouTube title options for a documentary about: ${topic}. What works on this channel: ${patternText()||"giant prehistoric predators framed as a threat to humans"}. Each under 60 characters, honest, naming the animal, ideally with a size or number people can picture and a threat or rivalry angle. Vary the angle.
JSON shape: {"titles":[""]}`,null);
  if(d?.titles?.length){const cur=(w.titles||[]).map(s=>s.trim()).filter(Boolean);w.titles=[...cur,...d.titles.filter(t=>!cur.includes(t))];saveWork();$("#mk-titles").value=w.titles.join("\n");renderTitles()}});
$("#mk-hook-ai").addEventListener("click",async e=>{const w=mkW(),topic=w.topic||mkPlan()?.title||"",st=$("#s-hook");if(!topic){st.className="status err";st.textContent="Isi topik dulu.";return}
  const d=await ask(st,e.currentTarget,`Write 2 alternative openings (the first 60 seconds, 120-160 words each, spoken narration) for a documentary about ${topic}.${w.pick?" Title: "+w.pick+".":""}${w.thumb?" Thumbnail text: "+w.thumb+".":""}
Rules from where this channel's viewers dropped off: name and show the animal in the first sentence; state the danger or threat before 15 seconds; say the thumbnail words before 15 seconds; promise a specific payoff at the end; no channel intro, no "subscribe", no "millions of years ago" warm-up. Keep every fact accurate; phrase uncertain claims carefully.
${(w.hook||"").trim()?"Current draft to improve:\n"+w.hook.trim():""}
JSON shape: {"hooks":[{"text":"","why":"one sentence in Indonesian on what changed"}]}`,"hook");
  if(d?.hooks?.length)renderHooks(d.hooks)});
function renderHooks(list){$("#o-hook").innerHTML=list.map((h,i)=>`<div class="card"><span class="layer">Versi ${i+1}</span><p>${esc(h.text)}</p><p class="note">${esc(h.why||"")}</p><button type="button" class="btn ghost" data-hook="${i}">Pakai versi ini</button></div>`).join("");
  $("#o-hook").onclick=e=>{const b=e.target.closest("[data-hook]");if(!b)return;mkW().hook=list[+b.dataset.hook].text;saveWork();$("#mk-hook").value=mkW().hook;renderRules();$("#mk-hook").focus()}}
function renderPub(){const w=mkW(),us=usShare(),best=winners()[0],done=w.pub||{};
  const items=[["t60","Judul terpilih, di bawah 60 karakter",w.pick?`"${w.pick}"`:"Pilih judul di tahap Paket"],["thumb","Thumbnail jadi, teks maksimal 4 kata, terbaca di ukuran HP",""],["tc","Test & Compare: 2 sampai 3 thumbnail diuji di YouTube Studio",""],["desc","Deskripsi dengan chapter, kata kunci di kalimat pertama","Salin dari paket SEO di atas"],["end","End screen mengarah ke video terbaik Anda",best?`"${best.t}"`:""],["pin","Komentar sematan dengan pertanyaan",""],["time",us?"Dijadwalkan jam 07:00 WIB, malam hari di Amerika":"Jam tayang diatur di YouTube Studio",us?`Penonton AS: ${us.views}% views`:""],["comm","Post Komunitas di hari tayang",""]];
  $("#mk-pub").innerHTML=items.map(([k,t,s])=>`<li><input type="checkbox" id="pub-${k}" data-pub="${k}" ${done[k]?"checked":""}><label for="pub-${k}">${esc(t)}${s?`<small>${esc(s)}</small>`:""}</label></li>`).join("");
  $("#mk-pub").onchange=e=>{const c=e.target.closest("[data-pub]");if(!c)return;w.pub={...(w.pub||{}),[c.dataset.pub]:c.checked};saveWork()}}
$("#mk-done").addEventListener("click",async()=>{const p=mkPlan();if(!p)return;await savePlans(plans().map(x=>x.id===p.id?{...x,status:"tayang"}:x));$("#s-done").className="status";$("#s-done").textContent="Ditandai tayang. Rapornya muncul di Pelajari setelah data berikutnya ditarik."});

// Ideas saved by 1.x have no animal facts, so they can't be scored; leave the empty state instead.
const RENDER={ideas:d=>d?.ideas?.length&&"subject" in d.ideas[0]&&(renderIdeas(d.ideas),true),script:d=>d?.acts?.length&&(renderScript(d),true),scriptfull:d=>d?.narration?.length&&$("#o-scriptfull")&&(renderScriptFull(d),true),seo:d=>d?.titles&&(renderSEO(d),true),thumb:d=>d?.concepts?.length&&(renderThumb(d.concepts),true),shorts:d=>d?.shorts?.length&&(renderShorts(d.shorts),true),ai:d=>d&&(renderAI(d),true)};
async function loadLast(){const j=await api("/api/last");if(!j||j.error)return;LAST=j;
  for(const [k,f] of Object.entries(RENDER)){const r=LAST[k];if(!r)continue;try{if(f(r.data)){const st=$("#s-"+k);if(st){st.className="status";st.textContent="Hasil terakhir, dibuat "+new Date(r.at).toLocaleString("id-ID",{day:"numeric",month:"short",hour:"2-digit",minute:"2-digit"})+". Tidak memakai saldo lagi."}}}catch{}}
  $("#cfg-spent").textContent=spentText()}
(async()=>{await loadConfig();await loadData();await loadLast();show(store.get("ver2",false)?store.get("tab","today"):"today",true);store.set("ver2",true);
  if(CFG.yt_connected&&Date.now()/1000-(CFG.yt_synced||0)>6*3600)ytSync(null,null)})();
</script>
